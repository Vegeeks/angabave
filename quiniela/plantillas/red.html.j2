<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="robots" content="noindex, nofollow">
<meta name="referrer" content="no-referrer">
<meta http-equiv="Content-Security-Policy" content="default-src 'none'; script-src 'unsafe-inline'; style-src 'unsafe-inline'; img-src data:; connect-src 'self' {{ origen_funcion }} {{ origen_espn }}; base-uri 'none'; form-action 'none'">
<meta name="theme-color" content="{{ tema_campo['--bg']|lower }}">
<link rel="icon" href="{{ favicon }}">
<title>Prueba de conexión · {{ marca }}</title>
<style>
:root{
  {% for nombre, valor in tema_campo.items() %}{{ nombre }}:{{ valor }}; {% endfor %}
  --verde:#34d680; --rojo:#ff6b61; --ambar:#ffb547;
  --pastilla:#f3f6f4; --pastilla-txt:#0a0f0c;
  --r1:16px; --r2:12px; --r3:8px;
  color-scheme:dark;
}
*{box-sizing:border-box} html,body{margin:0}
body{background:var(--bg); color:var(--txt); font:14px/1.45 -apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif;
  -webkit-font-smoothing:antialiased}
main{max-width:560px; margin:0 auto; padding:24px 16px 40px}
.casa{display:flex; align-items:center; gap:12px; margin-bottom:20px}
.casa .marca-svg{width:32px; height:32px; flex:none}
.casa .marca-palabra{display:block; width:100px; height:16px}
h1{font-size:20px; line-height:1.25; margin:0 0 4px} p{margin:4px 0} .tenue{color:var(--tenue)}
ol{list-style:none; padding:0; margin:16px 0; display:grid; gap:8px}
li{background:var(--panel); border:1px solid var(--linea); border-radius:var(--r2); padding:12px}
li b{display:block; font-size:16px; font-weight:600}
/* Un punto y nada más: lleno es que pasó, hueco que no. */
li b::before{content:""; display:inline-block; box-sizing:border-box; width:8px; height:8px; margin-right:8px; border-radius:50%;
  vertical-align:.1em; background:var(--ambar)}
li small{display:block; font-size:12px; color:var(--tenue); margin-top:2px; word-break:break-word}
.ok b::before{background:var(--verde)}
.mal b{color:var(--rojo)}
.mal b::before{background:transparent; border:2px solid var(--rojo)}
button{appearance:none; -webkit-appearance:none; border:0; border-radius:var(--r2); background:var(--pastilla); color:var(--pastilla-txt);
  font:inherit; font-size:16px; font-weight:700; width:100%; min-height:52px; margin-top:4px; cursor:pointer}
.caja{background:var(--panel2); border-radius:var(--r2); padding:12px; margin-top:12px; font-size:12px;
  color:var(--tenue); word-break:break-word}
</style>
</head>
<body>
<main>
  <div class="casa">{{ marca_svg|safe }}{{ marca_palabra|safe }}</div>
  <h1>Prueba de conexión</h1>
  <p class="tenue">Revisa, desde este teléfono y esta red, cada conexión que usan las páginas de {{ marca }}. Si algo sale en rojo, mándale a Angel una captura de toda la pantalla.</p>
  <ol id="lista"></ol>
  <button type="button" id="otra">Repetir la prueba</button>
  <div class="caja" id="equipo"></div>
  <p class="tenue" style="margin-top:14px">{{ version }}</p>
</main>
<script>
/* A propósito sin sintaxis moderna (nada de flechas ni const): esta página
   tiene que correr justo donde las otras fallan. */
(function () {
  var FUNCION = {{ url_funcion|tojson }};
  var ESPN = {{ url_espn|tojson }};
  var ESPERA = 20000;
  var lista = document.getElementById("lista");

  var pruebas = [
    { nombre: "Aviso de versión (version.json)", url: "version.json", leer: "version" },
    { nombre: "Portal completo (index.html)", url: "index.html", leer: "pagina" },
    { nombre: "Página del enlace (cargar.html)", url: "cargar.html", leer: "pagina" },
    { nombre: "Servidor de cargas (Supabase)", url: FUNCION + "?que=quien", esperado: 401 },
    { nombre: "Marcadores en vivo (ESPN)", url: ESPN, leer: "nada" }
  ];

  function renglon(texto) {
    var li = document.createElement("li");
    li.className = "espera";
    var b = document.createElement("b");
    b.appendChild(document.createTextNode(texto));
    var s = document.createElement("small");
    s.appendChild(document.createTextNode("probando…"));
    li.appendChild(b);
    li.appendChild(s);
    lista.appendChild(li);
    return { li: li, b: b, s: s };
  }

  function poner(r, bien, titulo, detalle) {
    r.li.className = bien ? "ok" : "mal";
    r.b.textContent = titulo;
    r.s.textContent = detalle;
  }

  function probar(prueba, hecho) {
    var r = renglon(prueba.nombre);
    var inicio = Date.now();
    var terminado = false;
    var control = window.AbortController ? new AbortController() : null;
    var reloj = setTimeout(function () {
      if (terminado) return;
      terminado = true;
      if (control) control.abort();
      poner(r, false, prueba.nombre, "Sin respuesta en " + (ESPERA / 1000) + " s.");
      hecho();
    }, ESPERA);
    var url = prueba.url + (prueba.url.indexOf("?") >= 0 ? "&" : "?") + "prueba=" + Date.now();
    var opciones = { cache: "no-store" };
    if (control) opciones.signal = control.signal;
    fetch(url, opciones).then(function (respuesta) {
      return respuesta.text().then(function (texto) {
        if (terminado) return;
        terminado = true;
        clearTimeout(reloj);
        var ms = Date.now() - inicio;
        var nodo = respuesta.headers.get("x-served-by") || "";
        var edad = respuesta.headers.get("age");
        var partes = ["HTTP " + respuesta.status, Math.round(texto.length / 1024) + " KB", ms + " ms"];
        if (prueba.leer === "version") {
          try { partes.push("versión " + JSON.parse(texto).version); } catch (e) { partes.push("respuesta ilegible"); }
        }
        if (prueba.leer === "pagina") {
          // En <meta name="version">; una copia vieja del CDN todavía la trae en el pie.
          var v = texto.match(/<meta name="version" content="([^"]+)"/i) || texto.match(/alfa v\d+\.\d+\.\d+/i);
          partes.push(v ? (v[1] || v[0]) : "sin versión (¿página incompleta?)");
        }
        if (nodo) partes.push("nodo " + nodo.split(",").pop().trim());
        if (edad) partes.push("en caché hace " + edad + " s");
        var bien = prueba.esperado ? respuesta.status === prueba.esperado : respuesta.ok;
        poner(r, bien, prueba.nombre, partes.join(" · "));
        hecho();
      });
    }).catch(function (error) {
      if (terminado) return;
      terminado = true;
      clearTimeout(reloj);
      poner(r, false, prueba.nombre, "No se pudo conectar (" + ((error && error.message) || error) + ") a los " + (Date.now() - inicio) + " ms.");
      hecho();
    });
  }

  function correr() {
    while (lista.firstChild) lista.removeChild(lista.firstChild);
    var i = 0;
    (function siguiente() {
      if (i < pruebas.length) probar(pruebas[i++], siguiente);
    })();
  }

  var equipo = document.getElementById("equipo");
  equipo.appendChild(document.createTextNode(
    "Teléfono: " + navigator.userAgent + " · Hora: " + new Date().toLocaleString("es-MX")
  ));
  document.getElementById("otra").addEventListener("click", correr);
  correr();
})();
</script>
</body>
</html>
