    const t2 = crear("div", "titulo");
    t2.appendChild(crear("h2", null, "Duelo"));
    t2.appendChild(crear("span", "nota", "compara a dos"));
    raiz.appendChild(t2);
    raiz.appendChild(duelo());
  }

  /* Todo lo que se puede decir de alguien cruzando los picks de los 34. */
  function retrato(idx) {
    const linea = [];
    const porEquipo = new Map();     // equipo -> {veces, aciertos}
    let contra = 0, contraOk = 0, cerrados = 0, aciertos = 0;

    jugadas.forEach((s) => {
      const fila = s.jugadores.indexOf(idx);
      const enTabla = (s.tabla || []).find((f) => f.p === idx);
      if (enTabla) linea.push({ n: s.n, aciertos: enTabla.f, pos: enTabla.pos });
      if (fila < 0) return;

      const juegos = partidosDe(s);
      juegos.forEach((p, col) => {
        const local = s.picks[fila][col] === 1;
        const lado = local ? "l" : "v";
        const eq = local ? p.l : p.v;
        const registro = porEquipo.get(eq) || { veces: 0, aciertos: 0 };
        registro.veces++;

        if (p.cerrado) {
          cerrados++;
          const acerto = p.g === lado;
          if (acerto) { aciertos++; registro.aciertos++; }

          // ¿Fue contra la mayoría? Se cuenta cómo votó la quiniela ese partido.
          let casa = 0;
          s.jugadores.forEach((_, otra) => { if (s.picks[otra][col] === 1) casa++; }); 
          const suyos = local ? casa : s.jugadores.length - casa;
          if (suyos * 2 < s.jugadores.length) {
            contra++;
            if (acerto) contraOk++;
          }
        }
        porEquipo.set(eq, registro);
      });
    });

    // El equipo que más elige, desempatando por aciertos.
    let consentido = null;
    porEquipo.forEach((registro, eq) => {
      if (!consentido || registro.veces > consentido.veces ||
          (registro.veces === consentido.veces && registro.aciertos > consentido.aciertos)) {
        consentido = { eq, ...registro };
      }
    });

    return { linea, consentido, contra, contraOk, cerrados, aciertos };
  }

  function perfil(idx) {
    const f = generalPorIdx.get(idx);
    const datos = retrato(idx);
    const caja = crear("div", "perfil");

    const cab = crear("div", "cab");
    const izq = crear("div");
    izq.appendChild(crear("div", "rotulo", f ? f.pos + "º lugar general" : "participante"));
    izq.appendChild(crear("div", "nom", nombre(idx)));
    cab.appendChild(izq);
    const cerrar = crear("button", "cerrar", "✕");
    cerrar.type = "button";
    cerrar.setAttribute("aria-label", "Cerrar ficha");
    cerrar.addEventListener("click", () => { perfilAbierto = null; pintarJugadores(); });
    cab.appendChild(cerrar);
    caja.appendChild(cab);

    const semanas = datos.linea.length || 1;
    const promedio = (datos.linea.reduce((s, x) => s + x.aciertos, 0) / semanas).toFixed(1);
    const ganadas = jugadas.filter((s) => s.oficial && (s.ganadores || []).includes(idx)).length;

    const cifras = crear("div", "cifras");
    [[f ? f.total : 0, "aciertos"], [f ? f.err : 0, "fallos"],
     [promedio, "por semana"], [ganadas, ganadas === 1 ? "semana ganada" : "semanas ganadas"]]
      .forEach(([valor, etiqueta]) => {
        const c = crear("div", "cifra");
        c.appendChild(crear("b", null, String(valor)));
        c.appendChild(crear("span", null, etiqueta));
        cifras.appendChild(c);
      });
    caja.appendChild(cifras);

    // A cuántos del primero: el dato que todo el mundo quiere saber.
    const lider = D.general[0];
    if (f && lider) {
      const falta = lider.total - f.total;
      const nota = crear("div", "nota-perfil");
      nota.textContent = falta === 0
        ? "Va en la punta de la general."
        : "A " + falta + (falta === 1 ? " acierto" : " aciertos") + " del primer lugar.";
      caja.appendChild(nota);
    }

    if (datos.linea.length) {
      const mejor = Math.max(...datos.linea.map((s) => s.aciertos));
      const peor = Math.min(...datos.linea.map((s) => s.aciertos));
      const barras = crear("div", "barras");
      datos.linea.forEach((s) => {
        const col = crear("div", "col" + (s.aciertos === mejor && mejor !== peor ? " mejor" : ""));
        const b = crear("div", "b");
        b.title = "Semana " + s.n + ": " + s.aciertos + " aciertos, " + s.pos + "º de la semana";
        col.appendChild(crear("small", "cima", String(s.aciertos)));
        col.appendChild(b);
        col.appendChild(crear("small", null, "S" + s.n));
        barras.appendChild(col);
        requestAnimationFrame(() => {
          b.style.height = Math.max(6, (s.aciertos / Math.max(1, mejor)) * 40) + "px";
        });
      });
      caja.appendChild(barras);
    }

    const rasgos = crear("div", "rasgos");
    if (datos.consentido && datos.consentido.veces > 1) {
      rasgos.appendChild(rasgo(
        "Su consentido",
        datos.consentido.eq,
        "lo eligió " + datos.consentido.veces + " veces · " +
          datos.consentido.aciertos + " bien",
        (D.colores[datos.consentido.eq] || {}).local
      ));
    }
    if (datos.cerrados) {
      rasgos.appendChild(rasgo(
        "Contra la mayoría",
        datos.contra + (datos.contra === 1 ? " vez" : " veces"),
        datos.contra ? datos.contraOk + " le salieron" : "siempre va con la manada"
      ));
      rasgos.appendChild(rasgo(
        "Acierto",
        Math.round((datos.aciertos / datos.cerrados) * 100) + "%",
        "de " + datos.cerrados + " partidos cerrados"
      ));
    }
    if (rasgos.children.length) caja.appendChild(rasgos);
    return caja;
  }

  function rasgo(titulo, valor, pie, color) {
    const nodo = crear("div", "rasgo");
    if (color) nodo.style.setProperty("--c", color);
    nodo.appendChild(crear("div", "rot", titulo));
    nodo.appendChild(crear("div", "val", valor));
    nodo.appendChild(crear("div", "pie", pie));
    return nodo;
  }

  function duelo() {
    const env = crear("div", "duelo");
    const orden = D.general.map((f) => f.p);
    const armar = (valor) => {
      const s = crear("select", "ancho");
      orden.forEach((i) => { const o = crear("option", null, nombre(i)); o.value = String(i); s.appendChild(o); });
      s.value = String(valor);
      return s;
    };
    const uno = armar(jugador !== null ? jugador : orden[0]);
    const dos = armar(orden.find((i) => i !== Number(uno.value)) ?? orden[0]);
    const fila = crear("div");
    fila.style.cssText = "display:grid; grid-template-columns:1fr 1fr; gap:.5rem";
    fila.appendChild(uno); fila.appendChild(dos);
    env.appendChild(fila);
    const destino = crear("div");
    env.appendChild(destino);

    const pintar = () => {
      const a = Number(uno.value), b = Number(dos.value);
      destino.textContent = "";
      const fa = generalPorIdx.get(a), fb = generalPorIdx.get(b);
      const caras = crear("div", "caras");
      [[fa, a], [fb, b]].forEach(([f, idx], n) => {
        const otra = n === 0 ? fb : fa;
        const cara = crear("div", "cara" + (f && otra && f.total > otra.total ? " arriba" : ""));
        cara.appendChild(crear("div", "q", nombre(idx)));
        cara.appendChild(crear("div", "t", String(f ? f.total : 0)));
        cara.appendChild(crear("div", "rotulo", f ? f.pos + "º" : ""));
        if (n === 0) { caras.appendChild(cara); caras.appendChild(crear("div", "vs-mid", "VS")); }
        else caras.appendChild(cara);
      });
      destino.appendChild(caras);

      const s = porSemana.get(D.activa) || jugadas[jugadas.length - 1];
      if (!s || !s.jugadores.length) return;
      const fa2 = s.jugadores.indexOf(a), fb2 = s.jugadores.indexOf(b);
      if (fa2 < 0 || fb2 < 0) return;
      const juegos = partidosDe(s);
      const difs = [];
      juegos.forEach((p, col) => {
        if (s.picks[fa2][col] === s.picks[fb2][col]) return;
        const ladoA = s.picks[fa2][col] === 1 ? "l" : "v";
        difs.push({ p, ladoA });
      });
      const t = crear("div", "titulo");
      t.appendChild(crear("h2", null, "Dónde difieren · semana " + s.n));
      t.appendChild(crear("span", "nota", difs.length + " de " + juegos.length));
      destino.appendChild(t);
      if (!difs.length) {
        destino.appendChild(aviso("Picks idénticos", "Eligieron exactamente lo mismo esta semana."));
        return;
      }
      const caja = crear("div", "dif");
      difs.forEach(({ p, ladoA }) => {
        const row = crear("div", "row");
        const eqA = ladoA === "l" ? p.l : p.v;
        const eqB = ladoA === "l" ? p.v : p.l;
        const claseA = p.cerrado ? (p.g === ladoA ? " gano" : " perdio") : "";
        const claseB = p.cerrado ? (p.g !== ladoA && p.g !== "x" ? " gano" : " perdio") : "";
        row.appendChild(crear("span", "j izq" + claseA, eqA));
        row.appendChild(crear("span", "mid", p.mv === null ? "por jugar" : p.mv + "–" + p.ml));
        row.appendChild(crear("span", "j der" + claseB, eqB));
        caja.appendChild(row);
      });
      destino.appendChild(caja);
    };
    uno.addEventListener("change", pintar);
    dos.addEventListener("change", pintar);
    pintar();
    return env;
  }

  /* ═══════════════ el momento de la semana ═══════════════
     El portal se acomoda a lo que está pasando: en tiempo de picks se ven los
     picks; con partidos, los partidos; con la semana cerrada, quién ganó. Y
     quien ya dijo quién es ve sus números todo el tiempo, en vivo. */

  const mismoDia = (a, b) => {
    const x = new Date(a), y = new Date(b);
    return x.getFullYear() === y.getFullYear() && x.getMonth() === y.getMonth() && x.getDate() === y.getDate();
  };
  const pct = (a, b) => (b > 0 ? Math.round((100 * a) / b) : null);
  const ordinal = (n) => n + ".º";
  /* "8.º" con el número en la tipografía de cifras y el ordinal, que no está en
     el recorte, chiquito y en la del sistema. */
  function conOrdinal(tag, clase, valor) {
    const nodo = crear(tag, clase);
    const m = /^(\d+)\.º$/.exec(valor);
    if (!m) { nodo.textContent = valor; return nodo; }
    nodo.appendChild(document.createTextNode(m[1]));
    nodo.appendChild(crear("small", "o", ".º"));
    return nodo;
  }

  /* Todos los partidos de una semana, cargados o por repartir, con el marcador en vivo encima. */
  function todosLosJuegos(s) {
    return s.partidos.map(efectivo).concat((s.por_entregar || []).map(efectivo));
  }
  function juegosEnVivo(s) {
    return s ? todosLosJuegos(s).filter((p) => p.vivo && !p.cerrado) : [];
  }
  /* Los de hoy, jugados o no: el domingo en la noche también importa cómo quedaron. */
  function juegosDeHoy(s) {
    if (!s) return [];
    const ahora = Date.now();
    return todosLosJuegos(s).filter((p) => p.t && mismoDia(p.t * 1000, ahora));
  }

  /* Hasta cuándo se mandan picks y de qué partidos: la tanda que falta de la
     semana en curso o, si ya no queda, la semana siguiente. */
  function picksAbiertos() {
    const ahora = Date.now();
    const abierta = (tandas) => (tandas || []).find((t) => Date.parse(t.cierre) > ahora);
    const s = porSemana.get(D.activa);
    if (s && (s.por_entregar || []).length) {
      const tanda = abierta(s.tandas_por_entregar);
      if (tanda) return { s, lista: s.por_entregar, tandas: s.tandas_por_entregar, cierre: tanda, parcial: true };
    }
    const siguiente = D.semanas.find((x) => x.estado === "pendiente");
    if (siguiente) {
      const tanda = abierta(siguiente.tandas);
      if (tanda) return { s: siguiente, lista: siguiente.partidos, tandas: siguiente.tandas, cierre: tanda, parcial: false };
    }
    return null;
  }

  function falta(ms) {
    if (ms <= 0) return "ya";
    const min = Math.floor(ms / 60000), h = Math.floor(min / 60), d = Math.floor(h / 24);
    if (d >= 1) return d + " d " + (h % 24) + " h";
    if (h >= 1) return h + " h " + (min % 60) + " min";
    return Math.max(1, min) + " min";
  }

  function proximoPartido() {
    const ahora = Date.now();
    let mejor = null;
    D.semanas.forEach((s) => todosLosJuegos(s).forEach((p) => {
      if (!p.cerrado && !p.vivo && p.t && p.t * 1000 > ahora && (!mejor || p.t < mejor.p.t)) mejor = { p, s };
    }));
    return mejor;
  }

  /* Tus números: los de la semana en curso (con lo que va en juego) y los de la temporada. */
  function numerosDe(idx, cual) {
    const g = D.general.find((f) => f.p === idx) || null;
    // La semana en curso; si aún no se reparte, la última que ya tiene tabla.
    const s = cual || [porSemana.get(D.activa)].concat(D.semanas.slice().reverse())
      .find((x) => x && x.tabla && x.tabla.length);
    let semana = null;
    if (s && s.tabla && s.tabla.length) {
      const f = s.tabla.find((x) => x.p === idx);
      const fila = s.jugadores.indexOf(idx);
      if (f && fila >= 0) {
        let ganando = 0, perdiendo = 0;
        partidosDe(s).forEach((p, col) => {
          if (p.cerrado || !p.vivo || !p.g) return;
          if ((p.g === "l") === (s.picks[fila][col] === 1)) ganando++; else perdiendo++;
        });
        const vivos = vivosPorParticipante(s);
        const mio = f.f + (vivos.get(idx) || 0);
        const proy = 1 + s.tabla.filter((x) => x.f + (vivos.get(x.p) || 0) > mio).length;
        semana = { n: s.n, ok: f.f, mal: f.e, jugados: f.f + f.e, pos: f.pos, proy, ganando, perdiendo };
      }
    }
    return { g, semana };
  }

  /* En cuántos de los resultados posibles de lo que falta ganas o empatas la semana. */
  function chanceDe(s, idx) {
    const pendientes = s.partidos.filter((p) => !p.cerrado).length;
    if (!pendientes || !s.panorama || !Object.keys(s.panorama).length) return null;
    const total = Math.pow(2, pendientes);
    const fila = s.panorama[String(idx)];
    if (!fila) return { solo: 0, empata: 0, total };
    return { solo: fila[0], empata: fila[1], total };
  }

  /* Tus aciertos uno tras otro, partido por partido en el orden en que se jugaron. */
  function rachaDe(idx) {
    const seguidos = [];
    D.semanas.forEach((s) => {
      const fila = s.jugadores.indexOf(idx);
      if (fila < 0) return;
      s.partidos.map((p, col) => [p, col]).filter(([p]) => p.cerrado)
        .sort((a, b) => a[0].t - b[0].t)
        .forEach(([p, col]) => seguidos.push(!!p.g && (p.g === "l") === (s.picks[fila][col] === 1)));
    });
    let actual = 0, mejor = 0, corrida = 0;
    seguidos.forEach((bien) => { corrida = bien ? corrida + 1 : 0; mejor = Math.max(mejor, corrida); });
    for (let i = seguidos.length - 1; i >= 0 && seguidos[i]; i--) actual++;
    return { actual, mejor };
  }

  /* ═══ la barra con tu avance, en todas las secciones ═══ */
  function elegirJugador(i) {
    jugador = i;
    guardar("angabave.jugador", i === null ? null : D.participantes[i]);
    selSoy.value = i === null ? "" : String(i);
    cajaSoy.classList.toggle("puesto", i !== null);
    perfilAbierto = null;
    pintarIdentidad();
    repintar();
  }

  function listaDeNombres(vacio) {
    const lista = crear("select");
    lista.setAttribute("aria-label", "Elige tu nombre");
    lista.appendChild(Object.assign(crear("option", null, vacio), { value: "" }));
    D.participantes.map((q, i) => [i, q]).sort((a, b) => a[1].localeCompare(b[1], "es"))
      .forEach(([i, q]) => lista.appendChild(Object.assign(crear("option", null, q), { value: String(i) })));
    return lista;
  }

  /* Sin nombre: una línea que abre la lista de un toque (la lista va encima,
     transparente, para que el teléfono muestre su selector nativo). */
  const LLAVE_INVITACION = "angabave.invitado";
  let ultimaBarra = { quien: null, cifras: [] };
  function pintarMiBarra() {
    if (!miBarra) return;
    miBarra.textContent = "";
    if (jugador === null) {
      if (leer(LLAVE_INVITACION) === "no") return;
      const fila = crear("div", "mi-barra-invita");
      const elegir = crear("label", "elegir");
      elegir.appendChild(crear("span", "txt", "¿Quién eres? Elige tu nombre y sigue tus aciertos en vivo"));
      elegir.appendChild(crear("span", "cta", "Elegir"));
      const lista = listaDeNombres("¿Quién eres?");
      lista.addEventListener("change", () => { if (lista.value !== "") elegirJugador(Number(lista.value)); });
      elegir.appendChild(lista);
      fila.appendChild(elegir);
      const cerrar = crear("button", "cerrar", "×");
      cerrar.type = "button";
      cerrar.setAttribute("aria-label", "Ahora no. Puedes elegir tu nombre después con el botón de arriba.");
      cerrar.addEventListener("click", () => { guardar(LLAVE_INVITACION, "no"); pintarMiBarra(); });
      fila.appendChild(cerrar);
      miBarra.appendChild(fila);
      return;
    }
    const { g, semana } = numerosDe(jugador);
    const b = crear("button", "mi-barra-yo");
    b.type = "button";
    b.setAttribute("aria-label", "Tu avance. Toca para ver tu perfil.");
    const celda = (rotulo, partes, vivo) => {
      const c = crear("span", "celda" + (vivo ? " vivo" : ""));
      c.appendChild(crear("small", "rot", rotulo));
      const linea = crear("span", "linea");
      partes.filter(Boolean).forEach((parte) => linea.appendChild(parte));
      c.appendChild(linea);
      b.appendChild(c);
    };
    if (semana) {
      const enJuego = semana.ganando + semana.perdiendo;
      const p = pct(semana.ok, semana.jugados);
      celda(enJuego ? "En vivo · ganas " + semana.ganando + " de " + enJuego : "Semana " + semana.n, [
        crear("b", null, semana.ok + "/" + semana.jugados),
        p === null ? null : crear("span", "por", p + "%"),
        conOrdinal("span", "rango", ordinal(enJuego ? semana.proy : semana.pos)),
      ], enJuego > 0);
    }
    if (g) {
      const p = pct(g.total, g.total + g.err);
      celda("Temporada", [
        crear("b", null, String(g.total)),
        p === null ? null : crear("span", "por", p + "%"),
        conOrdinal("span", "rango", ordinal(g.pos)),
        g.mov ? crear("span", "mov " + (g.mov > 0 ? "sube" : "baja"), (g.mov > 0 ? "▲" : "▼") + Math.abs(g.mov)) : null,
      ]);
    }
    if (!semana && !g) celda(nombre(jugador), [crear("span", "por", "Aún sin partidos cerrados")]);
    b.appendChild(crear("span", "flecha", "›"));
    b.addEventListener("click", () => {
      perfilAbierto = jugador;
      navegar("jugadores");
    });
    // Si una cifra cambió desde la última vez (un acierto en vivo), brinca.
    const cifrasAhora = Array.from(b.querySelectorAll(".linea b"), (x) => x.textContent);
    if (ultimaBarra.quien === jugador) {
      b.querySelectorAll(".linea b").forEach((x, i) => {
        if (ultimaBarra.cifras[i] !== undefined && ultimaBarra.cifras[i] !== x.textContent) x.classList.add("cambio");
      });
    }
    ultimaBarra = { quien: jugador, cifras: cifrasAhora };
    miBarra.appendChild(b);
  }

  /* ═══ hoy ═══ */
  function pintarHoy() {
    const raiz = vistas.hoy;
    raiz.textContent = "";
    const s = porSemana.get(D.activa) || null;
    const vivos = juegosEnVivo(s);
    const deHoy = juegosDeHoy(s).filter((p) => !p.vivo);
    const hoy = deHoy.filter((p) => !p.cerrado && !p.porConfirmar);
    const terminados = deHoy.filter((p) => p.cerrado || p.porConfirmar);
    const picks = picksAbiertos();
    const cerrada = !!s && s.estado === "cerrada";
    // Los picks de la semana que sigue no le quitan el lugar a la que se está
    // jugando (el domingo en la noche importa cómo vas) hasta que cierran pronto.
    const apuran = !!picks && (picks.s === s || !s || s.estado !== "en_vivo" ||
      Date.parse(picks.cierre.cierre) - Date.now() < 36 * 3600e3);
    const fase = vivos.length ? "vivo" : hoy.length ? "hoy" : apuran ? "picks" : cerrada ? "cerrada" : "semana";

    raiz.appendChild(saludo(fase, s, vivos, hoy, picks, terminados.length));
    const sinPartidos = !vivos.length && !hoy.length && !terminados.length;
    if (sinPartidos) raiz.appendChild(diaSinPartidos(picks));
    const rejilla = crear("div", "hoy-rejilla");
    const principal = crear("div", "hoy-principal");
    const lateral = crear("div", "hoy-lateral");
    rejilla.appendChild(principal);
    rejilla.appendChild(lateral);
    raiz.appendChild(rejilla);

    const previa = semanaRecienCerrada();
    const tarjetas = {
      partidos: () => tarjetaPartidos(s, vivos, hoy, terminados),
      // Con la semana nueva sin repartir, "tu semana" es la que acaba de cerrar.
      tuSemana: () => tarjetaTuSemana(s && s.estado !== "pendiente" ? s : previa),
      resultado: () => (s && (cerrada || s.proyectable) ? campeon(s) : null),
      previo: () => (previa && previa !== s ? campeon(previa) : null),
      picks: () => (picks ? tarjetaPicks(picks) : null),
      // El aviso de día sin partidos ya dice cuál es el próximo.
      proximo: () => (sinPartidos ? null : tarjetaProximo()),
    };
    // Pocas tarjetas y en orden de importancia: lo que pasa ahora, lo tuyo y
    // quién va ganando. Lo demás vive en su sección de la barra de abajo.
    // [columna principal, columna lateral]; en el teléfono van una tras otra.
    const plan = {
      vivo: [["partidos"], ["tuSemana", "resultado"]],
      hoy: [["partidos", "picks"], ["tuSemana"]],
      picks: [["previo", "picks"], ["tuSemana"]],
      cerrada: [["resultado"], ["tuSemana", "proximo"]],
      semana: [["tuSemana", "partidos"], ["resultado", "proximo"]],
    }[fase];
    let orden = 0;
    plan.forEach((claves, columna) => claves.forEach((clave) => {
      const nodo = tarjetas[clave]();
      if (!nodo) return;
      nodo.style.setProperty("--n", orden++);
      (columna === 0 ? principal : lateral).appendChild(nodo);
    }));
    if (!principal.firstChild) principal.remove();
    if (!principal.isConnected || !lateral.firstChild) rejilla.classList.add("sola");
  }

  /* Un día sin partidos se dice claro: si ese día cierran los picks, eso es lo
     único que pasa; si no, no hay nada. Y cuál es el próximo partido. */
  const DIAS_SEMANA = ["domingo", "lunes", "martes", "miércoles", "jueves", "viernes", "sábado"];
  function cuandoEs(t) {
    const fecha = new Date(t * 1000);
    if (mismoDia(fecha, Date.now() + 864e5)) return "mañana a las " + hora(t);
    return "el " + DIAS_SEMANA[fecha.getDay()] + " " + fecha.getDate() + " a las " + hora(t);
  }
  function diaSinPartidos(picks) {
    const caja = crear("div", "dia-libre");
    caja.insertAdjacentHTML("beforeend",
      '<svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3.5" y="5" width="17" height="15.5" rx="3.2"/>' +
      '<path d="M3.5 10h17M8 3v4M16 3v4M9.5 14.5l5 3M14.5 14.5l-5 3"/></svg>');
    const txt = crear("div", "txt");
    const cierraHoy = picks ? tandasAbiertas(picks).find((x) => mismoDia(Date.parse(x.cierre), Date.now())) : null;
    txt.appendChild(crear("b", null, cierraHoy ? "Hoy no hay partidos" : "Hoy no hay partidos ni eventos"));
    const partes = [];
    if (cierraHoy) partes.push("Hoy a las " + hora(Date.parse(cierraHoy.cierre) / 1000) + " cierran los picks.");
    const prox = proximoPartido();
    if (prox) partes.push("El próximo: " + prox.p.v + " @ " + prox.p.l + ", " + cuandoEs(prox.p.t) + ".");
    if (partes.length) txt.appendChild(crear("span", null, partes.join(" ")));
    caja.appendChild(txt);
    return caja;
  }

  /* La última semana cerrada sigue siendo noticia hasta el jueves. */
  function semanaRecienCerrada() {
    const cerradas = D.semanas.filter((x) => x.estado === "cerrada");
    const s = cerradas[cerradas.length - 1];
    if (!s) return null;
    const ultimo = Math.max(0, ...s.partidos.map((p) => p.t || 0));
    return ultimo && Date.now() - ultimo * 1000 < 3.5 * 864e5 ? s : null;
  }

  const hora = (t) => new Date(t * 1000).toLocaleTimeString("es-MX", { hour: "2-digit", minute: "2-digit", hour12: false });

  /* Cuántos partidos quedan por elegir y cuándo cierran, tanda por tanda. */
  function tandasAbiertas(picks) {
    return (picks.tandas || []).filter((t) => Date.parse(t.cierre) > Date.now());
  }
  function porElegir(picks) {
    return tandasAbiertas(picks).reduce((n, t) => n + t.claves.length, 0) || picks.lista.length;
  }
  function textoCierres(picks) {
    const abiertas = tandasAbiertas(picks);
    if (abiertas.length <= 1) return "Cierran el " + picks.cierre.cierre_texto + ".";
    const partes = abiertas.map((t) => t.claves.length + " el " + t.cierre_texto);
    return "Cierran " + partes.slice(0, -1).join(", ") + " y " + partes[partes.length - 1] + ".";
  }

  /* Las cuentas regresivas se mueven solas. Cuando una llega a cero el momento
     cambió (cerraron los picks, arrancó un partido) y la vista se rehace. */
  function cuentaRegresiva(clase, antes, hasta) {
    const n = crear("span", clase, antes + falta(hasta - Date.now()));
    n.dataset.hasta = String(hasta);
    n.dataset.antes = antes;
    return n;
  }
  const vencidas = new Set();
  setInterval(() => {
    if (document.hidden) return;
    let cambio = false;
    document.querySelectorAll("[data-hasta]").forEach((n) => {
      const hasta = Number(n.dataset.hasta), resta = hasta - Date.now();
      if (resta > 0) n.textContent = n.dataset.antes + falta(resta);
      else if (!vencidas.has(hasta)) { vencidas.add(hasta); cambio = true; }
    });
    if (cambio) repintarSinEstorbar();
  }, 20000);

  function saludo(fase, s, vivos, hoy, picks, yaJugados) {
    const caja = crear("div", "saludo fase-" + fase);
    const fecha = new Date().toLocaleDateString("es-MX", { weekday: "long", day: "numeric", month: "long" });
    caja.appendChild(crear("div", "fecha", fecha.charAt(0).toUpperCase() + fecha.slice(1)));
    const titulo = {
      vivo: vivos.length === 1 ? "Hay un partido en vivo" : "Hay " + vivos.length + " partidos en vivo",
      hoy: yaJugados ? (hoy.length === 1 ? "Queda un partido hoy" : "Quedan " + hoy.length + " partidos hoy")
        : hoy.length === 1 ? "Hoy hay partido" : "Hoy hay " + hoy.length + " partidos",
      picks: "Tiempo de picks",
      cerrada: s ? "Semana " + s.n + " cerrada" : "Semana cerrada",
      semana: s ? "Semana " + s.n + " en curso" : "Temporada " + D.anio,
    }[fase];
    caja.appendChild(crear("h1", null, titulo));
    const detalle = crear("p");
    if (fase === "vivo") detalle.textContent = "Los marcadores se actualizan solos cada minuto.";
    else if (fase === "hoy") {
      const primero = hoy.slice().sort((a, b) => a.t - b.t)[0];
      const duelo = (hoy.length > 1 ? "El primero: " : "") + primero.v + " @ " + primero.l;
      if (primero.t * 1000 > Date.now()) {
        detalle.textContent = duelo + " a las " + hora(primero.t) + " · ";
        detalle.appendChild(cuentaRegresiva("cuenta", "en ", primero.t * 1000));
      } else {
        detalle.textContent = duelo + " ya arrancó; el marcador aparece en cuanto haya datos.";
      }
    } else if (fase === "picks") {
      const cuantos = porElegir(picks);
      detalle.textContent = "Semana " + picks.s.n + ": " + cuantos + (cuantos === 1 ? " partido" : " partidos") +
        " por elegir. " + textoCierres(picks);
    } else if (fase === "cerrada" && s) {
      const gente = (s.ganadores || []).map(nombre);
      const primero = (s.tabla || []).find((f) => f.pos === 1);
      const con = primero ? " con " + primero.f + (primero.f === 1 ? " acierto." : " aciertos.") : ".";
      if (gente.length === 1) detalle.textContent = "Ganó " + gente[0] + con;
      else if (gente.length && gente.length <= 3) detalle.textContent = "Ganaron " + gente.slice(0, -1).join(", ") + " y " + gente[gente.length - 1] + con;
      else if (gente.length) detalle.textContent = "Ganaron " + gente.length + " empatados" + con;
    } else if (s) {
      detalle.textContent = s.cerrados + " de " + s.total + " partidos cerrados.";
    }
    if (detalle.textContent) caja.appendChild(detalle);
    return caja;
  }


  /* Cuántos le fueron a cada lado en un partido ya cargado. */
  function consenso(s, col) {
    let casa = 0;
    s.picks.forEach((fila) => { if (fila[col] === 1) casa++; });
    return { v: s.picks.length - casa, l: casa };
  }

  function sigla(equipo) {
    const i = crear("i", "sig", D.siglas[equipo] || equipo.slice(0, 3).toUpperCase());
    const c = D.colores[equipo] || {};
    if (c.local) { i.style.background = c.local; i.style.color = c.local_texto || "#070b12"; }
    return i;
  }

  /* Los partidos de hoy en una sola tarjeta: en vivo, más tarde y terminados. */
  function tarjetaPartidos(s, vivos, porJugar, terminados) {
    const grupos = [["En vivo", vivos], ["Más tarde", porJugar], ["Terminados", terminados]]
      .filter(([, juegos]) => juegos.length);
    if (!grupos.length) return null;
    const caja = crear("section", "tarjeta partidos-hoy" + (vivos.length ? " envivo" : ""));
    const cab = crear("div", "cab");
    if (vivos.length) cab.appendChild(crear("span", "punto"));
    cab.appendChild(crear("h3", null, grupos.length > 1 ? "Partidos de hoy"
      : vivos.length ? "En vivo ahora" : porJugar.length ? "Hoy juegan" : "Resultados de hoy"));
    if (s) {
      const todos = crear("button", "enlace", "Toda la semana ›");
      todos.type = "button";
      todos.addEventListener("click", () => { pestana = "partidos"; pestanaElegida = true; navegar(s.n); });
      cab.appendChild(todos);
    }
    caja.appendChild(cab);
    grupos.forEach(([titulo, juegos]) => {
      if (grupos.length > 1) caja.appendChild(crear("div", "subgrupo", titulo));
      juegos.slice().sort((a, b) => a.t - b.t).forEach((p) => caja.appendChild(filaJuego(s, p)));
    });
    return caja;
  }

  function filaJuego(s, p) {
    const col = s ? s.partidos.findIndex((q) => q.v === p.v && q.l === p.l) : -1;
    const fila = crear("button", "juego-fila" + (p.vivo ? " vivo" : ""));
    fila.type = "button";
    const lados = crear("div", "lados");
    const empezo = p.vivo || p.cerrado || p.porConfirmar;
    [["v", p.v, p.mv], ["l", p.l, p.ml]].forEach(([lado, eq, m]) => {
      const l = crear("div", "eq-fila" + (empezo && p.g === lado ? " adelante" : ""));
      l.appendChild(sigla(eq));
      l.appendChild(crear("span", "eq", eq));
      if (empezo && m !== null && m !== undefined) l.appendChild(crear("b", "mrc", String(m)));
      lados.appendChild(l);
    });
    fila.appendChild(lados);
    const meta = crear("div", "meta");
    meta.appendChild(crear("span", "cuando", p.vivo ? (p.e || "En juego")
      : p.cerrado || p.porConfirmar ? (p.e || "Final") : hora(p.t)));
    if (col >= 0) {
      const mio = miPick(s, col);
      if (mio) {
        // En juego el color dice cómo vas; la palomita o la tache, solo con el final.
        const final = p.cerrado || p.porConfirmar;
        const estado = !p.g ? "neutro" : p.g === mio.lado ? "bien" : "mal";
        const marca = !final ? "" : estado === "bien" ? " ✓" : estado === "mal" ? " ✗" : "";
        // En pantallas angostas va la sigla: el nombre completo ya está en la fila.
        const pill = crear("span", "mio " + estado + (p.vivo ? " provisional" : ""), "Tu pick: ");
        pill.appendChild(crear("span", "largo", mio.equipo));
        pill.appendChild(crear("span", "corto", D.siglas[mio.equipo] || mio.equipo.slice(0, 3).toUpperCase()));
        if (marca) pill.appendChild(document.createTextNode(marca));
        if (p.vivo && p.g) pill.title = estado === "bien" ? "Va ganando" : "Va perdiendo";
        meta.appendChild(pill);
      }
      const c = consenso(s, col), total = c.v + c.l;
      if (total) {
        const mayor = c.l >= c.v ? p.l : p.v;
        const linea = crear("span", "consenso", pct(Math.max(c.v, c.l), total) + "% con ");
        linea.appendChild(crear("span", "largo", mayor));
        linea.appendChild(crear("span", "corto", D.siglas[mayor] || mayor.slice(0, 3).toUpperCase()));
        meta.appendChild(linea);
      }
    } else {
      meta.appendChild(crear("span", "consenso", "picks por repartir"));
    }
    fila.appendChild(meta);
    fila.addEventListener("click", () => {
      if (!s) return;
      pestana = "partidos";
      pestanaElegida = true;
      navegar(s.n);
    });
    return fila;
  }

  function tarjetaTuSemana(s) {
    if (jugador === null || !s || s.estado === "pendiente") return null;
    const { semana } = numerosDe(jugador, s);
    if (!semana) return null;
    const caja = crear("section", "tarjeta tu-semana");
    const cab = crear("div", "cab");
    cab.appendChild(crear("h3", null, "Tu semana " + semana.n));
    const ver = crear("button", "enlace", "Ver tabla ›");
    ver.type = "button";
    ver.addEventListener("click", () => { pestana = "tabla"; pestanaElegida = true; navegar(s.n); });
    cab.appendChild(ver);
    caja.appendChild(cab);

    const cifras = crear("div", "cifras");
    const cifra = (valor, rot, clase) => {
      const d = crear("div", "cifra" + (clase ? " " + clase : ""));
      d.appendChild(conOrdinal("b", null, valor));
      d.appendChild(crear("span", null, rot));
      cifras.appendChild(d);
    };
    cifra(semana.ok + "/" + semana.jugados, "aciertos");
    const p = pct(semana.ok, semana.jugados);
    cifra(p === null ? "—" : p + "%", "de efectividad");
    const enJuego = semana.ganando + semana.perdiendo;
    cifra(ordinal(enJuego ? semana.proy : semana.pos), (enJuego ? "de " + s.tabla.length + " si todo acaba así" : "lugar de " + s.tabla.length), "rango");
    caja.appendChild(cifras);

    // Barra: aciertos, fallos, en juego y por jugar, en proporción.
    const total = s.total || 1;
    const porJugar = Math.max(0, s.total - semana.jugados - enJuego);
    const barra = crear("div", "progreso-semana");
    [["ok", semana.ok], ["mal", semana.mal], ["juego", enJuego], ["falta", porJugar]].forEach(([c, n]) => {
      if (!n) return;
      const i = crear("i", c);
      i.style.flexGrow = String(n);
      i.title = n + " " + { ok: "aciertos", mal: "fallos", juego: "en juego", falta: "por jugar" }[c];
      barra.appendChild(i);
    });
    caja.appendChild(barra);
    const leyenda = crear("div", "leyenda");
    leyenda.appendChild(crear("span", "ok", semana.ok + " bien"));
    leyenda.appendChild(crear("span", "mal", semana.mal + " mal"));
    if (enJuego) leyenda.appendChild(crear("span", "juego", semana.ganando + " ganando · " + semana.perdiendo + " perdiendo"));
    if (porJugar) leyenda.appendChild(crear("span", "falta", porJugar + " por jugar"));
    caja.appendChild(leyenda);

    const c = chanceDe(s, jugador);
    if (c) {
      let texto;
      if (c.solo === c.total) texto = "Ya aseguraste el primer lugar, pase lo que pase.";
      else if (!c.solo && !c.empata) texto = "Con lo que falta ya no alcanzas el primer lugar.";
      else {
        const veces = Math.max(1, Math.round((100 * (c.solo + c.empata)) / c.total));
        texto = "Ganas o empatas la semana en " + veces + " de cada 100 resultados posibles.";
      }
      const nota = crear("button", "nota-chance", texto + " Ver escenarios ›");
      nota.type = "button";
      nota.addEventListener("click", () => { pestana = "escenarios"; pestanaElegida = true; navegar(s.n); });
      caja.appendChild(nota);
    }
    return caja;
  }

  function tarjetaPicks(picks) {
    const caja = crear("section", "tarjeta tus-picks");
    const cab = crear("div", "cab");
    cab.appendChild(crear("h3", null, "Tus picks · semana " + picks.s.n));
    cab.appendChild(cuentaRegresiva("cuenta-regresiva", "cierran en ", Date.parse(picks.cierre.cierre)));
    caja.appendChild(cab);
    const cuantos = porElegir(picks), llevas = borradorDe(picks);
    // La fecha exacta ya va en el titular de Hoy y aquí la cuenta regresiva.
    caja.appendChild(crear("p", "nota", llevas
      ? "Llevas " + llevas + " de " + cuantos + "."
      : cuantos + (cuantos === 1 ? " partido por elegir." : " partidos por elegir.")));
    const b = crear("button", "boton-principal", llevas ? "Seguir con mis picks" : "Armar mis picks");
    b.type = "button";
    b.addEventListener("click", () => navegar("picks"));
    caja.appendChild(b);
    return caja;
  }

  /* Cuántos picks de lo que sigue abierto lleva el borrador de este teléfono. */
  function borradorDe(picks) {
    let guardado = {};
    try { guardado = JSON.parse(leer(LLAVE_BORRADOR(picks.s.n)) || "{}"); } catch (e) { guardado = {}; }
    const abiertos = new Set(tandasAbiertas(picks).flatMap((tanda) => tanda.claves));
    return Object.keys(guardado).filter((clave) => abiertos.has(clave)).length;
  }

  function tarjetaProximo() {
    const prox = proximoPartido();
    if (!prox) return null;
    const caja = crear("section", "tarjeta proximo");
    const cab = crear("div", "cab");
    cab.appendChild(crear("h3", null, "Próximo partido"));
    cab.appendChild(cuentaRegresiva("cuenta-regresiva", "en ", prox.p.t * 1000));
    caja.appendChild(cab);
    const fila = crear("div", "juego-fila quieto");
    const lados = crear("div", "lados");
    [prox.p.v, prox.p.l].forEach((eq) => {
      const l = crear("div", "eq-fila");
      l.appendChild(sigla(eq));
      l.appendChild(crear("span", "eq", eq));
      lados.appendChild(l);
    });
    fila.appendChild(lados);
    const meta = crear("div", "meta");
    meta.appendChild(crear("span", "cuando", new Date(prox.p.t * 1000).toLocaleString("es-MX",
      { weekday: "short", day: "numeric", hour: "2-digit", minute: "2-digit", hour12: false })));
    meta.appendChild(crear("span", "consenso", "Semana " + prox.s.n));
    fila.appendChild(meta);
    caja.appendChild(fila);
    return caja;
  }


  /* En la general: tu temporada arriba, si ya dijiste quién eres. */
  function tarjetaTemporada() {
    if (jugador === null) return null;
    const g = D.general.find((f) => f.p === jugador);
    if (!g) return null;
    const caja = crear("section", "tarjeta mi-temporada");
    const cab = crear("div", "cab");
    cab.appendChild(crear("h3", null, "Tu temporada"));
    const ir_ = crear("button", "enlace", "Ir a mi fila ›");
    ir_.type = "button";
    ir_.addEventListener("click", () => {
      const fila = vistas.general.querySelector("tbody tr.yo");
      if (fila) fila.scrollIntoView({ behavior: suave ? "auto" : "smooth", block: "center" });
    });
    cab.appendChild(ir_);
    caja.appendChild(cab);
    const cifras = crear("div", "cifras");
    const cifra = (valor, rot, clase) => {
      const d = crear("div", "cifra" + (clase ? " " + clase : ""));
      d.appendChild(conOrdinal("b", null, valor));
      d.appendChild(crear("span", null, rot));
      cifras.appendChild(d);
    };
    cifra(String(g.total), "aciertos");
    const p = pct(g.total, g.total + g.err);
    cifra(p === null ? "—" : p + "%", "de efectividad");
    cifra(ordinal(g.pos), "lugar de " + D.general.length, "rango");
    caja.appendChild(cifras);
    const semanas = Object.entries(g.sem || {});
    const mejor = semanas.reduce((m, [n, v]) => (v > (m ? m[1] : -1) ? [n, v] : m), null);
    const racha = rachaDe(jugador);
    const extra = crear("p", "nota");
    const partes = [];
    if (mejor) partes.push("Tu mejor semana: la " + mejor[0] + ", con " + mejor[1]);
    if (racha.actual >= 2) partes.push("vas " + racha.actual + " aciertos seguidos");
    else if (racha.mejor >= 3) partes.push("tu mejor racha: " + racha.mejor + " seguidos");
    if (g.mov) partes.push(g.mov > 0 ? "subiste " + g.mov + (g.mov === 1 ? " lugar" : " lugares") : "bajaste " + Math.abs(g.mov) + (g.mov === -1 ? " lugar" : " lugares"));
    if (partes.length) { extra.textContent = partes.join(" · ") + "."; caja.appendChild(extra); }
    const rebanada = tuRebanada();
    if (rebanada) caja.appendChild(crear("p", "rebanada", rebanada));
    return caja;
  }

  /* ═══ picks: la única puerta para armar los tuyos ═══
     Se acomoda a la semana en curso: lo que está abierto, con su cuenta
     regresiva, y lo que el organizador ya registró a tu nombre para que
     revises que quedó bien. */
  function pintarPicks() {
    const raiz = vistas.picks;
    raiz.textContent = "";
    const abiertos = picksAbiertos();
    const conPicks = [porSemana.get(D.activa)].concat(D.semanas.slice().reverse())
      .find((x) => x && x.jugadores && x.jugadores.length);
    const s = abiertos ? abiertos.s : (porSemana.get(D.activa) || conPicks);

    const cabeza = crear("div", "saludo fase-picks");
    cabeza.appendChild(crear("div", "fecha", s ? "Semana " + s.n : "Temporada " + D.anio));
    cabeza.appendChild(crear("h1", null, abiertos ? "Tus picks" : "Picks cerrados"));
    const detalle = crear("p");
    if (abiertos) {
      const n = porElegir(abiertos);
      detalle.textContent = n + (n === 1 ? " partido" : " partidos") + " por elegir. " + textoCierres(abiertos);
    } else {
      detalle.textContent = "Por ahora no hay partidos abiertos. Los siguientes se abren en cuanto salga el calendario de la próxima semana.";
    }
    cabeza.appendChild(detalle);
    raiz.appendChild(cabeza);

    if (abiertos) {
      const tarjeta = crear("section", "tarjeta tus-picks completa");
      const cab = crear("div", "cab");
      cab.appendChild(crear("h3", null, "Arma tu quiniela"));
      cab.appendChild(cuentaRegresiva("cuenta-regresiva", "cierran en ", Date.parse(abiertos.cierre.cierre)));
      tarjeta.appendChild(cab);
      tarjeta.appendChild(moduloPicks(abiertos.s, abiertos.lista, abiertos.tandas, abiertos.parcial));
      raiz.appendChild(tarjeta);
    }

    if (conPicks) {
      const tarjeta = crear("section", "tarjeta registrados");
      const cab = crear("div", "cab");
      cab.appendChild(crear("h3", null, "Registrados · semana " + conPicks.n));
      const todos = crear("button", "enlace", "Los de todos ›");
      todos.type = "button";
      todos.addEventListener("click", () => { pestana = "picks"; pestanaElegida = true; navegar(conPicks.n); });
      cab.appendChild(todos);
      tarjeta.appendChild(cab);
      if (jugador === null) {
        tarjeta.appendChild(crear("p", "nota", "Elige tu nombre arriba y aquí ves lo que el organizador registró a tu nombre."));
      } else if (conPicks.jugadores.indexOf(jugador) < 0) {
        tarjeta.appendChild(crear("p", "nota", "El organizador todavía no registra picks a tu nombre en la semana " + conPicks.n + "."));
      } else {
        tarjeta.appendChild(crear("p", "nota", "Lo que el organizador cargó a tu nombre. Si algo no coincide con lo que mandaste, avísale."));
        tarjeta.appendChild(boleta(conPicks, jugador));
      }
      raiz.appendChild(tarjeta);
    }
  }


  /* ═══ dentro de "Semana" ═══ */
  function selectorDeSemanas(actual) {
    const caja = crear("div", "cambia-semana");
    const i = D.semanas.findIndex((x) => x.n === actual);
    const flecha = (destino, texto) => {
      const b = crear("button", "flecha-semana", texto);
      b.type = "button";
      if (!destino) { b.disabled = true; b.setAttribute("aria-label", "No hay más semanas"); return b; }
      b.setAttribute("aria-label", "Semana " + destino.n);
      b.addEventListener("click", () => { pestanaElegida = false; navegar(destino.n); });
      return b;
    };
    caja.appendChild(flecha(D.semanas[i - 1], "‹"));
    const centro = crear("button", "semana-elegida");
    centro.type = "button";
    centro.setAttribute("aria-haspopup", "dialog");
    centro.setAttribute("aria-label", "Semana " + actual + ". Elegir otra semana");
    centro.appendChild(crear("span", "num", "Semana " + actual));
    centro.appendChild(crear("span", "abre", "▾"));
    centro.addEventListener("click", () => abrirSemanas(actual, centro));
    caja.appendChild(centro);
    caja.appendChild(flecha(D.semanas[i + 1], "›"));
    return caja;
  }

  /* Todas las semanas en una hoja aparte: la fila de S1 a S18 ocupaba media
     pantalla. Cada una dice cómo quedó y cuántos llevas tú. */
  function abrirSemanas(actual, origen) {
    const fondo = crear("div", "hoja-fondo");
    const hoja = crear("div", "hoja");
    hoja.setAttribute("role", "dialog");
    hoja.setAttribute("aria-modal", "true");
    hoja.setAttribute("aria-label", "Elegir semana");
    hoja.appendChild(crear("div", "agarradera"));
    hoja.appendChild(crear("h3", null, "Semanas"));
    const rejilla = crear("div", "rejilla-semanas");
    const g = jugador !== null ? D.general.find((f) => f.p === jugador) : null;
    const cerrar = () => {
      document.documentElement.classList.remove("con-hoja");
      document.removeEventListener("keydown", tecla);
      fondo.remove();
      if (origen && origen.isConnected) origen.focus();
    };
    const tecla = (e) => { if (e.key === "Escape") cerrar(); };
    D.semanas.forEach((s) => {
      const vivos = juegosEnVivo(s).length;
      const b = crear("button", "celda-semana " + s.estado + (vivos ? " vivo" : ""));
      b.type = "button";
      if (s.n === actual) b.classList.add("elegida");
      if (s.n === D.activa) b.classList.add("en-curso");
      b.appendChild(crear("b", null, String(s.n)));
      b.appendChild(crear("small", null, vivos ? "En vivo" : { pendiente: "Por cargar", en_vivo: "En curso", cerrada: "Cerrada" }[s.estado] || ""));
      const mios = g && g.sem ? g.sem[String(s.n)] : undefined;
      if (mios !== undefined && s.estado !== "pendiente") {
        const gano = s.oficial && (s.ganadores || []).includes(jugador);
        b.appendChild(crear("span", "mio" + (gano ? " gano" : ""), (gano ? "🏆 " : "") + mios + (mios === 1 ? " tuyo" : " tuyos")));
      }
      b.setAttribute("aria-current", String(s.n === actual));
      b.addEventListener("click", () => { cerrar(); pestanaElegida = false; navegar(s.n); });
      rejilla.appendChild(b);
    });
    hoja.appendChild(rejilla);
    if (actual !== D.activa && porSemana.has(D.activa)) {
      const volver = crear("button", "boton-principal volver-actual", "Ir a la semana en curso (" + D.activa + ")");
      volver.type = "button";
      volver.addEventListener("click", () => { cerrar(); pestanaElegida = false; navegar(D.activa); });
      hoja.appendChild(volver);
    }
    fondo.appendChild(hoja);
    fondo.addEventListener("click", (e) => { if (e.target === fondo) cerrar(); });
    document.addEventListener("keydown", tecla);
    document.documentElement.classList.add("con-hoja");
    document.body.appendChild(fondo);
    const elegida = hoja.querySelector('[aria-current="true"]');
    if (elegida) elegida.focus();
  }

  /* Una sola línea con todo lo que antes eran tres tarjetas de avisos. */
  function lineaDeEstado(s) {
    const caja = crear("div", "detalle-semana");
    if (s.estado !== "pendiente") {
      const barra = crear("div", "avance-semana");
      barra.setAttribute("aria-hidden", "true");
      const lleno = crear("i");
      lleno.style.width = (s.total ? (100 * s.cerrados) / s.total : 0) + "%";
      barra.appendChild(lleno);
      caja.appendChild(barra);
    }
    const partes = [];
    if (s.estado === "pendiente") {
      const tanda = (s.tandas || []).find((x) => Date.parse(x.cierre) > Date.now()) || (s.tandas || [])[0];
      partes.push("Picks por cargar");
      if (tanda) partes.push("cierran el " + tanda.cierre_texto);
    } else {
      partes.push(s.cerrados + " de " + s.total + " partidos cerrados");
      const faltan = (s.por_entregar || []).length;
      if (faltan) {
        const tanda = (s.tandas_por_entregar || [])[0];
        partes.push(faltan + " por repartir" + (tanda ? " hasta el " + tanda.cierre_texto : ""));
      }
      if (s.estado !== "cerrada" && !s.proyectable) partes.push("ganador a partir de " + s.umbral + " cerrados");
    }
    caja.appendChild(crear("p", "linea-estado", partes.join(" · ")));
    return caja;
  }

  /* En Semana ya no va el generador: una sola puerta para los picks. */
  function avisoPicks(s, cuantos) {
    const abiertos = picksAbiertos();
    if (!abiertos || abiertos.s !== s) return null;
    const b = crear("button", "aviso-picks");
    b.type = "button";
    b.appendChild(crear("span", "txt", cuantos + (cuantos === 1 ? " partido" : " partidos") +
      " por elegir. Cierran el " + abiertos.cierre.cierre_texto + "."));
    b.appendChild(crear("span", "ir", "Armar mis picks ›"));
    b.addEventListener("click", () => navegar("picks"));
    return b;
  }

  /* ═══ vista de una semana ═══ */
  const PESTANAS = [["partidos", "Partidos"], ["tabla", "Tabla"],
                    ["picks", "Quién le fue a quién"], ["escenarios", "Escenarios"]];

  function pintarSemana(n) {
    const s = porSemana.get(n), raiz = vistas.semana;
    raiz.textContent = "";
    if (!s) return;

    const cabeza = crear("div", "cabeza-semana");
    cabeza.appendChild(selectorDeSemanas(n));
    const vivos = juegosEnVivo(s).length;
    const fila = crear("div", "estado-fila");
    const estado = crear("span", "estado-semana " + (vivos ? "vivo" : s.estado),
      vivos ? "En vivo" : { pendiente: "Por cargar", en_vivo: "En curso", cerrada: "Cerrada" }[s.estado] || "");
    if (vivos && ultimaConsulta) estado.title = "Última consulta " + ultimaConsulta.toLocaleTimeString("es-MX");
    fila.appendChild(estado);
    if (n !== D.activa && porSemana.has(D.activa)) {
      const volver = crear("button", "volver-actual", "Ir a la semana " + D.activa + " ›");
      volver.type = "button";
      volver.addEventListener("click", () => { pestanaElegida = false; navegar(D.activa); });
      fila.appendChild(volver);
    }
    cabeza.appendChild(fila);
    cabeza.appendChild(lineaDeEstado(s));
    raiz.appendChild(cabeza);

    const franja = avisoDeRezago(s);
    if (franja) raiz.appendChild(franja);

    if (s.estado === "pendiente") {
      const aviso_ = avisoPicks(s, s.partidos.length);
      if (aviso_) raiz.appendChild(aviso_);
      raiz.appendChild(panelPartidos(s));
      return;
    }

    const hero = campeon(s);
    if (hero) raiz.appendChild(hero);
    const resumen = miSemana(s);
    if (resumen) raiz.appendChild(resumen);

    const disponibles = PESTANAS.filter(([c]) =>
      c !== "escenarios" || (s.cerrados < s.total && Object.keys(s.panorama || {}).length > 0));
    if (!pestanaElegida) pestana = juegosDeHoy(s).length || vivos ? "partidos" : "tabla";
    if (!disponibles.some(([c]) => c === pestana)) pestana = disponibles[0][0];

    const tabs = crear("div", "tabs"), interior = crear("div", "tabs-int");
    interior.setAttribute("role", "tablist");
    interior.setAttribute("aria-label", "Vistas de la semana " + s.n);
    const corredera = crear("span", "corredera");
    interior.appendChild(corredera);
    disponibles.forEach(([clave, etiqueta]) => {
      const b = crear("button", null, etiqueta);
      b.type = "button";
      b.setAttribute("role", "tab");
      b.setAttribute("aria-selected", String(clave === pestana));
      b.addEventListener("click", () => {
        pestana = clave;
        pestanaElegida = true;
        recordarSitio();
        pintarSemana(n);
      });
      interior.appendChild(b);
    });
    tabs.appendChild(interior);
    raiz.appendChild(tabs);
    requestAnimationFrame(() => moverCorredera(interior));

    if (pestana === "tabla") raiz.appendChild(tablaSemana(s));
    else if (pestana === "partidos") raiz.appendChild(panelPartidos(s));
    else if (pestana === "picks") raiz.appendChild(panelReparto(s));
    else raiz.appendChild(panelEscenarios(s));

    /* El organizador reparte por tandas: mientras falten partidos por repartir,
       abajo de la tabla queda el acceso a la sección Picks. */
    const faltan = (s.por_entregar || []);
    if (faltan.length) {
      const aviso_ = avisoPicks(s, faltan.length);
      if (aviso_) raiz.appendChild(aviso_);
    }
  }

  /* La corredera sigue a la pestaña activa en vez de pintarle un fondo fijo. */
  function moverCorredera(interior) {
    const activa = interior.querySelector('button[aria-selected="true"]');
    const corredera = interior.querySelector(".corredera");
    if (!activa || !corredera) return;
    corredera.style.width = activa.offsetWidth + "px";
    corredera.style.transform = "translateX(" + activa.offsetLeft + "px)";
    activa.scrollIntoView({ inline: "nearest", block: "nearest" });
  }

  /* Filtro de nombres sobre una tabla ya dibujada. */
  function ponerFiltro(destino, filas, textoDe, etiqueta) {
    const caja = crear("div", "filtro-tabla");
    const campo = crear("input");
    campo.type = "search";
    campo.placeholder = etiqueta;
    campo.setAttribute("aria-label", etiqueta);
    caja.appendChild(campo);
    const vacio = crear("div", "sin-resultados", "Nadie con ese nombre.");
    vacio.hidden = true;
    campo.addEventListener("input", () => {
      const busca = campo.value.trim().toLowerCase();
      let visibles = 0;
      filas.forEach((fila) => {
        const cabe = !busca || textoDe(fila).toLowerCase().includes(busca);
        fila.hidden = !cabe;
        if (cabe) visibles++;
      });
      vacio.hidden = visibles > 0;
    });
    destino.insertBefore(caja, destino.firstChild);
    destino.appendChild(vacio);
  }

  /* ═══ volver arriba ═══ */
  const botonArriba = crear("button", "arriba");
  botonArriba.type = "button";
  botonArriba.setAttribute("aria-label", "Volver arriba");
  botonArriba.innerHTML =
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" ' +
    'stroke-linecap="round" stroke-linejoin="round"><path d="M12 19V5M5 12l7-7 7 7"/></svg>';
  botonArriba.addEventListener("click", () => window.scrollTo({ top: 0, behavior: "smooth" }));
  document.body.appendChild(botonArriba);

  /* El campo de fondo avanza a un tercio de la velocidad de la página. */
  const lienzo = document.querySelector(".campo .lienzo");
  function moverCampo() {
    if (!lienzo || suave) return;
    const tope = Math.max(0, lienzo.offsetHeight - window.innerHeight);
    lienzo.style.transform = "translate3d(0," + (-Math.min(tope, window.scrollY * 0.3)).toFixed(1) + "px,0)";
  }
  moverCampo();

  let esperandoScroll = false;
  window.addEventListener("scroll", () => {
    if (esperandoScroll) return;
    esperandoScroll = true;
    requestAnimationFrame(() => {
      botonArriba.classList.toggle("se-ve", window.scrollY > 520);
      moverCampo();
      recordarSitio();
      esperandoScroll = false;
    });
  }, { passive: true });

  // El acelerador de arriba usa requestAnimationFrame, que no corre con la
  // pestaña oculta. Al salir se anota la posición a la fuerza.
  window.addEventListener("pagehide", recordarSitio);
  document.addEventListener("visibilitychange", () => { if (document.hidden) recordarSitio(); });

  /* Las pestañas se pegan justo debajo del encabezado, que cambia de alto. */
  const encabezado = document.querySelector("header");
  function medirEncabezado() {
    document.documentElement.style.setProperty(
      "--alto-encabezado", Math.round(encabezado.getBoundingClientRect().height) + "px"
    );
  }
  medirEncabezado();
  if (window.ResizeObserver) new ResizeObserver(medirEncabezado).observe(encabezado);
  else window.addEventListener("resize", medirEncabezado);

  /* ═══ navegación ═══ */
  /* La pastilla que marca la sección elegida, en las dos barras. */
  navs.forEach((n) => n.insertBefore(crear("span", "indicador"), n.firstChild));
  function moverIndicadores() {
    navs.forEach((n) => {
      const pastilla = n.querySelector(".indicador");
      const elegido = n.querySelector('button[aria-selected="true"]');
      if (!pastilla || !elegido || !n.offsetWidth) return;     // la barra oculta no se mide
      const margen = n.classList.contains("al-pie") ? 5 : 0;
      pastilla.style.width = (elegido.offsetWidth - margen * 2) + "px";
      pastilla.style.transform = "translateX(" + (elegido.offsetLeft + margen) + "px)";
      if (!pastilla.classList.contains("listo")) requestAnimationFrame(() => pastilla.classList.add("listo"));
    });
  }
  window.addEventListener("resize", moverIndicadores);

  /* Cambiar de sección desliza la vista hacia donde vas: a la derecha si la
     sección está más adelante en la barra (o la semana es posterior), a la
     izquierda si está antes. Sin soporte del navegador, entra como siempre. */
  const ORDEN_VISTAS = ["hoy", "picks", "semana", "general", "jugadores", "premios"];
  function rumboHacia(destino) {
    const de = typeof vistaActual === "number" ? "semana" : vistaActual;
    const a = destino === "semana" || typeof destino === "number" ? "semana" : destino;
    if (de === "semana" && a === "semana") {
      const n = destino === "semana" ? semanaElegida : destino;
      return n > vistaActual ? "adelante" : n < vistaActual ? "atras" : null;
    }
    const i = ORDEN_VISTAS.indexOf(de), j = ORDEN_VISTAS.indexOf(a);
    return j > i ? "adelante" : j < i ? "atras" : null;
  }
  function navegar(destino, despues) {
    const rumbo = rumboHacia(destino);
    if (rumbo && document.startViewTransition && !suave) {
      document.documentElement.dataset.rumbo = rumbo;
      document.startViewTransition(() => {
        window.scrollTo({ top: 0, behavior: "instant" });
        ir(destino, true, true);
        if (despues) despues();
      });
      return;
    }
    window.scrollTo({ top: 0, behavior: suave ? "auto" : "smooth" });
    ir(destino, true);
    if (despues) despues();
  }

  function repintar() {
    const alto = window.scrollY;
    ir(vistaActual, false, true);
    window.scrollTo({ top: alto });
  }

  /* El repintado que pide el reloj o el marcador, no la persona: espera si está
     escribiendo o acaba de tocar algo, y le devuelve lo que tenía a medias. */
  let repintePendiente = false;
  function repintarSinEstorbar() {
    if (escribiendo() || Date.now() - ultimoToque < 8000) { repintePendiente = true; return; }
    repintePendiente = false;
    const controles = leerControles();
    repintar();
    reponerControles(controles);
  }
  document.addEventListener("focusout", () => setTimeout(() => {
    if (repintePendiente) repintarSinEstorbar();
  }, 0));

  function ir(vista, empujar, quieto) {
    if (vista === "semana") vista = semanaElegida;
    if (typeof vista === "number" || /^\d+$/.test(String(vista))) {
      vista = Number(vista);
      if (!porSemana.has(vista)) vista = "hoy";
      else semanaElegida = vista;
    }
    vistaActual = vista;
    const cual = typeof vista === "number" ? "semana" : (vistas[vista] ? vista : "hoy");
    Object.entries(vistas).forEach(([k, nodo]) => nodo.classList.toggle("oculto", k !== cual));
    if (cual === "semana") pintarSemana(vista);
    else if (cual === "hoy") pintarHoy();
    else if (cual === "picks") pintarPicks();
    else if (cual === "premios") pintarPremios();
    else if (cual === "jugadores") pintarJugadores();
    else marcarFilasPropias();
    pintarMiBarra();

    const nodo = vistas[cual];
    nodo.classList.toggle("sin-animar", !!quieto);
    if (!quieto) {
      nodo.classList.remove("anima");
      void nodo.offsetWidth;
      nodo.classList.add("anima");
    }

    // Jugadores vive dentro de General: la barra marca General.
    const enBarra = cual === "jugadores" ? "general" : cual;
    navs.forEach((n) => n.querySelectorAll("button").forEach((b) =>
      b.setAttribute("aria-selected", String(b.dataset.vista === enBarra))));
    moverIndicadores();
    pintarEstado(cual === "semana" ? vista : D.activa);

    const destino = cual === "semana" ? "#s" + vista : "#" + cual;
    if (empujar && location.hash !== destino) history.replaceState(null, "", destino);
    recordarSitio();
  }

  /* Con muchas semanas la tabla se desborda: se muestran las últimas y el
     resto queda a un clic. */
  const botonTodas = document.getElementById("ver-todas");
  if (botonTodas) {
    let desplegadas = false;
    botonTodas.addEventListener("click", () => {
      desplegadas = !desplegadas;
      vistas.general.querySelectorAll(".c-sem").forEach((celda) => {
        celda.classList.toggle("vieja", !desplegadas && celda.dataset.vieja === "1");
      });
      botonTodas.textContent = desplegadas ? "Ver solo las últimas" : botonTodas.dataset.todas;
    });
    botonTodas.dataset.todas = botonTodas.textContent;
    vistas.general.querySelectorAll(".c-sem.vieja").forEach((celda) => {
      celda.dataset.vieja = "1";
    });
  }

  /* La tabla general viene escrita en el HTML: aquí se marca tu fila,
     se hace clicable y se le agrega el buscador. */
  let generalLista = false;
  /* El podio viene escrito en el HTML; aquí sus cifras arrancan de cero. */
  let podioAnimado = false;
  function animarPodio() {
    if (podioAnimado || suave) return;
    podioAnimado = true;
    vistas.general.querySelectorAll(".lugar .puntos").forEach((nodo, i) => {
      const destino = Number(nodo.textContent);
      if (!Number.isFinite(destino)) return;
      nodo.textContent = "0";
      setTimeout(() => contarHasta(nodo, destino, 900), 180 + i * 110);
    });
  }

  function marcarFilasPropias() {
    animarPodio();
    const previa = vistas.general.querySelector(".mi-temporada");
    if (previa) previa.remove();
    const mia = tarjetaTemporada();
    if (mia) vistas.general.insertBefore(mia, vistas.general.firstChild);
    const filas = vistas.general.querySelectorAll("tbody tr");
    if (!generalLista && filas.length > 12) {
      generalLista = true;
      const marco = vistas.general.querySelector(".marco");
      const env = crear("div");
      marco.parentNode.insertBefore(env, marco);
      env.appendChild(marco);
      ponerFiltro(env, Array.from(filas),
        (fila) => fila.children[1].textContent, "Buscar participante…");
    }
    filas.forEach((tr, i) => {
      const f = D.general[i];
      if (!f) return;
      tr.classList.toggle("yo", f.p === jugador);
      if (!tr.dataset.listo) {
        tr.dataset.listo = "1";
        tr.classList.add("clic");
        tr.addEventListener("click", () => { perfilAbierto = f.p; ir("jugadores", true); });
      }
    });
  }

  navs.forEach((n) => n.addEventListener("click", (e) => {
    const b = e.target.closest("button");
    if (!b) return;
    // "Semana" en la barra siempre lleva a la que se está jugando.
    if (b.dataset.vista === "semana") {
      pestanaElegida = false;
      if (porSemana.has(D.activa)) semanaElegida = D.activa;
    }
    navegar(b.dataset.vista);
  }));
  // El logo siempre lleva a Hoy.
  document.querySelector(".logo").addEventListener("click", (e) => {
    e.preventDefault();
    navegar("hoy");
  });
  const aDinamica = document.getElementById("a-dinamica");
  if (aDinamica) aDinamica.addEventListener("click", () => navegar("premios", () => requestAnimationFrame(() => {
    const ancla = document.getElementById("dinamica");
    if (ancla) ancla.scrollIntoView({ behavior: suave ? "auto" : "smooth", block: "start" });
  })));
  // Las fichas y el duelo ya no tienen botón abajo: se entra desde la general.
  const aJugadores = document.getElementById("a-jugadores");
  if (aJugadores) aJugadores.addEventListener("click", () => { perfilAbierto = null; navegar("jugadores"); });

  montarSoy();
  montarEquipo();
  pintarIdentidad();

  const hash = location.hash;
  const m = hash.match(/^#s(\d+)$/);
  const guardado = sitioGuardado();
  const valida = (v) => v === "hoy" || v === "picks" || v === "general" || v === "premios" || v === "jugadores" ||
    porSemana.has(Number(v));

  const inicio = m && porSemana.has(Number(m[1])) ? Number(m[1])
    : ["#hoy", "#picks", "#premios", "#jugadores", "#general"].includes(hash) ? hash.slice(1)
    : guardado && valida(guardado.vista) ? guardado.vista
    : "hoy";

  if (guardado && guardado.pestana) pestana = guardado.pestana;
  const automatica = !!(guardado && guardado.auto);
  if (automatica && guardado.elegida) pestanaElegida = true;
  if (automatica && guardado.perfil && D.participantes.includes(guardado.perfil)) {
    perfilAbierto = D.participantes.indexOf(guardado.perfil);
  }
  ir(inicio, false);

  // Y a la altura donde se quedó, para que una recarga no te mande al inicio.
  if (guardado && String(guardado.vista) === String(inicio)) {
    if (automatica) reponerControles(guardado.controles);
    if (guardado.scroll > 0) requestAnimationFrame(() => window.scrollTo({ top: guardado.scroll }));
  }

  if (D.vivo) {
    consultarVivo();
    setInterval(consultarVivo, D.vivo.cada * 1000);
    document.addEventListener("visibilitychange", () => { if (!document.hidden) consultarVivo(); });
  }
  /* ═══ que nadie se quede con una copia vieja ═══
     Pages cachea el HTML diez minutos y esa cabecera no se puede cambiar. Así
     que se consulta un archivo de cien bytes y se recarga solo si su firma es
     otra: cerró un partido, llegó una hoja, se movió un horario. Una hora nueva
     con la misma firma es un latido: dice que el cálculo sigue vivo, nada más.
     Y si la persona está en medio de algo, se espera a la siguiente revisión.

     Con candados, porque el CDN de GitHub ignora el ?v= (medido: una dirección
     con un ?v= nunca pedido sale del caché). Recargar en seguida puede traer la
     misma página vieja, y sin candados eso era un bucle que recargaba cada
     segundo y dejaba la pantalla en blanco hasta diez minutos después de cada
     publicación. Ahora:
       · solo se recarga si lo publicado es más nuevo que esta página;
       · por cada versión nueva, una sola vez cada once minutos (lo que tarda
         en vencer el caché del CDN);
       · y nunca más de una recarga cada tres minutos, pase lo que pase. */
  const LLAVE_RECARGA = "angabave.recarga";
  const TRES_MIN = 3 * 60 * 1000, ONCE_MIN = 11 * 60 * 1000;

  function marca(iso) {
    // Safari no siempre entiende seis decimales en los segundos.
    const t = Date.parse(String(iso || "").replace(/(\.\d{3})\d+/, "$1"));
    return isFinite(t) ? t : NaN;
  }

  function leerRecarga() {
    try { return JSON.parse(sessionStorage.getItem(LLAVE_RECARGA) || "null") || {}; }
    catch (e) { return {}; }
  }

  function recargarFresco(version) {
    const ahora = Date.now(), previa = leerRecarga();
    if (previa.cuando && ahora - previa.cuando < TRES_MIN) return;
    if (previa.version === version && ahora - previa.cuando < ONCE_MIN) return;
    try {
      sessionStorage.setItem(LLAVE_RECARGA, JSON.stringify({ cuando: ahora, version }));
    } catch (e) {
      // Sin dónde anotar la recarga no hay candado: mejor no recargar solo.
      return;
    }
    recargaAutomatica = true;
    recordarSitio();
    const url = new URL(location.href);
    url.searchParams.set("v", String(ahora));
    location.replace(url.toString());
  }

  /* El aviso de "lleva tanto sin recalcularse" entra o sale según el último latido. */
  function revisarRezago() {
    if (typeof vistaActual !== "number") return;
    const hay = !!vistas.semana.querySelector(".rezago");
    if (hay !== !!avisoDeRezago(porSemana.get(vistaActual))) repintarSinEstorbar();
  }

  async function revisarVersion() {
    if (document.hidden) return;
    try {
      const r = await fetch("version.json?t=" + Date.now(), { cache: "no-store" });
      if (!r.ok) return;
      const sello = await r.json();
      const publicada = marca(sello.generado), esta = marca(D.generado);
      if (publicada > latido) latido = publicada;
      latidoVisto = true;
      revisarRezago();
      if (!sello.firma || sello.firma === D.firma) return;   // nada oficial cambió
      if (!(publicada > esta)) return;   // el CDN trajo uno más viejo o ilegible
      if (escribiendo() || document.querySelector(".hoja-fondo") || Date.now() - ultimoToque < 30000) return;
      recargarFresco(sello.firma);
    } catch (e) { /* sin red o archivo viejo: se sigue con lo que hay */ }
  }

  setInterval(revisarVersion, 90000);
  document.addEventListener("visibilitychange", () => { if (!document.hidden) revisarVersion(); });
  revisarVersion();

  // Arrancó bien: la red de seguridad ya no hace falta.
  window.angabaveListo = true;
})();
</script>
</body>
</html>
