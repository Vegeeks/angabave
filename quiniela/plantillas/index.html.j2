        requestAnimationFrame(() => { relleno.style.width = (P.semanas_jugadas / P.semanas_temporada) * 100 + "%"; });
      }
      bolsas.appendChild(c);
    });
    raiz.appendChild(bolsas);

    // La dinámica, en claro: quién gana qué y qué pasa con los empates.
    const t2 = crear("div", "titulo");
    t2.id = "dinamica";
    t2.appendChild(crear("h2", null, "Cómo se gana"));
    raiz.appendChild(t2);
    const reglas = crear("section", "tarjeta dinamica");
    const bloque = (titulo, lineas) => {
      reglas.appendChild(crear("h3", "sub", titulo));
      const lista = crear("ul");
      lineas.forEach((linea) => lista.appendChild(crear("li", null, linea)));
      reglas.appendChild(lista);
    };
    bloque("Cada semana", P.dinamica.semana);
    bloque("Al final de la temporada", P.dinamica.temporada);
    const lugares = crear("div", "lugares-premio");
    P.reglas.forEach((r, i) => {
      const fila = crear("div", "lugar-premio " + ["oro", "plata", "bronce"][i]);
      fila.appendChild(crear("span", "n", r.lugar));
      fila.appendChild(crear("span", "pct", r.porcentaje));
      fila.appendChild(crear("b", null, r.monto));
      lugares.appendChild(fila);
    });
    reglas.appendChild(lugares);
    bloque("Si hay empates", P.dinamica.empates);
    raiz.appendChild(reglas);

    // Quién se llevaría algo hoy: "la rebanada del pastel". Al cerrar, el oficial.
    const tReparto = crear("div", "titulo");
    tReparto.appendChild(crear("h2", null, P.temporada_cerrada ? "Reparto final" : "La rebanada del pastel"));
    tReparto.appendChild(crear("span", "nota", P.temporada_cerrada ? "oficial"
      : "si la temporada terminara hoy · van " + P.semanas_jugadas + " de " + P.semanas_temporada));
    raiz.appendChild(tReparto);
    if (P.hoy.length) raiz.appendChild(listaDelReparto(P.hoy));
    const mia = tuRebanada();
    if (mia) raiz.appendChild(crear("p", "rebanada", mia));

    const t3 = crear("div", "titulo");
    t3.appendChild(crear("h2", null, "Ganadores por semana"));
    t3.appendChild(crear("span", "nota", P.semanal + " al 1er lugar"));
    raiz.appendChild(t3);

    const jugadas = D.semanas.filter((s) => s.estado !== "pendiente");
    if (!jugadas.length) {
      raiz.appendChild(aviso("Aún no hay semanas jugadas", "Aquí aparece el ganador de cada una."));
      return;
    }
    const lista = crear("div", "ganadores");
    jugadas.slice().reverse().forEach((s, i) => {
