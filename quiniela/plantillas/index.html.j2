<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="author" content="{{ desarrollador }}">
<meta name="description" content="{{ marca }} · Quiniela NFL {{ anio }}: tabla general, ganadores por semana, premios, marcador en vivo y los picks de todos.">
<meta name="theme-color" content="{{ tema_campo['--bg']|lower }}">
<link rel="icon" href="{{ favicon }}">
<link rel="manifest" href="manifest.webmanifest">
<link rel="apple-touch-icon" href="icono-180.png">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content="{{ marca }}">
<meta property="og:type" content="website">
<meta property="og:site_name" content="{{ marca }}">
<meta property="og:url" content="{{ sitio }}">
<meta property="og:title" content="{{ marca }} · Quiniela NFL {{ anio }}">
<meta property="og:description" content="Tabla general, ganadores por semana y marcador en vivo.">
<meta property="og:image" content="{{ sitio }}portada.png?v={{ firma }}">
<meta property="og:image:type" content="image/png">
<meta property="og:image:width" content="{{ tamano_portada[0] }}">
<meta property="og:image:height" content="{{ tamano_portada[1] }}">
<meta name="twitter:card" content="summary_large_image">
<title>{{ marca }} · Quiniela NFL {{ anio }}</title>
<style>
{% if tipografia %}
/* Oswald recortada a mayúsculas y números (SIL OFL 1.1, ver
   quiniela/tipografia/OFL.txt). Va incrustada: el sitio no pide archivos. */
@font-face{
  font-family:'Rotulo'; font-style:normal; font-weight:500 700; font-display:swap;
  src:url(data:font/woff2;base64,{{ tipografia }}) format('woff2');
}
{% endif %}
:root{
  /* El tema sin equipo (un campo de noche) sale de render_html.tema_campo(),
     verificado como los de cada equipo: ningún color de texto se pone a mano. */
  {% for nombre, valor in tema_campo.items() %}{{ nombre }}:{{ valor }}; {% endfor %}
  --oro:#f7c948; --oro2:#ffe193; --plata:#cfd9e6; --bronce:#d58f52;
  --verde:#3ddc84; --rojo:#ff6058; --vivo:#ff4757;
  --radio:18px; --sombra:0 16px 48px rgba(0,0,0,.55);
  /* El campo: cal de las líneas, de las marcas y el corte del pasto. */
  --cal:rgba(255,255,255,.062); --cal2:rgba(255,255,255,.042); --franja:rgba(255,255,255,.02);
  /* El vidrio esmerilado: borde, brillo de arriba y grano. */
  --borde-vidrio:rgba(255,255,255,.085);
  --brillo:linear-gradient(180deg,rgba(255,255,255,.055),rgba(255,255,255,.012) 36%,rgba(255,255,255,0) 72%);
  --grano:url("{{ grano }}");
  --rebote:cubic-bezier(.34,1.42,.5,1); --salida:cubic-bezier(.2,.8,.2,1);
  /* Solo para mayúsculas y cifras: los nombres llevan minúsculas y usan la
     del sistema, que las tiene todas. */
  --rotulo:'Rotulo','Oswald','Arial Narrow',var(--cuerpo);
  --cuerpo:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,'Helvetica Neue',Arial,sans-serif;
  --alto-encabezado:132px;
  --pastilla:linear-gradient(180deg,#fff,#e2ebe5); --pastilla-txt:#0b1510;
}
*{box-sizing:border-box; -webkit-tap-highlight-color:transparent; min-width:0}
html{-webkit-text-size-adjust:100%; scroll-behavior:smooth}
body{
  margin:0; background:var(--bg); color:var(--txt); overflow-x:hidden;
  font-family:var(--cuerpo);
  font-size:16px; line-height:1.45; -webkit-font-smoothing:antialiased;
  transition:background-color .45s ease;
}

/* ═══════ el campo ═══════
   De fondo, un campo visto desde arriba: el corte del pasto cada cinco yardas,
   las líneas de cal, las marcas de cada yarda, los números y las luces del
   estadio. Todo tenue: es ambiente, no información. Se mueve más despacio que
   la página, como el fondo de una toma de televisión. */
.campo{position:fixed; inset:0; z-index:-1; overflow:hidden; pointer-events:none;
  background:
    radial-gradient(55% 42% at 6% -4%, var(--resplandor), transparent 72%),
    radial-gradient(55% 42% at 94% -4%, var(--resplandor), transparent 72%),
    radial-gradient(130% 70% at 50% 118%, rgba(0,0,0,.5), transparent 62%),
    linear-gradient(180deg, var(--bg2), var(--bg) 46%);
  transition:background .45s ease}
.campo .lienzo{--y:clamp(56px,8.8vh,84px); position:absolute; left:0; right:0; top:0;
  height:calc(var(--y) * 22); will-change:transform;
  background:
    linear-gradient(90deg, transparent calc(2.5% - 1px), var(--cal) calc(2.5% - 1px) calc(2.5% + 1px),
      transparent calc(2.5% + 1px) calc(97.5% - 1px), var(--cal) calc(97.5% - 1px) calc(97.5% + 1px),
      transparent calc(97.5% + 1px)),
    repeating-linear-gradient(180deg, var(--cal) 0 1.5px, transparent 1.5px var(--y)),
    repeating-linear-gradient(180deg, var(--cal2) 0 1.5px, transparent 1.5px calc(var(--y) / 5)) 35% 0 / 14px 100% no-repeat,
    repeating-linear-gradient(180deg, var(--cal2) 0 1.5px, transparent 1.5px calc(var(--y) / 5)) 65% 0 / 14px 100% no-repeat,
    repeating-linear-gradient(180deg, var(--cal2) 0 1.5px, transparent 1.5px calc(var(--y) / 5)) 4.2% 0 / 10px 100% no-repeat,
    repeating-linear-gradient(180deg, var(--cal2) 0 1.5px, transparent 1.5px calc(var(--y) / 5)) 95.8% 0 / 10px 100% no-repeat,
    repeating-linear-gradient(180deg, var(--franja) 0 var(--y), transparent var(--y) calc(var(--y) * 2))}
.campo .num{position:absolute; top:calc(var(--y) * var(--k) * 2); font-family:var(--rotulo); font-weight:700;
  font-size:calc(var(--y) * .64); line-height:1; letter-spacing:.32em; color:var(--cal2); white-space:nowrap}
.campo .num.izq{left:10%; transform:translate(-50%,-50%) rotate(90deg)}
.campo .num.der{right:10%; transform:translate(50%,-50%) rotate(-90deg)}
@media (min-width:900px){ .campo .num.izq{left:7%} .campo .num.der{right:7%} }
h1,h2,h3{margin:0; font-weight:800; letter-spacing:-.02em}

/* ═══════ rótulos y cifras ═══════ */
.rotulo,.titulo h2,.estado,.version,.logo .marca,.logo .sub,
.campeon .rot,.mi-semana .rot,.mi-semana .dato span,.bolsa-card .rot,.rasgo .rot,
.lugar .detalle,.lado .sig,.juego .pie,.mi-pick,.bloque-hora span,.cuenta-lado,
.mini,.sello-consenso,.fila-gan .sN,.perfil .cifra span,.ver-todas,thead th{
  font-family:var(--rotulo); font-weight:700;
}
.lugar .puntos,.lado .mrc,.candidato .pct,.perfil .cifra b,.mi-semana .dato b,
.bolsa-card .val,.ficha .tot,.medalla,.pts,.err,.sem,.c-pos,.duelo .cara .t,
.campeon .bolsa,.fila-gan .monto,.split .cab .mr,.barras .col small,.candidato .n{
  font-family:var(--rotulo); font-variant-numeric:tabular-nums;
}
/* Las flechas y los ordinales no están en el recorte: que usen la del sistema. */
.mov,.ficha .pos{font-family:var(--cuerpo)}
button{font:inherit; color:inherit; background:none; border:0; cursor:pointer}
input,select{font:inherit}
.oculto{display:none !important}
.env{max-width:1160px; margin:0 auto; padding-inline:clamp(.7rem,3.4vw,1.5rem)}
.rotulo{font-size:.63rem; font-weight:900; letter-spacing:.16em; text-transform:uppercase; color:var(--tenue2)}

/* ═══════ encabezado ═══════ */
header{
  position:sticky; top:0; z-index:60;
  background:linear-gradient(180deg,rgba(6,9,15,.97),rgba(6,9,15,.88));
  backdrop-filter:blur(18px) saturate(150%);
  border-bottom:1px solid var(--linea); padding-top:env(safe-area-inset-top);
}
header::after{content:""; position:absolute; left:0; right:0; bottom:-1px; height:2px;
  background:linear-gradient(90deg,transparent,var(--acento),var(--oro),var(--acento),transparent);
  opacity:.65; transition:background .45s ease}
.top{display:flex; align-items:center; gap:.55rem; padding-block:.6rem .45rem; flex-wrap:wrap}
.logo{display:flex; align-items:center; gap:.55rem; min-width:0; flex:1 1 auto; text-align:left}
.logo svg{width:38px; height:38px; flex:0 0 auto; filter:drop-shadow(0 6px 14px rgba(0,0,0,.5))}
.logo .letras{display:flex; flex-direction:column; min-width:0}
.logo .marca{
  font-size:clamp(1.05rem,5.2vw,1.5rem); font-weight:900; line-height:1; letter-spacing:.15em;
  white-space:nowrap;
  background:linear-gradient(96deg,#ffe193,#f7c948 38%,#fff 66%,#d9f2e2);
  -webkit-background-clip:text; background-clip:text; color:transparent;
}
.logo .sub{font-size:.6rem; letter-spacing:.2em; color:var(--tenue2); font-weight:800;
  text-transform:uppercase; display:flex; align-items:center; gap:.35rem; flex-wrap:wrap; margin-top:.15rem}
.version{font-style:normal; letter-spacing:.08em; font-size:.56rem; color:var(--oro);
  background:rgba(247,201,72,.1); border:1px solid rgba(247,201,72,.26);
  padding:.04rem .3rem; border-radius:4px; white-space:nowrap}
.estado{
  display:inline-flex; align-items:center; gap:.38rem; flex:0 0 auto; max-width:100%;
  font-size:.62rem; font-weight:900; text-transform:uppercase; letter-spacing:.09em;
  padding:.34rem .6rem; border-radius:999px;
  border:1px solid var(--linea2); color:var(--tenue); background:rgba(255,255,255,.02);
}
.estado span:last-child{overflow:hidden; text-overflow:ellipsis; white-space:nowrap}
.estado.vivo{color:var(--vivo); border-color:rgba(255,71,87,.45); background:rgba(255,71,87,.09)}
.estado.esperando{color:var(--oro); border-color:rgba(247,201,72,.42); background:rgba(247,201,72,.08)}
.punto{width:7px; height:7px; border-radius:50%; background:currentColor; flex:0 0 auto}
.estado.vivo .punto,.estado.esperando .punto{animation:latir 1.5s ease-in-out infinite}
@keyframes latir{0%,100%{opacity:1; transform:scale(1)} 50%{opacity:.3; transform:scale(.7)}}

/* El marcador que acaba de cambiar se anuncia: antes podías estar viendo la
   pantalla en el momento del touchdown y no enterarte. */
@keyframes anotacion{
  0%{transform:scale(1); color:var(--txt)}
  18%{transform:scale(1.35); color:var(--verde)}
  100%{transform:scale(1); color:var(--txt)}
}
.lado.anoto .mrc{animation:anotacion 1.4s cubic-bezier(.2,.8,.3,1) 2}
.juego.anoto{animation:destello-juego 1.6s ease 2}
@keyframes destello-juego{
  0%,100%{box-shadow:0 0 0 1px transparent}
  30%{box-shadow:0 0 0 1px rgba(61,220,132,.45), 0 8px 28px rgba(61,220,132,.16)}
}

.identidad{display:flex; align-items:center; gap:.4rem; flex:0 0 auto; max-width:11rem;
  padding:.24rem .5rem .24rem .28rem; border-radius:999px;
  border:1px solid var(--linea2); background:rgba(255,255,255,.02); transition:border-color .18s}
.identidad:hover{border-color:var(--acento)}
.identidad .ini{width:24px; height:24px; border-radius:50%; display:grid; place-items:center;
  font-size:.62rem; font-weight:900; color:var(--pastilla-txt); background:var(--pastilla); flex:0 0 auto}
.identidad .txt{font-size:.74rem; font-weight:800; overflow:hidden; text-overflow:ellipsis;
  white-space:nowrap; color:var(--tenue)}
.identidad.puesta .txt{color:var(--txt)}
.identidad .flecha{font-size:.6rem; color:var(--tenue2); transition:transform .22s}
.identidad[aria-expanded="true"] .flecha{transform:rotate(180deg)}
.identidad[aria-expanded="true"]{border-color:var(--acento); background:var(--panel2)}
.controles{display:flex; gap:.4rem; padding-bottom:.45rem; animation:entrar .22s ease both}

.soy{display:flex; align-items:center; gap:.35rem; flex:1 1 0; min-width:0;
  border:1px solid var(--linea2); border-radius:999px; padding:.2rem .28rem .2rem .58rem;
  background:rgba(255,255,255,.02)}
.soy>span{font-size:.56rem; font-weight:900; letter-spacing:.12em; text-transform:uppercase; color:var(--tenue2)}
.soy>span{flex:0 0 auto}
.soy select{width:100%; max-width:none; margin:0; min-width:0; padding:.16rem 1.25rem .16rem .35rem; border:0;
  background-color:transparent; border-radius:999px; font-size:.74rem; font-weight:800; color:var(--txt);
  text-overflow:ellipsis; appearance:none;
  background-image:linear-gradient(45deg,transparent 50%,var(--tenue) 50%),linear-gradient(135deg,var(--tenue) 50%,transparent 50%);
  background-position:calc(100% - 10px) 50%,calc(100% - 6px) 50%; background-size:4px 4px,4px 4px;
  background-repeat:no-repeat}
.soy.puesto{border-color:rgba(91,149,255,.5); background:rgba(91,149,255,.1)}
.soy.puesto select{color:var(--acento)}


main{padding-bottom:3.5rem}
.vista.anima{animation:entrar .34s cubic-bezier(.2,.7,.3,1) both}
@keyframes entrar{from{opacity:0; transform:translateY(12px)} to{opacity:1; transform:none}}
.titulo{display:flex; align-items:center; gap:.5rem; margin:1.5rem .1rem .7rem; flex-wrap:wrap}
.titulo h2{font-size:.76rem; text-transform:uppercase; letter-spacing:.15em; color:var(--tenue)}
.titulo h2::before{content:""; display:inline-block; width:3px; height:.78rem; margin-right:.45rem;
  background:linear-gradient(180deg,var(--oro),var(--acento)); border-radius:2px; vertical-align:-1px}
.titulo .nota{font-size:.74rem; color:var(--tenue2); margin-left:auto; text-align:right}

/* ═══════ podio ═══════ */
/* En el teléfono es una lista compacta; en escritorio, una peana de verdad
   con el primero al centro, la plata a la izquierda y el bronce a la derecha. */
.podio{display:grid; gap:.55rem; grid-template-columns:1fr}
.lugar{position:relative; overflow:hidden; border-radius:var(--radio);
  background:linear-gradient(180deg,var(--panel2),var(--panel));
  border:1px solid var(--linea); box-shadow:var(--sombra);
  display:grid; grid-template-columns:auto minmax(0,1fr) auto; align-items:center;
  gap:.75rem; padding:.7rem .85rem;
  animation:brincar .55s cubic-bezier(.2,.8,.3,1) both; animation-delay:calc(var(--i)*90ms)}
@keyframes brincar{from{opacity:0; transform:translateY(22px) scale(.95)} to{opacity:1; transform:none}}
.lugar::before{content:""; position:absolute; inset:0 auto 0 0; width:3px; height:100%;
  background:var(--linea2)}
.lugar.oro{border-color:rgba(247,201,72,.45); box-shadow:0 16px 48px rgba(247,201,72,.1)}
.lugar.oro::before{background:linear-gradient(180deg,#f7c948,#ffe193,#f7c948)}
.lugar.plata::before{background:linear-gradient(180deg,#9fb0c6,#e6edf6,#9fb0c6)}
.lugar.bronce::before{background:linear-gradient(180deg,#b5773f,#e6b183,#b5773f)}
.lugar.oro::after{content:""; position:absolute; top:0; left:-60%; width:42%; height:100%;
  background:linear-gradient(100deg,transparent,rgba(255,255,255,.09),transparent);
  animation:destello 5s ease-in-out infinite 1.2s; pointer-events:none}
@keyframes destello{0%{left:-60%} 45%,100%{left:140%}}
.medalla{width:34px; height:34px; border-radius:50%; display:grid; place-items:center;
  font-size:.9rem; font-weight:900; color:#0a1020; flex:0 0 auto;
  background:linear-gradient(160deg,#dfe7f2,#93a3b8)}
.oro .medalla{background:linear-gradient(160deg,#ffe193,#e0a92b); box-shadow:0 0 22px rgba(247,201,72,.32)}
.bronce .medalla{background:linear-gradient(160deg,#e9bb92,#b5773f)}
.lugar .cuerpo{min-width:0}
.lugar .quien{font-weight:800; font-size:.98rem; line-height:1.25; overflow-wrap:anywhere}
.empatados{font-weight:800; font-size:.95rem; color:var(--txt)}
.empatados summary{cursor:pointer; list-style:none; display:inline-flex; align-items:center;
  gap:.3rem; padding:.1rem .45rem .1rem .1rem; border-radius:8px; transition:background .18s}
.empatados summary::-webkit-details-marker{display:none}
.empatados summary::after{content:"▾"; font-size:.65rem; color:var(--tenue2); transition:transform .2s}
.empatados[open] summary::after{transform:rotate(180deg)}
.empatados summary:hover{background:var(--panel2)}
.empatados .gente{margin-top:.4rem; animation:entrar .2s ease both}
.lugar .empatados .gente{justify-content:center}
.lugar .detalle{font-size:.6rem; color:var(--tenue2); text-transform:uppercase; letter-spacing:.1em}
.lugar .cifra{text-align:right; flex:0 0 auto}
.lugar .puntos{font-size:2.1rem; font-weight:700; letter-spacing:0; line-height:.95}
.oro .puntos{color:var(--oro)} .plata .puntos{color:var(--plata)} .bronce .puntos{color:var(--bronce)}

@media (min-width:660px){
  .podio{grid-template-columns:repeat(3,1fr); align-items:end; gap:.7rem}
  .lugar{display:block; text-align:center; padding:1.1rem .9rem 1rem}
  .lugar::before{inset:0 0 auto 0; width:100%; height:3px}
  .lugar.oro::before{background:linear-gradient(90deg,#f7c948,#ffe193,#f7c948)}
  .lugar.plata::before{background:linear-gradient(90deg,#9fb0c6,#e6edf6,#9fb0c6)}
  .lugar.bronce::before{background:linear-gradient(90deg,#b5773f,#e6b183,#b5773f)}
  .medalla{margin:0 auto .5rem; width:38px; height:38px; font-size:.98rem}
  .lugar .cifra{text-align:center}
  .lugar .puntos{font-size:2.9rem}
  .lugar .cuerpo{margin-top:.45rem}
  /* La peana: plata a la izquierda, oro al centro y más alto, bronce a la derecha. */
  .podio .lugar:nth-child(1){order:2; padding-block:1.6rem 1.35rem}
  .podio .lugar:nth-child(2){order:1}
  .podio .lugar:nth-child(3){order:3}
  .podio .lugar:nth-child(1) .puntos{font-size:3.6rem}
}
.lugar .bolsa{font-size:.78rem; font-weight:900; color:var(--oro); margin-top:.2rem;
  padding:.14rem .42rem; border-radius:7px; background:rgba(247,201,72,.12); display:inline-block}

/* ═══════ tablas ═══════ */
.marco{border:1px solid var(--linea); border-radius:var(--radio); background:var(--panel); position:relative}
/* Las superficies acompañan el cambio de tema sin saltos. */
.marco,.juego,.split,.lugar,.bolsa-card,.fila-gan,.ficha,.candidato,.perfil,.campeon,
.boleta .linea,.mi-semana,.aviso,.duelo .cara,.dif .row{transition:background .45s ease,border-color .45s ease}
.rueda{overflow-x:auto; -webkit-overflow-scrolling:touch; border-radius:var(--radio)}
.rueda::-webkit-scrollbar{height:6px}
.rueda::-webkit-scrollbar-thumb{background:var(--linea2); border-radius:99px}
table{border-collapse:separate; border-spacing:0; width:100%; font-variant-numeric:tabular-nums}
th,td{padding:.6rem .5rem; text-align:right; white-space:nowrap; font-size:clamp(.82rem,3.3vw,.93rem)}
thead th{font-size:.6rem; text-transform:uppercase; letter-spacing:.1em; color:var(--tenue2);
  border-bottom:1px solid var(--linea); font-weight:900; background:var(--panel);
  position:sticky; top:0; z-index:3}
tbody td{border-bottom:1px solid rgba(31,41,56,.7)}
tbody tr:last-child td{border-bottom:0}
tbody tr{animation:asomar .42s ease both; animation-delay:calc(var(--i)*20ms)}
@keyframes asomar{from{opacity:0; transform:translateX(-7px)} to{opacity:1; transform:none}}
.c-pos{width:2.5rem; min-width:2.5rem; box-sizing:border-box; color:var(--tenue2); font-weight:900; text-align:right}
/* El mínimo evita que la columna se colapse cuando la tabla se desborda. */
.c-nombre{text-align:left; font-weight:700; width:99%; min-width:9.5rem; max-width:0;
  overflow:hidden; text-overflow:ellipsis; white-space:nowrap}
.pts{font-weight:900; font-size:1.02em; color:var(--verde)}
.err{color:var(--rojo); opacity:.8}
.sem{color:var(--tenue2)}
tr.p1 .c-pos{color:var(--oro)} tr.p2 .c-pos{color:var(--plata)} tr.p3 .c-pos{color:var(--bronce)}
table.fija th:nth-child(-n+2),table.fija td:nth-child(-n+2){position:sticky; background:var(--panel); z-index:2}
table.fija th:nth-child(1),table.fija td:nth-child(1){left:0}
table.fija th:nth-child(2),table.fija td:nth-child(2){left:2.5rem; box-shadow:1px 0 0 var(--linea)}
table.fija thead th:nth-child(-n+2){z-index:4}
tbody tr:hover td{background:var(--panel2)}
tbody tr.yo td{background:rgba(91,149,255,.1)}
tbody tr.yo .c-nombre{color:var(--acento)}
table.fija tbody tr.yo td:nth-child(-n+2){background:#16233a}
tbody tr.clic{cursor:pointer}
.mov{display:inline-block; margin-left:.25rem; font-size:.6rem; font-weight:900;
  letter-spacing:-.01em; vertical-align:1px}
.mov.sube{color:var(--verde)} .mov.baja{color:var(--rojo); opacity:.75}
.mov.igual{color:var(--tenue2)}
th.c-sem.vieja,td.c-sem.vieja{display:none}
.ver-todas{display:block; width:100%; padding:.5rem; font-size:.72rem; font-weight:800;
  letter-spacing:.08em; text-transform:uppercase; color:var(--tenue);
  border-top:1px solid var(--linea); background:rgba(255,255,255,.015)}
.ver-todas:hover{color:var(--txt)}

.bloque-hora{display:flex; align-items:center; gap:.5rem; margin:.9rem .1rem .45rem}
.bloque-hora:first-child{margin-top:0}
.bloque-hora span{font-size:.64rem; font-weight:900; letter-spacing:.14em;
  text-transform:uppercase; color:var(--tenue2); white-space:nowrap}
.bloque-hora i{flex:1; height:1px; background:var(--linea)}
.bloque-hora em{font-style:normal; font-size:.6rem; font-weight:900; color:var(--vivo);
  letter-spacing:.1em; text-transform:uppercase}
.bloque-hora.seccion{margin-top:1.3rem}
.bloque-hora.seccion:first-child{margin-top:0}
.bloque-hora.seccion span{font-size:.72rem; color:var(--txt); letter-spacing:.16em}
.bloque-hora.seccion i{background:linear-gradient(90deg,var(--acento),transparent)}

.chip-vivo{display:inline-block; margin-left:.3rem; padding:.02rem .3rem; border-radius:5px;
  font-size:.6rem; font-weight:900; color:var(--oro); background:rgba(247,201,72,.14);
  border:1px solid rgba(247,201,72,.3); vertical-align:middle}

/* ═══════ pestañas ═══════ */
.tabs{position:sticky; top:var(--alto-encabezado); z-index:40; margin:.2rem -.2rem .85rem;
  padding:.35rem .2rem; background:linear-gradient(180deg,var(--bg) 72%,transparent)}
.tabs-int{position:relative; display:flex; gap:.15rem; overflow-x:auto; scrollbar-width:none;
  background:var(--panel); border:1px solid var(--linea); border-radius:13px; padding:.22rem}
.tabs-int::-webkit-scrollbar{display:none}
.tabs-int button{position:relative; z-index:2; flex:1 0 auto; padding:.44rem .7rem; border-radius:10px;
  font-size:.79rem; font-weight:800; color:var(--tenue); white-space:nowrap;
  transition:color .22s; text-align:center}
.tabs-int button[aria-selected="true"]{color:var(--txt)}
.corredera{position:absolute; top:.22rem; bottom:.22rem; left:0; width:0; border-radius:10px;
  background:var(--panel3); box-shadow:inset 0 0 0 1px var(--linea2); z-index:1;
  transition:transform .32s cubic-bezier(.3,.8,.35,1), width .32s cubic-bezier(.3,.8,.35,1)}

/* ═══════ volver arriba ═══════ */
.arriba{position:fixed; right:max(.9rem,env(safe-area-inset-right));
  bottom:calc(1.1rem + env(safe-area-inset-bottom)); z-index:70;
  width:44px; height:44px; border-radius:50%; display:grid; place-items:center;
  background:var(--panel2); border:1px solid var(--linea2); color:var(--txt);
  box-shadow:0 10px 30px rgba(0,0,0,.5); opacity:0; transform:translateY(14px) scale(.9);
  pointer-events:none; transition:opacity .25s, transform .25s}
.arriba.se-ve{opacity:1; transform:none; pointer-events:auto}
.arriba svg{width:20px; height:20px}

.filtro-tabla{position:relative; margin-bottom:.55rem}
.filtro-tabla input{width:100%; padding:.5rem .7rem .5rem 2rem; border-radius:11px;
  background:var(--panel); color:var(--txt); border:1px solid var(--linea); font-size:.85rem}
.filtro-tabla input:focus{outline:0; border-color:var(--acento)}
.filtro-tabla::before{content:"⌕"; position:absolute; left:.6rem; top:50%; transform:translateY(-50%);
  color:var(--tenue2); font-size:1rem}
.sin-resultados{padding:1rem; text-align:center; color:var(--tenue2); font-size:.85rem}

/* ═══════ campeón ═══════ */
.campeon{position:relative; overflow:hidden; border-radius:var(--radio); padding:1.3rem 1rem 1.15rem;
  text-align:center; border:1px solid var(--linea2); margin-bottom:.9rem;
  background:linear-gradient(180deg,var(--panel2),var(--panel));
  animation:brincar .5s cubic-bezier(.2,.8,.3,1) both}
.campeon.oficial{border-color:rgba(247,201,72,.5);
  background:radial-gradient(120% 90% at 50% -20%, rgba(247,201,72,.17), transparent 62%),
             linear-gradient(180deg,var(--panel2),var(--panel));
  box-shadow:0 18px 54px rgba(247,201,72,.12)}
.copa{width:46px; height:46px; margin:0 auto .35rem; display:block}
.campeon.oficial .copa{animation:palpitar 2.6s ease-in-out infinite; filter:drop-shadow(0 0 14px rgba(247,201,72,.45))}
@keyframes palpitar{0%,100%{transform:scale(1)} 50%{transform:scale(1.07)}}
.campeon .rot{font-size:.62rem; letter-spacing:.2em; text-transform:uppercase; font-weight:900; color:var(--tenue)}
.campeon.oficial .rot{color:var(--oro)}
.campeon .nombres{font-size:clamp(1.45rem,7.4vw,2.4rem); font-weight:900; letter-spacing:-.03em;
  line-height:1.15; margin:.3rem 0 .1rem; overflow-wrap:anywhere}
.campeon.oficial .nombres{background:linear-gradient(94deg,#fff,#ffe193 55%,#f7c948);
  -webkit-background-clip:text; background-clip:text; color:transparent}
.campeon .cifra{font-size:.78rem; color:var(--tenue); margin-top:.15rem}
.campeon .bolsa{display:inline-block; margin-top:.7rem; padding:.4rem 1rem; border-radius:999px;
  font-weight:700; font-size:1.35rem; letter-spacing:.01em; color:var(--oro);
  background:rgba(247,201,72,.12); border:1px solid rgba(247,201,72,.3)}
.campeon.provisional .bolsa{color:var(--tenue); background:rgba(255,255,255,.04); border-color:var(--linea2)}
.confetis{position:absolute; inset:0; pointer-events:none; overflow:hidden}
.confeti{position:absolute; top:-16px; width:7px; height:13px; border-radius:2px; opacity:0;
  animation:caer var(--d) cubic-bezier(.3,.5,.5,1) forwards}
@keyframes caer{0%{opacity:0; transform:translate3d(0,-20px,0) rotate(0)} 12%{opacity:1}
  100%{opacity:0; transform:translate3d(var(--x),300px,0) rotate(var(--r))}}

/* ═══════ mi semana ═══════ */
.mi-semana{display:flex; align-items:center; gap:.7rem; flex-wrap:wrap;
  border:1px solid rgba(91,149,255,.35); border-radius:14px; padding:.7rem .85rem;
  background:linear-gradient(180deg,rgba(91,149,255,.1),var(--panel)); margin-bottom:.85rem;
  animation:brincar .4s ease both}
.mi-semana .yo{font-weight:900; font-size:1rem; overflow-wrap:anywhere}
.mi-semana .rot{font-size:.58rem; letter-spacing:.14em; text-transform:uppercase; color:var(--acento); font-weight:900}
.mi-semana .cuentas{display:flex; gap:.9rem; margin-left:auto; flex-wrap:wrap}
.mi-semana .dato{text-align:right}
.mi-semana .dato b{display:block; font-size:1.6rem; font-weight:700; line-height:1}
.mi-semana .dato span{font-size:.58rem; text-transform:uppercase; letter-spacing:.1em; color:var(--tenue2)}
.mi-semana .dato.ok b{color:var(--verde)} .mi-semana .dato.no b{color:var(--rojo)}
.mi-semana .dato.vivo b{color:var(--oro)}

/* ═══════ premios ═══════ */
.bolsas{display:grid; gap:.6rem; grid-template-columns:repeat(auto-fit,minmax(min(100%,185px),1fr))}
.bolsa-card{border:1px solid var(--linea); border-radius:var(--radio); padding:.95rem .9rem;
  background:linear-gradient(180deg,var(--panel2),var(--panel));
  animation:brincar .45s ease both; animation-delay:calc(var(--i)*70ms)}
.bolsa-card .rot{font-size:.6rem; letter-spacing:.14em; text-transform:uppercase; color:var(--tenue2); font-weight:900}
.bolsa-card .val{font-size:clamp(1.8rem,8.4vw,2.4rem); font-weight:700; letter-spacing:0;
  margin-top:.25rem; color:var(--oro)}
.bolsa-card .pie{font-size:.73rem; color:var(--tenue2); margin-top:.25rem}
.bolsa-card.neutra .val{color:var(--txt)}
.progreso-bolsa{height:6px; border-radius:99px; background:var(--linea); overflow:hidden; margin-top:.6rem}
.progreso-bolsa i{display:block; height:100%; width:0; border-radius:99px;
  background:linear-gradient(90deg,var(--oro),#ffe193); transition:width 1s cubic-bezier(.2,.7,.3,1)}
.ganadores{display:grid; gap:.45rem}
.fila-gan{display:grid; grid-template-columns:auto minmax(0,1fr) auto; align-items:center; gap:.65rem;
  padding:.62rem .8rem; border:1px solid var(--linea); border-radius:12px; background:var(--panel);
  animation:asomar .4s ease both; animation-delay:calc(var(--i)*30ms)}
.fila-gan .sN{font-size:.64rem; font-weight:900; color:var(--tenue2); letter-spacing:.08em;
  background:var(--panel2); padding:.28rem .45rem; border-radius:7px; min-width:2.5rem; text-align:center}
.fila-gan .quien{font-weight:800; overflow-wrap:anywhere; line-height:1.25}
.fila-gan .quien small{display:block; font-weight:600; font-size:.69rem; color:var(--tenue2)}
.fila-gan .monto{font-weight:900; color:var(--oro); font-size:.9rem; white-space:nowrap}
.fila-gan.abierta{border-style:dashed}
.fila-gan.abierta .monto{color:var(--tenue2)}

/* ═══════ marcador estilo transmisión ═══════ */
.juegos{display:grid; gap:.5rem; grid-template-columns:repeat(auto-fill,minmax(min(100%,300px),1fr))}
.juego{border:1px solid var(--linea); border-radius:14px; background:var(--panel); overflow:hidden;
  animation:brincar .42s ease both; animation-delay:calc(var(--i)*30ms)}
.juego.envivo{border-color:rgba(255,71,87,.4);
  box-shadow:0 0 0 1px rgba(255,71,87,.12), 0 10px 30px rgba(255,71,87,.07)}
.juego.mi-equipo{border-color:var(--acento); box-shadow:0 0 0 1px var(--resplandor), 0 12px 34px var(--resplandor)}
.cinta-equipo{display:flex; align-items:center; gap:.3rem; padding:.3rem .7rem;
  background:var(--pastilla); color:var(--pastilla-txt);
  font-size:.58rem; font-weight:900; letter-spacing:.14em; text-transform:uppercase}
.lado{display:flex; align-items:center; gap:.55rem; padding:.55rem .7rem; position:relative}
.lado+.lado{border-top:1px solid rgba(31,41,56,.7)}
.lado::before{content:""; position:absolute; left:0; top:0; bottom:0; width:4px; background:var(--c,var(--linea2))}
.lado .sig{font-size:.64rem; font-weight:900; letter-spacing:.06em; color:#070b12;
  background:var(--c,var(--tenue2)); padding:.16rem .34rem; border-radius:5px; min-width:2.5rem;
  text-align:center; flex:0 0 auto}
.lado .nom{flex:1; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; color:var(--tenue);
  font-weight:700; font-size:.94rem}
.lado .mrc{font-weight:700; font-size:1.5rem; color:var(--tenue2); letter-spacing:0; line-height:1}
.lado.gana .nom{color:var(--txt); font-weight:900}
.lado.gana .mrc{color:var(--txt)}
.lado.gana::after{content:"◀"; font-size:.5rem; color:var(--verde); margin-left:-.25rem}
.juego .pie{display:flex; align-items:center; gap:.4rem; font-size:.63rem; color:var(--tenue2);
  text-transform:uppercase; letter-spacing:.09em; font-weight:800;
  border-top:1px solid var(--linea); padding:.42rem .7rem; background:rgba(0,0,0,.18)}
.juego.envivo .pie{color:var(--vivo)}
.juego .pie .der{margin-left:auto; color:var(--tenue2)}
.juego{border-left:3px solid transparent}
.juego.mio-ok{border-left-color:var(--verde)}
.juego.mio-no{border-left-color:var(--rojo)}
.juego.mio-vivo-ok{border-left-color:rgba(61,220,132,.55)}
.juego.mio-vivo-no{border-left-color:rgba(255,96,88,.55)}
.mi-pick{display:flex; align-items:center; gap:.3rem; font-size:.63rem; font-weight:900;
  letter-spacing:.07em; text-transform:uppercase; color:var(--tenue2);
  padding:.36rem .7rem; border-top:1px solid var(--linea)}
.mi-pick b{color:var(--txt)}
.juego.mio-ok .mi-pick b,.juego.mio-vivo-ok .mi-pick b{color:var(--verde)}
.juego.mio-no .mi-pick b,.juego.mio-vivo-no .mi-pick b{color:var(--rojo)}

/* ═══════ reparto de picks ═══════ */
.reparto{display:grid; gap:.55rem}
.split{border:1px solid var(--linea); border-radius:14px; background:var(--panel); padding:.7rem .8rem;
  display:grid; gap:.45rem; animation:brincar .4s ease both; animation-delay:calc(var(--i)*30ms)}
.split .cab{display:flex; align-items:center; gap:.5rem; font-weight:800; font-size:.92rem}
.split .cab .vs{flex:1; overflow:hidden; text-overflow:ellipsis; white-space:nowrap}
.split .cab .mr{font-variant-numeric:tabular-nums; color:var(--tenue2); font-weight:900; font-size:.82rem}
.balanza{display:flex; height:8px; border-radius:99px; overflow:hidden; background:var(--linea)}
.balanza i{display:block; height:100%; transition:width .8s cubic-bezier(.2,.7,.3,1)}
.cuenta-lado{display:flex; justify-content:space-between; font-size:.66rem; font-weight:900;
  text-transform:uppercase; letter-spacing:.06em}
.gente{display:flex; flex-wrap:wrap; gap:.26rem}
.gente span{font-size:.71rem; padding:.13rem .4rem; border-radius:6px; background:var(--panel2);
  border:1px solid var(--linea); color:var(--tenue); overflow-wrap:anywhere}
.gente span.ok{color:var(--verde); border-color:rgba(61,220,132,.3)}
.gente span.no{color:var(--rojo); border-color:rgba(255,96,88,.25); opacity:.68}
.gente span.tu{outline:1px solid var(--acento)}
.mini{font-size:.67rem; color:var(--tenue2); text-transform:uppercase; letter-spacing:.08em}
.sello-consenso{font-size:.58rem; font-weight:900; letter-spacing:.1em; text-transform:uppercase;
  padding:.1rem .36rem; border-radius:5px; white-space:nowrap}
.sello-consenso.unanime{color:var(--oro); background:rgba(247,201,72,.12)}
.sello-consenso.dividido{color:var(--acento); background:rgba(91,149,255,.14)}

select.ancho,input.ancho{width:100%; padding:.6rem .7rem; border-radius:12px; margin-bottom:.7rem;
  background:var(--panel); color:var(--txt); border:1px solid var(--linea2); font-size:.92rem}
select.ancho{appearance:none;
  background-image:linear-gradient(45deg,transparent 50%,var(--tenue) 50%),linear-gradient(135deg,var(--tenue) 50%,transparent 50%);
  background-position:calc(100% - 18px) 50%,calc(100% - 13px) 50%; background-size:5px 5px,5px 5px;
  background-repeat:no-repeat}
input.ancho::placeholder{color:var(--tenue2)}
input.ancho:focus,select.ancho:focus{outline:0; border-color:var(--acento)}

.boleta{display:grid; gap:.36rem}
.boleta .linea{display:grid; grid-template-columns:auto minmax(0,1fr) auto; align-items:center; gap:.55rem;
  padding:.52rem .7rem; border:1px solid var(--linea); border-radius:12px; background:var(--panel);
  font-size:.87rem; animation:asomar .34s ease both; animation-delay:calc(var(--i)*22ms)}
.boleta .vs{color:var(--tenue); overflow:hidden; text-overflow:ellipsis; white-space:nowrap}
.boleta .vs b{color:var(--txt)}
.sello{width:22px; height:22px; border-radius:50%; display:grid; place-items:center;
  font-size:.7rem; font-weight:900; flex:0 0 auto}
.sello.ok{background:rgba(61,220,132,.16); color:var(--verde)}
.sello.no{background:rgba(255,96,88,.13); color:var(--rojo)}
.sello.esp{background:var(--panel2); color:var(--tenue2)}
.boleta .linea.acierto{border-color:rgba(61,220,132,.28)}
.boleta .linea.fallo{opacity:.7}

/* ═══════ escenarios ═══════ */
.escena{display:grid; gap:.42rem}
.candidato{display:grid; grid-template-columns:1.5rem minmax(0,1fr) auto; align-items:center; gap:.55rem;
  padding:.5rem .7rem; border:1px solid var(--linea); border-radius:12px; background:var(--panel);
  animation:asomar .38s ease both; animation-delay:calc(var(--i)*35ms)}
.candidato .n{color:var(--tenue2); font-weight:900; font-size:.78rem}
.candidato .quien{font-weight:800; overflow:hidden; text-overflow:ellipsis; white-space:nowrap}
.candidato .pct{font-weight:700; color:var(--oro); font-size:1.15rem; letter-spacing:0}
.candidato.yo{border-color:rgba(91,149,255,.5); background:rgba(91,149,255,.08)}
.progreso{grid-column:2/4; height:6px; border-radius:99px; background:var(--linea); overflow:hidden; margin-top:.15rem}
.progreso i{display:block; height:100%; width:0; border-radius:99px;
  background:linear-gradient(90deg,var(--acento),#9dc0ff); transition:width .9s cubic-bezier(.2,.7,.3,1)}
.candidato.lider .progreso i{background:linear-gradient(90deg,#f7c948,#ffe193)}
.candidato{grid-template-columns:1.6rem minmax(0,1fr) auto}
.candidato .quien{white-space:normal; overflow:visible}
.que-significa{grid-column:2/4; font-size:.68rem; color:var(--tenue2); margin-top:.25rem; line-height:1.35}
.que-significa.tuya{color:var(--acento); font-weight:700}
.candidato .empatados{font-size:.95rem; font-weight:800}
.candidato .empatados .gente{margin-top:.35rem}
.candidato .empatados .gente span{font-size:.68rem}

/* ═══════ jugadores ═══════ */
.fichas{display:grid; gap:.42rem}
.ficha{display:grid; grid-template-columns:2.1rem minmax(0,1fr) auto; align-items:center; gap:.6rem;
  padding:.55rem .75rem; border:1px solid var(--linea); border-radius:12px; background:var(--panel);
  text-align:left; width:100%; transition:border-color .18s,background .18s}
.ficha:hover{border-color:var(--linea2); background:var(--panel2)}
.ficha .pos{font-weight:900; color:var(--tenue2); font-size:.82rem}
.ficha.p1 .pos{color:var(--oro)} .ficha.p2 .pos{color:var(--plata)} .ficha.p3 .pos{color:var(--bronce)}
.ficha .quien{font-weight:800; overflow:hidden; text-overflow:ellipsis; white-space:nowrap}
.ficha .quien small{display:block; font-weight:600; font-size:.68rem; color:var(--tenue2)}
.ficha .tot{font-weight:900; color:var(--verde); font-size:1.05rem}
.ficha.tuya{border-color:rgba(91,149,255,.5); background:rgba(91,149,255,.08)}

.perfil{border:1px solid var(--linea2); border-radius:var(--radio); background:linear-gradient(180deg,var(--panel2),var(--panel));
  padding:1rem .9rem; margin-bottom:.8rem; animation:brincar .4s ease both}
.perfil .cab{display:flex; align-items:flex-start; gap:.7rem; flex-wrap:wrap}
.perfil .nom{font-size:clamp(1.15rem,5.4vw,1.5rem); font-weight:900; letter-spacing:-.02em; overflow-wrap:anywhere}
.perfil .cerrar{margin-left:auto; font-size:1.1rem; color:var(--tenue2); padding:.1rem .4rem; line-height:1}
.perfil .cifras{display:flex; gap:1.1rem; flex-wrap:wrap; margin-top:.7rem}
.perfil .cifra b{display:block; font-size:1.7rem; font-weight:700; line-height:1}
.perfil .cifra span{font-size:.58rem; text-transform:uppercase; letter-spacing:.1em; color:var(--tenue2)}
.barras{display:flex; align-items:flex-end; gap:5px; height:58px; margin-top:.85rem}
.barras .col{flex:1 1 0; max-width:44px; display:flex; flex-direction:column;
  justify-content:flex-end; align-items:center; gap:3px}
.barras .b{width:100%; border-radius:3px 3px 0 0; background:linear-gradient(180deg,var(--acento),#3b6fd4);
  min-height:3px; transition:height .7s cubic-bezier(.2,.7,.3,1)}
.barras .col.mejor .b{background:linear-gradient(180deg,#ffe193,var(--oro))}
.barras .col small{font-size:.54rem; color:var(--tenue2); font-weight:800}
.barras .col small.cima{color:var(--tenue); font-size:.58rem}
.barras{height:76px}
.nota-perfil{margin-top:.6rem; font-size:.82rem; color:var(--tenue)}
.rasgos{display:grid; gap:.45rem; margin-top:.9rem;
  grid-template-columns:repeat(auto-fit,minmax(min(100%,150px),1fr))}
.rasgo{border:1px solid var(--linea); border-radius:11px; padding:.55rem .65rem;
  background:var(--panel); border-left:3px solid var(--c,var(--linea2))}
.rasgo .rot{font-size:.56rem; font-weight:900; letter-spacing:.12em; text-transform:uppercase;
  color:var(--tenue2)}
.rasgo .val{font-size:1.02rem; font-weight:900; margin-top:.15rem; overflow-wrap:anywhere}
.rasgo .pie{font-size:.68rem; color:var(--tenue2); margin-top:.1rem}

.duelo{display:grid; gap:.5rem}
.duelo .caras{display:grid; grid-template-columns:1fr auto 1fr; gap:.5rem; align-items:center}
.duelo .cara{border:1px solid var(--linea); border-radius:12px; background:var(--panel); padding:.6rem;
  text-align:center; min-width:0}
.duelo .cara .q{font-weight:900; font-size:.88rem; overflow-wrap:anywhere; line-height:1.2}
.duelo .cara .t{font-size:1.5rem; font-weight:900; color:var(--verde); font-variant-numeric:tabular-nums}
.duelo .cara.arriba{border-color:rgba(61,220,132,.45); background:rgba(61,220,132,.06)}
.duelo .vs-mid{font-weight:900; color:var(--tenue2); font-size:.72rem; letter-spacing:.1em}
.dif{display:grid; gap:.36rem}
.dif .row{display:grid; grid-template-columns:1fr auto 1fr; gap:.4rem; align-items:center;
  padding:.45rem .6rem; border:1px solid var(--linea); border-radius:10px; background:var(--panel); font-size:.8rem}
.dif .row .j{overflow:hidden; text-overflow:ellipsis; white-space:nowrap; font-weight:800}
.dif .row .j.izq{text-align:right} .dif .row .j.der{text-align:left}
.dif .row .mid{font-size:.6rem; color:var(--tenue2); text-transform:uppercase; letter-spacing:.06em; text-align:center}
.dif .row .j.gano{color:var(--verde)} .dif .row .j.perdio{color:var(--rojo); opacity:.7}

.rezago{display:flex; align-items:center; gap:.55rem; margin-bottom:.8rem;
  padding:.6rem .8rem; border-radius:12px; font-size:.82rem; line-height:1.35;
  color:#ffd9a8; background:rgba(247,170,72,.12); border:1px solid rgba(247,170,72,.4);
  animation:brincar .4s ease both}
.rezago b{color:#ffe7c4}
.rezago .icono{font-size:1.1rem; flex:0 0 auto}

/* Foco visible para quien navega con teclado. */
:focus-visible{outline:2px solid var(--acento); outline-offset:2px; border-radius:8px}

/* ═══════ generador de picks ═══════ */
.generador{border:1px solid var(--linea2); border-radius:var(--radio); background:var(--panel);
  padding:.95rem .9rem 1rem; margin-bottom:.9rem; animation:brincar .45s ease both}
.generador .rot{font-family:var(--rotulo); font-size:.6rem; font-weight:700; letter-spacing:.18em;
  text-transform:uppercase; color:var(--acento)}
.generador h3{font-size:clamp(1.05rem,5vw,1.3rem); margin:.2rem 0 .3rem; font-weight:900}
.generador .pie-gen{font-size:.8rem; color:var(--tenue); line-height:1.4; margin:0 0 .8rem}
.generador .quien-soy{display:flex; align-items:center; gap:.5rem; margin-bottom:.85rem;
  flex-wrap:wrap; font-size:.82rem; color:var(--tenue)}
.generador .quien-soy b{color:var(--txt)}
.tanda{margin-top:.9rem}
.tanda:first-of-type{margin-top:.3rem}
.tanda .cab{display:flex; align-items:baseline; gap:.5rem; flex-wrap:wrap; margin-bottom:.5rem}
.tanda .cab span{font-family:var(--rotulo); font-size:.64rem; font-weight:700; letter-spacing:.14em;
  text-transform:uppercase; color:var(--tenue2)}
.tanda .cab em{font-style:normal; font-size:.7rem; color:var(--oro); font-weight:700}
.tanda .cab em.vencida{color:var(--rojo)}
.duelo-pick{display:grid; grid-template-columns:1fr auto 1fr; gap:.35rem; align-items:stretch;
  margin-bottom:.4rem}
.duelo-pick .vs{display:grid; place-items:center; font-family:var(--rotulo); font-size:.58rem;
  font-weight:700; color:var(--tenue2); letter-spacing:.1em}
.opcion{display:flex; align-items:center; gap:.45rem; padding:.5rem .55rem; border-radius:11px;
  border:1px solid var(--linea); background:var(--panel2); text-align:left; min-width:0;
  transition:border-color .16s, background .16s, transform .12s}
.opcion:active{transform:scale(.98)}
.opcion .sig{font-family:var(--rotulo); font-size:.6rem; font-weight:700; color:#070b12;
  background:var(--c,var(--tenue2)); padding:.14rem .3rem; border-radius:5px; min-width:2.3rem;
  text-align:center; flex:0 0 auto}
.opcion .nom{font-size:.85rem; font-weight:700; color:var(--tenue); overflow:hidden;
  text-overflow:ellipsis; white-space:nowrap}
.opcion[aria-pressed="true"]{border-color:var(--c); background:color-mix(in srgb, var(--c) 16%, var(--panel2))}
.opcion[aria-pressed="true"] .nom{color:var(--txt)}
/* En teléfonos angostos el nombre manda: menos relleno y, abajo de 360 px, la
   sigla se vuelve un punto de color ("Panth…", "Washi…" se cortaban). */
@media (max-width:380px){
  .duelo-pick{gap:.25rem}
  .opcion{padding:.5rem .45rem; gap:.35rem}
}
@media (max-width:360px){
  .opcion .sig{font-size:0; min-width:0; width:9px; height:9px; padding:0; border-radius:50%}
}
.acciones-gen{display:flex; gap:.5rem; flex-wrap:wrap; align-items:center; margin-top:1rem;
  padding-top:.85rem; border-top:1px solid var(--linea)}
.acciones-gen .cuenta{font-family:var(--rotulo); font-size:.8rem; font-weight:700; color:var(--tenue);
  margin-right:auto}
.boton{padding:.6rem 1rem; border-radius:12px; font-size:.84rem; font-weight:800;
  background:var(--pastilla); color:var(--pastilla-txt); border:0; transition:opacity .16s}
.boton:disabled{opacity:.4}
.boton.suave{background:var(--panel2); color:var(--txt); box-shadow:inset 0 0 0 1px var(--linea2)}
.aviso-gen{font-size:.74rem; color:var(--tenue2); margin-top:.6rem; line-height:1.4}
.aviso-gen a{color:var(--acento)}


.aviso{border:1px dashed var(--linea2); border-radius:var(--radio); padding:1.4rem 1rem; text-align:center;
  color:var(--tenue); font-size:.88rem; background:rgba(16,23,36,.55)}
.aviso strong{display:block; color:var(--txt); font-size:1.02rem; margin-bottom:.35rem}
.envivo-chip{display:inline-flex; align-items:center; gap:.3rem; font-size:.58rem; font-weight:900;
  letter-spacing:.1em; text-transform:uppercase; color:var(--vivo); padding:.16rem .4rem;
  border-radius:5px; background:rgba(255,71,87,.1); border:1px solid rgba(255,71,87,.3)}
.envivo-chip .punto{animation:latir 1.4s ease-in-out infinite; width:5px; height:5px}

footer{border-top:1px solid var(--linea); color:var(--tenue2); font-size:.75rem;
  padding:1.7rem 0 calc(2.6rem + env(safe-area-inset-bottom)); margin-top:1.5rem}
footer p{margin:.26rem 0}
footer .firma{color:var(--tenue); font-weight:800}
footer .sello-marca{font-weight:900; letter-spacing:.16em; color:var(--oro); font-size:.78rem}

/* ═══════ la marca ═══════ */
.logo{text-decoration:none; color:inherit; cursor:pointer}

/* ═══════ la barra con tu avance ═══════ */
.mi-barra{padding-block:0 .55rem}
.mi-barra:empty{display:none}
.mi-barra-yo{width:100%; display:flex; align-items:stretch; text-align:left;
  padding:.38rem .5rem .38rem 0; border-radius:14px;
  background:rgba(255,255,255,.035); border:1px solid var(--linea); transition:border-color .2s, background .2s}
.mi-barra-yo:hover{border-color:var(--linea2); background:rgba(255,255,255,.055)}
.mi-barra .celda{flex:1 1 0; min-width:0; display:flex; flex-direction:column; gap:.1rem; padding:0 .75rem}
.mi-barra .celda + .celda{border-left:1px solid var(--linea)}
.mi-barra .rot{font-family:var(--rotulo); font-weight:700; font-size:.58rem; letter-spacing:.13em;
  text-transform:uppercase; color:var(--tenue2); white-space:nowrap; overflow:hidden; text-overflow:ellipsis}
.mi-barra .celda.vivo .rot{color:var(--vivo); letter-spacing:.05em}
.mi-barra .celda.vivo .rot::before{content:""; display:inline-block; width:6px; height:6px; margin-right:.35rem;
  border-radius:50%; background:currentColor; vertical-align:.1em; animation:latir 1.5s ease-in-out infinite}
.mi-barra .linea{display:flex; align-items:baseline; gap:.45rem; white-space:nowrap; overflow:hidden}
.mi-barra .linea b{font-size:1.06rem; font-weight:900; font-variant-numeric:tabular-nums; letter-spacing:-.01em}
.mi-barra .linea .por{font-size:.8rem; font-weight:700; color:var(--tenue)}
.mi-barra .linea .rango{font-size:.8rem; font-weight:800; color:var(--oro2)}
.mi-barra .linea .mov{font-size:.68rem; font-weight:800}
.mi-barra .linea .sube{color:var(--verde)} .mi-barra .linea .baja{color:var(--rojo)}
.mi-barra .flecha{align-self:center; margin-left:auto; padding-left:.2rem; color:var(--tenue2); font-size:1.25rem; line-height:1}
@media (max-width:350px){ .mi-barra .linea .mov{display:none} .mi-barra .celda{padding:0 .55rem} }

.mi-barra-invita{display:flex; align-items:center; gap:.3rem}
.mi-barra-invita .elegir{position:relative; flex:1 1 auto; min-width:0; display:flex; align-items:center; gap:.6rem;
  padding:.45rem .45rem .45rem .8rem; border-radius:14px; cursor:pointer;
  background:linear-gradient(90deg,rgba(91,149,255,.14),rgba(91,149,255,.05)); border:1px solid rgba(91,149,255,.32)}
.mi-barra-invita .txt{flex:1 1 auto; min-width:0; font-size:.84rem; line-height:1.25; color:var(--txt)}
.mi-barra-invita .cta{flex:0 0 auto; padding:.4rem .8rem; border-radius:999px; font-size:.8rem; font-weight:800;
  color:#0b1220; background:linear-gradient(180deg,#fff,#cfe0ff)}
.mi-barra-invita select{position:absolute; inset:0; top:0; left:0; width:100%; height:100%; opacity:0; cursor:pointer; font-size:16px}
.mi-barra-invita .elegir:focus-within{outline:2px solid var(--acento); outline-offset:2px}
.mi-barra-invita .cerrar{flex:0 0 auto; width:36px; height:36px; border-radius:50%; font-size:1.2rem; line-height:1;
  color:var(--tenue2)}
.mi-barra-invita .cerrar:hover{color:var(--txt); background:rgba(255,255,255,.06)}

/* ═══════ navegación: abajo en el teléfono, arriba en computadora ═══════ */
.navegacion{display:flex}
.navegacion button{flex:1 1 0; display:flex; flex-direction:column; align-items:center; gap:3px;
  padding:6px 2px 5px; border-radius:12px; color:var(--tenue2); font-size:.66rem; font-weight:700;
  transition:color .2s, background .2s}
.navegacion svg{width:24px; height:24px; fill:none; stroke:currentColor; stroke-width:1.8;
  stroke-linecap:round; stroke-linejoin:round; transition:transform .25s}
.navegacion svg .lleno{fill:currentColor; stroke:none}
.navegacion button[aria-selected="true"]{color:var(--oro)}
.navegacion button[aria-selected="true"] svg{transform:translateY(-1px) scale(1.06)}
.navegacion.al-pie{position:fixed; left:0; right:0; bottom:0; z-index:80;
  padding:5px max(6px,env(safe-area-inset-right)) calc(5px + env(safe-area-inset-bottom)) max(6px,env(safe-area-inset-left));
  background:rgba(8,12,19,.94); backdrop-filter:blur(18px) saturate(160%);
  border-top:1px solid var(--linea)}
.navegacion.en-cabeza{display:none}
@media (max-width:899px){
  body{padding-bottom:calc(66px + env(safe-area-inset-bottom))}
  .arriba{bottom:calc(78px + env(safe-area-inset-bottom))}
  main{padding-bottom:.6rem}
  footer{margin-top:.6rem; padding-bottom:1.4rem}
}
@media (min-width:900px){
  .navegacion.al-pie{display:none}
  .fila-yo{display:flex; align-items:center; gap:1rem; padding-bottom:.55rem}
  .fila-yo .mi-barra{margin-left:auto; flex:1 1 auto; max-width:540px; min-width:0; padding-block:0}
  .navegacion.en-cabeza{display:flex; gap:4px; flex:0 0 auto}
  .navegacion.en-cabeza button{flex:0 0 auto; flex-direction:row; gap:7px; padding:7px 14px; font-size:.86rem; color:var(--tenue)}
  .navegacion.en-cabeza svg{width:18px; height:18px}
  .navegacion.en-cabeza button[aria-selected="true"]{color:var(--oro); background:rgba(247,201,72,.1)}
}
/* En el teléfono el encabezado se queda en lo esencial: la marca y quién eres. */
@media (max-width:599px){
  .estado{display:none}
  .identidad .txt{display:none}
}
.navegacion button{position:relative}
.hay-vivo .navegacion button[data-vista="hoy"]::after{content:""; position:absolute; top:4px; left:calc(50% + 8px);
  width:8px; height:8px; border-radius:50%; background:var(--vivo); box-shadow:0 0 0 2px var(--bg);
  animation:latir 1.5s ease-in-out infinite}
.hay-vivo .navegacion.en-cabeza button[data-vista="hoy"]::after{top:3px; left:22px}

/* ═══════ hoy ═══════ */
.saludo{padding:.35rem 0 .85rem}
.saludo .fecha{font-size:.78rem; font-weight:700; color:var(--tenue2)}
.saludo .cuenta{color:var(--oro2); font-weight:800; white-space:nowrap}
.saludo h1{font-size:clamp(1.65rem,7.4vw,2.3rem); line-height:1.06; margin:.12rem 0 .3rem; font-weight:900; letter-spacing:-.03em}
.saludo p{margin:0; color:var(--tenue); font-size:.92rem; line-height:1.4}
.saludo.fase-vivo h1::before{content:""; display:inline-block; width:11px; height:11px; border-radius:50%;
  margin-right:.5rem; vertical-align:.18em; background:var(--vivo); box-shadow:0 0 0 0 rgba(255,71,87,.6);
  animation:onda 1.6s ease-out infinite}
@keyframes onda{0%{box-shadow:0 0 0 0 rgba(255,71,87,.55)} 100%{box-shadow:0 0 0 12px rgba(255,71,87,0)}}
.saludo.fase-picks h1{background:linear-gradient(96deg,#fff3c9,#f7c948 60%,#e5a92a);
  -webkit-background-clip:text; background-clip:text; color:transparent}


.tarjeta{position:relative; margin-bottom:.85rem; padding:1rem; border-radius:18px;
  background:linear-gradient(180deg,var(--panel),rgba(16,23,36,.7)); border:1px solid var(--linea);
  box-shadow:0 10px 30px rgba(0,0,0,.28); animation:entrar .32s ease both}
.sin-animar .tarjeta{animation:none}
@media (max-width:380px){ .tarjeta{padding:.9rem .75rem} }
@media (min-width:900px){
  .hoy-rejilla{display:grid; grid-template-columns:minmax(0,1.55fr) minmax(300px,1fr); gap:0 1rem; align-items:start}
  .hoy-rejilla.sola{grid-template-columns:minmax(0,1fr)}
}
.tarjeta .cab{display:flex; align-items:center; gap:.5rem; margin-bottom:.7rem; min-height:24px}
.tarjeta .cab h3{font-family:var(--rotulo); font-size:.72rem; font-weight:700; letter-spacing:.16em;
  text-transform:uppercase; color:var(--tenue)}
.tarjeta .cab .enlace{margin-left:auto; font-size:.82rem; font-weight:700; color:var(--oro2)}
.tarjeta .cab .punto{color:var(--vivo); animation:latir 1.5s ease-in-out infinite}
.cuenta-regresiva{margin-left:auto; padding:.2rem .6rem; border-radius:999px; white-space:nowrap;
  font-size:.78rem; font-weight:800; color:var(--oro); background:rgba(247,201,72,.1); border:1px solid rgba(247,201,72,.3)}
.tarjeta.envivo{border-color:rgba(255,71,87,.38); background:linear-gradient(180deg,rgba(255,71,87,.09),var(--panel) 50%)}
.tarjeta .nota{margin:.1rem 0 .85rem; color:var(--tenue); font-size:.88rem; line-height:1.4}
.boton-principal{width:100%; min-height:48px; border-radius:14px; font-weight:800; font-size:.96rem;
  color:#171203; background:linear-gradient(180deg,#ffe193,#f7c948); box-shadow:0 10px 24px rgba(247,201,72,.2);
  transition:transform .15s}
.boton-principal:active{transform:scale(.98)}
.tus-picks.completa .generador{margin:0; padding:0; border:0; background:none; box-shadow:none}
.tus-picks.completa .generador > .rot,.tus-picks.completa .generador > h3{display:none}

/* Un partido en una fila: equipos y marcador a la izquierda, tu pick a la derecha. */
.juego-fila{display:flex; align-items:center; gap:.7rem; width:100%; padding:.7rem .1rem; text-align:left;
  border-top:1px solid rgba(255,255,255,.055)}
.tarjeta .cab + .juego-fila{border-top:0; padding-top:.15rem}
.juego-fila .lados{flex:1 1 auto; display:grid; gap:.32rem; min-width:0}
.juego-fila .eq-fila{display:flex; align-items:center; gap:.5rem; min-width:0; color:var(--tenue)}
.juego-fila .sig{flex:0 0 auto; min-width:36px; padding:.16rem .3rem; border-radius:6px; text-align:center;
  font-style:normal; font-family:var(--rotulo); font-weight:700; font-size:.68rem; letter-spacing:.04em;
  background:var(--panel3); color:var(--txt)}
.juego-fila .eq{flex:1 1 auto; font-weight:700; font-size:.93rem; color:var(--txt);
  white-space:nowrap; overflow:hidden; text-overflow:ellipsis}
.juego-fila .mrc{font-family:var(--rotulo); font-size:1.2rem; font-variant-numeric:tabular-nums; min-width:1.7em; text-align:right; color:var(--tenue)}
.juego-fila .eq-fila.adelante .mrc{color:#fff}
.juego-fila .meta .corto{display:none}
@media (max-width:389px){ .juego-fila .meta .largo{display:none} .juego-fila .meta .corto{display:inline} }
.juego-fila .mio.provisional::before{content:""; display:inline-block; width:6px; height:6px; margin-right:.35rem;
  border-radius:50%; background:currentColor; vertical-align:.1em; animation:latir 1.5s ease-in-out infinite}
.juego-fila .meta{flex:0 0 auto; display:flex; flex-direction:column; align-items:flex-end; gap:.22rem; max-width:48%; text-align:right}
.juego-fila .cuando{font-size:.76rem; font-weight:800; color:var(--tenue)}
.juego-fila.vivo .cuando{color:var(--vivo)}
.juego-fila .mio{padding:.14rem .5rem; border-radius:999px; font-size:.74rem; font-weight:800; white-space:nowrap;
  background:rgba(255,255,255,.06)}
.juego-fila .mio.bien{color:var(--verde); background:rgba(61,220,132,.12)}
.juego-fila .mio.mal{color:var(--rojo); background:rgba(255,96,88,.12)}
.juego-fila .consenso{font-size:.7rem; color:var(--tenue2)}
.juego-fila.quieto{cursor:default; padding-block:.1rem}

/* Tus números: tres cifras grandes, una barra y una frase. */
.cifras{display:grid; grid-template-columns:repeat(3,1fr); gap:.5rem; margin-bottom:.85rem}
.cifras .cifra{padding:.65rem .4rem; border-radius:13px; text-align:center; background:rgba(255,255,255,.04)}
.cifras .cifra b{display:block; font-size:1.5rem; font-weight:900; letter-spacing:-.02em; font-variant-numeric:tabular-nums; line-height:1.1}
.cifras .cifra span{display:block; margin-top:.15rem; font-size:.7rem; color:var(--tenue); line-height:1.2}
.cifras .cifra.rango b{color:var(--oro2)}
.progreso-semana{display:flex; gap:2px; height:9px; border-radius:99px; overflow:hidden; background:rgba(255,255,255,.06)}
.progreso-semana i{display:block; min-width:5px; transition:flex-grow .5s ease}
.progreso-semana .ok{background:var(--verde)}
.progreso-semana .mal{background:var(--rojo)}
.progreso-semana .juego{background:var(--vivo); opacity:.75}
.progreso-semana .falta{background:rgba(255,255,255,.1)}
.leyenda{display:flex; flex-wrap:wrap; gap:.3rem .9rem; margin-top:.5rem; font-size:.76rem; color:var(--tenue)}
.leyenda span::before{content:""; display:inline-block; width:8px; height:8px; margin-right:.35rem; border-radius:50%;
  vertical-align:.05em; background:currentColor}
.leyenda .ok{color:var(--verde)} .leyenda .mal{color:var(--rojo)} .leyenda .juego{color:var(--vivo)} .leyenda .falta{color:var(--tenue2)}
.nota-chance{display:block; width:100%; margin-top:.85rem; padding:.65rem .8rem; border-radius:12px; text-align:left;
  font-size:.86rem; line-height:1.38; background:rgba(247,201,72,.07); border:1px solid rgba(247,201,72,.22)}

.lista-mini{list-style:none; margin:0; padding:0}
.lista-mini li{display:flex; align-items:center; gap:.65rem; padding:.52rem .35rem; border-top:1px solid rgba(255,255,255,.055)}
.lista-mini li:first-child{border-top:0}
.lista-mini li.separada{margin-top:.25rem; border-top:1px dashed var(--linea2)}
.lista-mini .pos{width:1.7em; text-align:right; font-family:var(--rotulo); color:var(--tenue2)}
.lista-mini .quien{flex:1 1 auto; font-weight:700; white-space:nowrap; overflow:hidden; text-overflow:ellipsis}
.lista-mini .mov{font-size:.72rem} .lista-mini .mov.sube{color:var(--verde)} .lista-mini .mov.baja{color:var(--rojo)}
.lista-mini .pts{font-family:var(--rotulo); font-size:1.08rem; font-variant-numeric:tabular-nums}
.lista-mini li.yo{border-radius:10px; background:rgba(247,201,72,.09)}
.lista-mini li.yo .quien{color:var(--oro2)}

/* ═══════ dentro de "Semana" ═══════ */


/* ═══════ menos es más ═══════ */
.saludo{padding:.5rem 0 1.15rem}
.tarjeta{margin-bottom:1rem}
.hoy-rejilla{gap:0 1.1rem}
.subgrupo{font-family:var(--rotulo); font-weight:700; font-size:.66rem; letter-spacing:.16em; text-transform:uppercase;
  color:var(--tenue2); margin:.9rem .1rem .1rem}
.tarjeta .cab + .subgrupo{margin-top:0}
.partidos-hoy.envivo .subgrupo:first-of-type{color:var(--vivo)}
/* En el teléfono, volver arriba es tocar otra vez la sección: el botón flotante
   se encimaba con "Generar imagen" y con las cifras de la orilla. */
@media (max-width:899px){ .arriba{display:none} }

/* ═══════ semana: la enfocada, flechas y selector aparte ═══════ */
.cabeza-semana{margin:.5rem 0 1.1rem; text-align:center}
.cambia-semana{display:flex; align-items:center; justify-content:space-between; gap:.5rem}
.flecha-semana{width:46px; height:46px; flex:0 0 auto; border-radius:15px; display:grid; place-items:center;
  font-size:1.7rem; line-height:1; padding-bottom:3px; color:var(--txt);
  background-color:var(--vidrio); background-image:var(--grano),var(--brillo); border:1px solid var(--borde-vidrio);
  transition:transform .15s, opacity .2s}
.flecha-semana:disabled{opacity:.22; cursor:default}
.flecha-semana:not(:disabled):active{transform:scale(.9)}
.semana-elegida{display:inline-flex; align-items:center; gap:.5rem; padding:.25rem .7rem; border-radius:14px; min-width:0}
.semana-elegida .num{font-family:var(--rotulo); font-weight:700; text-transform:uppercase; letter-spacing:.05em;
  font-size:clamp(1.8rem,8.6vw,2.5rem); line-height:1; white-space:nowrap}
.semana-elegida .abre{font-size:.8rem; color:var(--oro); transition:transform .25s var(--rebote)}
.semana-elegida:hover .abre,.semana-elegida:focus-visible .abre{transform:translateY(3px)}
.estado-fila{display:flex; align-items:center; justify-content:center; gap:.7rem; flex-wrap:wrap; margin-top:.55rem}
.volver-actual{font-size:.8rem; font-weight:800; color:var(--oro2)}
.boton-principal.volver-actual{margin-top:1rem; color:#171203}
.detalle-semana{margin-top:.9rem}
.avance-semana{height:5px; border-radius:99px; background:rgba(255,255,255,.08); overflow:hidden; margin:0 auto .5rem; max-width:420px}
.avance-semana i{display:block; height:100%; border-radius:99px; background:linear-gradient(90deg,var(--verde),#a6f3c9);
  transition:width .7s var(--salida)}
.linea-estado{margin:0; font-size:.82rem; line-height:1.4; color:var(--tenue)}
.aviso-picks{display:flex; align-items:center; gap:.8rem; width:100%; margin:0 0 1rem; padding:.85rem 1rem; border-radius:16px;
  text-align:left; border:1px solid rgba(247,201,72,.35);
  background-color:var(--vidrio); background-image:var(--grano),linear-gradient(90deg,rgba(247,201,72,.12),rgba(247,201,72,0) 70%)}
.aviso-picks .txt{flex:1 1 auto; font-size:.88rem; line-height:1.35; color:var(--txt)}
.aviso-picks .ir{flex:0 0 auto; font-weight:800; font-size:.86rem; color:var(--oro)}
.aviso-picks:active{transform:scale(.985)}

.dia-libre{display:flex; align-items:center; gap:.85rem; margin:0 0 1rem; padding:.85rem 1rem; border-radius:16px;
  background-color:var(--vidrio); background-image:var(--grano),var(--brillo); border:1px solid var(--borde-vidrio);
  animation:entrar .4s var(--salida) both}
.dia-libre svg{width:28px; height:28px; flex:0 0 auto; fill:none; stroke:var(--tenue); stroke-width:1.7;
  stroke-linecap:round; stroke-linejoin:round}
.dia-libre .txt{display:flex; flex-direction:column; gap:.15rem; min-width:0}
.dia-libre b{font-size:.98rem}
.dia-libre span{font-size:.85rem; line-height:1.35; color:var(--tenue)}

/* El podio solo pinta medalla a los lugares con premio (1º, 2º y 3º). */
.lugar.sin-medalla .medalla{background:rgba(255,255,255,.07); color:var(--tenue); box-shadow:inset 0 0 0 1px var(--borde-vidrio)}
.lugar.sin-medalla .puntos{color:var(--tenue)}
.lugar .sin-premio{margin-top:.25rem; font-size:.74rem; font-weight:700; color:var(--tenue2)}
.nota-podio{margin:.75rem .1rem 0; font-size:.82rem; line-height:1.45; color:var(--tenue)}
.nota-podio .enlace-titulo{margin-left:.2rem}
/* Cómo se gana. */
#dinamica{scroll-margin-top:calc(var(--alto-encabezado) + 14px)}
.dinamica h3.sub{font-family:var(--rotulo); font-size:.74rem; font-weight:700; letter-spacing:.15em; text-transform:uppercase;
  color:var(--oro); margin:1rem 0 .45rem}
.dinamica h3.sub:first-child{margin-top:0}
.dinamica ul{margin:0; padding-left:1.1rem; display:grid; gap:.4rem}
.dinamica li{font-size:.9rem; line-height:1.45; color:var(--txt)}
.dinamica li::marker{color:var(--tenue2)}
.lugares-premio{display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:.45rem; margin:.8rem 0 .2rem}
.lugar-premio{display:flex; flex-direction:column; align-items:center; gap:.05rem; padding:.6rem .3rem; border-radius:14px;
  background:rgba(255,255,255,.04); border:1px solid var(--borde-vidrio)}
.lugar-premio .n{font-family:var(--rotulo); font-weight:700; font-size:1.2rem}
.lugar-premio .pct{font-size:.72rem; color:var(--tenue)}
.lugar-premio b{font-family:var(--rotulo); font-weight:700; font-size:1rem}
.lugar-premio.oro .n,.lugar-premio.oro b{color:var(--oro)}
.lugar-premio.plata .n,.lugar-premio.plata b{color:var(--plata)}
.lugar-premio.bronce .n,.lugar-premio.bronce b{color:var(--bronce)}
.fila-gan.tuya{border-color:rgba(91,149,255,.5); background-color:rgba(91,149,255,.08)}
.rebanada{margin:.75rem .1rem 0; padding:.7rem .85rem; border-radius:14px; font-size:.88rem; font-weight:700; line-height:1.4;
  color:var(--oro2); background:rgba(247,201,72,.08); border:1px solid rgba(247,201,72,.25)}
.tarjeta .rebanada{margin:.8rem 0 0}

/* La hoja con todas las semanas: abajo en el teléfono, al centro en computadora. */
.con-hoja,.con-hoja body{overflow:hidden}
.hoja-fondo{position:fixed; inset:0; z-index:200; display:flex; align-items:flex-end; justify-content:center;
  background:rgba(2,6,4,.55); -webkit-backdrop-filter:blur(6px); backdrop-filter:blur(6px); animation:fundido .25s ease both}
.hoja{width:min(100%,560px); max-height:min(82vh,680px); overflow:auto; overscroll-behavior:contain;
  padding:.6rem 1rem calc(1.2rem + env(safe-area-inset-bottom)); border-radius:24px 24px 0 0;
  background-color:var(--cristal); background-image:var(--grano); border:1px solid var(--borde-vidrio); border-bottom:0;
  -webkit-backdrop-filter:blur(26px) saturate(160%); backdrop-filter:blur(26px) saturate(160%);
  box-shadow:0 -24px 60px rgba(0,0,0,.5); animation:subir .42s var(--salida) both}
.hoja .agarradera{width:42px; height:5px; border-radius:3px; background:rgba(255,255,255,.22); margin:0 auto .9rem}
.hoja h3{margin:0 0 .9rem; text-align:center; font-family:var(--rotulo); font-size:.8rem; letter-spacing:.18em;
  text-transform:uppercase; color:var(--tenue)}
.rejilla-semanas{display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:.5rem}
.celda-semana{position:relative; display:flex; flex-direction:column; align-items:center; gap:.12rem; padding:.65rem .2rem .6rem;
  border-radius:15px; background-color:var(--vidrio); background-image:var(--grano),var(--brillo);
  border:1px solid var(--borde-vidrio); transition:transform .15s, border-color .2s}
.celda-semana:active{transform:scale(.95)}
.celda-semana b{font-family:var(--rotulo); font-weight:700; font-size:1.6rem; line-height:1}
.celda-semana small{font-size:.6rem; font-weight:800; letter-spacing:.06em; text-transform:uppercase; color:var(--tenue2)}
.celda-semana .mio{font-size:.7rem; font-weight:800; color:var(--tenue)}
.celda-semana .mio.gano{color:var(--oro)}
.celda-semana.pendiente{border-style:dashed}
.celda-semana.cerrada small{color:var(--tenue)}
.celda-semana.vivo small{color:var(--vivo)}
.celda-semana.en-curso::after{content:""; position:absolute; top:7px; right:8px; width:7px; height:7px; border-radius:50%;
  background:var(--oro); box-shadow:0 0 0 3px rgba(247,201,72,.18)}
.celda-semana.elegida{border-color:var(--oro); box-shadow:inset 0 0 0 1px var(--oro); background-color:rgba(247,201,72,.1)}
@keyframes fundido{from{opacity:0} to{opacity:1}}
@keyframes subir{from{transform:translateY(100%)} to{transform:none}}
@keyframes acercar{from{opacity:0; transform:translateY(16px) scale(.97)} to{opacity:1; transform:none}}
@media (min-width:700px){
  .hoja-fondo{align-items:center}
  .hoja{border-radius:24px; border-bottom:1px solid var(--borde-vidrio); animation:acercar .32s var(--salida) both}
}
@media (max-width:340px){ .rejilla-semanas{grid-template-columns:repeat(3,minmax(0,1fr))} }

/* ═══════ la sección Picks ═══════ */
.registrados .nota{margin:.1rem 0 .8rem}
.tus-picks.completa .una-tanda .tanda .cab{display:none}
.tus-picks.completa .una-tanda .tanda{margin-top:.2rem}

/* Jugadores cuelga de la general. */
.regreso{display:inline-flex; align-items:center; gap:.3rem; margin:.7rem 0 .2rem; padding:.35rem .1rem;
  font-weight:800; font-size:.88rem; color:var(--oro2)}
.enlace-titulo{margin-left:auto; font-size:.8rem; font-weight:800; color:var(--oro2)}

/* ═══════ vidrio esmerilado ═══════
   Las superficies son vidrio translúcido con grano: detrás se adivina el campo,
   borroso, como en un cancel de regadera. El tinte de cada tema llega en
   --vidrio, ya verificado en Python; el grano y el brillo de arriba son iguales
   en todos. Solo las superficies grandes desenfocan lo de atrás: en las listas
   largas (16 partidos, 34 participantes) cuesta mucho en un teléfono y casi no
   se nota, porque el vidrio ya tapa el campo. */
.tarjeta,.marco,.generador,.perfil,.lugar,.bolsa-card,.campeon,.mi-barra-yo,.tabs-int,
.juego,.split,.fila-gan,.ficha,.candidato,.boleta .linea,.duelo .cara,.dif .row,.rasgo,.aviso,
.opcion,.filtro-tabla input,select.ancho,input.ancho{
  background-color:var(--vidrio); background-image:var(--grano),var(--brillo);
  border-color:var(--borde-vidrio)}
.tarjeta,.generador,.perfil,.campeon,.bolsa-card,.lugar,.mi-semana{
  -webkit-backdrop-filter:blur(14px) saturate(135%); backdrop-filter:blur(14px) saturate(135%);
  box-shadow:inset 0 1px 0 rgba(255,255,255,.055), 0 14px 34px rgba(0,0,0,.3)}
.tus-picks.completa .generador{-webkit-backdrop-filter:none; backdrop-filter:none; background-image:none}
.tarjeta.envivo{background-color:var(--vidrio);
  background-image:var(--grano),linear-gradient(180deg,rgba(255,71,87,.11),rgba(255,71,87,0) 55%)}
.lugar.oro{box-shadow:inset 0 1px 0 rgba(255,255,255,.08), 0 16px 48px rgba(247,201,72,.12)}
.campeon.oficial{box-shadow:inset 0 1px 0 rgba(255,255,255,.08), 0 18px 54px rgba(247,201,72,.13)}
header,.navegacion.al-pie{background-color:var(--cristal); background-image:var(--grano);
  -webkit-backdrop-filter:blur(22px) saturate(160%); backdrop-filter:blur(22px) saturate(160%)}
header{border-bottom-color:var(--borde-vidrio)}
.navegacion.al-pie{border-top-color:var(--borde-vidrio)}
header::after{background:linear-gradient(90deg,transparent,rgba(255,255,255,.16) 22%,var(--oro),rgba(255,255,255,.16) 78%,transparent);
  opacity:.5; height:1px}
.mi-semana{border-color:rgba(91,149,255,.32);
  background:var(--grano),linear-gradient(180deg,rgba(91,149,255,.12),var(--vidrio))}
/* Las tablas son vidrio esmerilado opaco: sus columnas pegadas no pueden ser
   translúcidas (por debajo pasa el resto de la fila) y así todo es del mismo
   tono. Además es la superficie más grande: sin desenfoque, cuesta menos. */
.marco{background-color:var(--vidrio-solido); background-image:var(--grano);
  box-shadow:inset 0 1px 0 rgba(255,255,255,.05), 0 14px 34px rgba(0,0,0,.3)}
thead th,table.fija th:nth-child(-n+2),table.fija td:nth-child(-n+2){
  background-color:var(--vidrio-solido); background-image:var(--grano)}
tbody td{border-bottom-color:rgba(255,255,255,.05)}
.lado+.lado{border-top-color:rgba(255,255,255,.05)}
tbody tr.yo td,table.fija tbody tr.yo td:nth-child(-n+2){background-color:var(--fila-yo)}
tbody tr:hover td,table.fija tbody tr:hover td:nth-child(-n+2){background-color:var(--panel2)}
.tabs{background:none}
.tabs-int{background-color:var(--cristal); -webkit-backdrop-filter:blur(18px) saturate(150%);
  backdrop-filter:blur(18px) saturate(150%); box-shadow:0 10px 26px rgba(0,0,0,.3)}
.corredera{background:rgba(255,255,255,.09); box-shadow:inset 0 0 0 1px rgba(255,255,255,.1)}

/* ═══════ jerarquía ═══════
   Primero lo que se viene a ver, grande; luego lo de apoyo, chico y en gris. */
.saludo h1{font-family:var(--rotulo); font-weight:700; text-transform:uppercase; letter-spacing:.012em;
  font-size:clamp(2.15rem,10.6vw,3.4rem); line-height:.96; margin:.2rem 0 .45rem}
.saludo.fase-vivo h1::before{width:13px; height:13px; vertical-align:.2em}
.saludo .fecha{font-family:var(--rotulo); font-weight:500; text-transform:uppercase; letter-spacing:.16em; font-size:.7rem}
.saludo p{font-size:.95rem}
.titulo{margin:1.7rem .1rem .75rem}
.titulo h2{font-family:var(--rotulo); font-size:1rem; font-weight:700; letter-spacing:.13em; color:var(--txt)}
.titulo h2::before{width:4px; height:.9rem; background:var(--oro); vertical-align:-2px; margin-right:.55rem}
.estado-semana{display:inline-flex; align-items:center; gap:.35rem; font-family:var(--rotulo); font-weight:700;
  font-size:.68rem; letter-spacing:.14em; text-transform:uppercase; padding:.26rem .6rem; border-radius:999px;
  color:var(--tenue); background:var(--vidrio); border:1px solid var(--borde-vidrio)}
.estado-semana.cerrada{color:var(--oro); border-color:rgba(247,201,72,.35)}
.estado-semana.pendiente{border-style:dashed}
.estado-semana.vivo{color:var(--vivo); border-color:rgba(255,71,87,.45); background:rgba(255,71,87,.1)}
.estado-semana.vivo::before{content:""; width:7px; height:7px; border-radius:50%; background:currentColor;
  animation:latir 1.5s ease-in-out infinite}
.tarjeta{border-radius:20px}
.tarjeta .cab h3{font-size:.76rem}
.hoy-principal > .tarjeta:first-child:not(.envivo){border-color:rgba(247,201,72,.26);
  box-shadow:inset 0 1px 0 rgba(255,255,255,.07), 0 0 0 1px rgba(247,201,72,.06), 0 18px 44px rgba(0,0,0,.36)}
.cifras .cifra b{font-family:var(--rotulo); font-weight:700; font-size:2rem; letter-spacing:.01em}
.cifra b small.o,.mi-barra .rango small.o{font-family:var(--cuerpo); font-size:.5em; font-weight:800; margin-left:.04em; vertical-align:.75em}
.mi-barra .linea b{font-family:var(--rotulo); font-weight:700; font-size:1.18rem; letter-spacing:.02em}
.acciones-gen .boton:not(.suave){color:#171203; background:linear-gradient(180deg,#ffe193,#f7c948);
  box-shadow:0 8px 20px rgba(247,201,72,.18)}

/* ═══════ movimiento ═══════ */
.hoy-rejilla .tarjeta{animation:entrar .52s var(--salida) both; animation-delay:calc(var(--n,0) * 70ms)}
.sin-animar .tarjeta,.sin-animar .hoy-rejilla .tarjeta{animation:none}
.juego-fila,.boton-principal,.ficha,.opcion,.mi-barra-yo{transition:transform .15s ease, background-color .2s, border-color .2s}
.juego-fila:active,.ficha:active,.mi-barra-yo:active{transform:scale(.985)}
.opcion[aria-pressed="true"]{animation:elegir .36s var(--rebote)}
@keyframes elegir{0%{transform:scale(1)} 45%{transform:scale(1.05)} 100%{transform:scale(1)}}
/* La palomita va en la esquina, encima: no le quita espacio al nombre. */
.opcion{position:relative}
.opcion::after{content:"✓"; position:absolute; top:-7px; right:-5px; width:19px; height:19px; border-radius:50%;
  display:grid; place-items:center; font-size:.66rem; font-weight:900; color:#070b12; background:var(--c,var(--oro));
  box-shadow:0 0 0 2px var(--bg); opacity:0; transform:scale(.3); transition:opacity .18s, transform .32s var(--rebote)}
.opcion[aria-pressed="true"]::after{opacity:1; transform:none}
.mi-barra .cambio{animation:sube .9s var(--rebote)}
@keyframes sube{0%{transform:translateY(0)} 30%{transform:translateY(-3px) scale(1.12); color:var(--verde)} 100%{transform:none}}

/* El botón de la sección elegida lleva una pastilla que se desliza al cambiar. */
.navegacion{position:relative}
.navegacion button{z-index:1}
.navegacion .indicador{position:absolute; z-index:0; left:0; top:4px; bottom:4px; width:0; border-radius:16px;
  pointer-events:none; opacity:0; background:rgba(247,201,72,.12); box-shadow:inset 0 0 0 1px rgba(247,201,72,.2)}
.navegacion .indicador.listo{opacity:1; transition:transform .5s var(--rebote), width .5s var(--rebote), opacity .2s}
.navegacion.en-cabeza .indicador{top:0; bottom:0; border-radius:12px}
.navegacion button[aria-selected="true"]{background:none}
.navegacion button[aria-selected="true"] svg{animation:brinco .5s var(--rebote)}
@keyframes brinco{0%{transform:translateY(3px) scale(.86)} 100%{transform:translateY(-1px) scale(1.06)}}

/* Con picks elegidos, el botón para generar la imagen te sigue mientras bajas. */
.acciones-gen{position:relative}
.acciones-gen .avance{position:absolute; left:0; top:-1px; height:2px; width:0; border-radius:2px;
  background:linear-gradient(90deg,var(--oro),#ffe193); transition:width .45s var(--salida)}
.generador.con-picks .acciones-gen{position:sticky; bottom:calc(76px + env(safe-area-inset-bottom)); z-index:6;
  margin:1rem -.45rem 0; padding:.6rem .6rem .6rem .8rem; border:1px solid var(--borde-vidrio); border-radius:16px;
  background-color:var(--cristal); background-image:var(--grano);
  -webkit-backdrop-filter:blur(18px) saturate(150%); backdrop-filter:blur(18px) saturate(150%);
  box-shadow:0 -6px 28px rgba(0,0,0,.38); animation:entrar .3s var(--salida) both}
.generador.con-picks .acciones-gen .avance{left:14px; right:auto; max-width:calc(100% - 28px)}
.generador.con-picks .acciones-gen{flex-wrap:nowrap}
.generador.con-picks .acciones-gen .cuenta small{display:none}
.acciones-gen .boton{white-space:nowrap}
@media (min-width:900px){ .generador.con-picks .acciones-gen{bottom:16px} }

/* Entre secciones, la vista se desliza hacia donde vas (donde el navegador lo
   permite; en los demás entra con la animación de siempre). */
header{view-transition-name:cabeza}
.navegacion.al-pie{view-transition-name:pie}
main{view-transition-name:contenido}
::view-transition-old(contenido){animation:.2s ease-in both vt-salir}
::view-transition-new(contenido){animation:.38s var(--salida) both vt-llegar}
html[data-rumbo="atras"]::view-transition-old(contenido){animation-name:vt-salir-atras}
html[data-rumbo="atras"]::view-transition-new(contenido){animation-name:vt-llegar-atras}
@keyframes vt-salir{to{opacity:0; transform:translateX(-26px)}}
@keyframes vt-llegar{from{opacity:0; transform:translateX(34px)}}
@keyframes vt-salir-atras{to{opacity:0; transform:translateX(26px)}}
@keyframes vt-llegar-atras{from{opacity:0; transform:translateX(-34px)}}

@media (prefers-reduced-motion:reduce){
  *,*::before,*::after{animation:none !important; transition:none !important}
  ::view-transition-group(*),::view-transition-old(*),::view-transition-new(*){animation:none !important}
  html{scroll-behavior:auto}
  .confetis{display:none}
}
</style>
</head>
<body>
{% macro botones_nav() -%}
<button type="button" data-vista="hoy" aria-selected="false"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3.5" y="5" width="17" height="15.5" rx="3.2"/><path d="M3.5 10h17M8 3v4M16 3v4"/><circle class="lleno" cx="12" cy="15.2" r="1.7"/></svg><span>Hoy</span></button>
<button type="button" data-vista="picks" aria-selected="false"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="4.5" y="3.5" width="15" height="17" rx="3"/><path d="M8.3 9.2l1.9 1.9 3.6-3.6M8.5 15.5h7"/></svg><span>Picks</span></button>
<button type="button" data-vista="semana" aria-selected="false"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3.5" y="4" width="17" height="16" rx="3.2"/><path d="M3.5 12h17M12 4v16"/><circle cx="12" cy="12" r="2.6"/></svg><span>Semana</span></button>
<button type="button" data-vista="general" aria-selected="false"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3.5 20.5h17M5 20.5v-6.5h4.5v6.5M9.5 20.5V8h5v12.5M14.5 20.5v-9h4.5v9"/></svg><span>General</span></button>
<button type="button" data-vista="premios" aria-selected="false"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 4h8v5.2a4 4 0 0 1-8 0zM8 6.2H5.4a2.7 2.7 0 0 0 3 4.2M16 6.2h2.6a2.7 2.7 0 0 1-3 4.2M12 13.2v3.6M8.6 20.3h6.8M10 16.8h4v3.5h-4z"/></svg><span>Premios</span></button>
{%- endmacro %}
{% set espera_rescate = 8000 %}{% include "_rescate.html.j2" %}
<div class="campo" aria-hidden="true"><div class="lienzo">{% for yardas in [10, 20, 30, 40, 50, 40, 30, 20, 10] %}<b class="num izq" style="--k:{{ loop.index }}">{{ yardas }}</b><b class="num der" style="--k:{{ loop.index }}">{{ yardas }}</b>{% endfor %}</div></div>

<header>
  <div class="env top">
    <div class="logo">
      {{ marca_svg|safe }}
      <span class="letras">
        <span class="marca">{{ marca }}</span>
        <span class="sub">Quiniela NFL {{ anio }} <i class="version">{{ etapa }} {{ version }}</i></span>
      </span>
    </div>
    <button type="button" class="identidad" id="identidad" aria-expanded="false" aria-controls="controles">
      <span class="ini" id="identidad-ini">?</span>
      <span class="txt" id="identidad-txt">Identifícate</span>
      <span class="flecha">▾</span>
    </button>
    <span class="estado" id="estado"><span class="punto"></span><span id="estado-txt">Temporada</span></span>
  </div>
  <div class="env controles oculto" id="controles">
    <label class="soy" id="soy"><span>Soy</span><select id="quien-soy" aria-label="Elige tu nombre"></select></label>
    <label class="soy" id="equipo"><span>Equipo</span><select id="mi-equipo" aria-label="Elige tu equipo"></select></label>
  </div>
  <div class="env fila-yo">
    <nav class="navegacion en-cabeza" data-nav aria-label="Secciones">{{ botones_nav() }}</nav>
    <div class="mi-barra" id="mi-barra" aria-live="polite"></div>
  </div>
</header>

<main>
  <section class="vista oculto env" id="vista-hoy"></section>
  <section class="vista oculto env" id="vista-picks"></section>
  <!-- La general se escribe en el HTML: se ve aunque el navegador no ejecute nada. -->
  <section class="vista anima env" id="vista-general">
    {% if podio_listo %}
    <div class="titulo">
      <h2>Podio</h2><span class="nota">Bolsa final {{ premios.total }}</span>
    </div>
    <div class="podio">
      {% for escalon in podio %}
      <article class="lugar {{ escalon.medalla }}" style="--i:{{ loop.index0 }}">
        <div class="medalla">{{ escalon.pos }}</div>
        <div class="cuerpo">
          {% if escalon.enlistar %}
          <div class="quien">{{ escalon.nombres|join(' · ') }}</div>
          {% else %}
          <div class="empatados">{{ escalon.cuantos }} empatados</div>
          {% endif %}
          <div class="detalle">{{ escalon.pos }}º lugar</div>
          {% if escalon.premio %}<div class="bolsa">{% if not premios.temporada_cerrada %}Hoy: {% endif %}{{ escalon.premio }}{% if escalon.cuantos > 1 %} c/u{% endif %}</div>
          {% elif escalon.pos > 3 %}<div class="sin-premio">Sin premio{% if not premios.temporada_cerrada %} por ahora{% endif %}</div>{% endif %}
        </div>
        <div class="cifra">
          <div class="puntos">{{ escalon.total }}</div>
          <div class="detalle">{% if escalon.total == 1 %}acierto{% else %}aciertos{% endif %}</div>
        </div>
      </article>
      {% endfor %}
    </div>
    <p class="nota-podio">Solo ganan los 3 primeros lugares de la general. Con empates, los premios de los
      lugares que ocupan se juntan y se dividen parejo{% if not premios.temporada_cerrada %}; los montos son si
      la temporada terminara hoy{% endif %}.
      <button type="button" class="enlace-titulo" id="a-dinamica">Cómo se reparte ›</button></p>
    {% else %}
    <div class="titulo"><h2>Podio</h2><span class="nota">aún no</span></div>
    <div class="aviso">
      <strong>El podio se arma con más partidos</strong>
      Van {{ cerrados_temporada }} de {{ umbral_podio }} partidos cerrados. Con tan pocos juegos
      casi todos van empatados y un podio no diría nada. La tabla de abajo ya cuenta.
    </div>
    {% endif %}

    <div class="titulo">
      <h2>Tabla general</h2><button type="button" class="enlace-titulo" id="a-jugadores">Fichas y duelo ›</button>
    </div>
    <div class="marco rueda">
      <table class="fija">
        <thead>
          <tr>
            <th class="c-pos">#</th><th class="c-nombre">Participante</th>
            <th>Aciertos</th><th>Fallos</th>
            {% for columna in columnas_semana %}<th class="c-sem{% if loop.revindex > 4 %} vieja{% endif %}">{{ columna }}</th>{% endfor %}
          </tr>
        </thead>
        <tbody>
          {% for fila in general %}
          <tr class="p{{ fila.pos }}" style="--i:{{ loop.index0 }}">
            <td class="c-pos">{{ fila.pos }}{% if fila.mov is not none %}{% if fila.mov > 0 %}<span class="mov sube" title="Subió {{ fila.mov }} lugares">▲{{ fila.mov }}</span>{% elif fila.mov < 0 %}<span class="mov baja" title="Bajó {{ -fila.mov }} lugares">▼{{ -fila.mov }}</span>{% else %}<span class="mov igual" title="Sin cambio">=</span>{% endif %}{% endif %}</td>
            <td class="c-nombre">{{ participantes[fila.p] }}</td>
            <td class="pts">{{ fila.total }}</td>
            <td class="err">{{ fila.err }}</td>
            {% for columna in columnas_semana %}<td class="sem c-sem{% if loop.revindex > 4 %} vieja{% endif %}">{{ fila.sem[columna[1:]] }}</td>{% endfor %}
          </tr>
          {% endfor %}
        </tbody>
      </table>
      {% if columnas_semana|length > 4 %}
      <button type="button" class="ver-todas" id="ver-todas">Ver las {{ columnas_semana|length }} semanas</button>
      {% endif %}
    </div>
  </section>

  <section class="vista oculto env" id="vista-premios"></section>
  <section class="vista oculto env" id="vista-jugadores"></section>
  <section class="vista oculto env" id="vista-semana"></section>
</main>

<nav class="navegacion al-pie" data-nav aria-label="Secciones">{{ botones_nav() }}</nav>

<footer>
  <div class="env">
    <p class="sello-marca">{{ marca }} · {{ etapa }} {{ version }}</p>
    <p>Gana la semana quien tenga más aciertos. Si un partido termina empatado, nadie acierta. La bolsa final
      se reparte entre los 3 primeros lugares de la general.</p>
    <p>Actualizado {{ actualizado }} · horario de Ciudad de México</p>
    <p class="firma">Desarrollado por {{ desarrollador }}</p>
  </div>
</footer>

<script type="application/json" id="datos">{{ datos|safe }}</script>
<script>
(() => {
  "use strict";
  const D = JSON.parse(document.getElementById("datos").textContent);
  const vistas = {
    hoy: document.getElementById("vista-hoy"),
    picks: document.getElementById("vista-picks"),
    general: document.getElementById("vista-general"),
    premios: document.getElementById("vista-premios"),
    jugadores: document.getElementById("vista-jugadores"),
    semana: document.getElementById("vista-semana"),
  };
  // Dos navegaciones con los mismos botones: arriba en computadora, abajo en el teléfono.
  const navs = document.querySelectorAll("[data-nav]");
  const miBarra = document.getElementById("mi-barra");
  const chip = document.getElementById("estado");
  const chipTxt = document.getElementById("estado-txt");
  const porSemana = new Map(D.semanas.map((s) => [s.n, s]));
  const nombre = (i) => D.participantes[i] || "?";
  const suave = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const MAX_NOMBRES = 3, MAX_NOMBRES_OFICIAL = 6;
  let pestana = "tabla", vistaActual = "hoy", perfilAbierto = null;
  // La semana que se ve en "Semana": la en curso, hasta que se elija otra.
  let semanaElegida = D.activa !== null && porSemana.has(D.activa) ? D.activa : (D.semanas.length ? D.semanas[D.semanas.length - 1].n : null);
  // Si la pestaña la eligió la persona, se respeta; si no, la decide el momento.
  let pestanaElegida = false;

  /* Dónde se quedó el usuario, para volver ahí al recargar. Si la recarga la
     hizo la página, además se le devuelve todo lo demás: no la pidió él. */
  const SITIO = "angabave.sitio";
  let recargaAutomatica = false;
  function recordarSitio() {
    try {
      sessionStorage.setItem(SITIO, JSON.stringify({
        vista: vistaActual, pestana, scroll: Math.round(window.scrollY), auto: recargaAutomatica,
        elegida: pestanaElegida, perfil: perfilAbierto === null ? null : D.participantes[perfilAbierto],
        controles: leerControles(),
      }));
    } catch (e) { /* sin memoria: se abre donde toque por omisión */ }
  }
  function sitioGuardado() {
    try { return JSON.parse(sessionStorage.getItem(SITIO) || "null"); }
    catch (e) { return null; }
  }

  /* Lo que la persona dejó a medias en la vista: búsquedas, a quién eligió en
     una lista y los desplegables abiertos. Sobrevive a que la vista se redibuje
     y a una recarga. Las listas se recuerdan por el texto, no por el valor: el
     valor es la posición en la tabla, y esa cambia cuando cierra un partido. */
  function controlesDeLaVista() {
    const raiz = vistas[typeof vistaActual === "number" ? "semana" : vistaActual] || vistas.hoy;
    return Array.from(raiz.querySelectorAll("input,select,details"));
  }
  function leerControles() {
    return controlesDeLaVista().map((c) => c.tagName === "DETAILS" ? c.open
      : c.tagName === "SELECT" ? (c.selectedOptions[0] || {}).text || "" : c.value);
  }
  function reponerControles(valores) {
    const controles = controlesDeLaVista();
    if (!Array.isArray(valores) || valores.length !== controles.length) return;
    controles.forEach((c, i) => {
      if (c.tagName === "DETAILS") { c.open = valores[i] === true; return; }
      if (c.tagName === "SELECT") {
        const opcion = Array.from(c.options).find((o) => o.text === valores[i]);
        if (!opcion || opcion.selected) return;
        c.value = opcion.value;
        c.dispatchEvent(new Event("change"));
      } else if (typeof valores[i] === "string" && c.value !== valores[i]) {
        c.value = valores[i];
        c.dispatchEvent(new Event("input"));
      }
    });
  }

  /* Un toque, una tecla o un deslizamiento reciente: la persona está ahí. */
  let ultimoToque = 0;
  ["pointerdown", "keydown", "wheel", "touchmove", "scroll"].forEach((tipo) =>
    document.addEventListener(tipo, () => { ultimoToque = Date.now(); }, { passive: true }));
  const escribiendo = () => /^(INPUT|TEXTAREA)$/.test((document.activeElement || {}).tagName || "");

  const crear = (tag, clase, texto) => {
    const n = document.createElement(tag);
    if (clase) n.className = clase;
    if (texto !== undefined) n.textContent = texto;
    return n;
  };
  /* "31 empatados" sin decir quiénes no sirve de nada. Se cuenta, pero con la
     lista a un toque. */
  function nombrar(gente, oficial) {
    const tope = oficial ? MAX_NOMBRES_OFICIAL : MAX_NOMBRES;
    if (gente.length <= tope) return document.createTextNode(gente.join(" · "));

    const caja = crear("details", "empatados");
    const titulo = crear("summary", null, gente.length + " empatados");
    caja.appendChild(titulo);
    const lista = crear("div", "gente");
    gente.slice().sort((a, b) => a.localeCompare(b, "es")).forEach((quien) => {
      const et = crear("span", null, quien);
      if (jugador !== null && quien === nombre(jugador)) et.classList.add("tu");
      lista.appendChild(et);
    });
    caja.appendChild(lista);
    return caja;
  }
  const COPA =
    '<svg class="copa" viewBox="0 0 24 24" fill="none" aria-hidden="true">' +
    '<path d="M6 4h12v5a6 6 0 0 1-12 0V4Z" fill="#f7c948"/>' +
    '<path d="M6 5H4a3 3 0 0 0 3 3M18 5h2a3 3 0 0 1-3 3" stroke="#f7c948" stroke-width="1.6" stroke-linecap="round"/>' +
    '<path d="M12 15v3M9 21h6M10 18h4" stroke="#ffe193" stroke-width="1.8" stroke-linecap="round"/></svg>';

  /* ═══ memoria del navegador ═══ */
  function guardar(llave, valor) {
    try { valor === null ? localStorage.removeItem(llave) : localStorage.setItem(llave, valor); }
    catch (e) { /* ventana privada o permisos: el modo sigue vivo esta visita */ }
  }
  function leer(llave) {
    try { return localStorage.getItem(llave); } catch (e) { return null; }
  }

  /* ═══ identidad: un botón en vez de dos filas de selectores ═══ */
  const botonIdentidad = document.getElementById("identidad");
  const panelControles = document.getElementById("controles");
  const identidadIni = document.getElementById("identidad-ini");
  const identidadTxt = document.getElementById("identidad-txt");

  function iniciales(texto) {
    const partes = texto.trim().split(/\s+/).filter(Boolean);
    if (!partes.length) return "?";
    const primera = partes[0][0] || "";
    const segunda = partes.length > 1 ? partes[partes.length - 1][0] : (partes[0][1] || "");
    return (primera + segunda).toUpperCase();
  }

  function pintarIdentidad() {
    const quien = jugador !== null ? nombre(jugador) : null;
    const partes = [quien, equipo].filter(Boolean);
    botonIdentidad.classList.toggle("puesta", partes.length > 0);
    identidadTxt.textContent = partes.length ? partes.join(" · ") : "Identifícate";
    identidadIni.textContent = quien ? iniciales(quien) : (equipo ? (D.siglas[equipo] || "?") : "?");
    botonIdentidad.title = partes.length
      ? "Cambiar tu nombre o tu equipo"
      : "Elige tu nombre y tu equipo";
  }

  function abrirControles(abrir) {
    panelControles.classList.toggle("oculto", !abrir);
    botonIdentidad.setAttribute("aria-expanded", String(abrir));
    medirEncabezado();
  }

  botonIdentidad.addEventListener("click", (evento) => {
    evento.stopPropagation();
    abrirControles(panelControles.classList.contains("oculto"));
  });
  document.addEventListener("click", (evento) => {
    if (!panelControles.classList.contains("oculto") && !panelControles.contains(evento.target)) {
      abrirControles(false);
    }
  });
  document.addEventListener("keydown", (evento) => {
    if (evento.key === "Escape") abrirControles(false);
  });

  /* ═══ quién soy ═══ */
  const cajaSoy = document.getElementById("soy");
  const selSoy = document.getElementById("quien-soy");
  let jugador = null;

  function montarSoy() {
    selSoy.innerHTML = '<option value="">elige tu nombre</option>';
    D.participantes.map((q, i) => [i, q]).sort((a, b) => a[1].localeCompare(b[1], "es"))
      .forEach(([i, q]) => { const o = crear("option", null, q); o.value = String(i); selSoy.appendChild(o); });
    const g = leer("angabave.jugador");
    const i = g ? D.participantes.indexOf(g) : -1;
    jugador = i >= 0 ? i : null;
    selSoy.value = jugador === null ? "" : String(jugador);
    cajaSoy.classList.toggle("puesto", jugador !== null);
    selSoy.addEventListener("change", () => elegirJugador(selSoy.value === "" ? null : Number(selSoy.value)));
  }

  /* ═══ mi equipo: el portal se tiñe con sus colores ═══ */
  const cajaEquipo = document.getElementById("equipo");
  const selEquipo = document.getElementById("mi-equipo");
  let equipo = null;

  function montarEquipo() {
    selEquipo.innerHTML = '<option value="">elige tu equipo</option>';
    Object.keys(D.colores).sort((a, b) => a.localeCompare(b, "es")).forEach((eq) => {
      const o = crear("option", null, eq); o.value = eq; selEquipo.appendChild(o);
    });
    const g = leer("angabave.equipo");
    equipo = g && D.colores[g] ? g : null;
    selEquipo.value = equipo || "";
    selEquipo.addEventListener("change", () => {
      equipo = selEquipo.value || null;
      guardar("angabave.equipo", equipo);
      aplicarTema();
      pintarIdentidad();
      repintar();
    });
    aplicarTema();
  }

  /* Colores de casa si juega de local esta semana, de visita si va de visitante.
     No cambia un acento: cambia fondo, superficies, bordes y resplandor. */
  let temaPuesto = [];
  function aplicarTema() {
    const raiz = document.documentElement;
    cajaEquipo.classList.toggle("puesto", equipo !== null);
    temaPuesto.forEach((v) => raiz.style.removeProperty(v));
    temaPuesto = [];
    const meta = document.querySelector('meta[name="theme-color"]');

    if (!equipo || !D.temas[equipo]) {
      if (meta) meta.setAttribute("content", D.fondo);
      return;
    }
    const s = porSemana.get(D.activa) || D.semanas[D.semanas.length - 1];
    let donde = "local";
    if (s) {
      const juego = s.partidos.find((p) => p.v === equipo || p.l === equipo);
      if (juego) donde = juego.l === equipo ? "local" : "visita";
    }
    const tema = D.temas[equipo][donde];
    Object.entries(tema).forEach(([variable, valor]) => {
      raiz.style.setProperty(variable, valor);
      temaPuesto.push(variable);
    });
    if (meta) meta.setAttribute("content", tema["--bg"]);
  }

  /* ═══ marcador en vivo ═══ */
  const marcadores = new Map();
  const anotaciones = new Map();   // clave -> cuándo cambió el marcador
  const SEGUNDOS_ANOTACION = 9;
  let fallosVivo = 0, ultimaConsulta = null;
  // La última vez que se supo que el cálculo oficial sigue corriendo.
  let latido = Date.parse(String(D.generado || "").replace(/(\.\d{3})\d+/, "$1")) || 0, latidoVisto = false;

  /* Una cifra que sube contando se nota; una que aparece ya puesta, no. */
  function contarHasta(nodo, destino, ms) {
    if (suave || destino <= 0 || destino > 999) { nodo.textContent = String(destino); return; }
    const arranque = performance.now();
    nodo.textContent = "0";
    const paso = (ahora) => {
      const avance = Math.min(1, (ahora - arranque) / ms);
      // Desacelera al final, como un marcador mecánico.
      const suavizado = 1 - Math.pow(1 - avance, 3);
      nodo.textContent = String(Math.round(destino * suavizado));
      if (avance < 1) requestAnimationFrame(paso);
      else nodo.textContent = String(destino);
    };
    requestAnimationFrame(paso);
  }

  function parsearVivo(carga) {
    if (!carga || !Array.isArray(carga.events)) return null;
    const salida = new Map();
    for (const ev of carga.events) {
      const comp = (ev.competitions || [])[0];
      if (!comp || !Array.isArray(comp.competitors) || comp.competitors.length !== 2) return null;
      let v = null, l = null;
      for (const c of comp.competitors) {
        const eq = D.vivo.equipos[(c.team || {}).abbreviation];
        if (!eq) return null;
        const m = c.score === "" || c.score == null ? null : Number(c.score);
        if (Number.isNaN(m)) return null;
        if (c.homeAway === "home") l = { eq, m };
        else if (c.homeAway === "away") v = { eq, m };
      }
      if (!v || !l) return null;
      const reloj = comp.status || ev.status || {};
      const tipo = reloj.type || {};
      if (typeof tipo.completed !== "boolean") return null;
      // ESPN manda "0" de marcador antes de la patada: eso no es un 0-0.
      const antes = tipo.state === "pre" ||
        (!tipo.completed && tipo.state !== "in" && (v.m || 0) + (l.m || 0) === 0);
      if (antes) { v.m = null; l.m = null; }
      let g = null;
      if (v.m !== null && l.m !== null && v.m !== l.m) g = v.m > l.m ? "v" : "l";
      const crudo = tipo.description || tipo.name || "";
      // Antes de la patada no hay nada que decir: se queda el horario publicado.
      let e = crudo === "Scheduled" ? null : (D.vivo.estados[crudo] || crudo);
      // En juego, mejor el cuarto y el reloj que un "En curso" genérico.
      if (tipo.state === "in" && crudo === "In Progress" && Number(reloj.period) > 0) {
        e = (reloj.period > 4 ? "TE" : "Q" + reloj.period) + (reloj.displayClock ? " · " + reloj.displayClock : "");
      }
      salida.set(v.eq + "@" + l.eq, {
        mv: v.m, ml: l.m, g, e,
        completado: tipo.completed,
        enJuego: !tipo.completed && !antes,
      });
    }
    return salida;
  }

  async function consultarVivo() {
    if (!D.vivo || fallosVivo >= 3 || document.hidden) return;
    const s = typeof vistaActual === "number" ? porSemana.get(vistaActual) : porSemana.get(D.activa);
    if (!s || s.cerrados >= s.total) return;
    const control = new AbortController();
    const corte = setTimeout(() => control.abort(), 8000);
    try {
      const r = await fetch(
        D.vivo.url + "?dates=" + D.anio + "&seasontype=2&week=" + s.n,
        { signal: control.signal, cache: "no-store" }
      );
      if (!r.ok) throw new Error(r.status);
      const frescos = parsearVivo(await r.json());
      if (!frescos) throw new Error("formato inesperado");
      const antes = JSON.stringify(todosLosJuegos(s));
      frescos.forEach((valor, clave) => {
        const previo = marcadores.get(clave);
        if (previo && (previo.mv !== valor.mv || previo.ml !== valor.ml)) {
          anotaciones.set(clave, {
            cuando: Date.now(),
            lado: previo.mv !== valor.mv ? "v" : "l",
          });
        }
        marcadores.set(clave, valor);
      });
      fallosVivo = 0;
      ultimaConsulta = new Date();
      // Redibujar sin que nada cambie borraba lo que la persona tenía a medias.
      if (repintePendiente || JSON.stringify(todosLosJuegos(s)) !== antes) repintarSinEstorbar();
    } catch (e) {
      fallosVivo++;   // a la tercera se deja de insistir y manda lo publicado por CI
    } finally {
      clearTimeout(corte);
    }
  }

  /* El navegador nunca cierra un partido: eso lo decide CI, que es la fuente oficial. */
  function efectivo(p) {
    if (p.cerrado) return p;
    const vivo = marcadores.get(p.v + "@" + p.l);
    if (!vivo) return p;
    return Object.assign({}, p, {
      mv: vivo.mv, ml: vivo.ml, g: vivo.g, vivo: vivo.enJuego,
      e: vivo.completado ? "Final · por confirmar" : (vivo.e || p.e),
      porConfirmar: vivo.completado,
    });
  }
  const partidosDe = (s) => s.partidos.map(efectivo);

  /* ═══ encabezado ═══ */
  /* "En vivo" solo cuando de verdad se está jugando algo. Una semana a medias
     un viernes está en curso, no en vivo: antes se encendía en rojo toda la
     semana y ya nadie le creía. */
  function pintarEstado(vista) {
    const s = typeof vista === "number" ? porSemana.get(vista) : porSemana.get(D.activa);
    document.body.classList.toggle("hay-vivo", juegosEnVivo(porSemana.get(D.activa)).length > 0);
    chip.className = "estado";
    if (!s) { chipTxt.textContent = "Temporada " + D.anio; return; }
    const vivos = juegosEnVivo(s).length;
    if (vivos) {
      chip.classList.add("vivo");
      chipTxt.textContent = vivos === 1 ? "1 partido en vivo" : vivos + " partidos en vivo";
    } else if (s.estado === "pendiente") {
      chip.classList.add("esperando");
      chipTxt.textContent = "Picks abiertos · S" + s.n;
    } else if (s.estado === "en_vivo") {
      chipTxt.textContent = "S" + s.n + " · " + s.cerrados + " de " + s.total;
    } else {
      chipTxt.textContent = "Semana " + s.n + " cerrada";
    }
  }

  const COLORES = ["#f7c948", "#ffe193", "#5b95ff", "#3ddc84", "#ffffff", "#ff6058"];
  function confeti(caja) {
    if (suave) return;
    for (let i = 0; i < 46; i++) {
      const p = crear("i", "confeti");
      p.style.left = Math.random() * 100 + "%";
      p.style.background = COLORES[i % COLORES.length];
      p.style.setProperty("--d", (2.2 + Math.random() * 1.6).toFixed(2) + "s");
      p.style.setProperty("--x", Math.round(Math.random() * 140 - 70) + "px");
      p.style.setProperty("--r", Math.round(Math.random() * 720 - 360) + "deg");
      p.style.animationDelay = (Math.random() * 0.9).toFixed(2) + "s";
      caja.appendChild(p);
    }
  }

  function miPick(s, col) {
    if (jugador === null) return null;
    const fila = s.jugadores.indexOf(jugador);
    if (fila < 0) return null;
    const local = s.picks[fila][col] === 1;
    return { lado: local ? "l" : "v", equipo: local ? s.partidos[col].l : s.partidos[col].v };
  }

  function campeon(s) {
    if (!s.proyectable) return null;   // la línea de estado de la semana ya lo explica
    const gente = (s.ganadores || []).map(nombre);
    if (!gente.length) return null;
    const oficial = !!s.oficial;
    const caja = crear("div", "campeon " + (oficial ? "oficial" : "provisional"));
    const lluvia = crear("div", "confetis");
    caja.appendChild(lluvia);
    caja.insertAdjacentHTML("beforeend", COPA);
    caja.appendChild(crear("div", "rot", oficial
      ? (gente.length > 1 ? "Ganadores de la semana " + s.n : "Ganador de la semana " + s.n)
      : "Va ganando la semana " + s.n));
    const nombres = crear("div", "nombres");
    nombres.appendChild(nombrar(gente, oficial));
    caja.appendChild(nombres);
    const fila = s.tabla.find((f) => f.pos === 1);
    const ac = fila ? fila.f : 0;
    caja.appendChild(crear("div", "cifra",
      ac + (ac === 1 ? " acierto" : " aciertos") + " de " + s.cerrados +
      (s.cerrados === 1 ? " partido cerrado" : " partidos cerrados")));
    const bolsa = crear("div", "bolsa");
    bolsa.textContent = oficial ? s.premio + (gente.length > 1 ? " para cada uno" : "")
                                : s.premio_total + " en juego";
    caja.appendChild(bolsa);
    if (oficial) requestAnimationFrame(() => confeti(lluvia));
    return caja;
  }

  function miSemana(s) {
    if (jugador === null || s.jugadores.indexOf(jugador) < 0) return null;
    const juegos = partidosDe(s);
    let ok = 0, mal = 0, ganando = 0, faltan = 0;
    juegos.forEach((p, col) => {
      const mio = miPick(s, col);
      if (!mio) return;
      if (p.cerrado) { p.g === mio.lado ? ok++ : mal++; }
      else { faltan++; if (p.g === mio.lado) ganando++; }
    });
    faltan += (s.por_entregar || []).filter((p) => !p.cerrado).length;
    const caja = crear("div", "mi-semana");
    const quien = crear("div");
    quien.appendChild(crear("div", "rot", "Tu semana"));
    quien.appendChild(crear("div", "yo", nombre(jugador)));
    caja.appendChild(quien);
    const cuentas = crear("div", "cuentas");
    [["ok", ok, ok === 1 ? "acierto" : "aciertos"], ["no", mal, mal === 1 ? "fallo" : "fallos"],
     ["vivo", ganando, "ganando"], ["", faltan, "por jugar"]].forEach(([c, v, et]) => {
      const d = crear("div", "dato" + (c ? " " + c : ""));
      const cifra = crear("b");
      contarHasta(cifra, v, 700);
      d.appendChild(cifra);
      d.appendChild(crear("span", null, et));
      cuentas.appendChild(d);
    });
    caja.appendChild(cuentas);
    return caja;
  }

  function vivosPorParticipante(s) {
    const juegos = partidosDe(s);
    const cuenta = new Map();
    s.jugadores.forEach((idx, fila) => {
      let n = 0;
      juegos.forEach((p, col) => {
        if (!p.cerrado && p.g !== null && (p.g === "l") === (s.picks[fila][col] === 1)) n++;
      });
      cuenta.set(idx, n);
    });
    return cuenta;
  }

  function tablaSemana(s) {
    const marco = crear("div", "marco rueda");
    const tabla = crear("table");
    tabla.className = "fija";
    tabla.innerHTML = '<thead><tr><th class="c-pos">#</th><th class="c-nombre">Participante</th>' +
      "<th>Aciertos</th><th>Fallos</th></tr></thead>";
    const cuerpo = crear("tbody");
    const vivos = vivosPorParticipante(s);
    // Dentro de un empate, primero quien va ganando más partidos en este momento.
    const filas = s.tabla.slice().sort((a, b) => a.pos - b.pos || (vivos.get(b.p) || 0) - (vivos.get(a.p) || 0));
    filas.forEach((fila, i) => {
      const tr = crear("tr", "p" + fila.pos + (fila.p === jugador ? " yo" : "") + " clic");
      tr.style.setProperty("--i", Math.min(i, 12));
      tr.appendChild(crear("td", "c-pos", String(fila.pos)));
      tr.appendChild(crear("td", "c-nombre", nombre(fila.p)));
      const pts = crear("td", "pts", String(fila.f));
      const extra = vivos.get(fila.p) || 0;
      if (extra > 0) {
        const m = crear("span", "chip-vivo", "+" + extra);
        m.title = "Va ganando " + extra + (extra === 1 ? " partido en curso" : " partidos en curso");
        pts.appendChild(m);
      }
      tr.appendChild(pts);
      tr.appendChild(crear("td", "err", String(fila.e)));
      tr.addEventListener("click", () => { perfilAbierto = fila.p; ir("jugadores", true); });
      cuerpo.appendChild(tr);
    });
    tabla.appendChild(cuerpo);
    marco.appendChild(tabla);
    const env = crear("div");
    env.appendChild(marco);
    if (s.tabla.length > 12) {
      ponerFiltro(env, Array.from(cuerpo.children),
        (fila) => fila.children[1].textContent, "Buscar participante…");
    }
    return env;
  }

  /* ═══ marcador estilo transmisión ═══ */
  function panelPartidos(s) {
    const raiz = crear("div");
    const juegos = partidosDe(s).map((p, i) => ({ p, i }));

    // Lo que falta por jugarse manda: va arriba. Lo ya jugado queda abajo,
    // del más reciente al más viejo, porque es consulta, no expectativa.
    const bloques = [];
    let mios = [];
    if (equipo) {
      // Tu partido se adelanta solo mientras no haya terminado: una vez
      // cerrado no tiene por qué encabezar nada.
      mios = juegos.filter(({ p }) => (p.v === equipo || p.l === equipo) && !p.cerrado);
      if (mios.length) bloques.push({ etiqueta: "Tu equipo", juegos: mios, suelto: true });
    }

    const resto = juegos.filter((juego) => !mios.includes(juego));
    const porJugar = resto
      .filter(({ p }) => !p.cerrado)
      .sort((a, b) => (a.p.t || Infinity) - (b.p.t || Infinity) || a.i - b.i);
    const jugados = resto
      .filter(({ p }) => p.cerrado)
      .sort((a, b) => (b.p.t || 0) - (a.p.t || 0) || b.i - a.i);

    const agrupar = (lista, titulo) => {
      if (!lista.length) return;
      bloques.push({ etiqueta: titulo, seccion: true });
      lista.forEach((juego) => {
        const etiqueta = juego.p.grupo || "Por programar";
        const ultimo = bloques[bloques.length - 1];
        if (ultimo && !ultimo.suelto && !ultimo.seccion && ultimo.etiqueta === etiqueta) {
          ultimo.juegos.push(juego);
        } else {
          bloques.push({ etiqueta, juegos: [juego] });
        }
      });
    };
    agrupar(porJugar, porJugar.length === 1 ? "Falta este" : "Por jugarse");
    agrupar(jugados, "Ya jugados");

    let orden = 0;
    bloques.forEach((bloque) => {
      const cabeza = crear("div", "bloque-hora" + (bloque.seccion ? " seccion" : ""));
      cabeza.appendChild(crear("span", null, bloque.etiqueta));
      cabeza.appendChild(crear("i"));
      if (!bloque.seccion) {
        const abiertos = (bloque.juegos || []).filter(({ p }) => !p.cerrado).length;
        if (abiertos) cabeza.appendChild(crear("em", null, abiertos + " por cerrar"));
      }
      raiz.appendChild(cabeza);
      if (bloque.seccion) return;

      const caja = crear("div", "juegos");
      raiz.appendChild(caja);
      bloque.juegos.forEach(({ p, i }) => dibujarJuego(caja, s, p, i, orden++));
    });
    return raiz;
  }

  function dibujarJuego(caja, s, p, i, orden) {
    const mioEquipo = equipo && (p.v === equipo || p.l === equipo);
    const anotacion = anotaciones.get(p.v + "@" + p.l);
    const reciente = anotacion && (Date.now() - anotacion.cuando) < SEGUNDOS_ANOTACION * 1000;
    const nodo = crear("article", "juego" + (p.vivo ? " envivo" : "") +
      (mioEquipo ? " mi-equipo" : "") + (reciente ? " anoto" : ""));
    nodo.style.setProperty("--i", Math.min(orden, 12));
    if (mioEquipo) {
      const cinta = crear("div", "cinta-equipo");
      cinta.appendChild(crear("span", null, "Tu equipo"));
      nodo.appendChild(cinta);
    }
    [["v", p.v, p.mv], ["l", p.l, p.ml]].forEach(([lado, eq, marcador]) => {
      const linea = crear("div", "lado" + (p.g === lado ? " gana" : "") +
        (reciente && anotacion.lado === lado ? " anoto" : ""));
      const color = (D.colores[eq] || {}).local;
      if (color) linea.style.setProperty("--c", color);
      linea.appendChild(crear("span", "sig", D.siglas[eq] || eq.slice(0, 3).toUpperCase()));
      linea.appendChild(crear("span", "nom", eq));
      linea.appendChild(crear("span", "mrc", marcador === null ? "—" : String(marcador)));
      nodo.appendChild(linea);
    });
    const pie = crear("div", "pie");
    if (p.vivo) pie.appendChild(crear("span", "punto"));
    pie.appendChild(crear("span", null, p.e));
    if (p.cerrado && p.g === "x") pie.appendChild(crear("span", "der", "empate"));
    nodo.appendChild(pie);

    const mio = miPick(s, i);
    if (mio) {
      if (p.g === null) nodo.classList.add("mio-esp");
      else if (p.cerrado) nodo.classList.add(p.g === mio.lado ? "mio-ok" : "mio-no");
      else nodo.classList.add(p.g === mio.lado ? "mio-vivo-ok" : "mio-vivo-no");
      const marca = crear("div", "mi-pick");
      marca.appendChild(crear("span", null, "Tu pick"));
      marca.appendChild(crear("b", null, mio.equipo));
      if (p.cerrado) marca.appendChild(crear("span", null, p.g === "x" ? "· empate" : (p.g === mio.lado ? "· acierto" : "· fallo")));
      else if (p.g !== null) marca.appendChild(crear("span", null, p.g === mio.lado ? "· vas ganando" : "· vas perdiendo"));
      nodo.appendChild(marca);
    }
    caja.appendChild(nodo);
  }

  /* ═══ quién le fue a quién, con consenso ═══ */
  function panelReparto(s) {
    const env = crear("div");
    const lista = crear("select", "ancho");
    lista.innerHTML = '<option value="">Reparto de cada partido</option>';
    s.jugadores.map((i) => [i, nombre(i)]).sort((a, b) => a[1].localeCompare(b[1], "es"))
      .forEach(([i, q]) => { const o = crear("option", null, q); o.value = String(i); lista.appendChild(o); });
    if (jugador !== null && s.jugadores.indexOf(jugador) >= 0) lista.value = String(jugador);
    env.appendChild(lista);
    const destino = crear("div");
    env.appendChild(destino);
    const pintar = () => {
      destino.textContent = "";
      destino.appendChild(lista.value === "" ? repartoPorPartido(s) : boleta(s, Number(lista.value)));
    };
    lista.addEventListener("change", pintar);
    pintar();
    return env;
  }

  function repartoPorPartido(s) {
    const caja = crear("div", "reparto");
    const juegos = partidosDe(s);
    juegos.forEach((p, col) => {
      const visita = [], casa = [];
      s.jugadores.forEach((idx, fila) => { (s.picks[fila][col] === 1 ? casa : visita).push(idx); });
      const total = visita.length + casa.length || 1;
      const mayor = Math.max(visita.length, casa.length) / total;

      const nodo = crear("article", "split");
      nodo.style.setProperty("--i", Math.min(col, 12));
      const cab = crear("div", "cab");
      cab.appendChild(crear("span", "vs", p.v + " @ " + p.l));
      if (mayor >= 0.9) cab.appendChild(crear("span", "sello-consenso unanime", "casi unánime"));
      else if (mayor <= 0.6) cab.appendChild(crear("span", "sello-consenso dividido", "dividido"));
      cab.appendChild(crear("span", "mr", p.mv === null ? p.e : p.mv + "–" + p.ml));
      nodo.appendChild(cab);

      const balanza = crear("div", "balanza");
      const iv = crear("i"), il = crear("i");
      iv.style.background = (D.colores[p.v] || {}).local || "#5b95ff";
      il.style.background = (D.colores[p.l] || {}).local || "#f7c948";
      balanza.appendChild(iv); balanza.appendChild(il);
      nodo.appendChild(balanza);
      requestAnimationFrame(() => {
        iv.style.width = (visita.length / total) * 100 + "%";
        il.style.width = (casa.length / total) * 100 + "%";
      });

      const cuentas = crear("div", "cuenta-lado");
      const izq = crear("span", null, p.v + " · " + visita.length);
      izq.style.color = iv.style.background;
      const der = crear("span", null, casa.length + " · " + p.l);
      der.style.color = il.style.background;
      cuentas.appendChild(izq); cuentas.appendChild(der);
      nodo.appendChild(cuentas);

      [[visita, "v"], [casa, "l"]].forEach(([quienes, lado]) => {
        const fila = crear("div", "gente");
        quienes.slice().sort((a, b) => nombre(a).localeCompare(nombre(b), "es")).forEach((idx) => {
          const et = crear("span", p.cerrado ? (p.g === lado ? "ok" : "no") : null, nombre(idx));
          if (idx === jugador) et.classList.add("tu");
          fila.appendChild(et);
        });
        nodo.appendChild(fila);
      });
      caja.appendChild(nodo);
    });
    return caja;
  }

  function boleta(s, idx) {
    const fila = s.jugadores.indexOf(idx);
    const caja = crear("div", "boleta");
    if (fila < 0) return caja;
    partidosDe(s).forEach((p, col) => {
      const local = s.picks[fila][col] === 1;
      const lado = local ? "l" : "v";
      let clase = "", sello = "esp", simbolo = "·";
      if (p.cerrado) {
        if (p.g === "x") { clase = " fallo"; sello = "no"; simbolo = "="; }
        else if (p.g === lado) { clase = " acierto"; sello = "ok"; simbolo = "✓"; }
        else { clase = " fallo"; sello = "no"; simbolo = "✗"; }
      }
      const linea = crear("div", "linea" + clase);
      linea.style.setProperty("--i", Math.min(col, 12));
      linea.appendChild(crear("span", "sello " + sello, simbolo));
      const texto = crear("span", "vs");
      texto.appendChild(local ? crear("span", null, p.v) : crear("b", null, p.v));
      texto.appendChild(document.createTextNode(" @ "));
      texto.appendChild(local ? crear("b", null, p.l) : crear("span", null, p.l));
      linea.appendChild(texto);
      linea.appendChild(crear("span", "mini", p.mv === null ? p.e : p.mv + "–" + p.ml));
      caja.appendChild(linea);
    });
    return caja;
  }

  /* Una línea que diga qué falta. En segunda persona cuando es tu fila: es
     la diferencia entre leer una tabla y que te hablen a ti. */
  function queSignifica(g, total, soyYo) {
    const varios = g.gente.length > 1;
    if (g.suma >= total) {
      if (soyYo) {
        return g.solo === 0
          ? "Ya aseguraste el primer lugar, compartido."
          : "Ya aseguraste el primer lugar.";
      }
      if (varios) return "Ya aseguraron el primer lugar, compartido.";
      return g.solo === 0 ? "Ya aseguró el primer lugar, compartido." : "Ya aseguró el primer lugar.";
    }

    const equipos = g.req.map((x) => x.split("→")[1]);
    if (equipos.length) {
      const verbo = soyYo ? "Necesitas" : (varios ? "Necesitan" : "Necesita");
      if (equipos.length === 1) return verbo + " que gane " + equipos[0] + ".";
      if (equipos.length === 2) return verbo + " que ganen " + equipos.join(" y ") + ".";
      return verbo + " que ganen " + equipos.slice(0, 2).join(", ") +
        " y " + (equipos.length - 2) + " más.";
    }

    if (g.solo === 0) {
      return soyYo ? "Solo te alcanza para empatar el primer lugar."
                   : "Solo le alcanza para empatar el primer lugar.";
    }
    if (g.emp === 0) return soyYo ? "Si llegas, llegas solo." : "Si llega, llega solo.";
    return (soyYo ? "Ganas" : "Gana") + " solo en " + g.solo + " y " +
      (soyYo ? "empatas" : "empata") + " en " + g.emp + ".";
  }

  function panelEscenarios(s) {
    const total = s.combinaciones || 0;
    const filas = Object.entries(s.panorama || {})
      .map(([i, [solo, emp, req]]) => ({
        idx: Number(i), solo, emp, suma: solo + emp,
        req: (req || []).map(([clave, equipo]) => clave + "→" + equipo),
      }))
      .sort((a, b) => b.suma - a.suma || b.solo - a.solo ||
        nombre(a.idx).localeCompare(nombre(b.idx), "es"));
    if (!total || !filas.length) {
      return aviso("Sin escenarios que calcular", "La semana ya cerró: el primer lugar está definido.");
    }

    // Los que están en la misma situación van juntos: con un partido por jugar
    // media quiniela comparte el mismo porcentaje y serían seis filas idénticas.
    const grupos = [];
    filas.forEach((f) => {
      const ultimo = grupos[grupos.length - 1];
      if (ultimo && ultimo.suma === f.suma && ultimo.solo === f.solo) {
        ultimo.gente.push(f.idx);
        // Lo que el grupo necesita en común: si a uno no le hace falta, al
        // grupo tampoco se lo pedimos.
        ultimo.req = ultimo.req.filter((x) => f.req.includes(x));
      } else {
        grupos.push({ suma: f.suma, solo: f.solo, emp: f.emp, gente: [f.idx], req: f.req.slice() });
      }
    });

    const env = crear("div");
    const faltan = s.total - s.cerrados;
    const intro = crear("p", "mini");
    intro.style.margin = "0 .1rem .7rem";
    intro.textContent = "Falta" + (faltan === 1 ? " 1 partido" : "n " + faltan + " partidos") +
      ": " + total.toLocaleString("es-MX") +
      (total === 1 ? " desenlace posible." : " desenlaces posibles.");
    env.appendChild(intro);

    const caja = crear("div", "escena");
    const tope = grupos[0].suma || 1;
    const mio = grupos.findIndex((g) => g.gente.includes(jugador));
    const visibles = grupos.slice(0, 8);
    if (mio >= 8) visibles.push(grupos[mio]);

    visibles.forEach((g, i) => {
      const puesto = i < 8 ? i + 1 : mio + 1;
      const soyYo = g.gente.includes(jugador);
      const nodo = crear("div", "candidato" + (puesto === 1 ? " lider" : "") + (soyYo ? " yo" : ""));
      nodo.style.setProperty("--i", Math.min(i, 12));
      nodo.appendChild(crear("span", "n", String(puesto)));

      const quien = crear("span", "quien");
      quien.appendChild(nombrar(g.gente.map(nombre), false));
      nodo.appendChild(quien);
      nodo.appendChild(crear("span", "pct", ((g.suma / total) * 100).toFixed(0) + "%"));

      const barra = crear("div", "progreso");
      const relleno = crear("i");
      barra.appendChild(relleno);
      nodo.appendChild(barra);

      const nota = crear("div", "que-significa" + (soyYo ? " tuya" : ""));
      nota.textContent = queSignifica(g, total, soyYo);
      nodo.appendChild(nota);

      caja.appendChild(nodo);
      requestAnimationFrame(() => { relleno.style.width = (g.suma / tope) * 100 + "%"; });
    });
    env.appendChild(caja);
    return env;
  }

  /* Si la tabla oficial lleva mucho sin recalcularse y hay partidos abiertos,
     se dice. Una página que se ve perfecta con números viejos es peor que una
     que avisa. Los marcadores sí siguen vivos: esos los pide el navegador. */
  /* Solo avisa si de verdad puede haber algo atrasado: un partido que ya
     arrancó y que el sitio todavía no cierra. Un viernes sin partidos la tabla
     no tiene por qué recalcularse, y avisar "10 horas sin recalcularse" era
     una falsa alarma que asustaba a todos. Se cuenta desde el último latido o
     desde que arrancó el partido, lo más reciente: sin novedades el sitio ya no
     se publica, y antes del partido nadie tenía por qué recalcular. Doce horas
     después de la patada ya no se está jugando: estará pospuesto. */
  function avisoDeRezago(s) {
    if (!s || s.cerrados >= s.total || !latidoVisto) return null;
    const ahora = Date.now();
    const arrancados = s.partidos.concat(s.por_entregar || [])
      .filter((p) => !p.cerrado && p.t && p.t * 1000 <= ahora && ahora - p.t * 1000 < 12 * 3600e3);
    if (!arrancados.length) return null;
    const desde = Math.max(latido, Math.min(...arrancados.map((p) => p.t * 1000)));
    const minutos = Math.floor((ahora - desde) / 60000);
    if (!Number.isFinite(minutos) || minutos < (D.rezago || 35)) return null;

    const caja = crear("div", "rezago");
    caja.appendChild(crear("span", "icono", "⚠"));
    const texto = crear("span");
    const horas = Math.floor(minutos / 60);
    const cuanto = horas >= 1
      ? horas + (horas === 1 ? " hora" : " horas")
      : minutos + " minutos";
    texto.appendChild(crear("b", null, "La tabla lleva " + cuanto + " sin recalcularse."));
    texto.appendChild(document.createTextNode(
      " Los marcadores de abajo sí están al día, pero los aciertos y el ganador " +
      "pueden estar atrasados."
    ));
    caja.appendChild(texto);
    return caja;
  }

  /* ═══ generador de picks para la semana que aún no se carga ═══
     No manda nada ni guarda nada aquí: arma una imagen membretada para que
     cada quien la mande por su cuenta antes de que cierre la tanda. */
  const LLAVE_BORRADOR = (n) => "angabave.borrador." + n;

  /* Dibuja el escudo de la marca en el canvas, igual que el del encabezado. */
  /* La marca en la imagen de picks: las mismas rutas y colores de
     quiniela/marca.py, para que la imagen y el portal no se desalineen. */
  function marcaEnLienzo(ctx, x, y, lado) {
    const L = D.logo, u = lado / 64;
    const m = new DOMMatrix([u, 0, 0, u, x, y]);
    const ruta = (d) => { const p = new Path2D(); p.addPath(new Path2D(d), m); return p; };
    const loseta = ruta("M16 1H48A15 15 0 0 1 63 16V48A15 15 0 0 1 48 63H16A15 15 0 0 1 1 48V16A15 15 0 0 1 16 1Z");
    const fondo = ctx.createLinearGradient(x, y, x + lado, y + lado);
    fondo.addColorStop(0, L.loseta[0]);
    fondo.addColorStop(1, L.loseta[1]);
    ctx.save();
    ctx.fillStyle = fondo;
    ctx.fill(loseta);
    ctx.strokeStyle = "rgba(247,201,72,.3)";
    ctx.lineWidth = u;
    ctx.stroke(loseta);
    const oro = ([arriba, abajo]) => {
      const g = ctx.createLinearGradient(0, y + arriba * u, 0, y + abajo * u);
      g.addColorStop(0, L.oro[0]);
      g.addColorStop(0.55, L.oro[1]);
      g.addColorStop(1, L.oro[2]);
      return g;
    };
    ctx.fillStyle = oro(L.alto_a);
    ctx.fill(ruta(L.rutas.a));
    const balon = ruta(L.rutas.balon);
    ctx.fillStyle = oro(L.alto_balon);
    ctx.fill(balon);
    ctx.strokeStyle = L.tinta;
    ctx.lineJoin = "round";
    ctx.lineCap = "round";
    ctx.lineWidth = L.contorno * u;
    ctx.stroke(balon);
    ctx.lineWidth = L.costura * u;
    ctx.stroke(ruta(L.rutas.costuras));
    ctx.restore();
  }

  /* Arma la imagen membretada con los picks elegidos y la comparte o descarga. */
  async function exportarPicks(s, elegidos, porClave) {
    if (document.fonts && document.fonts.ready) await document.fonts.ready;

    const ANCHO = 1080, MARGEN = 56, ALTO_FILA = 96;
    // Los partidos salen de los que ofrece este generador (porClave), no de
    // s.partidos: con la semana a medias, s.partidos solo trae la tanda ya
    // cargada y la imagen salía vacía. El orden es el de la NFL, el mismo en
    // que se armó porClave.
    const claves = [...porClave.keys()].filter((clave) => elegidos.has(clave));
    if (!claves.length) return;

    const cabecera = 320;
    const pie = 96;
    const alto = cabecera + claves.length * ALTO_FILA + pie;

    const escala = 2;
    const lienzo = document.createElement("canvas");
    lienzo.width = ANCHO * escala;
    lienzo.height = alto * escala;
    const ctx = lienzo.getContext("2d");
    ctx.scale(escala, escala);

    const rotulo = (peso, tam) => peso + " " + tam + "px Rotulo, 'Arial Narrow', sans-serif";
    const cuerpo = (peso, tam) => peso + " " + tam + "px -apple-system, Segoe UI, Roboto, sans-serif";

    // Fondo plano a propósito: un degradado multiplica por diez el peso del PNG
    // y esta imagen se manda por correo y por WhatsApp.
    ctx.fillStyle = "#041009";
    ctx.fillRect(0, 0, ANCHO, alto);
    ctx.fillStyle = "#102117";
    ctx.fillRect(0, 0, ANCHO, 140);
    ctx.fillStyle = "#f7c948";
    ctx.fillRect(0, 138, ANCHO, 2);

    marcaEnLienzo(ctx, MARGEN, 38, 64);
    ctx.fillStyle = "#f7c948";
    ctx.font = rotulo(700, 46);
    ctx.textBaseline = "alphabetic";
    ctx.fillText("ANGABAVE", MARGEN + 82, 84);
    ctx.fillStyle = "#62776b";
    ctx.font = rotulo(500, 20);
    ctx.fillText("QUINIELA NFL " + D.anio, MARGEN + 84, 108);

    ctx.strokeStyle = "#1d3728";
    ctx.lineWidth = 2;
    ctx.beginPath();
    ctx.moveTo(MARGEN, 140);
    ctx.lineTo(ANCHO - MARGEN, 140);
    ctx.stroke();

    ctx.fillStyle = "#eef5f0";
    ctx.font = rotulo(700, 84);
    ctx.fillText("SEMANA " + s.n, MARGEN, 226);

    if (jugador !== null) {
      ctx.fillStyle = "#5b95ff";
      ctx.font = cuerpo(800, 34);
      ctx.fillText(nombre(jugador), MARGEN, 272);
    }
    ctx.fillStyle = "#93a69a";
    ctx.font = rotulo(500, 22);
    const cuantos = claves.length === 1 ? "1 PICK" : claves.length + " PICKS";
    ctx.textAlign = "right";
    ctx.fillText(cuantos, ANCHO - MARGEN, 226);
    ctx.textAlign = "left";

    claves.forEach((clave, i) => {
      const p = porClave.get(clave);
      const lado = elegidos.get(clave);
      const elegido = lado === "l" ? p.l : p.v;
      const rival = lado === "l" ? p.v : p.l;
      const color = (D.colores[elegido] || {}).local || "#5b95ff";
      const y = cabecera + i * ALTO_FILA;

      if (i % 2 === 0) {
        ctx.fillStyle = "#0a1c11";
        ctx.fillRect(MARGEN, y - 30, ANCHO - MARGEN * 2, ALTO_FILA - 12);
      }
      ctx.fillStyle = color;
      ctx.fillRect(MARGEN, y - 30, 6, ALTO_FILA - 12);

      ctx.fillStyle = color;
      const sigla = D.siglas[elegido] || elegido.slice(0, 3).toUpperCase();
      ctx.font = rotulo(700, 26);
      const anchoSigla = ctx.measureText(sigla).width + 22;
      ctx.beginPath();
      // roundRect no existe en Safari anterior a iOS 16: ahí va con esquinas rectas.
      if (ctx.roundRect) ctx.roundRect(MARGEN + 24, y - 24, anchoSigla, 38, 8);
      else ctx.rect(MARGEN + 24, y - 24, anchoSigla, 38);
      ctx.fill();
      ctx.fillStyle = (D.colores[elegido] || {}).local_texto || "#070b12";
      ctx.fillText(sigla, MARGEN + 35, y + 4);

      ctx.fillStyle = "#eef5f0";
      ctx.font = cuerpo(800, 34);
      ctx.fillText(elegido, MARGEN + 40 + anchoSigla, y + 6);

      ctx.fillStyle = "#62776b";
      ctx.font = cuerpo(600, 24);
      ctx.textAlign = "right";
      ctx.fillText((lado === "l" ? "vs " : "@ ") + rival, ANCHO - MARGEN - 18, y + 4);
      ctx.textAlign = "left";
    });

    ctx.strokeStyle = "#1d3728";
    ctx.beginPath();
    ctx.moveTo(MARGEN, alto - pie + 18);
    ctx.lineTo(ANCHO - MARGEN, alto - pie + 18);
    ctx.stroke();
    ctx.fillStyle = "#62776b";
    ctx.font = rotulo(500, 20);
    const sello = new Date();
    ctx.fillText(
      "GENERADO " + sello.toLocaleString("es-MX", { dateStyle: "medium", timeStyle: "short" })
        .toUpperCase() + "  ·  MANDAR A " + D.correo.toUpperCase(),
      MARGEN, alto - pie + 54
    );

    const blob = await new Promise((listo) => lienzo.toBlob(listo, "image/png"));
    if (!blob) return;
    const archivo = new File([blob], "picks-semana-" + s.n + ".png", { type: "image/png" });
    const titulo = "Picks semana " + s.n + (jugador !== null ? " · " + nombre(jugador) : "");

    // En el teléfono se abre el menú de compartir; en escritorio se descarga.
    if (navigator.canShare && navigator.canShare({ files: [archivo] })) {
      try {
        await navigator.share({ files: [archivo], title: titulo, text: titulo });
        return;
      } catch (e) { /* si cancela, se descarga igual */ }
    }
    const url = URL.createObjectURL(blob);
    const enlace = document.createElement("a");
    enlace.href = url;
    enlace.download = archivo.name;
    document.body.appendChild(enlace);
    enlace.click();
    enlace.remove();
    setTimeout(() => URL.revokeObjectURL(url), 4000);
  }

  function moduloPicks(s, lista, tandas, parcial) {
    const elegidos = new Map();   // clave del partido -> "v" | "l"
    try {
      const guardado = JSON.parse(leer(LLAVE_BORRADOR(s.n)) || "{}");
      Object.entries(guardado).forEach(([clave, lado]) => elegidos.set(clave, lado));
    } catch (e) { /* borrador ilegible: se empieza de cero */ }

    const caja = crear("div", "generador");
    caja.appendChild(crear("div", "rot", "Tus picks · semana " + s.n));
    caja.appendChild(crear("h3", null, "Arma tu quiniela y mándala"));
    const explica = crear("p", "pie-gen");
    explica.textContent = (parcial ? "Son los que el organizador todavía no reparte. " : "") +
      "Elige los que quieras y manda la imagen al organizador: aquí no se registra nada.";
    caja.appendChild(explica);

    // A nombre de quién va la imagen ya lo dice la barra de arriba; solo se
    // pide el nombre si falta.
    if (jugador === null) {
      caja.appendChild(crear("div", "quien-soy", "Elige tu nombre arriba para que la imagen lo lleve."));
    }
    if ((tandas || []).length === 1) caja.classList.add("una-tanda");

    const porClave = new Map((lista || []).map((p) => [p.v + "@" + p.l, p]));
    const ahora = Date.now();

    (tandas || []).forEach((tanda) => {
      const bloque = crear("div", "tanda");
      const cab = crear("div", "cab");
      const cuantos = tanda.claves.length;
      cab.appendChild(crear("span", null, cuantos === 1 ? "1 partido" : cuantos + " partidos"));
      const cierra = new Date(tanda.cierre);
      const vencida = cierra.getTime() < ahora;
      cab.appendChild(crear("em", vencida ? "vencida" : null,
        vencida ? "cerró el " + tanda.cierre_texto : "hasta el " + tanda.cierre_texto));
      bloque.appendChild(cab);

      tanda.claves.forEach((clave) => {
        const p = porClave.get(clave);
        if (!p) return;
        const fila = crear("div", "duelo-pick");
        [["v", p.v], ["l", p.l]].forEach(([lado, eq], i) => {
          const boton = crear("button", "opcion");
          boton.type = "button";
          const color = (D.colores[eq] || {}).local;
          if (color) boton.style.setProperty("--c", color);
          boton.setAttribute("aria-pressed", String(elegidos.get(clave) === lado));
          boton.appendChild(crear("span", "sig", D.siglas[eq] || eq.slice(0, 3).toUpperCase()));
          boton.appendChild(crear("span", "nom", eq));
          boton.addEventListener("click", () => {
            if (elegidos.get(clave) === lado) elegidos.delete(clave);
            else elegidos.set(clave, lado);
            fila.querySelectorAll(".opcion").forEach((otro, n) => {
              otro.setAttribute("aria-pressed",
                String(elegidos.get(clave) === (n === 0 ? "v" : "l")));
            });
            guardar(LLAVE_BORRADOR(s.n), JSON.stringify(Object.fromEntries(elegidos)));
            refrescar();
          });
          if (i === 1) fila.appendChild(crear("span", "vs", "@"));
          fila.appendChild(boton);
        });
        bloque.appendChild(fila);
      });
      caja.appendChild(bloque);
    });

    const acciones = crear("div", "acciones-gen");
    const avance = crear("i", "avance");
    acciones.appendChild(avance);
    const cuenta = crear("span", "cuenta");
    const descargar = crear("button", "boton", "Generar imagen");
    descargar.type = "button";
    const limpiar = crear("button", "boton suave", "Borrar");
    limpiar.type = "button";
    acciones.appendChild(cuenta);
    acciones.appendChild(limpiar);
    acciones.appendChild(descargar);
    caja.appendChild(acciones);

    const nota = crear("p", "aviso-gen");
    nota.innerHTML = "Al generarla se abre compartir o se descarga. " +
      'Mándala a <a href="mailto:' + D.correo + '?subject=' +
      encodeURIComponent("Picks semana " + s.n + (jugador !== null ? " · " + nombre(jugador) : "")) +
      '">' + D.correo + "</a>.";
    caja.appendChild(nota);

    function refrescar() {
      // Solo cuentan los de este generador: el borrador guardado puede traer
      // picks de partidos que ya no se ofrecen (una tanda que ya se cargó).
      const n = [...elegidos.keys()].filter((clave) => porClave.has(clave)).length;
      cuenta.textContent = n === 0 ? "Ninguno elegido" : n + " de " + porClave.size;
      if (n) cuenta.appendChild(crear("small", null, " elegidos"));
      descargar.disabled = n === 0;
      limpiar.disabled = n === 0;
      // Con al menos uno, la barra de abajo se queda a la vista mientras bajas.
      caja.classList.toggle("con-picks", n > 0);
      avance.style.width = (porClave.size ? (100 * n) / porClave.size : 0) + "%";
    }
    limpiar.addEventListener("click", () => {
      elegidos.clear();
      guardar(LLAVE_BORRADOR(s.n), null);
      caja.querySelectorAll(".opcion").forEach((b) => b.setAttribute("aria-pressed", "false"));
      refrescar();
    });
    descargar.addEventListener("click", async () => {
      descargar.disabled = true;
      const antes = descargar.textContent;
      descargar.textContent = "Generando…";
      try {
        await exportarPicks(s, elegidos, porClave);
      } finally {
        descargar.textContent = antes;
        refrescar();
      }
    });
    refrescar();
    return caja;
  }

  function aviso(titulo, texto) {
    const n = crear("div", "aviso");
    n.appendChild(crear("strong", null, titulo));
    n.appendChild(document.createTextNode(texto));
    return n;
  }

  /* ═══ premios ═══ */
  function pintarPremios() {
