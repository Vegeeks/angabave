<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="author" content="{{ desarrollador }}">
<meta name="version" content="{{ etapa }} {{ version }}">
<meta name="description" content="{{ marca }} · Quiniela NFL {{ anio }}: tabla general, ganadores por semana, premios, marcador en vivo y los picks de todos.">
<meta name="theme-color" content="{{ tema_campo['--bg']|lower }}">
<link rel="icon" href="{{ favicon }}">
<link rel="manifest" href="manifest.webmanifest">
<link rel="apple-touch-icon" href="icono-180.png">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content="{{ marca }}">
<meta property="og:type" content="website">
<meta property="og:site_name" content="{{ marca }}">
<meta property="og:url" content="{{ sitio }}">
<meta property="og:title" content="{{ marca }} · Quiniela NFL {{ anio }}">
<meta property="og:description" content="{{ descripcion }}">
<meta property="og:image" content="{{ sitio }}portada.png?v={{ firma }}">
<meta property="og:image:type" content="image/png">
<meta property="og:image:width" content="{{ tamano_portada[0] }}">
<meta property="og:image:height" content="{{ tamano_portada[1] }}">
<meta name="twitter:card" content="summary_large_image">
<title>{{ marca }} · Quiniela NFL {{ anio }}</title>
{#- Antes de pintar nada: qué vista se esconde mientras corre el script, tu equipo y si
    es la primera vez. En JavaScript viejo, como la red de seguridad: si el script
    principal revienta, DOMContentLoaded igual destapa la General. El touchstart vacío
    es para que Safari pinte :active al instante. #}
<script>
(function(){var r=document.documentElement;r.className='js';try{if(navigator.standalone===true||matchMedia('(display-mode: standalone)').matches)r.classList.add('instalada')}catch(e){}try{var t=localStorage.getItem('angabave.tema');if(t){r.style.cssText=t;var c=document.querySelector('meta[name="theme-color"]'),m=t.match(/--bg:([^;]+)/);if(c&&m)c.setAttribute('content',m[1])}if(!sessionStorage.getItem('angabave.estreno')&&!matchMedia('(prefers-reduced-motion: reduce)').matches){r.className+=' estreno';window.campoRescate=setTimeout(function(){r.classList.remove('estreno')},6000)}}catch(e){}document.addEventListener('DOMContentLoaded',function(){r.classList.add('listo')});document.addEventListener('touchstart',function(){},{passive:true})})();
try{var g=JSON.parse(localStorage.getItem('angabave.campo')||'null');if(g&&g.v===2){window.campoGuardado=g;if(g.e)document.documentElement.setAttribute('data-campo',g.e)}}catch(e){}
</script>
<style>
{% if tipografia %}
/* Cifras de marcador: solo números y sus signos. Lo que el recorte no trae (º, –, −)
   y cualquier letra cae a la letra del sistema. */
@font-face{font-family:'Rotulo'; font-style:normal; font-weight:500 700; font-display:swap;
  src:url(data:font/woff2;base64,{{ tipografia }}) format('woff2');
  unicode-range:U+30-39,U+24,U+25,U+2B-2F,U+3A}
{% endif %}
:root{
  /* El tema sin equipo sale de render_html.tema_campo(), verificado como los de
     cada equipo: ningún color de texto se pone a mano. */
  {% for nombre, valor in tema_campo.items() %}{{ nombre }}:{{ valor }}; {% endfor %}
  /* Un color, un trabajo. --oro: dinero y la línea amarilla. --acento: tú y lo que se
     toca. --txt: cifras y lugares. --verde y --rojo: solo resultados. */
  --oro:#ffd60a; --plata:#c9d2db; --bronce:#d8935c;
  --verde:#34d680; --rojo:#ff6b61; --vivo:#ff453a;
  --pastilla:#f3f6f4; --pastilla-txt:#0a0f0c;
  /* Seis tamaños de letra y ninguno más. El mínimo son 12 px. */
  --t1:clamp(2.75rem,12.8vw,4.5rem); --t2:1.75rem; --t3:1.25rem; --t4:1rem; --t5:.875rem; --t6:.75rem;
  /* Tres radios y el círculo; aparte, la hoja (20 px) y la barra de abajo (26 px).
     Espacios de 4, 8, 12, 16, 24 y 32 px: 32 entre secciones, 8 de título a contenido. */
  --r1:16px; --r2:12px; --r3:8px;
  --cuerpo:-apple-system,BlinkMacSystemFont,'SF Pro Text','Segoe UI Variable Text','Segoe UI',Roboto,'Helvetica Neue',Arial,sans-serif;
  /* Sus cifras son proporcionales: toda columna numérica se alinea a la derecha. */
  --num:'Rotulo',var(--cuerpo);
  /* Un solo idioma de movimiento. --sale para lo que entra, --entra para lo que se va,
     --traza para líneas y barras que se dibujan, --hoja para superficies y --rebote (8 %)
     solo para piezas de hasta 44 px: nada grande rebota. Duraciones: toque 70 ms, salida
     100, cambio chico 240, entrada 360. Escalonado de 36 ms y máximo 5 pasos. */
  --sale:cubic-bezier(.16,1,.3,1); --entra:cubic-bezier(.4,0,1,1); --traza:cubic-bezier(.65,0,.35,1);
  --hoja:cubic-bezier(.32,.72,0,1); --rebote:cubic-bezier(.34,1.3,.64,1);
  --alto-pie:calc(84px + env(safe-area-inset-bottom));
  --alto-encabezado:64px; --alto-marca:56px;
}
/* Un rebote de verdad donde el navegador lo sabe hacer. */
@supports (transition-timing-function:linear(0,1)){
  :root{--rebote:linear(0,.064,.216,.403,.589,.753,.883,.978,1.038,1.071,1.083,1.08,1.069,1.054,1.038,1.024,1.012,1.004,.998,.995,.993,.993,.994,.995,1)}
}
*,*::before,*::after{box-sizing:border-box; -webkit-tap-highlight-color:transparent; min-width:0}
html{-webkit-text-size-adjust:100%; background:var(--bg); transition:background-color .45s ease}
/* El fondo va en html: en body taparía el campo, que vive detrás de todo. */
body{margin:0; color:var(--txt); overflow-x:hidden; font-family:var(--cuerpo);
  font-size:var(--t4); line-height:1.45; -webkit-font-smoothing:antialiased}
h1,h2,h3,p{margin:0}
button{font:inherit; color:inherit; background:none; border:0; padding:0; cursor:pointer; touch-action:manipulation}
input,select{font:inherit; font-size:var(--t4)}
i,em{font-style:normal}
.oculto{display:none !important}
.env{max-width:1120px; margin:0 auto; padding-inline:max(16px,env(safe-area-inset-left))}
:focus-visible{outline:2px solid var(--acento); outline-offset:2px; border-radius:var(--r3)}
/* Mientras el script no decide la vista no se pinta ninguna: ni la General de paso a
   Hoy ni el "?" del botón. Sin script .js no llega, y si revienta DOMContentLoaded
   igual pone .listo: en los dos casos la General queda a la vista. */
.js:not(.listo) main>.vista,.js:not(.listo) footer{display:none}
.js:not(.listo) .fila-yo{min-height:64px}
.js:not(.listo) .identidad .ini{color:transparent}
/* Las cifras de marcador. Nunca en nombres ni en frases. */
.juego-fila .mrc,.pts,.err,.sem,.c-pos .n,.medalla,.lugar .puntos,.lugar .bolsa,.fila-gan .monto,.bolsa-final .val,.campeon .bolsa,
.cifras .cifra b,.mi-barra .linea b,.mi-barra .linea .rango,.mi-semana .fila .rango,.leyenda b,.celda-semana b,.duelo .cara .t,
.detalle-partido .marcador,.candidato .n,.candidato .pct,.barras .col small.cima,.lugar-premio b,.acciones-gen .cuenta{
  font-family:var(--num); font-weight:600; letter-spacing:0}

/* ═══════ el campo ═══════
   Una toma de transmisión hecha de polígonos ya en perspectiva (quiniela/campo.py).
   Vive arriba de la línea amarilla y se va con la página: quieto no anima nada, no pide
   capas y no gasta. Debajo de la línea solo hay --bg.
   --u es un píxel del diseño de 390; --ancla, donde termina el encabezado. */
:root{--u:min(calc(100vw / 390),1px); --ancla:56px; --alto-campo:210px}
.cancha{position:absolute; inset:0 0 auto 0; height:var(--alto-campo); z-index:-1; overflow:hidden; pointer-events:none; background:var(--bg)}
.cancha svg{display:block; overflow:visible}
.cancha .plano,.cancha .luz{position:absolute}
.cp-fuera{fill:var(--bg)}
.campo-aro{position:absolute; width:44px; height:44px; margin:-22px 0 0 -22px; border-radius:50%; border:2px solid #fff; opacity:0; pointer-events:none;
  animation:campo-aro 1.5s var(--sale) 3}
.campo-aro::before{content:""; position:absolute; inset:15px; border-radius:50%; background:#fff}
@keyframes campo-aro{0%{opacity:.9; transform:scale(.35)}100%{opacity:0; transform:scale(1.6)}}
.revelado{position:fixed; inset:0; z-index:95; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:16px; overflow:hidden;
  padding:max(56px,env(safe-area-inset-top)) 16px max(20px,env(safe-area-inset-bottom)); background:rgba(6,10,8,.96); animation:aparece .2s ease backwards}
.revelado::before,.revelado::after{content:""; position:absolute; top:-18%; width:70%; height:75%; pointer-events:none; opacity:0;
  background:radial-gradient(closest-side,rgba(233,245,238,.2),transparent); animation:revelado-luz 1.1s ease .1s forwards}
.revelado::before{left:-20%} .revelado::after{right:-20%}
@keyframes revelado-luz{0%{opacity:0}35%{opacity:1}60%{opacity:.45}100%{opacity:.7}}
.revelado-estado{position:relative; font-size:var(--t4); font-weight:700; color:var(--txt); text-align:center}
.revelado-estado::after{content:""; display:block; height:2px; margin-top:10px; background:var(--oro); transform-origin:0 50%; animation:revelado-carga .9s ease-in-out 4}
.revelado.listo .revelado-estado::after{animation:none; opacity:0}
@keyframes revelado-carga{from{transform:scaleX(0)}to{transform:scaleX(1)}}
.revelado-marco{position:relative; width:min(420px,100%); border-radius:var(--r1); overflow:hidden; box-shadow:0 30px 80px rgba(0,0,0,.6)}
.revelado-marco img{display:block; width:100%; height:auto; max-height:64vh; object-fit:contain; background:#060a08}
.revelado.listo .revelado-marco{animation:revelado-escaneo .9s var(--sale) backwards}
@keyframes revelado-escaneo{from{clip-path:inset(0 0 100% 0); transform:translateY(24px) scale(.96)}to{clip-path:inset(0); transform:none}}
.revelado-marco::after{content:""; position:absolute; inset:0; pointer-events:none; transform:translateX(-130%);
  background:linear-gradient(105deg,transparent 35%,rgba(255,255,255,.32) 50%,transparent 65%)}
.revelado.listo .revelado-marco::after{animation:revelado-brillo .8s ease .85s backwards}
@keyframes revelado-brillo{to{transform:translateX(130%)}}
.revelado-acciones{display:flex; gap:12px; width:min(420px,100%)}
.revelado-mandar{flex:1; min-height:52px; border-radius:var(--r2); background:#f3f6f4; color:#060a08; font-size:var(--t4); font-weight:800}
.revelado-cerrar{position:absolute; top:max(8px,env(safe-area-inset-top)); right:8px; width:44px; height:44px; border-radius:50%; font-size:var(--t3); color:var(--tenue)}
.revelado-pieza{position:absolute; top:-16px; width:9px; height:15px; border-radius:2px; animation:revelado-cae 1.5s cubic-bezier(.2,.6,.4,1) backwards}
@keyframes revelado-cae{from{transform:none; opacity:1}to{transform:translate(var(--dx),110vh) rotate(var(--giro)); opacity:.85}}
@media (prefers-reduced-motion:reduce){.revelado,.revelado::before,.revelado::after,.revelado-marco,.revelado-marco::after,.revelado-estado::after{animation:none}
  .revelado::before,.revelado::after{opacity:.6}}
html[data-campo=gano] .cp-palabra{fill:url(#cp-oro)}
html[data-campo=perdio] .cp-palabra{fill:none; stroke:var(--txt); stroke-width:1.5; stroke-opacity:.65; vector-effect:non-scaling-stroke}
html[data-campo=juega] .cp-palabra{fill:#F3F6F4}
.cp-zona{fill:var(--zona)} .cp-palabra{fill:var(--letra)} .cp-raya{fill:var(--letra); opacity:.42}
.cp-pilon{fill:#ff7a18} .cp-foco{fill:#fff}
.cancha .vuelo{display:none; position:absolute; left:calc(50% + var(--dx)); top:calc(var(--ancla) + var(--dy)); width:0; height:0; transform-origin:0 0}
.vuelo svg{position:absolute; max-width:none}
.cp-v-franja{fill:#fff; opacity:.05}
{{ campo_css|safe }}
/* La llegada, una vez por visita: la cámara arranca arriba de la zona de anotación con el estadio
   apagado, prenden las luces y baja hasta su lugar. Solo transform y opacity. Al final el pasto en
   movimiento se cruza con la toma quieta, que cae encima porque es la misma cámara. Mientras
   la página se arma todo espera a oscuras; .llegando es la señal de salida. */
.estreno .cancha{height:100vh}
.estreno .cancha::after{content:""; position:absolute; left:0; right:0; top:var(--alto-campo); height:100vh; background:var(--bg); opacity:0}
.llegando .cancha::after{animation:aparece .55s ease 1.3s forwards}
.estreno .cancha .plano{visibility:hidden}
.estreno .cancha .luz,.estreno .top,.estreno .fila-yo,.estreno .vista,.estreno .navegacion.al-pie{opacity:0}
.estreno .cancha .vuelo{display:block; opacity:.08; transform:perspective(var(--ini-f)) translateZ(var(--ini-f)) rotateX(var(--ini-rx)) rotateZ(var(--ini-rz)) translate3d(var(--ini-x),var(--ini-y),var(--ini-z))}
.llegando .cancha .vuelo{animation:cp-camara 2.2s cubic-bezier(.45,0,.12,1) both,cp-vuelo-luz 2.2s linear both}
.llegando .cancha .plano{animation:cp-espera 2.2s step-end both}
.llegando .cancha .luz{opacity:1; animation:cp-prende 2.2s linear both}
.llegando .top,.llegando .fila-yo{opacity:1; animation:aparece .5s ease 1.25s backwards}
.llegando .navegacion.al-pie{opacity:1; animation:nav-sube .46s var(--sale) 1.35s backwards}
.llegando .vista{opacity:1; animation:aparece .55s ease 1.3s backwards}
.estreno .vista .saludo::after{animation-delay:1.35s}
.estreno .vista .saludo .palabra>i{animation-delay:calc(var(--k) * 65ms + 1.3s)}
.estreno .vista .saludo .fecha,.estreno .vista .saludo p{animation-delay:1.45s}
@media (min-width:900px){.llegando .cancha .luz{animation-name:cp-prende-tarde}}
/* La carrera de un touchdown: un avance de la cámara sobre el mismo dibujo. La sombra detrás
   del texto ya viene pintada, así que el texto se sigue leyendo mientras corre. */
.cancha.corre .plano{animation:cp-carrera 1.4s; transform-origin:var(--fuga-x) var(--fuga-y)}
.cancha.corre .luz{animation:cp-destello 1.4s ease-out}
@keyframes cp-carrera{
  0%{animation-timing-function:cubic-bezier(.2,.75,.3,1)}
  30%{transform:matrix3d(1,0,0,0,0,1,0,var(--carrera),0,0,1,0,0,0,0,1); animation-timing-function:cubic-bezier(.55,0,.2,1)}
}
@keyframes cp-destello{0%,100%{opacity:1} 10%{opacity:.3} 28%{opacity:1}}
@keyframes cp-camara{
  from{transform:perspective(var(--ini-f)) translateZ(var(--ini-f)) rotateX(var(--ini-rx)) rotateZ(var(--ini-rz)) translate3d(var(--ini-x),var(--ini-y),var(--ini-z))}
  to{transform:perspective(var(--fin-f)) translateZ(var(--fin-f)) rotateX(var(--fin-rx)) rotateZ(var(--fin-rz)) translate3d(var(--fin-x),var(--fin-y),var(--fin-z))}
}
@keyframes cp-vuelo-luz{0%,5%{opacity:.08} 7%{opacity:.62} 11%{opacity:.3} 14%{opacity:.85} 18%{opacity:.6} 26%,74%{opacity:1} 92%,100%{opacity:0}}
@keyframes cp-espera{0%{visibility:hidden} 74%,100%{visibility:visible}}
@keyframes cp-prende{0%,5%{opacity:0} 7%{opacity:.9} 11%{opacity:.25} 14%{opacity:1} 18%{opacity:.7} 26%,100%{opacity:1}}
@keyframes cp-prende-tarde{0%,45%{opacity:0} 47%{opacity:.9} 50%{opacity:.3} 53%{opacity:1} 100%{opacity:1}}

/* ═══════ encabezado ═══════
   La fila de la marca se va con la página y queda solo tu avance: lo que está fijo
   arriba y abajo no llega a 15% de la pantalla. */
header{position:sticky; top:calc(-1 * var(--alto-marca)); z-index:60; padding-top:env(safe-area-inset-top);
  view-transition-name:cabeza}
header::before{content:""; position:absolute; inset:0; z-index:-1; background:var(--cristal); opacity:0;
  -webkit-backdrop-filter:blur(22px) saturate(170%); backdrop-filter:blur(22px) saturate(170%);
  border-bottom:1px solid rgba(255,255,255,.07); transition:opacity .24s ease}
header.plegado::before{opacity:1}
.top{display:flex; align-items:center; gap:12px; min-height:56px; transition:opacity .2s ease}
header.plegado .top{opacity:0; pointer-events:none}
.logo{display:inline-flex; align-items:center; gap:8px; min-height:44px; margin-right:auto}
.logo{color:var(--txt)}
.logo .marca-svg{width:32px; height:32px; flex:0 0 auto}
.logo .marca-palabra{width:100px; height:16px; flex:0 0 auto}
.logo .marca-linea{fill:var(--oro)}
.estado{display:none; align-items:center; gap:6px; font-size:var(--t6); font-weight:600; color:var(--tenue); white-space:nowrap}
.estado.vivo{color:var(--txt)}
.estado .punto{width:7px; height:7px; border-radius:50%; background:var(--tenue2)}
.estado.vivo .punto{background:var(--vivo)}
.estado.esperando .punto{background:var(--txt)}
@keyframes latir{0%,100%{opacity:1; transform:scale(1)} 50%{opacity:.35; transform:scale(.72)}}
.identidad{position:relative; display:inline-flex; align-items:center; justify-content:center; gap:8px;
  min-width:44px; min-height:44px; flex:0 0 auto}
.identidad .ini{width:36px; height:36px; border-radius:50%; display:grid; place-items:center; font-size:var(--t6); font-weight:700;
  background:var(--panel2); color:var(--tenue); transition:background .24s,color .24s,transform .28s var(--rebote)}
.identidad.puesta .ini{background:var(--pastilla); color:var(--pastilla-txt)}
.identidad:active .ini{transform:scale(.9); transition:transform .07s linear}
.identidad .txt{display:none; font-size:var(--t5); font-weight:600; color:var(--tenue)}

/* Tu avance, siempre a la vista. */
.fila-yo{padding-bottom:8px}
.mi-barra:empty{display:none}
.mi-barra-yo{position:relative; display:flex; align-items:center; width:100%; min-height:56px; overflow:hidden; text-align:left;
  background:var(--panel); border:1px solid var(--linea); border-radius:var(--r2); transition:transform .28s var(--sale)}
.mi-barra-yo::after{content:""; position:absolute; left:0; bottom:0; height:2px; width:var(--avance,0%); background:var(--oro)}
.mi-barra .celda{flex:1 1 0; display:flex; flex-direction:column; padding:4px 12px}
.mi-barra .celda + .celda{border-left:1px solid var(--linea)}
.mi-barra .rot{font-size:var(--t6); color:var(--tenue); white-space:nowrap; overflow:hidden; text-overflow:ellipsis}
.mi-barra .celda.vivo .rot{color:var(--txt); font-weight:600}
.mi-barra .celda.vivo .rot::before{content:""; display:inline-block; width:6px; height:6px; margin-right:4px; border-radius:50%;
  background:var(--vivo); vertical-align:.08em; animation:latir 1.6s ease-in-out infinite}
.mi-barra .linea{display:flex; align-items:baseline; gap:8px; line-height:1.2; white-space:nowrap; overflow:hidden}
.mi-barra .linea b{font-size:var(--t3)}
.mi-barra .linea .por{font-size:var(--t6); color:var(--tenue); font-variant-numeric:tabular-nums}
.mi-barra .linea .rango{font-size:var(--t3); color:var(--txt)}
.mi-barra .linea .mov{font-size:var(--t6); font-weight:700}
@media (max-width:350px){ .mi-barra .linea .mov,.mi-barra .linea .por{display:none} }
.mi-barra-invita{display:flex; align-items:center; gap:4px}
.mi-barra-invita .elegir{position:relative; flex:1 1 auto; display:flex; align-items:center; gap:12px; min-height:56px; padding:8px 8px 8px 16px;
  border-radius:var(--r2); cursor:pointer; background:var(--panel); border:1px solid var(--linea)}
.mi-barra-invita .txt{flex:1 1 auto; font-size:var(--t5); line-height:1.25}
.mi-barra-invita .cta{flex:0 0 auto; padding:8px 16px; border-radius:99px; font-size:var(--t5); font-weight:700;
  color:var(--pastilla-txt); background:var(--pastilla)}
.mi-barra-invita select{position:absolute; inset:0; width:100%; height:100%; opacity:0; cursor:pointer}
.mi-barra-invita .elegir:focus-within{outline:2px solid var(--acento); outline-offset:2px}
.mi-barra-invita .cerrar{flex:0 0 auto; width:44px; height:44px; border-radius:50%; font-size:var(--t3); line-height:1; color:var(--tenue)}

/* ═══════ la barra de abajo ═══════ */
.navegacion{position:relative; display:flex}
.navegacion button{position:relative; z-index:1; flex:1 1 0; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:2px;
  min-height:44px; color:var(--tenue); font-size:var(--t6); font-weight:600; transition:color .24s}
.navegacion svg{width:24px; height:24px; fill:none; stroke:currentColor; stroke-width:1.8; stroke-linecap:round; stroke-linejoin:round;
  transition:transform .28s var(--rebote)}
.navegacion svg .lleno{fill:currentColor; stroke:none}
.navegacion button[aria-selected="true"]{color:var(--acento)}
.navegacion button[aria-selected="true"] svg{transform:translateY(-1px) scale(1.08)}
.navegacion button:active svg{transform:scale(.86); transition:transform .07s linear}
.navegacion .indicador{position:absolute; z-index:0; left:0; top:6px; bottom:6px; width:0; border-radius:20px; pointer-events:none; opacity:0;
  background:rgba(255,255,255,.09)}
.navegacion .indicador.listo{opacity:1; transition:transform .3s var(--sale)}
.navegacion.al-pie{position:fixed; z-index:80; left:max(12px,env(safe-area-inset-left)); right:max(12px,env(safe-area-inset-right));
  bottom:max(10px,env(safe-area-inset-bottom)); height:64px; padding:0 6px; border-radius:26px;
  background:var(--cristal); border:1px solid rgba(255,255,255,.09);
  -webkit-backdrop-filter:blur(26px) saturate(180%); backdrop-filter:blur(26px) saturate(180%);
  box-shadow:0 12px 40px rgba(0,0,0,.45); view-transition-name:pie}
.navegacion.en-cabeza{display:none}
.hay-vivo .navegacion button[data-vista="hoy"]::after{content:""; position:absolute; top:7px; left:calc(50% + 5px); width:12px; height:12px; border-radius:50%;
  background:var(--vivo); background-clip:padding-box; border:2px solid var(--bg); animation:latir 1.6s ease-in-out infinite}
body{padding-bottom:var(--alto-pie)}
/* En la pestaña de Safari la barra flotante deja asomar renglones entre ella y la
   del navegador: ahí va de orilla a orilla, opaca y pegada abajo. */
@media (max-width:899px){
  html:not(.instalada){--alto-pie:calc(56px + env(safe-area-inset-bottom))}
  html:not(.instalada) .navegacion.al-pie{left:0; right:0; bottom:0; height:calc(56px + env(safe-area-inset-bottom));
    padding:0 max(6px,env(safe-area-inset-right)) env(safe-area-inset-bottom) max(6px,env(safe-area-inset-left));
    border-radius:2px; border-width:1px 0 0; border-color:var(--linea); background:var(--bg);
    -webkit-backdrop-filter:none; backdrop-filter:none; box-shadow:none}
  html:not(.instalada) .navegacion.al-pie .indicador{top:4px; bottom:4px; border-radius:var(--r2)}
  html:not(.instalada) .navegacion.al-pie button{gap:0}
  html:not(.instalada) .navegacion.al-pie svg{width:22px; height:22px}
  html:not(.instalada) .acciones-gen{bottom:calc(var(--alto-pie) + 8px)}
}

/* ═══════ las vistas ═══════ */
main{view-transition-name:contenido; min-height:60vh}
.vista{padding-top:calc(4px + 40 * var(--u))}
/* Solo se anima lo que acaba de entrar: redibujar no vuelve a lanzar nada. Las entradas
   llenan hacia atrás, no hacia adelante: al terminar sueltan su capa. */
@keyframes sube{from{opacity:0; transform:translate3d(0,12px,0)}}
@keyframes aparece{from{opacity:0} to{opacity:1}}
.anima .tarjeta,.anima .podio,.anima .campeon,.anima .mi-semana,.anima .aviso-picks,.anima .cabeza-semana,.anima .perfil{
  animation:sube .36s var(--sale) backwards; animation-delay:calc(min(var(--n,0),5) * 36ms + 60ms)}
.anima .tabs{animation:aparece .24s ease backwards .06s}
.panel-entra{animation:panel-entra .26s var(--sale) backwards}
@keyframes panel-entra{from{opacity:0; transform:translate3d(calc(var(--lado,1) * 14px),0,0)}}
/* Lo de más abajo se asoma una sola vez, al salir de detrás de la barra. */
@keyframes revela{from{opacity:.3; transform:translate3d(0,16px,0)}}
.vista .revela{animation:revela .36s var(--sale) backwards}

/* El titular de cada sección, a lo grande. */
.saludo{padding:12px 0 0; margin-bottom:24px}
/* La línea amarilla de primera y diez, de orilla a orilla: el sello del portal. */
.saludo::after{content:""; display:block; width:100vw; height:2px; margin:16px 0 0 calc(50% - 50vw); background:var(--oro);
  transform-origin:0 50%}
.anima .saludo::after{animation:traza .56s var(--traza) backwards .12s}
/* Las vistas sin titular también tienen su línea: en Semana es el avance de la semana. */
.frontera{height:2px; width:100vw; margin:18px 0 18px calc(50% - 50vw); background:var(--oro); transform-origin:0 50%}
.anima .frontera{animation:traza .56s var(--traza) backwards .12s}
.cabeza-semana .avance-semana{width:100vw; max-width:none; height:2px; margin:14px 0 10px calc(50% - 50vw); border-radius:2px; background:color-mix(in srgb,var(--oro) 26%,var(--bg))}
.cabeza-semana .avance-semana i{border-radius:2px}
.saludo .fecha{font-size:var(--t5); color:var(--sobre-campo); font-weight:500}
.saludo h1{font-size:var(--t1); line-height:1; font-weight:700; letter-spacing:-.03em; margin:4px 0 8px}
.saludo .palabra{display:inline-block; overflow:hidden; vertical-align:top; padding:.04em .02em .12em 0; margin-bottom:-.12em}
.saludo .palabra>i{display:inline-block}
.anima .saludo .palabra>i{animation:asoma .46s var(--sale) backwards; animation-delay:calc(var(--k) * 36ms + 30ms)}
@keyframes asoma{from{transform:translateY(112%)}}
.anima .saludo .fecha,.anima .saludo p{animation:aparece .3s ease backwards .12s}
.saludo p{font-size:var(--t4); line-height:1.4; color:var(--sobre-campo); max-width:36em}
.saludo p b{color:var(--txt); font-weight:600}
.saludo .cuenta{color:var(--txt); font-weight:600; white-space:nowrap}
.saludo .dia-libre{margin-top:8px}

.titulo{display:flex; align-items:baseline; justify-content:space-between; gap:12px; margin:32px 0 8px}
.titulo h2{font-size:var(--t3); font-weight:700; letter-spacing:-.03em}
.titulo .nota{font-size:var(--t5); color:var(--tenue); text-align:right}
.rotulo{font-size:var(--t5); color:var(--tenue); font-weight:500}

/* ═══════ superficies ═══════
   Piso plano y filas separadas por una línea. Caja solo para lo que se toca o pide una
   acción. */
.tarjeta{position:relative; margin-bottom:32px}
.tarjeta .cab{display:flex; align-items:center; gap:8px; margin-bottom:8px; min-height:24px}
.tarjeta .cab h3{font-size:var(--t3); font-weight:700; letter-spacing:-.03em}
.tarjeta .nota{margin:0 0 12px; color:var(--tenue); font-size:var(--t5); line-height:1.4}
.tarjeta.tus-picks:not(.completa){padding:16px; border-radius:var(--r1); background:var(--panel); border:1px solid var(--linea)}
.enlace,.enlace-titulo{display:inline-flex; align-items:center; min-height:44px; margin-block:-10px; margin-left:auto; padding-inline:4px;
  font-size:var(--t5); font-weight:600; color:var(--acento); white-space:nowrap}
.volver-actual{display:inline-flex; align-items:center; min-height:44px; margin-block:-10px; font-size:var(--t5); font-weight:600; color:var(--acento)}
.enlace:active,.enlace-titulo:active,.volver-actual:active,.regreso:active{opacity:.6}
.punto{display:inline-block; width:7px; height:7px; border-radius:50%; background:currentColor; flex:0 0 auto}
.tarjeta .cab .punto{color:var(--vivo); animation:latir 1.6s ease-in-out infinite}
.cuenta-regresiva{margin-left:auto; font-size:var(--t5); font-weight:600; color:var(--txt); white-space:nowrap; font-variant-numeric:tabular-nums}
.boton-principal{display:block; width:100%; min-height:48px; border-radius:var(--r2); font-weight:700; font-size:var(--t4);
  color:var(--pastilla-txt); background:var(--pastilla); transition:transform .28s var(--sale),opacity .2s}
.boton{min-height:44px; padding:0 16px; border-radius:var(--r2); font-size:var(--t5); font-weight:700; white-space:nowrap;
  background:var(--pastilla); color:var(--pastilla-txt); transition:transform .28s var(--sale),opacity .2s}
.boton:disabled{opacity:.35}
/* El tacto: se hunde al instante y regresa con calma. */
.boton-principal:active,.boton:active,.juego-fila:active,.aviso-picks:active,.opcion:active,.celda-semana:active,.mi-barra-yo:active,
.mi-fila:active,.ver-todas:active,.nota-chance:active{transform:scale(.985); transition:transform .07s linear}
.juego-fila.quieto:active{transform:none}
.aviso{padding:16px 0; border-top:1px solid var(--linea); color:var(--tenue); font-size:var(--t5)}
.aviso strong{display:block; color:var(--txt); font-size:var(--t4); margin-bottom:4px}
.rezago{display:flex; align-items:flex-start; gap:8px; margin-bottom:16px; padding-block:12px;
  font-size:var(--t5); line-height:1.35; color:var(--tenue); border-block:1px solid var(--linea)}
.rezago b{color:var(--txt); font-weight:600}
.rezago .icono{color:var(--txt); flex:0 0 auto}

/* ═══════ los partidos ═══════ */
.bloque-hora{display:flex; align-items:baseline; gap:8px; margin:24px 0 0}
.bloque-hora:first-child{margin-top:0}
.bloque-hora span{font-size:var(--t5); font-weight:600; color:var(--tenue)}
.bloque-hora em{margin-left:auto; font-size:var(--t6); color:var(--tenue2)}
.bloque-hora.seccion{margin:32px 0 0}
.bloque-hora.seccion:first-child{margin-top:0}
.bloque-hora.seccion span{font-size:var(--t3); font-weight:700; letter-spacing:-.03em; color:var(--txt)}
.tarjeta.lista-juegos{margin-bottom:0}
.subgrupo{font-size:var(--t5); font-weight:600; color:var(--tenue); margin:16px 0 0}
.tarjeta .cab + .subgrupo{margin-top:0}
.frescura{display:flex; align-items:center; justify-content:space-between; gap:12px; margin:-4px 0 8px; font-size:var(--t6); color:var(--tenue)}
.frescura.sin-senal .frescura-texto{color:var(--rojo)}
.frescura-boton{min-height:44px; padding:0 12px; font-size:var(--t6); font-weight:600; color:var(--acento)}
.frescura-boton[hidden]{display:none}
.partidos-hoy.envivo .subgrupo:first-of-type{color:var(--txt)}
/* Un partido, siempre igual: equipos a la izquierda, marcador en su columna y a la
   derecha la hora y tu pick, de ancho fijo para que los números queden alineados. */
.juego-fila{position:relative; display:grid; grid-template-columns:minmax(0,1fr) 5.75rem; align-items:center; column-gap:12px; width:100%;
  padding:12px 0; text-align:left; border-top:1px solid var(--linea); transition:transform .28s var(--sale)}
.juego-fila:first-child,.tarjeta .cab + .juego-fila,.subgrupo + .juego-fila,.bloque-hora + .juego-fila{padding-top:8px; border-top:0}
.juego-fila .lados{display:grid; gap:8px}
.juego-fila .eq-fila{display:grid; grid-template-columns:2.625rem minmax(0,1fr) 2.2rem; align-items:center; column-gap:8px; color:var(--tenue)}
.sig{display:inline-grid; place-items:center; height:24px; border-radius:var(--r3); font-size:var(--t6); font-weight:700; letter-spacing:.01em;
  background:var(--panel3); color:var(--txt); font-style:normal}
.juego-fila .eq{font-size:var(--t4); font-weight:500; white-space:nowrap; overflow:hidden; text-overflow:ellipsis}
.juego-fila .mrc{font-size:var(--t3); line-height:1.2; text-align:right; color:var(--tenue)}
.juego-fila .eq-fila.adelante .eq{color:var(--txt); font-weight:600}
.juego-fila .eq-fila.adelante .mrc{color:var(--txt)}
.juego-fila .meta{display:flex; flex-direction:column; align-items:flex-end; gap:4px; text-align:right}
.juego-fila .cuando{font-size:var(--t5); font-weight:600; font-variant-numeric:tabular-nums; line-height:1.2}
.juego-fila .consenso{font-size:var(--t6); color:var(--tenue2); white-space:nowrap}
.juego-fila .fila-palabras{font-size:var(--t6); font-weight:600; line-height:1.25; color:var(--tenue); text-wrap:balance}
.juego-fila .fila-palabras.bien{color:var(--verde)}
.juego-fila .fila-palabras.mal{color:var(--rojo)}
/* Tu equipo: nombre en negritas y un anillo en su sigla, con el color de cómo vas. */
.juego-fila .fila-mi-pick{--fila-estado:var(--txt); color:var(--txt)}
.juego-fila .fila-mi-pick.fila-bien{--fila-estado:var(--verde)}
.juego-fila .fila-mi-pick.fila-mal{--fila-estado:var(--rojo)}
.juego-fila .fila-mi-pick .eq{font-weight:700; color:var(--txt)}
.juego-fila .fila-mi-pick .sig{outline:2px solid var(--fila-estado); outline-offset:2px}
.juego-fila .fila-con-marca{display:flex; align-items:baseline; gap:4px}
.juego-fila .fila-nombre{min-width:0; overflow:hidden; text-overflow:ellipsis}
.juego-fila .fila-marca{flex:0 0 auto; font-size:var(--t6); color:var(--fila-estado)}
.juego-fila.quieto{cursor:default; padding-block:4px}
/* Cuando alguien anota: una ola del color del equipo y el "+7" que sube. */
.juego-fila.anoto::before{content:""; position:absolute; inset:0 -16px; pointer-events:none; opacity:0;
  background:linear-gradient(90deg,transparent,var(--c,var(--verde)),transparent); animation:ola 1.5s var(--sale)}
@keyframes ola{0%{opacity:0; transform:translateX(-60%)} 25%{opacity:.22} 100%{opacity:0; transform:translateX(60%)}}
.mas{position:absolute; right:calc(5.75rem + 12px + 2.4rem); font-size:var(--t5); font-weight:800; color:var(--verde); pointer-events:none;
  animation:mas 1.8s var(--sale) both}
@keyframes mas{0%{opacity:0; transform:translateY(8px) scale(.8)} 15%{opacity:1; transform:none} 70%{opacity:1} 100%{opacity:0; transform:translateY(-16px)}}
.rodillo{display:inline-block; height:1.1em; line-height:1.1; overflow:hidden; vertical-align:bottom}
.rodillo>span{display:block; animation:rueda .56s var(--rebote) both}
.rodillo i{display:block}
@keyframes rueda{from{transform:translateY(0)} to{transform:translateY(-50%)}}

/* ═══════ tu semana: un drive, partido por partido ═══════ */
.progreso-semana{display:flex; gap:2px}
.progreso-semana i{flex:1 1 0; height:8px; border-radius:2px; background:var(--panel3)}
.progreso-semana .ok{background:var(--verde)}
.progreso-semana .mal{background:transparent; box-shadow:inset 0 0 0 1.5px var(--rojo)}
/* En juego todavía puede cambiar: el mismo lleno o hueco, a media luz. */
.progreso-semana .gana{background:var(--verde); opacity:.6}
.progreso-semana .pierde{background:transparent; box-shadow:inset 0 0 0 1.5px var(--rojo); opacity:.6}
.progreso-semana .juega{background:var(--tenue2)}
.anima .progreso-semana i{animation:brota .36s var(--rebote) backwards; animation-delay:calc(var(--k) * 12ms + 120ms)}
@keyframes brota{from{transform:scaleY(.1); opacity:0}}
.leyenda{display:flex; flex-wrap:wrap; gap:4px 12px; margin-top:8px; font-size:var(--t5); color:var(--tenue)}
.leyenda b{font-size:var(--t4); color:var(--txt)}
.leyenda .ok b{color:var(--verde)} .leyenda .mal b{color:var(--rojo)}
.nota-chance{display:block; width:100%; min-height:44px; margin-top:12px; padding-top:12px; text-align:left; font-size:var(--t5); line-height:1.4; color:var(--tenue);
  border-top:1px solid var(--linea); transition:transform .28s var(--sale)}
.nota-chance b{color:var(--acento); font-weight:600}
.mi-semana{margin-bottom:16px}
.mi-semana .fila{display:flex; align-items:baseline; gap:8px; margin-bottom:8px}
.mi-semana .fila b{font-size:var(--t4); font-weight:700}
.mi-semana .fila span{font-size:var(--t5); color:var(--tenue); font-variant-numeric:tabular-nums}
.mi-semana .fila .rango{margin-left:auto; font-size:var(--t3); color:var(--txt)}
/* Desde tu última visita. */
.novedades{display:flex; gap:12px; align-items:flex-start; margin-bottom:24px}
.novedades::before{content:""; flex:0 0 auto; width:3px; align-self:stretch; border-radius:2px; background:var(--acento)}
.novedades .rot{display:block; font-size:var(--t6); color:var(--tenue); margin-bottom:4px}
.novedades p{font-size:var(--t5); line-height:1.4}

/* ═══════ el campeón ═══════ */
.campeon{margin-bottom:32px}
.copa{display:block; width:32px; height:32px; margin-bottom:8px; color:var(--oro)}
.campeon .rot{font-size:var(--t5); font-weight:500; color:var(--tenue)}
.campeon.oficial .rot{color:var(--oro)}
.campeon .nombres{font-size:var(--t2); font-weight:700; letter-spacing:-.03em; line-height:1.1; margin:4px 0; overflow-wrap:anywhere}
.campeon .cifra{font-size:var(--t5); color:var(--tenue)}
.campeon .bolsa{margin-top:8px; font-size:var(--t1); line-height:1.05; color:var(--oro)}
.campeon.provisional .bolsa{font-size:var(--t4); font-weight:500; line-height:1.45; color:var(--tenue)}
.campeon.compacto{display:grid; grid-template-columns:auto minmax(0,1fr) auto; align-items:center; column-gap:12px; margin-bottom:16px; padding-bottom:12px; border-bottom:1px solid var(--linea)}
.campeon.compacto .copa{width:24px; height:24px; margin:0; grid-row:1/3}
.campeon.compacto .rot{font-size:var(--t6); grid-column:2}
.campeon.compacto .nombres{font-size:var(--t4); letter-spacing:-.01em; margin:0; grid-column:2}
.campeon.compacto .cifra{display:none}
.campeon.compacto .bolsa{margin:0; font-size:var(--t3); line-height:1.2; grid-column:3; grid-row:1/3}
.campeon.compacto.provisional .bolsa{font-size:var(--t5)}
.confetis{position:fixed; inset:0; z-index:150; pointer-events:none; overflow:hidden}
.confeti{position:absolute; top:-20px; width:8px; height:14px; border-radius:2px; opacity:0; will-change:transform;
  animation:caer var(--d) cubic-bezier(.25,.5,.5,1) forwards}
@keyframes caer{0%{opacity:0; transform:translate3d(0,-20px,0) rotate(0)} 8%{opacity:1} 80%{opacity:1}
  100%{opacity:0; transform:translate3d(var(--x),105vh,0) rotate(var(--r))}}
.empatados{font-weight:700}
.empatados summary{display:inline-flex; align-items:center; gap:4px; min-height:44px; cursor:pointer; list-style:none}
.empatados summary::-webkit-details-marker{display:none}
.empatados summary::after{content:""; width:7px; height:7px; margin-left:2px; border-right:1.6px solid var(--tenue); border-bottom:1.6px solid var(--tenue);
  transform:rotate(45deg) translate(-1px,-1px); transition:transform .28s var(--rebote)}
.empatados[open] summary::after{transform:rotate(-135deg) translate(-1px,-1px)}
.empatados .gente{margin-top:8px; justify-content:inherit; font-weight:500; animation:aparece .24s ease backwards}

/* ═══════ el podio ═══════ */
.podio{margin-bottom:8px}
.lugar{display:grid; grid-template-columns:1.5rem minmax(0,1fr) auto; align-items:center; column-gap:12px; padding:12px 0}
.lugar + .lugar{border-top:1px solid var(--linea)}
/* El lugar con su color solo si ese lugar cobra. */
.medalla{font-size:var(--t3); line-height:1; text-align:right; color:var(--tenue)}
.oro .medalla{color:var(--oro)}
.plata .medalla{color:var(--plata)}
.bronce .medalla{color:var(--bronce)}
.lugar .quien{font-size:var(--t4); font-weight:600; line-height:1.25; overflow-wrap:anywhere}
.lugar .bolsa{font-size:var(--t4); font-weight:500; color:var(--oro)}
.lugar .sin-premio{font-size:var(--t5); color:var(--tenue)}
.lugar .puntos{font-size:var(--t2); line-height:1; text-align:right}
.nota-podio{margin:8px 0 0; font-size:var(--t5); line-height:1.4; color:var(--tenue)}
.nota-podio .enlace-titulo{margin-block:-12px; margin-left:0; padding-inline:2px}

/* ═══════ las tablas ═══════ */
.filtro-tabla{position:relative; display:flex; gap:8px; margin:0 0 8px}
.filtro-tabla input{flex:1 1 auto; width:100%; height:44px; padding:0 12px 0 36px; border-radius:var(--r2); background:var(--panel); color:var(--txt); border:1px solid var(--linea);
  -webkit-appearance:none; appearance:none}
.filtro-tabla input::placeholder{color:var(--tenue2)}
.filtro-tabla input:focus{outline:0; border-color:var(--acento)}
.filtro-tabla::before{content:""; position:absolute; left:14px; top:14px; width:12px; height:12px; border:1.8px solid var(--tenue); border-radius:50%; pointer-events:none}
.filtro-tabla::after{content:""; position:absolute; left:25px; top:25px; width:6px; height:1.8px; background:var(--tenue); transform:rotate(45deg); transform-origin:0 50%; pointer-events:none}
.mi-fila{flex:0 0 auto; min-height:44px; padding:0 12px; border-radius:var(--r2); font-size:var(--t5); font-weight:600; color:var(--acento); background:var(--panel); border:1px solid var(--linea);
  transition:transform .28s var(--sale)}
.sin-resultados{padding:16px; text-align:center; color:var(--tenue); font-size:var(--t5)}
.marco{position:relative}
.rueda.expandida{overflow-x:auto; -webkit-overflow-scrolling:touch}
.rueda.expandida thead th{top:0}
table{border-collapse:separate; border-spacing:0; width:100%}
th,td{height:44px; padding:0 4px 0 8px; text-align:right; font-size:var(--t4); white-space:nowrap}
thead th{height:32px; position:sticky; top:var(--alto-encabezado); z-index:3; font-size:var(--t6); font-weight:600; color:var(--tenue);
  background:var(--bg); border-bottom:1px solid var(--linea)}
tbody td{border-bottom:1px solid var(--linea)}
tbody tr:last-child td{border-bottom:0}
.anima tbody tr:nth-child(-n+6){animation:sube .36s var(--sale) backwards; animation-delay:calc(var(--i,0) * 36ms + 60ms)}
/* Los lugares también son columna numérica: a la derecha, sin discos. */
.c-pos{width:32px; min-width:32px; padding:0 8px 0 0; color:var(--tenue)}
.c-pos .n{font-size:var(--t4); color:var(--tenue)}
tr.p1 .c-pos .n{color:var(--oro)}
tr.p2 .c-pos .n{color:var(--plata)}
tr.p3 .c-pos .n{color:var(--bronce)}
.c-nombre{width:99%; text-align:left; font-weight:500; white-space:normal; line-height:1.2; overflow-wrap:anywhere}
.pts{font-size:var(--t3)}
.err,.sem{font-weight:500; color:var(--tenue)}
th.c-sem.vieja,td.c-sem.vieja,th.c-sem.media,td.c-sem.media{display:none}
.rueda.expandida th.c-sem,.rueda.expandida td.c-sem{display:table-cell}
/* Con todas las semanas la tabla se desliza: el nombre no se parte letra por letra para caber. */
.rueda.expandida .c-nombre{white-space:nowrap; overflow-wrap:normal}
@media (min-width:700px){ th.c-sem.media,td.c-sem.media{display:table-cell} }
tbody tr.clic{cursor:pointer}
@media (hover:hover){ tbody tr:hover td{background:var(--panel2)} }
tbody tr:active td{background:var(--panel2)}
/* Tu fila: un escalón más clara, una raya de acento y el nombre en blanco. */
tbody tr.yo td{background:var(--fila-yo)}
tbody tr.yo td:first-child{box-shadow:inset 3px 0 0 var(--acento)}
tbody tr.yo .c-pos .n{color:var(--txt)}
tbody tr.yo.p1 .c-pos .n{color:var(--oro)}
tbody tr.yo.p2 .c-pos .n{color:var(--plata)}
tbody tr.yo.p3 .c-pos .n{color:var(--bronce)}
tbody tr.yo .c-nombre{color:var(--txt); font-weight:700}
tbody tr.resaltada td{position:relative}
tbody tr.resaltada td::after{content:""; position:absolute; inset:0; background:var(--txt); opacity:0; pointer-events:none; animation:resaltar 1.6s ease}
@keyframes resaltar{0%,60%{opacity:.12}}
.mov{display:inline-block; margin-left:4px; font-size:var(--t6); font-weight:700; white-space:nowrap}
.mov.sube{color:var(--verde)} .mov.baja{color:var(--rojo)}
.ver-todas{display:block; width:100%; min-height:44px; font-size:var(--t5); font-weight:600; color:var(--acento); border-top:1px solid var(--linea);
  transition:transform .28s var(--sale)}
.chip-vivo{display:inline-block; margin-left:4px; font-family:var(--cuerpo); font-size:var(--t6); font-weight:700; color:var(--verde)}

/* ═══════ pestañas ═══════ */
.tabs{position:sticky; top:var(--alto-encabezado); z-index:40; margin:0 -16px 8px; padding-inline:16px; background:var(--bg)}
.tabs-int{position:relative; display:flex; overflow-x:auto; scrollbar-width:none; border-bottom:1px solid var(--linea)}
.tabs-int::-webkit-scrollbar{display:none}
.tabs-int button{position:relative; z-index:2; flex:1 0 auto; min-height:44px; padding:0 12px; font-size:var(--t5); font-weight:600;
  color:var(--tenue); white-space:nowrap; transition:color .24s}
.tabs-int button[aria-selected="true"]{color:var(--txt); font-weight:700}
.corredera{position:absolute; bottom:0; left:0; width:0; height:2px; background:var(--acento); z-index:1;
  transition:transform .3s var(--sale),width .3s var(--sale)}

/* ═══════ semana ═══════ */
.cabeza-semana{margin:14px 0 16px; text-align:center}
.cabeza-semana .estado-semana{color:var(--sobre-campo)}
.cabeza-semana .volver-actual{color:var(--acento-campo)}
.cambia-semana{display:grid; grid-template-columns:44px minmax(0,1fr) 44px; align-items:center; gap:8px}
.flecha-semana{width:44px; height:44px; border-radius:50%; display:grid; place-items:center; color:var(--txt);
  transition:transform .28s var(--rebote),opacity .2s}
.flecha-semana svg{width:18px; height:18px; fill:none; stroke:currentColor; stroke-width:2.2; stroke-linecap:round; stroke-linejoin:round}
.flecha-semana:disabled{opacity:.25; cursor:default}
.flecha-semana:not(:disabled):active{transform:scale(.88); transition:transform .07s linear}
.semana-elegida{justify-self:center; display:inline-flex; align-items:center; gap:8px; min-height:44px; padding-inline:8px}
.semana-elegida .num{font-size:var(--t2); font-weight:700; letter-spacing:-.03em; white-space:nowrap}
.semana-elegida .abre{width:8px; height:8px; margin-top:-3px; border-right:2px solid var(--tenue); border-bottom:2px solid var(--tenue); transform:rotate(45deg)}
.estado-fila{display:flex; align-items:center; justify-content:center; gap:12px; flex-wrap:wrap}
.estado-semana{display:inline-flex; align-items:center; gap:8px; font-size:var(--t5); font-weight:600; color:var(--tenue)}
.estado-semana.cerrada{color:var(--txt)}
.estado-semana.vivo{color:var(--txt)}
.estado-semana.vivo::before{content:""; width:7px; height:7px; border-radius:50%; background:var(--vivo)}
.detalle-semana{margin-top:8px}
.avance-semana{height:2px; background:var(--panel3); overflow:hidden; margin:0 auto 8px; max-width:440px}
.avance-semana i{display:block; height:100%; background:var(--oro)}
.anima .avance-semana i{animation:traza .56s var(--traza) backwards .12s; transform-origin:0 50%}
@keyframes traza{from{transform:scaleX(0)}}
.linea-estado{font-size:var(--t5); line-height:1.35; color:var(--tenue)}
.aviso-picks{display:flex; align-items:center; gap:12px; width:100%; min-height:48px; margin:0 0 16px; padding:12px 16px; border-radius:var(--r2); text-align:left;
  background:var(--panel); border:1px solid var(--linea); transition:transform .28s var(--sale)}
.aviso-picks .txt{flex:1 1 auto; font-size:var(--t5); line-height:1.35; color:var(--tenue)}
.aviso-picks .ir{flex:0 0 auto; font-weight:600; font-size:var(--t5); color:var(--acento)}

/* ═══════ quién le fue a quién ═══════ */
select.ancho{display:block; width:100%; height:44px; margin-bottom:8px; padding:0 32px 0 12px; border-radius:var(--r2); background-color:var(--panel); color:var(--txt);
  border:1px solid var(--linea); -webkit-appearance:none; appearance:none;
  background-image:linear-gradient(45deg,transparent 50%,var(--tenue) 50%),linear-gradient(135deg,var(--tenue) 50%,transparent 50%);
  background-position:calc(100% - 19px) 50%,calc(100% - 14px) 50%; background-size:5px 5px,5px 5px; background-repeat:no-repeat}
select.ancho:focus{outline:0; border-color:var(--acento)}
.split{display:grid; gap:8px; padding:12px 0}
.split + .split{border-top:1px solid var(--linea)}
.split .cab{display:flex; align-items:center; gap:8px; font-weight:600}
.split .cab .vs{flex:1 1 auto; font-size:var(--t4)}
.split .cab .mr{font-size:var(--t5); color:var(--tenue); font-variant-numeric:tabular-nums; white-space:nowrap}
.sello-consenso{font-size:var(--t6); font-weight:600; white-space:nowrap; color:var(--tenue)}
.sello-consenso.unanime{color:var(--txt)}
.balanza{display:flex; gap:2px; height:6px; border-radius:99px; overflow:hidden; background:var(--panel3)}
.balanza i{display:block; height:100%; width:0; transition:width .56s var(--traza)}
.cuenta-lado{display:flex; justify-content:space-between; font-size:var(--t5); font-weight:600}
.gente{display:flex; flex-wrap:wrap; gap:4px}
.gente span{font-size:var(--t6); padding:2px 8px; border-radius:var(--r3); background:var(--panel2); color:var(--tenue); overflow-wrap:anywhere}
.gente span.ok{color:var(--verde)}
.gente span.no{color:var(--tenue2)}
.gente span.tu{box-shadow:inset 0 0 0 1px var(--acento); color:var(--txt)}
.boleta{display:grid}
.boleta .linea{display:grid; grid-template-columns:auto minmax(0,1fr) auto; align-items:center; gap:12px; min-height:44px; padding-block:4px; font-size:var(--t5)}
.boleta .linea + .linea{border-top:1px solid var(--linea)}
.boleta .vs{color:var(--tenue)}
.boleta .vs b{color:var(--txt); font-weight:600}
.boleta .linea.fallo .vs b{color:var(--tenue)}
.sello{width:22px; height:22px; border-radius:50%; display:grid; place-items:center; font-size:var(--t6); font-weight:800; background:var(--panel3); color:var(--tenue)}
.sello.ok{background:var(--verde); color:#04150c}
.sello.no{background:transparent; color:var(--rojo); box-shadow:inset 0 0 0 1.5px var(--rojo)}
.mini{font-size:var(--t5); color:var(--tenue); font-variant-numeric:tabular-nums; text-align:right}

/* ═══════ escenarios ═══════ */
.candidato{display:grid; grid-template-columns:1.5rem minmax(0,1fr) auto; align-items:center; column-gap:12px; padding-block:12px}
.candidato + .candidato{border-top:1px solid var(--linea)}
.candidato .n{font-size:var(--t4); text-align:right; color:var(--tenue)}
.candidato .quien{font-weight:600}
.candidato .pct{font-size:var(--t3)}
.candidato.yo{margin-inline:-8px; padding-inline:8px; background:var(--fila-yo); box-shadow:inset 3px 0 0 var(--acento)}
.progreso{grid-column:2/4; height:2px; background:var(--panel3); overflow:hidden; margin-top:8px}
.progreso i{display:block; height:100%; width:0; background:var(--tenue); transition:width .56s var(--traza)}
.candidato.yo .progreso i{background:var(--acento)}
.que-significa{grid-column:2/4; font-size:var(--t5); color:var(--tenue); margin-top:4px; line-height:1.35}
.que-significa.tuya{color:var(--txt)}

/* ═══════ la ficha de cada quien ═══════ */
.regreso{display:inline-flex; align-items:center; gap:4px; min-height:44px; margin:0 0 4px; font-weight:600; font-size:var(--t5); color:var(--acento-campo)}
.perfil{margin-bottom:12px}
.perfil .cab{display:flex; align-items:flex-start; gap:12px; margin-bottom:8px}
.perfil .nom{font-size:var(--t1); font-weight:700; line-height:1; letter-spacing:-.03em; overflow-wrap:anywhere; view-transition-name:nombre-perfil; margin-top:4px}
.perfil .nota-perfil{margin:0; font-size:var(--t4); color:var(--sobre-campo)}
.perfil .cab .rotulo{color:var(--sobre-campo)}
.cifras{display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); column-gap:16px; margin-bottom:24px}
.cifras .cifra{padding-block:12px; border-top:1px solid var(--linea)}
.cifras .cifra b{display:block; font-size:var(--t2); line-height:1.1}
.cifras .cifra span{display:block; font-size:var(--t5); color:var(--tenue)}
.barras{display:flex; align-items:flex-end; gap:4px; height:104px; margin-bottom:24px}
.barras .col{flex:1 1 0; max-width:48px; margin-inline:auto; display:flex; flex-direction:column; justify-content:flex-end; align-items:center; gap:4px; height:100%}
.barras .b{width:100%; min-height:3px; border-radius:2px 2px 0 0; background:var(--panel3); transition:height .36s var(--sale)}
.barras .col.mejor .b{background:var(--txt)}
.barras .col.abierta .b{background:repeating-linear-gradient(135deg,var(--panel3) 0 3px,transparent 3px 6px); box-shadow:inset 0 0 0 1px var(--panel3)}
.barras .col small{font-size:var(--t6); color:var(--tenue); line-height:1.2}
.barras .col small.cima{font-size:var(--t4); color:var(--txt)}
.rasgos{display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); column-gap:16px; margin-bottom:12px}
.rasgo{padding-block:12px; border-top:1px solid var(--linea)}
.rasgo:last-child:nth-child(odd){grid-column:1/-1}
.rasgo .rot{font-size:var(--t6); color:var(--tenue)}
.rasgo .val{font-size:var(--t3); font-weight:700; letter-spacing:-.03em; overflow-wrap:anywhere; color:var(--c,var(--txt))}
.rasgo .pie{font-size:var(--t5); color:var(--tenue)}
.duelo{display:grid; gap:12px}
.duelo .caras{display:grid; grid-template-columns:minmax(0,1fr) auto minmax(0,1fr); gap:12px; align-items:center}
.duelo .cara{padding-block:8px; text-align:center}
.duelo .cara .q{font-weight:600; font-size:var(--t5); overflow-wrap:anywhere; line-height:1.2}
.duelo .cara .t{font-size:var(--t2); line-height:1.2; color:var(--tenue)}
.duelo .cara.va-arriba .t{color:var(--txt)}
.duelo .vs-mid{font-weight:600; color:var(--tenue); font-size:var(--t6)}
.dif{display:grid}
.dif .row{display:grid; grid-template-columns:minmax(0,1fr) auto minmax(0,1fr); gap:12px; align-items:center; min-height:44px; padding-block:4px; font-size:var(--t5)}
.dif .row + .row{border-top:1px solid var(--linea)}
.dif .row .j{font-weight:600; overflow:hidden; text-overflow:ellipsis; white-space:nowrap}
.dif .row .j.izq{text-align:right} .dif .row .j.der{text-align:left}
.dif .row .mid{font-size:var(--t6); color:var(--tenue); text-align:center; white-space:nowrap}
.dif .row .j.gano{color:var(--verde)} .dif .row .j.perdio{color:var(--tenue2)}

/* ═══════ los picks ═══════ */
.generador .pie-gen{font-size:var(--t5); color:var(--tenue); line-height:1.4; margin:0 0 12px}
.generador .quien-soy{margin-bottom:12px; font-size:var(--t5); color:var(--acento)}
.tanda{margin-top:16px}
.tanda:first-of-type{margin-top:4px}
.tanda .cab{display:flex; align-items:baseline; gap:8px; flex-wrap:wrap; margin-bottom:4px}
.tanda .cab span{font-size:var(--t5); font-weight:700}
.tanda .cab em{font-size:var(--t5); color:var(--tenue)}
.dia-pick{margin:16px 0 8px; font-size:var(--t5); color:var(--tenue)}
.duelo-pick{position:relative; display:grid; grid-template-columns:minmax(0,1fr) minmax(0,1fr); gap:8px; margin-bottom:8px}
.duelo-pick .vs{display:none}
.opcion{position:relative; display:flex; align-items:center; gap:8px; min-height:48px; padding-inline:8px 12px; overflow:hidden; border-radius:var(--r2); text-align:left;
  background:var(--panel2); border:1px solid var(--linea); transition:opacity .24s,transform .28s var(--sale),border-color .2s; touch-action:manipulation}
/* Al elegir, el color del equipo llena el botón desde donde tocaste. */
.opcion::before{content:""; position:absolute; inset:0; background:var(--c,var(--acento)); clip-path:circle(0 at var(--tx,50%) var(--ty,50%));
  transition:clip-path .5s var(--sale)}
.opcion[aria-pressed="true"]::before{clip-path:circle(150% at var(--tx,50%) var(--ty,50%))}
.opcion>*{position:relative}
.opcion .sig{flex:0 0 auto; min-width:36px; padding-inline:4px; background:var(--c,var(--panel3)); color:var(--c-txt,#07090b); transition:background .24s,color .24s}
.opcion .nom{font-size:var(--t5); font-weight:600; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; color:var(--txt); transition:color .24s}
.opcion[aria-pressed="true"]{border-color:transparent}
.opcion[aria-pressed="true"] .nom{color:var(--c-txt,#07090b); font-weight:700}
.opcion[aria-pressed="true"] .sig{background:rgba(0,0,0,.14); color:var(--c-txt,#07090b)}
.duelo-pick:has(.opcion[aria-pressed="true"]) .opcion[aria-pressed="false"]{opacity:.55}
@media (max-width:360px){ .opcion .sig{display:none} .opcion{padding-inline:12px} }
/* El avance y el botón te siguen mientras bajas. */
.acciones-gen{position:sticky; bottom:calc(var(--alto-pie) + 2px); z-index:6; display:flex; align-items:center; gap:8px; margin:16px -8px 0; padding:8px 8px 8px 12px; overflow:hidden; border-radius:var(--r1);
  background:var(--panel3); border:1px solid var(--linea2)}
.acciones-gen .boton:disabled{opacity:1; background:var(--panel2); color:var(--tenue)}
.acciones-gen .avance{position:absolute; left:0; top:0; height:2px; width:0; background:var(--acento); transition:width .36s var(--sale)}
.acciones-gen .cuenta{margin-right:auto; font-size:var(--t3); white-space:nowrap}
.acciones-gen .cuenta small{font-family:var(--cuerpo); font-size:var(--t5); font-weight:500; color:var(--tenue)}
.borrar{flex:0 0 auto; width:44px; height:44px; border-radius:var(--r2); display:grid; place-items:center; color:var(--tenue); transition:opacity .2s}
.borrar svg{width:20px; height:20px; fill:none; stroke:currentColor; stroke-width:1.8; stroke-linecap:round; stroke-linejoin:round}
.borrar:disabled{opacity:.3}
.aviso-gen{font-size:var(--t5); color:var(--tenue); margin-top:12px; line-height:1.4}
.aviso-gen a{display:inline-flex; align-items:center; min-height:44px; color:var(--acento)}
/* El aviso de abajo: "Borraste tus picks · Deshacer". */
.flotante{position:fixed; left:50%; bottom:calc(var(--alto-pie) + 12px); z-index:120; display:flex; align-items:center; gap:12px; max-width:calc(100vw - 32px); padding:4px 8px 4px 16px; border-radius:var(--r1);
  font-size:var(--t5); white-space:nowrap; background:var(--panel3); border:1px solid var(--linea2); box-shadow:0 12px 34px rgba(0,0,0,.5);
  transform:translateX(-50%); animation:flota .36s var(--sale) backwards}
.flotante.saliendo{animation:flota-sale .1s var(--entra) both}
.flotante button{min-height:44px; padding:0 8px; font-weight:700; color:var(--acento)}
@keyframes flota{from{opacity:0; transform:translate(-50%,16px)}}
@keyframes flota-sale{to{opacity:0; transform:translate(-50%,8px)}}

/* ═══════ premios ═══════ */
.bolsa-final .rot{font-size:var(--t5); color:var(--tenue)}
.bolsa-final .val{font-size:var(--t1); line-height:1.05; color:var(--oro); margin-bottom:8px}
.progreso-bolsa{height:4px; background:var(--panel3); overflow:hidden}
.progreso-bolsa i{display:block; height:100%; width:0; background:var(--oro); transition:width .56s var(--traza)}
.bolsa-final .pie{font-size:var(--t5); color:var(--tenue); margin-top:8px}
.rebanada{margin:12px 0 0; padding-top:12px; border-top:1px solid var(--linea); font-size:var(--t4); font-weight:600; line-height:1.35}
.pastel{display:flex; gap:2px; height:12px; margin-bottom:8px}
.pastel i{display:block; min-width:4px; border-radius:2px; transform-origin:0 50%}
.pastel .oro{background:var(--oro)} .pastel .plata{background:var(--plata)} .pastel .bronce{background:var(--bronce)}
.anima .pastel i{animation:traza .56s var(--traza) backwards .12s}
.fila-gan{display:grid; grid-template-columns:2.4rem minmax(0,1fr) auto; align-items:center; column-gap:12px; min-height:48px; padding-block:8px}
.fila-gan + .fila-gan{border-top:1px solid var(--linea)}
.fila-gan .sN{font-size:var(--t5); font-weight:700; color:var(--tenue)}
.fila-gan .quien{font-weight:600; line-height:1.25; overflow-wrap:anywhere}
.fila-gan .quien small{display:block; font-weight:400; font-size:var(--t5); color:var(--tenue)}
.fila-gan .monto{font-size:var(--t3); color:var(--oro); white-space:nowrap}
.fila-gan.abierta .monto{font-size:var(--t5); font-weight:500; color:var(--tenue)}
.fila-gan.tuya{margin-inline:-8px; padding-inline:8px; background:var(--fila-yo); box-shadow:inset 3px 0 0 var(--acento)}
#dinamica,#mi-fila-ancla{scroll-margin-top:calc(var(--alto-encabezado) + 16px)}
.regla + .regla{border-top:1px solid var(--linea)}
.regla summary{display:flex; align-items:center; justify-content:space-between; gap:12px; min-height:48px; font-weight:600; cursor:pointer; list-style:none}
.regla summary::-webkit-details-marker{display:none}
.regla summary::after{content:""; width:8px; height:8px; flex:0 0 auto; margin-right:4px; border-right:2px solid var(--tenue); border-bottom:2px solid var(--tenue); transform:rotate(45deg) translate(-2px,-2px); transition:transform .28s var(--rebote)}
.regla[open] summary::after{transform:rotate(-135deg) translate(-2px,-2px)}
.regla .dentro{padding-bottom:16px; animation:aparece .24s ease backwards}
.regla ul{margin:0; padding-left:16px; display:grid; gap:8px}
.regla li{font-size:var(--t5); line-height:1.45; color:var(--tenue)}
.lugares-premio{display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:8px; margin-top:12px}
.lugar-premio{display:flex; flex-direction:column; padding-top:8px; border-top:1px solid var(--linea)}
.lugar-premio .n{font-size:var(--t5); font-weight:700}
.lugar-premio .pct{font-size:var(--t6); color:var(--tenue)}
.lugar-premio b{font-size:var(--t3); color:var(--oro)}

/* ═══════ las hojas que suben ═══════ */
.con-hoja,.con-hoja body{overflow:hidden}
.hoja-fondo{position:fixed; inset:0; z-index:200; display:flex; align-items:flex-end; justify-content:center; background:rgba(0,0,0,.5);
  -webkit-backdrop-filter:blur(8px); backdrop-filter:blur(8px); animation:aparece .24s ease backwards}
.hoja-fondo.saliendo{animation:aparece .24s ease reverse both}
.hoja{width:min(100%,560px); max-height:min(84vh,720px); overflow:auto; overscroll-behavior:contain; padding:0 16px calc(24px + env(safe-area-inset-bottom));
  border-radius:20px 20px 0 0; background:var(--panel); border:1px solid var(--linea2); border-bottom:0; animation:hoja-sube .42s var(--hoja) backwards}
.hoja-fondo.saliendo .hoja{animation:hoja-baja .24s var(--entra) both}
.hoja .tirador{position:sticky; top:0; z-index:2; padding:8px 0 12px; background:var(--panel); touch-action:none; cursor:grab}
.hoja .agarradera{width:40px; height:5px; border-radius:99px; background:var(--linea2); margin:0 auto 12px}
.hoja h3{font-size:var(--t3); font-weight:700; letter-spacing:-.03em; text-align:center}
@keyframes hoja-sube{from{transform:translateY(100%)}}
@keyframes hoja-baja{to{transform:translateY(100%)}}
.rejilla-semanas{display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:8px}
.celda-semana{position:relative; display:flex; flex-direction:column; align-items:center; min-height:72px; padding:8px 4px; border-radius:var(--r2);
  background:var(--panel2); border:1px solid var(--linea); transition:transform .28s var(--sale)}
.celda-semana b{font-size:var(--t3); line-height:1.2}
.celda-semana small{font-size:var(--t6); color:var(--tenue); white-space:nowrap}
.celda-semana .mio{font-size:var(--t6); font-weight:600; color:var(--tenue)}
.celda-semana .mio.gano{color:var(--oro)}
.celda-semana.pendiente{background:transparent; border-style:dashed}
.celda-semana.vivo small{color:var(--txt)}
.celda-semana.en-curso::after{content:""; position:absolute; top:8px; right:8px; width:6px; height:6px; border-radius:50%; background:var(--txt)}
.celda-semana.elegida{background:var(--panel3); border-color:var(--acento)}
.celda-semana:focus-visible{outline-offset:-2px}
.hoja .boton-principal.volver-actual{margin-top:12px; color:var(--pastilla-txt); display:block}
.controles{display:grid; gap:12px}
.soy{display:grid; gap:4px}
.soy>span{font-size:var(--t5); color:var(--tenue)}
.soy select{display:block; width:100%; height:48px; padding:0 32px 0 12px; border-radius:var(--r2); background-color:var(--panel2); color:var(--txt); border:1px solid var(--linea); -webkit-appearance:none; appearance:none;
  background-image:linear-gradient(45deg,transparent 50%,var(--tenue) 50%),linear-gradient(135deg,var(--tenue) 50%,transparent 50%);
  background-position:calc(100% - 19px) 50%,calc(100% - 14px) 50%; background-size:5px 5px,5px 5px; background-repeat:no-repeat}
.soy.puesto select{border-color:var(--acento)}
.hoja .nota-hoja{margin:4px 0 0; font-size:var(--t5); color:var(--tenue); line-height:1.4}
.detalle-partido{display:grid; gap:12px}
.detalle-partido .split{padding:0}
.detalle-partido .marcador{display:flex; align-items:center; justify-content:center; gap:12px; font-size:var(--t2)}
.detalle-partido .marcador .sig{font-family:var(--cuerpo); font-size:var(--t6); letter-spacing:.01em; min-width:38px; padding-inline:4px}
.detalle-partido .linea-estado{text-align:center}

/* ═══════ pie ═══════ */
footer{margin-top:32px; padding-block:16px; border-top:1px solid var(--linea); color:var(--tenue); font-size:var(--t6); line-height:1.5}
footer .firma{font-weight:500}
footer .pie-version{color:var(--tenue2)}
.arriba{display:none}

/* ═══════ transiciones entre secciones ═══════ */
::view-transition-old(contenido){animation:.1s var(--entra) both vt-salir}
::view-transition-new(contenido){animation:.36s var(--sale) both vt-llegar}
html[data-rumbo="atras"]::view-transition-old(contenido){animation-name:vt-salir-atras}
html[data-rumbo="atras"]::view-transition-new(contenido){animation-name:vt-llegar-atras}
::view-transition-group(nombre-perfil){animation-duration:.52s; animation-timing-function:var(--sale)}
@keyframes vt-salir{to{opacity:0; transform:translate3d(-16px,0,0)}}
@keyframes vt-llegar{from{opacity:0; transform:translate3d(16px,0,0)}}
@keyframes vt-salir-atras{to{opacity:0; transform:translate3d(16px,0,0)}}
@keyframes vt-llegar-atras{from{opacity:0; transform:translate3d(-16px,0,0)}}

/* ═══════ la primera vez ═══════ */
@keyframes nav-sube{from{transform:translateY(120%)}}
/* La línea del logo se traza junto con la del titular. */
.llegando .logo .marca-linea{transform-box:fill-box; transform-origin:0 50%;
  animation:traza .56s var(--traza) backwards 1.35s}

/* ═══════ pantallas grandes ═══════ */
@media (min-width:900px){.vista{padding-top:4px}}
@media (min-width:600px){
  .estado{display:inline-flex}
  .identidad .txt{display:inline}
  .tabs{margin-inline:0; padding-inline:0}
}
@media (min-width:700px){
  .hoja-fondo{align-items:center}
  .hoja{border-radius:20px; border-bottom:1px solid var(--linea2); max-height:min(80vh,720px); animation:hoja-acerca .36s var(--sale) backwards}
  .hoja-fondo.saliendo .hoja{animation:aparece .2s ease reverse both}
  @keyframes hoja-acerca{from{opacity:0; transform:translateY(24px) scale(.96)}}
  .podio{display:grid; grid-template-columns:repeat(3,minmax(0,1fr))}
  .lugar{align-content:start; padding-inline:16px}
  .lugar:first-child{padding-left:0}
  .lugar + .lugar{border-top:0; border-left:1px solid var(--linea)}
  .cifras{grid-template-columns:repeat(4,minmax(0,1fr))}
  .rasgos{grid-template-columns:repeat(3,minmax(0,1fr))}
  .rasgo:last-child:nth-child(odd){grid-column:auto}
}
@media (min-width:900px){
  :root{--alto-pie:0px}
  .navegacion.al-pie{display:none}
  .navegacion.en-cabeza{display:flex; gap:2px; margin-inline:auto}
  .logo{margin-right:0}
  .navegacion.en-cabeza button{flex:0 0 auto; flex-direction:row; gap:8px; padding:0 16px; font-size:var(--t5)}
  .navegacion.en-cabeza svg{width:18px; height:18px}
  .navegacion.en-cabeza .indicador{top:0; bottom:0; border-radius:var(--r2)}
  .navegacion.en-cabeza .indicador.listo{transition:transform .3s var(--sale),width .3s var(--sale)}
  .hay-vivo .navegacion.en-cabeza button[data-vista="hoy"]::after{top:4px; left:24px}
  header{top:0}
  header.plegado .top{opacity:1; pointer-events:auto}
  .fila-yo .mi-barra{max-width:560px}
  .hoy-rejilla{display:grid; grid-template-columns:minmax(0,1.5fr) minmax(320px,1fr); gap:0 32px; align-items:start}
  .hoy-rejilla.sola{grid-template-columns:minmax(0,1fr)}
  .acciones-gen{bottom:12px}
  .flotante{bottom:24px}
  .arriba{position:fixed; right:24px; bottom:24px; z-index:70; width:44px; height:44px; border-radius:50%; display:grid; place-items:center; background:var(--panel2); border:1px solid var(--linea2);
    opacity:0; transform:translateY(16px) scale(.9); pointer-events:none; transition:opacity .24s,transform .36s var(--rebote)}
  .arriba.se-ve{opacity:1; transform:none; pointer-events:auto}
  .arriba svg{width:20px; height:20px}
}

@media (prefers-reduced-motion:reduce){
  *,*::before,*::after{animation:none !important; transition:none !important}
  ::view-transition-group(*),::view-transition-old(*),::view-transition-new(*){animation:none !important}
}
</style>
{#- Sin JavaScript nadie mide la línea: se tapa lo que queda debajo de ella. #}
<noscript><style>
:root{--ancla:166px; --alto-campo:100vh}
.saludo{position:relative}
.saludo::before{content:""; position:absolute; z-index:-1; top:100%; left:calc(50% - 50vw); width:100vw; height:100vh; background:var(--bg)}
</style></noscript>
</head>
<body>
{% macro botones_nav() -%}
<button type="button" data-vista="hoy" aria-selected="false"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3.5" y="5" width="17" height="15.5" rx="4"/><path d="M3.5 10h17M8 3v4M16 3v4"/><circle class="lleno" cx="12" cy="15.2" r="1.7"/></svg><span>Hoy</span></button>
<button type="button" data-vista="picks" aria-selected="false"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="4" width="16" height="16" rx="5"/><path d="M8.3 12.3l2.6 2.6 4.8-5.3"/></svg><span>Picks</span></button>
<button type="button" data-vista="semana" aria-selected="false"><svg viewBox="0 0 24 24" aria-hidden="true"><g transform="rotate(-45 12 12)"><path d="M2.5 12c3-4.4 6.2-6.5 9.5-6.5s6.5 2.1 9.5 6.5c-3 4.4-6.2 6.5-9.5 6.5S5.5 16.4 2.5 12z"/><path d="M8.8 12h6.4M10.4 10.6v2.8M13.6 10.6v2.8"/></g></svg><span>Semana</span></button>
<button type="button" data-vista="general" aria-selected="false"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3.5 20.5h17M4.5 20.5v-7h5v7M9.5 20.5V8.5h5v12M14.5 20.5v-5h5v5"/></svg><span>General</span></button>
<button type="button" data-vista="premios" aria-selected="false"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 4h8v5.5a4 4 0 0 1-8 0zM8 6H5.2a2.6 2.6 0 0 0 3.1 3.9M16 6h2.8a2.6 2.6 0 0 1-3.1 3.9M12 13.5v7M8.5 20.5h7"/></svg><span>Premios</span></button>
{%- endmacro %}
{% set espera_rescate = 8000 %}{% include "_rescate.html.j2" %}
<div class="cancha" aria-hidden="true">{{ campo_html|safe }}</div>
<script>
/* El nombre de tu equipo, antes de pintar nada: que no se vea primero el de todos. */
try {
  if (window.campoGuardado) for (var id in campoGuardado.trazos) document.getElementById(id).setAttribute("d", campoGuardado.trazos[id]);
} catch (e) { /* lo pinta el guión principal */ }
</script>

<header>
  <div class="env top">
    <button type="button" class="logo" aria-label="{{ marca }}, ir a Hoy">
      {{ marca_svg|safe }}
      {{ marca_palabra|safe }}
    </button>
    <nav class="navegacion en-cabeza" data-nav aria-label="Secciones">{{ botones_nav() }}</nav>
    <span class="estado" id="estado"><span class="punto"></span><span id="estado-txt">Temporada</span></span>
    <button type="button" class="identidad" id="identidad" aria-haspopup="dialog">
      <span class="ini" id="identidad-ini">?</span>
      <span class="txt" id="identidad-txt">Identifícate</span>
    </button>
  </div>
  <div class="env fila-yo">
    <div class="mi-barra" id="mi-barra" aria-live="polite"></div>
  </div>
</header>

<div class="oculto" id="guardarropa">
  <div class="controles" id="controles">
    <label class="soy" id="soy"><span>Soy</span><select id="quien-soy" aria-label="Elige tu nombre"></select></label>
    <label class="soy" id="equipo"><span>Mi equipo</span><select id="mi-equipo" aria-label="Elige tu equipo"></select></label>
    <p class="nota-hoja">Con tu nombre ves tus números en todas las secciones. Con tu equipo, el portal se pinta de sus colores. Se guarda solo en este teléfono.</p>
  </div>
</div>

<main>
  <section class="vista oculto env" id="vista-hoy"></section>
  <section class="vista oculto env" id="vista-picks"></section>
  {# La general se escribe en el HTML: se ve aunque el navegador no ejecute nada. #}
  <section class="vista anima env" id="vista-general">
    <div class="saludo">
      <div class="fecha">Temporada {{ anio }}</div>
      <h1><span class="palabra"><i style="--k:0">Tabla</i></span> <span class="palabra"><i style="--k:1">general</i></span></h1>
    </div>
    {% if podio_listo %}
    <div class="podio">
      {% for escalon in podio %}
      <article class="lugar {{ escalon.medalla }}">
        <div class="medalla">{{ escalon.pos }}</div>
        <div class="cuerpo">
          {% if escalon.enlistar %}
          <div class="quien">{{ escalon.nombres|join(' · ') }}</div>
          {% else %}
          <div class="quien">{{ escalon.cuantos }} empatados</div>
          {% endif %}
          {% if escalon.premio %}<div class="bolsa">{% if not premios.temporada_cerrada %}Hoy: {% endif %}{{ escalon.premio }}{% if escalon.cuantos > 1 %} c/u{% endif %}</div>
          {% elif escalon.pos > 3 %}<div class="sin-premio">Sin premio{% if not premios.temporada_cerrada %} por ahora{% endif %}</div>{% endif %}
        </div>
        <div class="puntos" aria-label="{{ escalon.total }} aciertos">{{ escalon.total }}</div>
      </article>
      {% endfor %}
    </div>
    <p class="nota-podio">Solo ganan los 3 primeros lugares. Con empates, sus premios se juntan y se dividen parejo{% if not premios.temporada_cerrada %}; los montos son si la temporada terminara hoy{% endif %}.
      <button type="button" class="enlace-titulo" id="a-dinamica">Cómo se reparte</button></p>
    {% else %}
    <div class="aviso">
      <strong>El podio se arma con más partidos</strong>
      Van {{ cerrados_temporada }} de {{ umbral_podio }} partidos cerrados. Con tan pocos juegos
      casi todos van empatados y un podio no diría nada. La tabla de abajo ya cuenta.
    </div>
    {% endif %}

    <div class="titulo">
      <h2>Los {{ general|length }}</h2><span class="nota">Bolsa final {{ premios.total }}</span>
    </div>
    <div class="marco rueda">
      <table class="fija">
        <thead>
          <tr>
            <th class="c-pos">#</th><th class="c-nombre">Participante</th>
            <th>Aciertos</th><th>Fallos</th>
            {% for columna in columnas_semana|reverse %}<th class="c-sem{% if loop.index > 4 %} vieja{% elif loop.index > 1 %} media{% endif %}">{{ columna }}</th>{% endfor %}
          </tr>
        </thead>
        <tbody>
          {% for fila in general %}
          <tr class="p{{ fila.pos }}" style="--i:{{ loop.index0 }}">
            <td class="c-pos"><span class="n">{{ fila.pos }}</span></td>
            <td class="c-nombre">{{ participantes[fila.p] }}{% if fila.mov %}{% if fila.mov > 0 %}<span class="mov sube" title="Subió {{ fila.mov }} lugares">▲{{ fila.mov }}</span>{% else %}<span class="mov baja" title="Bajó {{ -fila.mov }} lugares">▼{{ -fila.mov }}</span>{% endif %}{% endif %}</td>
            <td class="pts">{{ fila.total }}</td>
            <td class="err">{{ fila.err }}</td>
            {% for columna in columnas_semana|reverse %}<td class="sem c-sem{% if loop.index > 4 %} vieja{% elif loop.index > 1 %} media{% endif %}">{{ fila.sem[columna[1:]] }}</td>{% endfor %}
          </tr>
          {% endfor %}
        </tbody>
      </table>
      {% if columnas_semana|length > 1 %}
      <button type="button" class="ver-todas" id="ver-todas">Ver las {{ columnas_semana|length }} semanas</button>
      {% endif %}
    </div>
  </section>

  <section class="vista oculto env" id="vista-premios"></section>
  <section class="vista oculto env" id="vista-jugadores"></section>
  <section class="vista oculto env" id="vista-semana"></section>
</main>

<nav class="navegacion al-pie" data-nav aria-label="Secciones">{{ botones_nav() }}</nav>

<footer>
  <div class="env">
    <p>Actualizado {{ actualizado }}, hora de Ciudad de México</p>
    <p class="firma">Desarrollado por {{ desarrollador }} · <span class="pie-version">{{ version }}</span></p>
  </div>
</footer>

<script type="application/json" id="datos">{{ datos|safe }}</script>
<script type="application/json" id="datos-campo">{{ campo_datos|tojson }}</script>
<script>
(() => {
  "use strict";
  const D = JSON.parse(document.getElementById("datos").textContent);
  const vistas = {
    hoy: document.getElementById("vista-hoy"),
    picks: document.getElementById("vista-picks"),
    general: document.getElementById("vista-general"),
    premios: document.getElementById("vista-premios"),
    jugadores: document.getElementById("vista-jugadores"),
    semana: document.getElementById("vista-semana"),
  };
  // Dos navegaciones con los mismos botones: arriba en computadora, abajo en el teléfono.
  const navs = document.querySelectorAll("[data-nav]");
  const miBarra = document.getElementById("mi-barra");
  const chip = document.getElementById("estado");
  const chipTxt = document.getElementById("estado-txt");
  const porSemana = new Map(D.semanas.map((s) => [s.n, s]));
  const nombre = (i) => D.participantes[i] || "?";
  const suave = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const MAX_NOMBRES = 3, MAX_NOMBRES_OFICIAL = 6;
  let pestana = "tabla", vistaActual = "hoy", perfilAbierto = null;
  // La semana que se ve en "Semana": la en curso, hasta que se elija otra.
  let semanaElegida = D.activa !== null && porSemana.has(D.activa) ? D.activa : (D.semanas.length ? D.semanas[D.semanas.length - 1].n : null);
  // Si la pestaña la eligió la persona, se respeta; si no, la decide el momento.
  let pestanaElegida = false;

  /* Dónde se quedó el usuario, para volver ahí al recargar. Si la recarga la
     hizo la página, además se le devuelve todo lo demás: no la pidió él. */
  const SITIO = "angabave.sitio";
  let recargaAutomatica = false;
  function recordarSitio() {
    try {
      sessionStorage.setItem(SITIO, JSON.stringify({
        vista: vistaActual, pestana, scroll: Math.round(window.scrollY), auto: recargaAutomatica,
        elegida: pestanaElegida, perfil: perfilAbierto === null ? null : D.participantes[perfilAbierto],
        controles: leerControles(),
      }));
    } catch (e) { /* sin memoria: se abre donde toque por omisión */ }
  }
  function sitioGuardado() {
    try { return JSON.parse(sessionStorage.getItem(SITIO) || "null"); }
    catch (e) { return null; }
  }

  /* Lo que la persona dejó a medias en la vista: búsquedas, a quién eligió en
     una lista y los desplegables abiertos. Sobrevive a que la vista se redibuje
     y a una recarga. Las listas se recuerdan por el texto, no por el valor: el
     valor es la posición en la tabla, y esa cambia cuando cierra un partido. */
  function controlesDeLaVista() {
    const raiz = vistas[typeof vistaActual === "number" ? "semana" : vistaActual] || vistas.hoy;
    return Array.from(raiz.querySelectorAll("input,select,details"));
  }
  function leerControles() {
    return controlesDeLaVista().map((c) => c.tagName === "DETAILS" ? c.open
      : c.tagName === "SELECT" ? (c.selectedOptions[0] || {}).text || "" : c.value);
  }
  function reponerControles(valores) {
    const controles = controlesDeLaVista();
    if (!Array.isArray(valores) || valores.length !== controles.length) return;
    controles.forEach((c, i) => {
      if (c.tagName === "DETAILS") { c.open = valores[i] === true; return; }
      if (c.tagName === "SELECT") {
        const opcion = Array.from(c.options).find((o) => o.text === valores[i]);
        if (!opcion || opcion.selected) return;
        c.value = opcion.value;
        c.dispatchEvent(new Event("change"));
      } else if (typeof valores[i] === "string" && c.value !== valores[i]) {
        c.value = valores[i];
        c.dispatchEvent(new Event("input"));
      }
    });
  }

  /* Un toque, una tecla o un deslizamiento reciente: la persona está ahí. */
  let ultimoToque = 0;
  ["pointerdown", "keydown", "wheel", "touchmove", "scroll"].forEach((tipo) =>
    document.addEventListener(tipo, () => { ultimoToque = Date.now(); }, { passive: true }));
  const escribiendo = () => /^(INPUT|TEXTAREA)$/.test((document.activeElement || {}).tagName || "");

  const crear = (tag, clase, texto) => {
    const n = document.createElement(tag);
    if (clase) n.className = clase;
    if (texto !== undefined) n.textContent = texto;
    return n;
  };
  /* "31 empatados" sin decir quiénes no sirve de nada. Se cuenta, pero con la
     lista a un toque. */
  function nombrar(gente, oficial) {
    const tope = oficial ? MAX_NOMBRES_OFICIAL : MAX_NOMBRES;
    if (gente.length <= tope) return document.createTextNode(gente.join(" · "));

    const caja = crear("details", "empatados");
    const titulo = crear("summary", null, gente.length + " empatados");
    caja.appendChild(titulo);
    const lista = crear("div", "gente");
    gente.slice().sort((a, b) => a.localeCompare(b, "es")).forEach((quien) => {
      const et = crear("span", null, quien);
      if (jugador !== null && quien === nombre(jugador)) et.classList.add("tu");
      lista.appendChild(et);
    });
    caja.appendChild(lista);
    return caja;
  }
  const COPA =
    '<svg class="copa" viewBox="0 0 24 24" fill="none" aria-hidden="true">' +
    '<path d="M7 4h10v6a5 5 0 0 1-10 0V4Z" fill="currentColor"/>' +
    '<path d="M7 6H4.5a2.5 2.5 0 0 0 2.6 3.6M17 6h2.5a2.5 2.5 0 0 1-2.6 3.6M12 15v5.5M8.5 20.5h7" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>';

  /* ═══ memoria del navegador ═══ */
  function guardar(llave, valor) {
    try { valor === null ? localStorage.removeItem(llave) : localStorage.setItem(llave, valor); }
    catch (e) { /* ventana privada o permisos: el modo sigue vivo esta visita */ }
  }
  function leer(llave) {
    try { return localStorage.getItem(llave); } catch (e) { return null; }
  }

  /* ═══ identidad: un botón en vez de dos filas de selectores ═══ */
  const botonIdentidad = document.getElementById("identidad");
  const panelControles = document.getElementById("controles");
  const identidadIni = document.getElementById("identidad-ini");
  const identidadTxt = document.getElementById("identidad-txt");

  function iniciales(texto) {
    const partes = texto.trim().split(/\s+/).filter(Boolean);
    if (!partes.length) return "?";
    const primera = partes[0][0] || "";
    const segunda = partes.length > 1 ? partes[partes.length - 1][0] : (partes[0][1] || "");
    return (primera + segunda).toUpperCase();
  }

  function pintarIdentidad() {
    const quien = jugador !== null ? nombre(jugador) : null;
    const partes = [quien, equipo].filter(Boolean);
    botonIdentidad.classList.toggle("puesta", partes.length > 0);
    identidadTxt.textContent = partes.length ? partes.join(" · ") : "Identifícate";
    identidadIni.textContent = quien ? iniciales(quien) : (equipo ? (D.siglas[equipo] || "?") : "?");
    botonIdentidad.title = partes.length
      ? "Cambiar tu nombre o tu equipo"
      : "Elige tu nombre y tu equipo";
    pintarCampo();
  }

  function abrirControles() {
    const guardarropa = document.getElementById("guardarropa");
    abrirHoja("Tú", panelControles, {
      origen: botonIdentidad,
      alCerrar: () => guardarropa.appendChild(panelControles),
    });
  }
  botonIdentidad.addEventListener("click", abrirControles);

  /* ═══ quién soy ═══ */
  const cajaSoy = document.getElementById("soy");
  const selSoy = document.getElementById("quien-soy");
  let jugador = null;

  function montarSoy() {
    selSoy.innerHTML = '<option value="">elige tu nombre</option>';
    D.participantes.map((q, i) => [i, q]).sort((a, b) => a[1].localeCompare(b[1], "es"))
      .forEach(([i, q]) => { const o = crear("option", null, q); o.value = String(i); selSoy.appendChild(o); });
    const g = leer("angabave.jugador");
    const i = g ? D.participantes.indexOf(g) : -1;
    jugador = i >= 0 ? i : null;
    selSoy.value = jugador === null ? "" : String(jugador);
    cajaSoy.classList.toggle("puesto", jugador !== null);
    selSoy.addEventListener("change", () => elegirJugador(selSoy.value === "" ? null : Number(selSoy.value)));
  }

  /* ═══ mi equipo: el portal se tiñe con sus colores ═══ */
  const cajaEquipo = document.getElementById("equipo");
  const selEquipo = document.getElementById("mi-equipo");
  let equipo = null;

  function montarEquipo() {
    selEquipo.innerHTML = '<option value="">elige tu equipo</option>';
    Object.keys(D.colores).sort((a, b) => a.localeCompare(b, "es")).forEach((eq) => {
      const o = crear("option", null, eq); o.value = eq; selEquipo.appendChild(o);
    });
    const g = leer("angabave.equipo");
    equipo = g && D.colores[g] ? g : null;
    selEquipo.value = equipo || "";
    selEquipo.addEventListener("change", () => {
      equipo = selEquipo.value || null;
      guardar("angabave.equipo", equipo);
      aplicarTema();
      pintarIdentidad();
      repintar();
    });
    aplicarTema();
  }

  /* Colores de casa si juega de local esta semana, de visita si va de visitante.
     No cambia un acento: cambia fondo, superficies, bordes y resplandor. */
  let temaPuesto = Array.from(document.documentElement.style);   // lo que ya puso el <head>
  function aplicarTema() {
    const raiz = document.documentElement;
    cajaEquipo.classList.toggle("puesto", equipo !== null);
    temaPuesto.forEach((v) => raiz.style.removeProperty(v));
    temaPuesto = [];
    const meta = document.querySelector('meta[name="theme-color"]');

    if (!equipo || !D.temas[equipo]) {
      guardar("angabave.tema", null);
      if (meta) meta.setAttribute("content", D.fondo);
      pintarCampo();
      return;
    }
    const s = porSemana.get(D.activa) || D.semanas[D.semanas.length - 1];
    let donde = "local";
    if (s) {
      const juego = s.partidos.find((p) => p.v === equipo || p.l === equipo);
      if (juego) donde = juego.l === equipo ? "local" : "visita";
    }
    const tema = D.temas[equipo][donde];
    Object.entries(tema).forEach(([variable, valor]) => {
      raiz.style.setProperty(variable, valor);
      temaPuesto.push(variable);
    });
    // La próxima visita lo aplica el <head>, antes de pintar nada.
    guardar("angabave.tema", Object.entries(tema).map(([variable, valor]) => variable + ":" + valor).join(";"));
    if (meta) meta.setAttribute("content", tema["--bg"]);
    pintarCampo();
  }

  /* El partido más reciente de tu equipo que ya empezó: en juego o ya terminado. */
  function ultimoJuegoDeMiEquipo() {
    if (!equipo) return null;
    const semanas = D.semanas.slice().sort((a, b) => b.n - a.n);
    for (const s of semanas) {
      const p = todosLosJuegos(s).find((j) => j.v === equipo || j.l === equipo);
      if (p && (p.cerrado || p.porConfirmar || p.vivo)) return p;
    }
    return null;
  }

  /* Tres pulsos sobre las letras para invitar a tocar, hasta que se toque la primera vez.
     Espera a que el campo termine de llegar. */
  function invitarAlCampo() {
    if (campoInvitado || suave || !equipo || jugador === null || leer("angabave.campo-tocado")) return;
    campoInvitado = true;
    setTimeout(() => {
      const campo = document.querySelector(".cancha");
      const letras = Array.from(document.querySelectorAll(".cp-palabra")).find((n) => n.getBoundingClientRect().width > 0);
      if (!campo || !letras || scrollY > 40 || leer("angabave.campo-tocado")) return;
      const c = campo.getBoundingClientRect(), r = letras.getBoundingClientRect();
      const aro = crear("span", "campo-aro");
      aro.setAttribute("aria-hidden", "true");
      aro.style.left = (r.left + r.width / 2 - c.left) + "px";
      aro.style.top = (r.top + r.height / 2 - c.top) + "px";
      aro.addEventListener("animationend", () => aro.remove());
      campo.append(aro);
      if (letras.animate) letras.animate([{ opacity: 1 }, { opacity: .5 }, { opacity: 1 }], { duration: 1500, iterations: 3, easing: "ease-in-out" });
    }, 2800);
  }

  /* Un toque en el campo cambia entre tu nombre y tu equipo. */
  document.addEventListener("click", (e) => {
    if (!equipo || jugador === null || String(getSelection())) return;
    if (e.target.closest("a,button,select,input,textarea,summary,label,.hoja-fondo")) return;
    const campo = document.querySelector(".cancha");
    if (!campo || e.clientY > campo.getBoundingClientRect().bottom) return;
    guardar("angabave.campo-ver", leer("angabave.campo-ver") === "equipo" ? null : "equipo");
    guardar("angabave.campo-tocado", "1");
    document.querySelectorAll(".campo-aro").forEach((n) => n.remove());
    pintarCampo();
    if (!suave) document.querySelectorAll(".cp-palabra").forEach((n) => {
      if (n.animate) n.animate([{ opacity: 0 }, { opacity: 1 }], { duration: 240, easing: "ease-out" });
    });
  });

  /* Lo que va en la zona de anotación: tu nombre; si no, tu equipo; si no, nada. Al tocar, cambia. */
  function pintarCampo() {
    const mio = jugador !== null ? nombre(jugador) : "";
    const alterno = leer("angabave.campo-ver") === "equipo";
    const juego = ultimoJuegoDeMiEquipo();
    const sigla = (eq) => (D.siglas && D.siglas[eq]) || eq;
    const enJuego = juego && juego.vivo && !juego.cerrado && !juego.porConfirmar;
    const marcador = enJuego ? [sigla(juego.v), juego.mv || 0, sigla(juego.l), juego.ml || 0].join(" ") : "";
    // Con tu equipo en juego manda el marcador y al tocar sale tu nombre. Si no, tu nombre y al tocar, tu equipo.
    const quien = marcador ? (alterno ? mio || equipo : marcador) : (equipo && alterno ? equipo : mio || equipo);
    let estado = "";
    if (marcador) estado = "juega";
    else if (juego && (juego.g === "v" || juego.g === "l")) estado = juego.g === (juego.v === equipo ? "v" : "l") ? "gano" : "perdio";
    if (!document.getElementById("cp-oro")) {
      const defs = crear("div");
      defs.innerHTML = '<svg width="0" height="0" style="position:absolute" aria-hidden="true"><defs><linearGradient id="cp-oro" x1="0" y1="0" x2="1" y2="0"><stop offset="0" stop-color="#C9971C"/><stop offset=".4" stop-color="#FFE98A"/><stop offset=".65" stop-color="#FFD60A"/><stop offset="1" stop-color="#C9971C"/></linearGradient></defs></svg>';
      document.body.append(defs.firstChild);
    }
    if (estado) document.documentElement.setAttribute("data-campo", estado);
    else document.documentElement.removeAttribute("data-campo");
    invitarAlCampo();
    const trazos = pintarNombreCampo(quien);
    if (marcador && marcadorEnCampo && marcador !== marcadorEnCampo && !suave && quien === marcador) {
      document.querySelectorAll(".cp-palabra").forEach((n) => {
        if (n.animate) n.animate([{ opacity: .15 }, { opacity: 1 }], { duration: 900, easing: "ease-out" });
      });
    }
    marcadorEnCampo = marcador;
    guardar("angabave.campo", quien ? JSON.stringify({ v: 2, trazos: trazos, e: estado }) : null);
  }

  /* El nombre de tu equipo en la zona de anotación, en las dos tomas y en el vuelo. Son los
     mismos contornos que la palabra del portal, llevados del pasto a la pantalla. */
  let campoInvitado = false, marcadorEnCampo = "";
  let nombreEnCampo = window.campoGuardado ? null : "";
  function pintarNombreCampo(crudo) {
    const nodos = document.querySelectorAll(".cp-palabra");
    const trazos = {};
    const nombre = String(crudo || "").toUpperCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "")
      .replace(/\s+/g, " ").trim();
    if (nombre === nombreEnCampo) { nodos.forEach((n) => { trazos[n.id] = n.getAttribute("d"); }); return trazos; }
    nombreEnCampo = nombre;
    const C = JSON.parse(document.getElementById("datos-campo").textContent), z = C.zona, separa = 26;
    // Un espacio es un hueco del ancho de una letra angosta; lo que no tiene glifo se omite.
    const hueco = C.glifos.I ? C.glifos.I[0] : 0;
    const letras = Array.from(nombre).filter((l) => l === " " || C.glifos[l]);
    const ancho = (l) => (l === " " ? hueco : C.glifos[l][0]);
    const total = letras.reduce((suma, l) => suma + ancho(l), 0) + separa * Math.max(letras.length - 1, 0);
    const sx = Math.min(z.largo / (total || 1), z.maxX), sy = z.alto / z.cap, y0 = 50 + (z.hondo - z.alto) / 2;
    let x = -total * sx / 2;
    const contornos = [];
    letras.forEach((l) => {
      if (l !== " ") C.glifos[l][1].split("|").forEach((parte) => {
        const nums = parte.split(" ").map(Number), puntos = [];
        for (let i = 0, a = 0, b = 0; i < nums.length; i += 2) {
          a += nums[i]; b += nums[i + 1];
          puntos.push([x + a * sx, y0 + b * sy]);
        }
        contornos.push(puntos);
      });
      x += (ancho(l) + separa) * sx;
    });
    const trazo = (lleva) => contornos.map((c) => "M" + c.map(lleva).map((p) => p[0].toFixed(2) + " " + p[1].toFixed(2)).join("L") + "z").join("");
    nodos.forEach((n) => {
      const h = C.h[n.id.slice(-1)];
      const d = h ? trazo(([a, b]) => {
        const w = h[6] * a + h[7] * b + 1;
        return [(h[0] * a + h[1] * b + h[2]) / w, (h[3] * a + h[4] * b + h[5]) / w];
      }) : trazo(([a, b]) => [a, -b]);
      n.setAttribute("d", d);
      trazos[n.id] = d;
    });
    return trazos;
  }

  /* ═══ marcador en vivo ═══ */
  const marcadores = new Map();
  const anotaciones = new Map();   // clave -> cuándo cambió el marcador
  const SEGUNDOS_ANOTACION = 9;
  let fallosVivo = 0, ultimaConsulta = null;
  // La última vez que se supo que el cálculo oficial sigue corriendo.
  let latido = Date.parse(String(D.generado || "").replace(/(\.\d{3})\d+/, "$1")) || 0, latidoVisto = false;

  /* Cuando una cifra cambia, solo el dígito que cambió rueda hacia arriba, como un
     marcador de estadio. Lo demás se queda quieto. */
  function rodar(nodo, antes, ahora) {
    if (suave) return;
    const a = String(antes), b = String(ahora), largo = Math.max(a.length, b.length);
    const pa = a.padStart(largo, " "), pb = b.padStart(largo, " ");
    nodo.textContent = "";
    for (let i = 0; i < largo; i++) {
      if (pa[i] === pb[i]) { nodo.appendChild(document.createTextNode(pb[i])); continue; }
      const rodillo = crear("span", "rodillo"), tira = crear("span");
      tira.appendChild(crear("i", null, pa[i] === " " ? "\u00a0" : pa[i]));
      tira.appendChild(crear("i", null, pb[i]));
      rodillo.appendChild(tira);
      nodo.appendChild(rodillo);
    }
    setTimeout(() => { nodo.textContent = b; }, 900);
  }

  /* Una cifra que sube contando se nota; una que aparece ya puesta, no. */
  function contarHasta(nodo, destino, ms) {
    if (suave || destino <= 0 || destino > 999) { nodo.textContent = String(destino); return; }
    const arranque = performance.now();
    nodo.textContent = "0";
    const paso = (ahora) => {
      const avance = Math.min(1, (ahora - arranque) / ms);
      // Desacelera al final, como un marcador mecánico.
      const suavizado = 1 - Math.pow(1 - avance, 3);
      nodo.textContent = String(Math.round(destino * suavizado));
      if (avance < 1) requestAnimationFrame(paso);
      else nodo.textContent = String(destino);
    };
    requestAnimationFrame(paso);
  }

  function parsearVivo(carga) {
    if (!carga || !Array.isArray(carga.events)) return null;
    const salida = new Map();
    for (const ev of carga.events) {
      const comp = (ev.competitions || [])[0];
      if (!comp || !Array.isArray(comp.competitors) || comp.competitors.length !== 2) return null;
      let v = null, l = null;
      for (const c of comp.competitors) {
        const eq = D.vivo.equipos[(c.team || {}).abbreviation];
        if (!eq) return null;
        const m = c.score === "" || c.score == null ? null : Number(c.score);
        if (Number.isNaN(m)) return null;
        if (c.homeAway === "home") l = { eq, m };
        else if (c.homeAway === "away") v = { eq, m };
      }
      if (!v || !l) return null;
      const reloj = comp.status || ev.status || {};
      const tipo = reloj.type || {};
      if (typeof tipo.completed !== "boolean") return null;
      // ESPN manda "0" de marcador antes de la patada: eso no es un 0-0.
      const antes = tipo.state === "pre" ||
        (!tipo.completed && tipo.state !== "in" && (v.m || 0) + (l.m || 0) === 0);
      if (antes) { v.m = null; l.m = null; }
      let g = null;
      if (v.m !== null && l.m !== null && v.m !== l.m) g = v.m > l.m ? "v" : "l";
      const crudo = tipo.description || tipo.name || "";
      // Antes de la patada no hay nada que decir: se queda el horario publicado.
      let e = crudo === "Scheduled" ? null : (D.vivo.estados[crudo] || crudo);
      // En juego, mejor el cuarto y el reloj que un "En curso" genérico.
      if (tipo.state === "in" && crudo === "In Progress" && Number(reloj.period) > 0) {
        e = (reloj.period > 4 ? "TE" : "Q" + reloj.period) + (reloj.displayClock ? " · " + reloj.displayClock : "");
      }
      salida.set(v.eq + "@" + l.eq, {
        mv: v.m, ml: l.m, g, e,
        completado: tipo.completed,
        enJuego: !tipo.completed && !antes,
      });
    }
    return salida;
  }

  /* ESPN solo se consulta con un partido encima: sin terminar y por empezar en menos
     de 15 minutos o empezado hace menos de 5 horas. Sin hora definida, sí. */
  function hayJuegoCerca(s) {
    const ahora = Date.now();
    return todosLosJuegos(s).some((p) => !p.cerrado && !p.porConfirmar &&
      (p.vivo || !p.t || (ahora >= p.t * 1000 - 15 * 60e3 && ahora <= p.t * 1000 + 5 * 3600e3)));
  }

  let consultando = false;
  async function consultarVivo() {
    if (!D.vivo || document.hidden || consultando) return;
    const s = typeof vistaActual === "number" ? porSemana.get(vistaActual) : porSemana.get(D.activa);
    if (!s || s.cerrados >= s.total || !hayJuegoCerca(s)) return;
    consultando = true;
    const control = new AbortController();
    const corte = setTimeout(() => control.abort(), 8000);
    try {
      const r = await fetch(
        D.vivo.url + "?dates=" + D.anio + "&seasontype=2&week=" + s.n,
        { signal: control.signal, cache: "no-store" }
      );
      if (!r.ok) throw new Error(r.status);
      const frescos = parsearVivo(await r.json());
      if (!frescos) throw new Error("formato inesperado");
      const antes = JSON.stringify(todosLosJuegos(s));
      frescos.forEach((valor, clave) => {
        const previo = marcadores.get(clave);
        if (previo && (previo.mv !== valor.mv || previo.ml !== valor.ml)) {
          anotaciones.set(clave, {
            cuando: Date.now(),
            lado: previo.mv !== valor.mv ? "v" : "l",
            suma: (valor.mv || 0) + (valor.ml || 0) - (previo.mv || 0) - (previo.ml || 0),
          });
        }
        marcadores.set(clave, valor);
      });
      fallosVivo = 0;
      try { pintarCampo(); } catch (e) { console.error(e); }
      ultimaConsulta = new Date();
      // Redibujar sin que nada cambie borraba lo que la persona tenía a medias.
      if (repintePendiente || JSON.stringify(todosLosJuegos(s)) !== antes) repintarSinEstorbar();
    } catch (e) {
      fallosVivo++;   // se sigue intentando: el marcador revive solo cuando vuelve la red
    } finally {
      clearTimeout(corte);
      consultando = false;
      pintarFrescura();
    }
  }

  /* Qué tan fresco está el marcador: la hora de la última respuesta buena de ESPN. */
  const CARGADA = Date.now();
  function pintarFrescura(linea = document.querySelector(".frescura")) {
    if (!linea) return;
    const base = ultimaConsulta ? ultimaConsulta.getTime() : CARGADA, seg = Math.max(0, Math.round((Date.now() - base) / 1000));
    const caduco = seg > 180;
    const texto = linea.querySelector(".frescura-texto"), boton = linea.querySelector(".frescura-boton");
    linea.classList.toggle("sin-senal", caduco);
    boton.hidden = !caduco;
    texto.textContent = caduco
      ? "Sin señal." + (ultimaConsulta ? " Marcadores de las " + hora(base / 1000) : "")
      : !ultimaConsulta ? "Consultando los marcadores"
      : "Actualizado hace " + (seg < 90 ? Math.max(seg, 1) + " s" : Math.round(seg / 60) + " min");
  }

  /* El navegador nunca cierra un partido: eso lo decide CI, que es la fuente oficial. */
  function efectivo(p) {
    if (p.cerrado) return p;
    const vivo = marcadores.get(p.v + "@" + p.l);
    if (!vivo) return p;
    return Object.assign({}, p, {
      mv: vivo.mv, ml: vivo.ml, g: vivo.g, vivo: vivo.enJuego,
      e: vivo.completado ? "Final · por confirmar" : (vivo.e || p.e),
      porConfirmar: vivo.completado,
    });
  }
  const partidosDe = (s) => s.partidos.map(efectivo);

  /* ═══ encabezado ═══ */
  /* "En vivo" solo cuando de verdad se está jugando algo. Una semana a medias
     un viernes está en curso, no en vivo: antes se encendía en rojo toda la
     semana y ya nadie le creía. */
  function pintarEstado(vista) {
    const s = typeof vista === "number" ? porSemana.get(vista) : porSemana.get(D.activa);
    document.body.classList.toggle("hay-vivo", juegosEnVivo(porSemana.get(D.activa)).length > 0);
    chip.className = "estado";
    if (!s) { chipTxt.textContent = "Temporada " + D.anio; return; }
    const vivos = juegosEnVivo(s).length;
    if (vivos) {
      chip.classList.add("vivo");
      chipTxt.textContent = vivos === 1 ? "1 partido en vivo" : vivos + " partidos en vivo";
    } else if (s.estado === "pendiente") {
      chip.classList.add("esperando");
      chipTxt.textContent = "Picks abiertos · S" + s.n;
    } else if (s.estado === "en_vivo") {
      chipTxt.textContent = "S" + s.n + " · " + s.cerrados + " de " + s.total;
    } else {
      chipTxt.textContent = "Semana " + s.n + " cerrada";
    }
  }

  /* El confeti es para el momento, no para cada visita: una sola vez por semana en
     cada teléfono, cuando la semana acaba de cerrar o cuando ganaste tú. */
  const COLORES = ["#ffd60a", "#ffffff", "#34d680", "#c9d2db"];
  function lanzarConfeti(s) {
    if (suave || leer("angabave.confeti." + s.n)) return;
    const gane = jugador !== null && (s.ganadores || []).includes(jugador);
    if (!gane) return;
    guardar("angabave.confeti." + s.n, "1");
    const lluvia = crear("div", "confetis");
    lluvia.setAttribute("aria-hidden", "true");
    for (let i = 0; i < (gane ? 70 : 40); i++) {
      const p = crear("i", "confeti");
      p.style.left = Math.random() * 100 + "%";
      p.style.background = i % 5 === 4 ? "var(--acento)" : COLORES[i % COLORES.length];
      p.style.setProperty("--d", (2.4 + Math.random() * 1.8).toFixed(2) + "s");
      p.style.setProperty("--x", Math.round(Math.random() * 160 - 80) + "px");
      p.style.setProperty("--r", Math.round(Math.random() * 900 - 450) + "deg");
      p.style.animationDelay = (Math.random() * 0.7).toFixed(2) + "s";
      lluvia.appendChild(p);
    }
    document.body.appendChild(lluvia);
    setTimeout(() => lluvia.remove(), 5500);
  }

  function miPick(s, col) {
    if (jugador === null) return null;
    const fila = s.jugadores.indexOf(jugador);
    if (fila < 0) return null;
    const local = s.picks[fila][col] === 1;
    return { lado: local ? "l" : "v", equipo: local ? s.partidos[col].l : s.partidos[col].v };
  }

  function campeon(s, compacto) {
    if (!s.proyectable) return null;   // la línea de estado de la semana ya lo explica
    const gente = (s.ganadores || []).map(nombre);
    if (!gente.length) return null;
    const oficial = !!s.oficial;
    const caja = crear("div", "campeon " + (oficial ? "oficial" : "provisional") + (compacto ? " compacto" : ""));
    caja.insertAdjacentHTML("beforeend", COPA);
    caja.appendChild(crear("div", "rot", oficial
      ? (gente.length > 1 ? "Ganadores de la semana " + s.n : "Ganador de la semana " + s.n)
      : "Va ganando la semana " + s.n));
    const nombres = crear("div", "nombres");
    nombres.appendChild(nombrar(gente, oficial));
    caja.appendChild(nombres);
    const fila = s.tabla.find((f) => f.pos === 1);
    const ac = fila ? fila.f : 0;
    caja.appendChild(crear("div", "cifra",
      ac + (ac === 1 ? " acierto" : " aciertos") + " de " + s.cerrados +
      (s.cerrados === 1 ? " partido cerrado" : " partidos cerrados")));
    const bolsa = crear("div", "bolsa");
    bolsa.textContent = oficial ? s.premio + (gente.length > 1 ? " c/u" : "")
                                : s.premio_total + " en juego";
    caja.appendChild(bolsa);
    if (oficial) lanzarConfeti(s);
    return caja;
  }

  /* Tu semana como un drive: un trazo por partido, en el orden en que se juegan. */
  function tiraDeLaSemana(s) {
    const tira = crear("div", "progreso-semana");
    tira.setAttribute("aria-hidden", "true");
    let k = 0;
    const trazo = (clase, titulo) => {
      const i = crear("i", clase);
      i.style.setProperty("--k", k++);
      i.title = titulo;
      tira.appendChild(i);
    };
    partidosDe(s).map((p, col) => ({ p, col }))
      .sort((a, b) => (a.p.t || Infinity) - (b.p.t || Infinity) || a.col - b.col)
      .forEach(({ p, col }) => {
        const mio = miPick(s, col), duelo = p.v + " @ " + p.l;
        if (p.cerrado) trazo(mio && p.g === mio.lado ? "ok" : "mal", duelo);
        else if (p.vivo) trazo(!mio || !p.g ? "juega" : p.g === mio.lado ? "gana" : "pierde", duelo);
        else trazo(null, duelo);
      });
    (s.por_entregar || []).forEach((p) => trazo(null, p.v + " @ " + p.l));
    return tira;
  }

  function miSemana(s) {
    if (jugador === null || s.jugadores.indexOf(jugador) < 0) return null;
    const { semana } = numerosDe(jugador, s);
    if (!semana) return null;
    const caja = crear("div", "mi-semana");
    const fila = crear("div", "fila");
    fila.appendChild(crear("b", null, "Tu semana"));
    const enJuego = semana.ganando + semana.perdiendo;
    const faltan = Math.max(0, s.total - semana.jugados);
    fila.appendChild(crear("span", null, s.cerrados >= s.total
      ? semana.ok + (semana.ok === 1 ? " acierto · " : " aciertos · ") + semana.mal + (semana.mal === 1 ? " fallo" : " fallos")
      : semana.ok + " bien · " + semana.mal + " mal · " + faltan + " por jugar"));
    fila.appendChild(crear("span", "rango", ordinal(enJuego ? semana.proy : semana.pos)));
    caja.appendChild(fila);
    caja.appendChild(tiraDeLaSemana(s));
    return caja;
  }

  function vivosPorParticipante(s) {
    const juegos = partidosDe(s);
    const cuenta = new Map();
    s.jugadores.forEach((idx, fila) => {
      let n = 0;
      juegos.forEach((p, col) => {
        if (!p.cerrado && p.g !== null && (p.g === "l") === (s.picks[fila][col] === 1)) n++;
      });
      cuenta.set(idx, n);
    });
    return cuenta;
  }

  function tablaSemana(s) {
    const marco = crear("div", "marco");
    const tabla = crear("table");
    tabla.innerHTML = '<thead><tr><th class="c-pos">#</th><th class="c-nombre">Participante</th>' +
      "<th>Aciertos</th><th>Fallos</th></tr></thead>";
    const cuerpo = crear("tbody");
    const vivos = vivosPorParticipante(s);
    // Dentro de un empate, primero quien va ganando más partidos en este momento.
    const filas = s.tabla.slice().sort((a, b) => a.pos - b.pos || (vivos.get(b.p) || 0) - (vivos.get(a.p) || 0));
    filas.forEach((fila, i) => {
      const tr = crear("tr", (s.oficial && fila.pos === 1 ? "p1" : "") + (fila.p === jugador ? " yo" : "") + " clic");
      tr.style.setProperty("--i", i);
      const lugar = crear("td", "c-pos");
      lugar.appendChild(crear("span", "n", String(fila.pos)));
      tr.appendChild(lugar);
      const quien = crear("td", "c-nombre", nombre(fila.p));
      tr.appendChild(quien);
      const pts = crear("td", "pts", String(fila.f));
      const extra = vivos.get(fila.p) || 0;
      if (extra > 0) {
        const m = crear("span", "chip-vivo", "+" + extra);
        m.title = "Va ganando " + extra + (extra === 1 ? " partido en curso" : " partidos en curso");
        pts.appendChild(m);
      }
      tr.appendChild(pts);
      tr.appendChild(crear("td", "err", String(fila.e)));
      tr.addEventListener("click", () => abrirPerfil(fila.p, quien));
      cuerpo.appendChild(tr);
    });
    tabla.appendChild(cuerpo);
    marco.appendChild(tabla);
    const env = crear("div");
    env.appendChild(marco);
    if (s.tabla.length > 12) {
      ponerFiltro(env, Array.from(cuerpo.children),
        (fila) => fila.children[1].textContent, "Buscar participante…");
    }
    return env;
  }

  /* ═══ todos los partidos de la semana ═══
     Con y sin picks repartidos: lo primero que quiere saber la gente es a qué hora
     juegan, y eso no depende de que ya haya llegado la hoja del organizador. */
  function panelPartidos(s) {
    const raiz = crear("div");
    const juegos = todosLosJuegos(s).map((p, i) => ({ p, i }));

    // Lo que falta por jugarse manda: va arriba. Lo ya jugado queda abajo,
    // del más reciente al más viejo, porque es consulta, no expectativa.
    const bloques = [];
    let mios = [];
    if (equipo) {
      // Tu partido se adelanta solo mientras no haya terminado: una vez
      // cerrado no tiene por qué encabezar nada.
      mios = juegos.filter(({ p }) => (p.v === equipo || p.l === equipo) && !p.cerrado);
      if (mios.length) bloques.push({ etiqueta: "Tu equipo", juegos: mios, suelto: true });
    }

    const resto = juegos.filter((juego) => !mios.includes(juego));
    const porJugar = resto
      .filter(({ p }) => !p.cerrado)
      .sort((a, b) => (a.p.t || Infinity) - (b.p.t || Infinity) || a.i - b.i);
    const jugados = resto
      .filter(({ p }) => p.cerrado)
      .sort((a, b) => (b.p.t || 0) - (a.p.t || 0) || b.i - a.i);

    const agrupar = (lista, titulo) => {
      if (!lista.length) return;
      bloques.push({ etiqueta: titulo, seccion: true });
      lista.forEach((juego) => {
        const etiqueta = juego.p.grupo || "Hora por definir";
        const ultimo = bloques[bloques.length - 1];
        if (ultimo && !ultimo.suelto && !ultimo.seccion && ultimo.etiqueta === etiqueta) {
          ultimo.juegos.push(juego);
        } else {
          bloques.push({ etiqueta, juegos: [juego] });
        }
      });
    };
    agrupar(porJugar, porJugar.length === 1 ? "Falta este" : "Por jugarse");
    agrupar(jugados, "Ya jugados");

    bloques.forEach((bloque) => {
      const cabeza = crear("div", "bloque-hora" + (bloque.seccion ? " seccion" : ""));
      cabeza.appendChild(crear("span", null, bloque.etiqueta));
      raiz.appendChild(cabeza);
      if (bloque.seccion) return;
      const caja = crear("div", "tarjeta lista-juegos");
      bloque.juegos.forEach(({ p }) => caja.appendChild(filaJuego(s, p)));
      raiz.appendChild(caja);
    });
    return raiz;
  }

  /* Al tocar un partido sube una hoja con quién le fue a quién. */
  function abrirPartido(s, p, origen) {
    const col = s ? s.partidos.findIndex((q) => q.v === p.v && q.l === p.l) : -1;
    const caja = crear("div", "detalle-partido");
    const empezo = p.vivo || p.cerrado || p.porConfirmar;
    if (empezo && p.mv !== null && p.mv !== undefined) {
      const marcador = crear("div", "marcador");
      marcador.appendChild(sigla(p.v));
      marcador.appendChild(document.createTextNode(p.mv + " – " + p.ml));
      marcador.appendChild(sigla(p.l));
      caja.appendChild(marcador);
    }
    caja.appendChild(crear("p", "linea-estado", empezo ? (p.e || "Final")
      : p.t ? "Se juega " + cuandoEs(p.t) : "Hora por definir"));
    if (col >= 0) caja.appendChild(tarjetaSplit(s, p, col));
    else caja.appendChild(crear("p", "nota-hoja", "El organizador todavía no reparte los picks de este partido. Puedes elegir el tuyo en Picks."));
    if (s && vistaActual !== s.n) {
      const b = crear("button", "boton-principal", "Ver toda la semana");
      b.type = "button";
      b.addEventListener("click", () => {
        if (hojaAbierta) hojaAbierta.cerrar(true);
        reemplazarEntrada = true;
        pestana = "partidos";
        pestanaElegida = true;
        navegar(s.n);
      });
      caja.appendChild(b);
    }
    abrirHoja(p.v + " @ " + p.l, caja, { origen });
  }

  /* ═══ quién le fue a quién, con consenso ═══ */
  function panelReparto(s) {
    const env = crear("div");
    const lista = crear("select", "ancho");
    lista.innerHTML = '<option value="">Reparto de cada partido</option>';
    s.jugadores.map((i) => [i, nombre(i)]).sort((a, b) => a[1].localeCompare(b[1], "es"))
      .forEach(([i, q]) => { const o = crear("option", null, q); o.value = String(i); lista.appendChild(o); });
    if (jugador !== null && s.jugadores.indexOf(jugador) >= 0) lista.value = String(jugador);
    env.appendChild(lista);
    const destino = crear("div");
    env.appendChild(destino);
    const pintar = () => {
      destino.textContent = "";
      destino.appendChild(lista.value === "" ? repartoPorPartido(s) : boleta(s, Number(lista.value)));
    };
    lista.addEventListener("change", pintar);
    pintar();
    return env;
  }

  function repartoPorPartido(s) {
    const caja = crear("div", "reparto");
    partidosDe(s).forEach((p, col) => caja.appendChild(tarjetaSplit(s, p, col)));
    return caja;
  }

  function tarjetaSplit(s, p, col) {
    const visita = [], casa = [];
    s.jugadores.forEach((idx, fila) => { (s.picks[fila][col] === 1 ? casa : visita).push(idx); });
    const total = visita.length + casa.length || 1;
    const mayor = Math.max(visita.length, casa.length) / total;

    const nodo = crear("article", "split");
    const cab = crear("div", "cab");
    cab.appendChild(crear("span", "vs", p.v + " @ " + p.l));
    if (mayor >= 0.9) cab.appendChild(crear("span", "sello-consenso unanime", "casi unánime"));
    else if (mayor <= 0.6) cab.appendChild(crear("span", "sello-consenso dividido", "dividido"));
    cab.appendChild(crear("span", "mr", p.mv === null || p.mv === undefined ? (p.e || "") : p.mv + "–" + p.ml));
    nodo.appendChild(cab);

    const balanza = crear("div", "balanza");
    const iv = crear("i"), il = crear("i");
    iv.style.background = (D.colores[p.v] || {}).local || "var(--tenue)";
    il.style.background = (D.colores[p.l] || {}).local || "var(--acento)";
    balanza.appendChild(iv); balanza.appendChild(il);
    nodo.appendChild(balanza);
    requestAnimationFrame(() => {
      iv.style.width = (visita.length / total) * 100 + "%";
      il.style.width = (casa.length / total) * 100 + "%";
    });

    const cuentas = crear("div", "cuenta-lado");
    const izq = crear("span", null, p.v + " · " + visita.length);
    izq.style.color = iv.style.background;
    const der = crear("span", null, casa.length + " · " + p.l);
    der.style.color = il.style.background;
    cuentas.appendChild(izq); cuentas.appendChild(der);
    nodo.appendChild(cuentas);

    [[visita, "v"], [casa, "l"]].forEach(([quienes, lado]) => {
      const fila = crear("div", "gente");
      quienes.slice().sort((a, b) => nombre(a).localeCompare(nombre(b), "es")).forEach((idx) => {
        const et = crear("span", p.cerrado ? (p.g === lado ? "ok" : "no") : null, nombre(idx));
        if (idx === jugador) et.classList.add("tu");
        fila.appendChild(et);
      });
      nodo.appendChild(fila);
    });
    return nodo;
  }

  function boleta(s, idx) {
    const fila = s.jugadores.indexOf(idx);
    const caja = crear("div", "boleta");
    if (fila < 0) return caja;
    partidosDe(s).forEach((p, col) => {
      const local = s.picks[fila][col] === 1;
      const lado = local ? "l" : "v";
      let clase = "", sello = "esp", simbolo = "·";
      if (p.cerrado) {
        if (p.g === "x") { clase = " fallo"; sello = "no"; simbolo = "="; }
        else if (p.g === lado) { clase = " acierto"; sello = "ok"; simbolo = "✓"; }
        else { clase = " fallo"; sello = "no"; simbolo = "✗"; }
      }
      const linea = crear("div", "linea" + clase);
      linea.style.setProperty("--i", Math.min(col, 12));
      linea.appendChild(crear("span", "sello " + sello, simbolo));
      const texto = crear("span", "vs");
      texto.appendChild(local ? crear("span", null, p.v) : crear("b", null, p.v));
      texto.appendChild(document.createTextNode(" @ "));
      texto.appendChild(local ? crear("b", null, p.l) : crear("span", null, p.l));
      linea.appendChild(texto);
      linea.appendChild(crear("span", "mini", p.mv === null ? p.e : p.mv + "–" + p.ml));
      caja.appendChild(linea);
    });
    return caja;
  }

  /* Una línea que diga qué falta. En segunda persona cuando es tu fila: es
     la diferencia entre leer una tabla y que te hablen a ti. */
  function queSignifica(g, total, soyYo) {
    const varios = g.gente.length > 1;
    if (g.suma >= total) {
      if (soyYo) {
        return g.solo === 0
          ? "Ya aseguraste el primer lugar, compartido."
          : "Ya aseguraste el primer lugar.";
      }
      if (varios) return "Ya aseguraron el primer lugar, compartido.";
      return g.solo === 0 ? "Ya aseguró el primer lugar, compartido." : "Ya aseguró el primer lugar.";
    }

    const equipos = g.req.map((x) => x.split("→")[1]);
    if (equipos.length) {
      const verbo = soyYo ? "Necesitas" : (varios ? "Necesitan" : "Necesita");
      if (equipos.length === 1) return verbo + " que gane " + equipos[0] + ".";
      if (equipos.length === 2) return verbo + " que ganen " + equipos.join(" y ") + ".";
      return verbo + " que ganen " + equipos.slice(0, 2).join(", ") +
        " y " + (equipos.length - 2) + " más.";
    }

    if (g.solo === 0) {
      return soyYo ? "Solo te alcanza para empatar el primer lugar."
                   : "Solo le alcanza para empatar el primer lugar.";
    }
    if (g.emp === 0) return soyYo ? "Si llegas, llegas solo." : "Si llega, llega solo.";
    return (soyYo ? "Ganas" : "Gana") + " solo en " + g.solo + " y " +
      (soyYo ? "empatas" : "empata") + " en " + g.emp + ".";
  }

  function panelEscenarios(s) {
    const total = s.combinaciones || 0;
    const filas = Object.entries(s.panorama || {})
      .map(([i, [solo, emp, req]]) => ({
        idx: Number(i), solo, emp, suma: solo + emp,
        req: (req || []).map(([clave, equipo]) => clave + "→" + equipo),
      }))
      .sort((a, b) => b.suma - a.suma || b.solo - a.solo ||
        nombre(a.idx).localeCompare(nombre(b.idx), "es"));
    if (!total || !filas.length) {
      return aviso("Sin escenarios que calcular", "La semana ya cerró: el primer lugar está definido.");
    }

    // Los que están en la misma situación van juntos: con un partido por jugar
    // media quiniela comparte el mismo porcentaje y serían seis filas idénticas.
    const grupos = [];
    filas.forEach((f) => {
      const ultimo = grupos[grupos.length - 1];
      if (ultimo && ultimo.suma === f.suma && ultimo.solo === f.solo) {
        ultimo.gente.push(f.idx);
        // Lo que el grupo necesita en común: si a uno no le hace falta, al
        // grupo tampoco se lo pedimos.
        ultimo.req = ultimo.req.filter((x) => f.req.includes(x));
      } else {
        grupos.push({ suma: f.suma, solo: f.solo, emp: f.emp, gente: [f.idx], req: f.req.slice() });
      }
    });

    const env = crear("div");
    const faltan = s.total - s.cerrados;
    const intro = crear("p", "mini");
    intro.style.margin = "0 0 8px";
    intro.style.textAlign = "left";
    intro.textContent = "Falta" + (faltan === 1 ? " 1 partido" : "n " + faltan + " partidos") +
      ": " + total.toLocaleString("es-MX") +
      (total === 1 ? " desenlace posible." : " desenlaces posibles.");
    env.appendChild(intro);

    const caja = crear("div", "escena");
    const tope = grupos[0].suma || 1;
    const mio = grupos.findIndex((g) => g.gente.includes(jugador));
    const visibles = grupos.slice(0, 8);
    if (mio >= 8) visibles.push(grupos[mio]);

    visibles.forEach((g, i) => {
      const puesto = i < 8 ? i + 1 : mio + 1;
      const soyYo = g.gente.includes(jugador);
      const nodo = crear("div", "candidato" + (puesto === 1 ? " lider" : "") + (soyYo ? " yo" : ""));
      nodo.style.setProperty("--i", Math.min(i, 12));
      nodo.appendChild(crear("span", "n", String(puesto)));

      const quien = crear("span", "quien");
      quien.appendChild(nombrar(g.gente.map(nombre), false));
      nodo.appendChild(quien);
      nodo.appendChild(crear("span", "pct", ((g.suma / total) * 100).toFixed(0) + "%"));

      const barra = crear("div", "progreso");
      const relleno = crear("i");
      barra.appendChild(relleno);
      nodo.appendChild(barra);

      const nota = crear("div", "que-significa" + (soyYo ? " tuya" : ""));
      nota.textContent = queSignifica(g, total, soyYo);
      nodo.appendChild(nota);

      caja.appendChild(nodo);
      requestAnimationFrame(() => { relleno.style.width = (g.suma / tope) * 100 + "%"; });
    });
    env.appendChild(caja);
    return env;
  }

  /* Si la tabla oficial lleva mucho sin recalcularse y hay partidos abiertos,
     se dice. Una página que se ve perfecta con números viejos es peor que una
     que avisa. Los marcadores sí siguen vivos: esos los pide el navegador. */
  /* Solo avisa si de verdad puede haber algo atrasado: un partido que ya
     arrancó y que el sitio todavía no cierra. Un viernes sin partidos la tabla
     no tiene por qué recalcularse, y avisar "10 horas sin recalcularse" era
     una falsa alarma que asustaba a todos. Se cuenta desde el último latido o
     desde que arrancó el partido, lo más reciente: sin novedades el sitio ya no
     se publica, y antes del partido nadie tenía por qué recalcular. Doce horas
     después de la patada ya no se está jugando: estará pospuesto. */
  function avisoDeRezago(s) {
    if (!s || s.cerrados >= s.total || !latidoVisto) return null;
    const ahora = Date.now();
    const arrancados = s.partidos.concat(s.por_entregar || [])
      .filter((p) => !p.cerrado && p.t && p.t * 1000 <= ahora && ahora - p.t * 1000 < 12 * 3600e3);
    if (!arrancados.length) return null;
    const desde = Math.max(latido, Math.min(...arrancados.map((p) => p.t * 1000)));
    const minutos = Math.floor((ahora - desde) / 60000);
    if (!Number.isFinite(minutos) || minutos < (D.rezago || 35)) return null;

    const caja = crear("div", "rezago");
    caja.appendChild(crear("span", "icono", "⚠"));
    const texto = crear("span");
    const horas = Math.floor(minutos / 60);
    const cuanto = horas >= 1
      ? horas + (horas === 1 ? " hora" : " horas")
      : minutos + " minutos";
    texto.appendChild(crear("b", null, "La tabla lleva " + cuanto + " sin recalcularse."));
    texto.appendChild(document.createTextNode(
      " Los marcadores de abajo sí están al día, pero los aciertos y el ganador " +
      "pueden estar atrasados."
    ));
    caja.appendChild(texto);
    return caja;
  }

  /* ═══ generador de picks para la semana que aún no se carga ═══
     No manda nada ni guarda nada aquí: arma una imagen membretada para que
     cada quien la mande por su cuenta antes de que cierre la tanda. */
  const LLAVE_BORRADOR = (n) => "angabave.borrador." + n;

  /* La marca y la palabra en la imagen de picks: las mismas rutas y colores de
     quiniela/marca.py, para que la imagen y el portal no se desalineen. */
  function marcaEnLienzo(ctx, x, y, lado) {
    const L = D.logo, u = lado / 64;
    ctx.save();
    ctx.translate(x, y);
    ctx.scale(u, u);
    ctx.fillStyle = L.blanco;
    ctx.fill(new Path2D(L.rutas.a));
    ctx.fillStyle = L.oro;
    ctx.fill(new Path2D(L.rutas.linea));
    ctx.restore();
  }

  function palabraEnLienzo(ctx, x, y, alto) {
    const L = D.logo, u = alto / L.alto_palabra;
    ctx.save();
    ctx.translate(x, y + u);
    ctx.scale(u, u);
    ctx.fillStyle = L.blanco;
    ctx.fill(new Path2D(L.rutas.palabra), "evenodd");
    ctx.restore();
  }

  /* La letra de marcador para la imagen: la misma Oswald que ya viaja en la página, pero
     completa, cargada solo al generar. Si algo falla, se usa la del sistema. */
  let letraLienzo = null;
  function letraDeLienzo() {
    if (letraLienzo) return letraLienzo;
    letraLienzo = (async () => {
      try {
        if (typeof FontFace === "undefined" || !document.fonts) return false;
        const css = Array.from(document.querySelectorAll("style")).map((n) => n.textContent).join("");
        const m = css.match(/font-family:'Rotulo'[^}]*?url\((data:[^)]+)\)/);
        if (!m) return false;
        const cara = new FontFace("RotuloLienzo", "url(" + m[1] + ")");
        await cara.load();
        document.fonts.add(cara);
        return true;
      } catch (e) {
        return false;
      }
    })();
    return letraLienzo;
  }

  /* Copia en el lienzo el campo que se ve en el portal, con otro texto en la zona de
     anotación y sin el dorado o el hueco del último partido. Lo deja como estaba. */
  async function campoEnLienzo(ctx, ancho, alto, texto, escala) {
    // Las dos capas de la toma del teléfono (pasto y luces) comparten coordenadas: se
    // encimen igual que en la página, aunque en esta pantalla estén ocultas.
    const capas = [".cancha svg.plano.en-telefono", ".cancha svg.luz.en-telefono"]
      .map((sel) => document.querySelector(sel)).filter(Boolean);
    if (!capas.length || !capas[0].viewBox || !capas[0].viewBox.baseVal.width) return false;
    const estado = document.documentElement.getAttribute("data-campo");
    let copias;
    try {
      document.documentElement.removeAttribute("data-campo");
      pintarNombreCampo(texto);
      copias = capas.map((fuente) => {
        const copia = fuente.cloneNode(true);
        const originales = fuente.querySelectorAll("*"), duplicados = copia.querySelectorAll("*");
        originales.forEach((n, i) => {
          const estilo = getComputedStyle(n);
          ["fill", "fill-opacity", "stroke", "stroke-width", "stroke-opacity", "opacity", "stop-color", "stop-opacity", "display", "visibility"].forEach((prop) => {
            const valor = estilo.getPropertyValue(prop);
            if (valor) duplicados[i].style.setProperty(prop, valor);
          });
        });
        copia.removeAttribute("class");
        copia.setAttribute("xmlns", "http://www.w3.org/2000/svg");
        return copia;
      });
    } finally {
      if (estado) document.documentElement.setAttribute("data-campo", estado);
      pintarCampo();
    }
    const vista = capas[0].viewBox.baseVal;
    const cubre = Math.max(ancho / vista.width, alto / vista.height);
    const w = vista.width * cubre, h = vista.height * cubre;
    const imagenes = [];
    for (const copia of copias) {
      copia.setAttribute("width", Math.round(w * escala));
      copia.setAttribute("height", Math.round(h * escala));
      const url = URL.createObjectURL(new Blob([new XMLSerializer().serializeToString(copia)], { type: "image/svg+xml" }));
      try {
        const img = new Image();
        await new Promise((listo, falla) => { img.onload = listo; img.onerror = falla; img.src = url; });
        imagenes.push(img);
      } finally {
        URL.revokeObjectURL(url);
      }
    }
    ctx.save();
    ctx.beginPath();
    ctx.rect(0, 0, ancho, alto);
    ctx.clip();
    imagenes.forEach((img) => ctx.drawImage(img, (ancho - w) / 2, 0, w, h));
    ctx.restore();
    return true;
  }


  /* Arma la imagen membretada con los picks elegidos y la comparte o descarga. */
  async function exportarPicks(s, elegidos, porClave) {
    if (document.fonts && document.fonts.ready) await document.fonts.ready;

    const ANCHO = 1080, MARGEN = 48;
    // Los partidos salen de los que ofrece este generador (porClave), no de
    // s.partidos: con la semana a medias, s.partidos solo trae la tanda ya
    // cargada y la imagen salía vacía. El orden es el de la NFL, el mismo en
    // que se armó porClave.
    const claves = [...porClave.keys()].filter((clave) => elegidos.has(clave));
    if (!claves.length) return;

    const conLetra = await letraDeLienzo();
    const sistema = "-apple-system, Segoe UI, Roboto, Helvetica, Arial, sans-serif";
    const cuerpo = (peso, tam) => peso + " " + tam + "px " + sistema;
    const rotulo = (tam) => "500 " + tam + "px " + (conLetra ? "RotuloLienzo, " : "") + sistema;
    const CDMX = "America/Mexico_City";
    const diaDe = (p) => !p.t ? "POR CONFIRMAR" : new Date(p.t * 1000)
      .toLocaleDateString("es-MX", { weekday: "long", day: "numeric", month: "long", timeZone: CDMX }).replace(",", "").toUpperCase();
    const horaDe = (p) => !p.t ? "" : new Date(p.t * 1000)
      .toLocaleTimeString("es-MX", { hour: "2-digit", minute: "2-digit", hour12: false, timeZone: CDMX });

    // Los partidos se agrupan por día; dentro de cada día, tarjetas en dos columnas (una
    // sola si son 6 o menos en total), en el orden de la NFL.
    const columnas = claves.length > 6 ? 2 : 1;
    const grupos = [];
    claves.forEach((clave) => {
      const p = porClave.get(clave), dia = diaDe(p);
      if (!grupos.length || grupos[grupos.length - 1].dia !== dia) grupos.push({ dia, picks: [] });
      grupos[grupos.length - 1].picks.push({ p, lado: elegidos.get(clave) });
    });
    const CAMPO = 560, ALTO_DIA = 64, ALTO_TARJETA = 150, SEP = 16, PIE = 150, escala = 2;
    const anchoTarjeta = (ANCHO - MARGEN * 2 - SEP * (columnas - 1)) / columnas;
    const alto = CAMPO + 24 + grupos.reduce((suma, g) => suma + ALTO_DIA + Math.ceil(g.picks.length / columnas) * (ALTO_TARJETA + SEP), 0) + PIE;
    const enZona = equipo || (jugador !== null ? nombre(jugador) : "");
    const titular = jugador !== null ? nombre(jugador).toUpperCase() : "MIS PICKS";
    const sello = new Date().toLocaleString("es-MX", { dateStyle: "medium", timeStyle: "short", timeZone: CDMX });
    const direccion = location.host + location.pathname.replace(/index\.html$/, "").replace(/\/$/, "");

    const armar = async (conCampo) => {
      const lienzo = document.createElement("canvas");
      lienzo.width = ANCHO * escala;
      lienzo.height = alto * escala;
      const ctx = lienzo.getContext("2d");
      ctx.scale(escala, escala);
      const caja = (x, y, w, h, r) => {
        ctx.beginPath();
        // roundRect no existe en Safari anterior a iOS 16: ahí va con esquinas rectas.
        if (ctx.roundRect) ctx.roundRect(x, y, w, h, r);
        else ctx.rect(x, y, w, h);
      };
      const espaciado = (px) => { if ("letterSpacing" in ctx) ctx.letterSpacing = px + "px"; };

      ctx.fillStyle = "#060a08";
      ctx.fillRect(0, 0, ANCHO, alto);

      // Arriba, el mismo campo del portal con tu equipo (o tu nombre) en la zona de anotación.
      let hayCampo = false;
      if (conCampo) {
        try { hayCampo = await campoEnLienzo(ctx, ANCHO, CAMPO, enZona, escala); } catch (e) { hayCampo = false; }
      }
      if (!hayCampo) {
        ctx.fillStyle = "#0b3a24";
        ctx.fillRect(0, 0, ANCHO, CAMPO);
        ctx.fillStyle = "rgba(243,246,244,.16)";
        for (let y = 40; y < CAMPO; y += 92) ctx.fillRect(0, y, ANCHO, 2);
      }
      let sombra = ctx.createLinearGradient(0, 0, 0, 140);
      sombra.addColorStop(0, "rgba(6,10,8,.8)");
      sombra.addColorStop(1, "rgba(6,10,8,0)");
      ctx.fillStyle = sombra;
      ctx.fillRect(0, 0, ANCHO, 140);
      sombra = ctx.createLinearGradient(0, CAMPO - 230, 0, CAMPO);
      sombra.addColorStop(0, "rgba(6,10,8,0)");
      sombra.addColorStop(.55, "rgba(6,10,8,.7)");
      sombra.addColorStop(1, "rgba(6,10,8,.94)");
      ctx.fillStyle = sombra;
      ctx.fillRect(0, CAMPO - 230, ANCHO, 230);

      marcaEnLienzo(ctx, MARGEN, 36, 56);
      palabraEnLienzo(ctx, MARGEN + 70, 45, 28);
      ctx.textBaseline = "alphabetic";
      ctx.textAlign = "right";
      ctx.fillStyle = "#d7ddd9";
      ctx.font = cuerpo(700, 20);
      espaciado(3);
      ctx.fillText("QUINIELA NFL " + D.anio, ANCHO - MARGEN, 74);
      ctx.textAlign = "left";

      // El sello dorado con la semana, como boleta oficial.
      const radio = 92, sx = ANCHO - MARGEN - radio, sy = CAMPO - 148;
      ctx.save();
      ctx.translate(sx, sy);
      ctx.rotate(-0.2);
      ctx.fillStyle = "rgba(6,10,8,.55)";
      ctx.beginPath();
      ctx.arc(0, 0, radio, 0, Math.PI * 2);
      ctx.fill();
      ctx.strokeStyle = "#ffd60a";
      ctx.lineWidth = 4;
      ctx.stroke();
      ctx.lineWidth = 1.5;
      ctx.beginPath();
      ctx.arc(0, 0, radio - 13, 0, Math.PI * 2);
      ctx.stroke();
      ctx.fillStyle = "#ffd60a";
      ctx.textAlign = "center";
      ctx.font = cuerpo(800, 13);
      espaciado(0);
      const anillo = "PICKS OFICIALES · ANGABAVE · " + D.anio + " · ";
      for (let i = 0; i < anillo.length; i++) {
        ctx.save();
        ctx.rotate((i / anillo.length) * Math.PI * 2);
        ctx.fillText(anillo[i], 0, -(radio - 24));
        ctx.restore();
      }
      ctx.font = rotulo(20);
      ctx.fillText("SEMANA", 0, -10);
      ctx.font = rotulo(58);
      ctx.fillText(String(s.n), 0, 44);
      ctx.restore();
      ctx.textAlign = "left";

      ctx.fillStyle = "#ffd60a";
      ctx.font = rotulo(30);
      espaciado(4);
      ctx.fillText("MIS PICKS", MARGEN, CAMPO - 126);
      espaciado(0);
      let tam = 96;
      ctx.font = rotulo(tam);
      const ancholibre = ANCHO - MARGEN * 2 - radio * 2 - 20;
      while (tam > 40 && ctx.measureText(titular).width > ancholibre) ctx.font = rotulo(--tam);
      ctx.fillStyle = "#f3f6f4";
      ctx.fillText(titular, MARGEN, CAMPO - 38);
      // La línea amarilla de primera y diez es la frontera, como en el portal.
      ctx.fillStyle = "#ffd60a";
      ctx.fillRect(0, CAMPO - 4, ANCHO, 8);

      // Un equipo dentro de su tarjeta: el elegido lleno de sus colores, con un brillo
      // de jersey y la etiqueta PICK; el otro, solo con contorno y en gris.
      const bloque = (eq, elegido, x, y, w, h) => {
        const col = D.colores[eq] || {};
        const sigla = D.siglas[eq] || eq.slice(0, 3).toUpperCase();
        caja(x, y, w, h, 14);
        if (elegido) {
          ctx.fillStyle = col.local || "#ffd60a";
          ctx.fill();
          ctx.save();
          caja(x, y, w, h, 14);
          ctx.clip();
          ctx.fillStyle = "rgba(255,255,255,.13)";
          ctx.beginPath();
          ctx.moveTo(x + w * .52, y);
          ctx.lineTo(x + w * .74, y);
          ctx.lineTo(x + w * .5, y + h);
          ctx.lineTo(x + w * .28, y + h);
          ctx.closePath();
          ctx.fill();
          ctx.restore();
        } else {
          ctx.strokeStyle = "#26302b";
          ctx.lineWidth = 2;
          ctx.stroke();
        }
        const tinta = elegido ? col.local_texto || "#060a08" : "#5b6661";
        ctx.fillStyle = tinta;
        ctx.font = rotulo(columnas === 2 ? 46 : 52);
        const anchoSigla = ctx.measureText(sigla).width;
        ctx.fillText(sigla, x + 16, y + (columnas === 2 ? 52 : h / 2 + 18));
        ctx.font = cuerpo(elegido ? 700 : 500, columnas === 2 ? 19 : 24);
        if (columnas === 2) ctx.fillText(eq, x + 16, y + h - 14);
        else ctx.fillText(eq, x + 16 + anchoSigla + 14, y + h / 2 + 10);
        if (elegido) {
          ctx.font = cuerpo(800, 14);
          espaciado(2);
          const ancho = ctx.measureText("PICK").width + 30;
          ctx.fillStyle = tinta;
          caja(x + w - ancho - 10, y + 10, ancho, 26, 13);
          ctx.fill();
          ctx.fillStyle = col.local || "#ffd60a";
          ctx.fillText("PICK", x + w - ancho + 12, y + 28);
          espaciado(0);
          ctx.strokeStyle = col.local || "#ffd60a";
          ctx.lineWidth = 2.5;
          ctx.beginPath();
          ctx.moveTo(x + w - ancho, y + 23);
          ctx.lineTo(x + w - ancho + 4, y + 27);
          ctx.lineTo(x + w - ancho + 10, y + 19);
          ctx.stroke();
        }
      };

      let y = CAMPO + 24;
      grupos.forEach((g) => {
        ctx.fillStyle = "#ffd60a";
        ctx.font = rotulo(26);
        espaciado(3);
        ctx.fillText(g.dia, MARGEN, y + 42);
        const anchoDia = ctx.measureText(g.dia).width;
        espaciado(0);
        ctx.fillStyle = "#1e2622";
        ctx.fillRect(MARGEN + anchoDia + 18, y + 33, ANCHO - MARGEN * 2 - anchoDia - 18, 2);
        y += ALTO_DIA;
        g.picks.forEach((pk, i) => {
          const x = MARGEN + (i % columnas) * (anchoTarjeta + SEP);
          const yt = y + Math.floor(i / columnas) * (ALTO_TARJETA + SEP);
          const p = pk.p;
          ctx.fillStyle = "#101613";
          caja(x, yt, anchoTarjeta, ALTO_TARJETA, 22);
          ctx.fill();
          ctx.fillStyle = "#a7b1ab";
          ctx.font = cuerpo(600, 18);
          espaciado(1);
          ctx.fillText(horaDe(p) || "POR CONFIRMAR", x + 18, yt + 30);
          espaciado(0);
          const arroba = 34, bx = x + 14, by = yt + 44, bh = ALTO_TARJETA - 58;
          const bw = (anchoTarjeta - 28 - arroba) / 2;
          bloque(p.v, pk.lado === "v", bx, by, bw, bh);
          ctx.fillStyle = "#5b6661";
          ctx.font = cuerpo(700, 22);
          ctx.textAlign = "center";
          ctx.fillText("@", bx + bw + arroba / 2, by + bh / 2 + 8);
          ctx.textAlign = "left";
          bloque(p.l, pk.lado === "l", bx + bw + arroba, by, bw, bh);
        });
        y += Math.ceil(g.picks.length / columnas) * (ALTO_TARJETA + SEP);
      });

      const yp = alto - PIE;
      ctx.fillStyle = "#1e2622";
      ctx.fillRect(MARGEN, yp + 20, ANCHO - MARGEN * 2, 2);
      ctx.fillStyle = "#ffd60a";
      ctx.font = rotulo(40);
      ctx.fillText(claves.length === 1 ? "1 PICK" : claves.length + " PICKS", MARGEN, yp + 80);
      marcaEnLienzo(ctx, ANCHO - MARGEN - 44, yp + 46, 44);
      ctx.fillStyle = "#a7b1ab";
      ctx.font = cuerpo(500, 20);
      ctx.fillText("Hecha el " + sello + "  ·  Para " + D.correo, MARGEN, yp + 120);
      ctx.textAlign = "right";
      ctx.fillText(direccion, ANCHO - MARGEN, yp + 120);
      ctx.textAlign = "left";
      return lienzo;
    };

    const titulo = "Picks semana " + s.n + (jugador !== null ? " · " + nombre(jugador) : "");
    const r = abrirRevelado(titulo);
    let blob = null;
    try {
      // Si el navegador no deja leer el lienzo con el campo dibujado, se arma sin él.
      let lienzo = await armar(true);
      try { lienzo.getContext("2d").getImageData(0, 0, 1, 1); } catch (e) { lienzo = await armar(false); }
      // JPEG: con el campo y las sombras, un PNG pesaría varias veces más.
      blob = await new Promise((listo) => lienzo.toBlob(listo, "image/jpeg", 0.9));
    } catch (e) {
      console.error(e);
    }
    if (!blob) {
      r.estado.textContent = "No se pudo armar la imagen. Cierra y vuelve a intentar.";
      return;
    }
    const archivo = new File([blob], "picks-semana-" + s.n + ".jpg", { type: "image/jpeg" });
    const url = URL.createObjectURL(blob);
    r.alCerrar(() => URL.revokeObjectURL(url));
    const img = new Image();
    img.alt = titulo;
    img.src = url;
    // Espera a que cargue, pero sin colgarse si el teléfono pausa la página.
    await Promise.race([new Promise((listo) => { img.onload = listo; img.onerror = listo; }), new Promise((listo) => setTimeout(listo, 1500))]);
    r.marco.append(img);
    r.estado.textContent = "Semana " + s.n + " · " + (claves.length === 1 ? "1 pick" : claves.length + " picks");
    r.capa.classList.add("listo");
    festejarRevelado(r.capa);
    const compartible = !!(navigator.canShare && navigator.canShare({ files: [archivo] }));
    const boton = crear("button", "revelado-mandar");
    boton.type = "button";
    boton.textContent = compartible ? "Mandar" : "Descargar imagen";
    boton.addEventListener("click", async () => {
      // Se comparte dentro del toque, así el teléfono siempre abre su menú.
      if (compartible) {
        try { await navigator.share({ files: [archivo], title: titulo }); return; }
        catch (e) { if (e && e.name === "AbortError") return; }
      }
      const enlace = document.createElement("a");
      enlace.href = url;
      enlace.download = archivo.name;
      document.body.appendChild(enlace);
      enlace.click();
      enlace.remove();
    });
    r.acciones.append(boton);
    boton.focus({ preventScroll: true });
  }

  /* La pantalla donde aparece la imagen: luces de estadio, la imagen que se escanea de arriba
     abajo, un brillo y confeti. Se cierra con la ×, Esc o Atrás. */
  function abrirRevelado(titulo) {
    const capa = crear("div", "revelado");
    capa.setAttribute("role", "dialog");
    capa.setAttribute("aria-modal", "true");
    capa.setAttribute("aria-label", titulo);
    const cerrarBoton = crear("button", "revelado-cerrar");
    cerrarBoton.type = "button";
    cerrarBoton.setAttribute("aria-label", "Cerrar");
    cerrarBoton.textContent = "×";
    const estado = crear("p", "revelado-estado");
    estado.textContent = "Armando tus picks…";
    const marco = crear("div", "revelado-marco");
    const acciones = crear("div", "revelado-acciones");
    capa.append(cerrarBoton, estado, marco, acciones);
    document.body.append(capa);
    const pendientes = [];
    const tecla = (e) => { if (e.key === "Escape") cerrar(); };
    function cerrar() {
      if (!capa.isConnected) return;
      capa.remove();
      document.removeEventListener("keydown", tecla);
      window.removeEventListener("popstate", cerrar);
      pendientes.forEach((f) => f());
    }
    cerrarBoton.addEventListener("click", cerrar);
    document.addEventListener("keydown", tecla);
    window.addEventListener("popstate", cerrar);
    return { capa, estado, marco, acciones, alCerrar: (f) => pendientes.push(f) };
  }

  function festejarRevelado(capa) {
    if (suave) return;
    const tuyo = equipo && D.colores[equipo] ? D.colores[equipo].local : "#34d680";
    const colores = [tuyo, "#ffd60a", "#f3f6f4"];
    for (let i = 0; i < 30; i++) {
      const pieza = crear("i", "revelado-pieza");
      pieza.style.left = Math.random() * 100 + "%";
      pieza.style.background = colores[i % colores.length];
      pieza.style.setProperty("--dx", Math.round(Math.random() * 140 - 70) + "px");
      pieza.style.setProperty("--giro", Math.round(Math.random() * 900 - 450) + "deg");
      pieza.style.animationDelay = (0.6 + Math.random() * 0.3).toFixed(2) + "s";
      capa.append(pieza);
      setTimeout(() => pieza.remove(), 2600);
    }
    if (navigator.vibrate) navigator.vibrate([12, 40, 18]);
  }

  function moduloPicks(s, lista, tandas, parcial) {
    const elegidos = new Map();   // clave del partido -> "v" | "l"
    try {
      const guardado = JSON.parse(leer(LLAVE_BORRADOR(s.n)) || "{}");
      Object.entries(guardado).forEach(([clave, lado]) => elegidos.set(clave, lado));
    } catch (e) { /* borrador ilegible: se empieza de cero */ }

    const caja = crear("div", "generador");
    const explica = crear("p", "pie-gen");
    explica.textContent = (parcial ? "Son los que el organizador todavía no reparte. " : "") +
      "Elige los que quieras y manda la imagen al organizador: aquí no se registra nada.";
    caja.appendChild(explica);

    // A nombre de quién va la imagen ya lo dice la barra de arriba; solo se
    // pide el nombre si falta.
    if (jugador === null) {
      caja.appendChild(crear("div", "quien-soy", "Elige tu nombre arriba para que la imagen lo lleve."));
    }
    if ((tandas || []).length === 1) caja.classList.add("una-tanda");

    const porClave = new Map((lista || []).map((p) => [p.v + "@" + p.l, p]));
    const filas = new Map();
    const ahora = Date.now();

    (tandas || []).forEach((tanda) => {
      const bloque = crear("div", "tanda");
      const cuantos = tanda.claves.length;
      const vencida = new Date(tanda.cierre).getTime() < ahora;
      // Con una sola tanda, a cuántos y hasta cuándo ya lo dice el titular.
      if (tandas.length > 1 || vencida) {
        const cab = crear("div", "cab");
        cab.appendChild(crear("span", null, cuantos === 1 ? "1 partido" : cuantos + " partidos"));
        cab.appendChild(crear("em", vencida ? "vencida" : null,
          vencida ? "cerró el " + tanda.cierre_texto : "hasta el " + tanda.cierre_texto));
        bloque.appendChild(cab);
      }

      let ultimoDia = null;
      tanda.claves.forEach((clave) => {
        const p = porClave.get(clave);
        if (!p) return;
        if (p.grupo !== ultimoDia) {
          ultimoDia = p.grupo;
          bloque.appendChild(crear("div", "dia-pick", p.grupo));
        }
        const fila = crear("div", "duelo-pick");
        filas.set(clave, fila);
        [["v", p.v], ["l", p.l]].forEach(([lado, eq], i) => {
          const boton = crear("button", "opcion");
          boton.type = "button";
          const color = D.colores[eq] || {};
          if (color.local) {
            boton.style.setProperty("--c", color.local);
            boton.style.setProperty("--c-txt", color.local_texto || "#07090b");
          }
          boton.setAttribute("aria-pressed", String(elegidos.get(clave) === lado));
          boton.appendChild(crear("span", "sig", D.siglas[eq] || eq.slice(0, 3).toUpperCase()));
          boton.appendChild(crear("span", "nom", eq));
          boton.addEventListener("click", (e) => {
            // El color llena el botón desde donde tocaste.
            const r = boton.getBoundingClientRect();
            boton.style.setProperty("--tx", (e.detail ? e.clientX - r.left : r.width / 2) + "px");
            boton.style.setProperty("--ty", (e.detail ? e.clientY - r.top : r.height / 2) + "px");
            if (navigator.vibrate) navigator.vibrate(8);
            if (elegidos.get(clave) === lado) elegidos.delete(clave);
            else elegidos.set(clave, lado);
            pintarFila(clave);
            guardar(LLAVE_BORRADOR(s.n), JSON.stringify(Object.fromEntries(elegidos)));
            refrescar();
          });
          fila.appendChild(boton);
          if (i === 0) fila.appendChild(crear("span", "vs", "@"));
        });
        bloque.appendChild(fila);
      });
      caja.appendChild(bloque);
    });

    const acciones = crear("div", "acciones-gen");
    const avance = crear("i", "avance");
    acciones.appendChild(avance);
    // Borrar va al otro extremo de Generar, y se puede deshacer.
    const limpiar = crear("button", "borrar");
    limpiar.type = "button";
    limpiar.setAttribute("aria-label", "Borrar mis picks");
    limpiar.innerHTML = '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4.5 7h15M10 11v6M14 11v6M6 7l1 12.5a1.5 1.5 0 0 0 1.5 1.4h7a1.5 1.5 0 0 0 1.5-1.4L18 7M9 7V4.5h6V7"/></svg>';
    const cuenta = crear("span", "cuenta");
    const descargar = crear("button", "boton", "Generar imagen");
    descargar.type = "button";
    acciones.appendChild(limpiar);
    acciones.appendChild(cuenta);
    acciones.appendChild(descargar);
    caja.appendChild(acciones);

    const nota = crear("p", "aviso-gen");
    nota.innerHTML = "Al generarla se abre compartir o se descarga. " +
      'Mándala a <a href="mailto:' + D.correo + '?subject=' +
      encodeURIComponent("Picks semana " + s.n + (jugador !== null ? " · " + nombre(jugador) : "")) +
      '">' + D.correo + "</a>.";
    caja.appendChild(nota);

    function pintarFila(clave) {
      const fila = filas.get(clave);
      if (!fila) return;
      fila.querySelectorAll(".opcion").forEach((otro, n) => {
        otro.setAttribute("aria-pressed", String(elegidos.get(clave) === (n === 0 ? "v" : "l")));
      });
    }
    function cuantosElegidos() {
      // Solo cuentan los de este generador: el borrador guardado puede traer
      // picks de partidos que ya no se ofrecen (una tanda que ya se cargó).
      return [...elegidos.keys()].filter((clave) => porClave.has(clave)).length;
    }
    function refrescar() {
      const n = cuantosElegidos();
      cuenta.textContent = String(n);
      cuenta.appendChild(crear("small", null, " de " + porClave.size));
      descargar.disabled = n === 0;
      limpiar.disabled = n === 0;
      avance.style.width = (porClave.size ? (100 * n) / porClave.size : 0) + "%";
    }
    limpiar.addEventListener("click", () => {
      const antes = new Map(elegidos), n = cuantosElegidos();
      elegidos.clear();
      guardar(LLAVE_BORRADOR(s.n), null);
      filas.forEach((_, clave) => pintarFila(clave));
      refrescar();
      avisoFlotante(n === 1 ? "Borraste 1 pick" : "Borraste " + n + " picks", "Deshacer", () => {
        antes.forEach((lado, clave) => elegidos.set(clave, lado));
        guardar(LLAVE_BORRADOR(s.n), JSON.stringify(Object.fromEntries(elegidos)));
        filas.forEach((_, clave) => pintarFila(clave));
        refrescar();
      });
    });
    descargar.addEventListener("click", async () => {
      descargar.disabled = true;
      const antes = descargar.textContent;
      descargar.textContent = "Generando…";
      try {
        await exportarPicks(s, elegidos, porClave);
      } finally {
        descargar.textContent = antes;
        refrescar();
      }
    });
    refrescar();
    return caja;
  }

  function aviso(titulo, texto) {
    const n = crear("div", "aviso");
    n.appendChild(crear("strong", null, titulo));
    n.appendChild(document.createTextNode(texto));
    return n;
  }

  /* ═══ premios ═══ */
  function pintarPremios() {
    const P = D.premios, raiz = vistas.premios;
    raiz.textContent = "";
    raiz.appendChild(cabezaDeVista(P.temporada_cerrada ? "Temporada cerrada"
      : "Van " + P.semanas_jugadas + " de " + P.semanas_temporada + " semanas", "Los", "premios"));

    // La bolsa, tu parte y quién se llevaría qué si la temporada terminara hoy.
    const bolsa = crear("section", "tarjeta bolsa-final");
    bolsa.style.setProperty("--n", 0);
    bolsa.appendChild(crear("div", "rot", "Bolsa final"));
    bolsa.appendChild(crear("div", "val", P.total));
    const barra = crear("div", "progreso-bolsa"), relleno = crear("i");
    barra.appendChild(relleno);
    bolsa.appendChild(barra);
    bolsa.appendChild(crear("div", "pie", "Van " + P.apartado + " apartados, " + P.acumulado_semanal + " por semana."));
    requestAnimationFrame(() => { relleno.style.width = (P.semanas_jugadas / P.semanas_temporada) * 100 + "%"; });
    const mia = tuRebanada();
    if (mia) bolsa.appendChild(crear("p", "rebanada", mia));
    raiz.appendChild(bolsa);

    const tReparto = crear("div", "titulo");
    tReparto.appendChild(crear("h2", null, P.temporada_cerrada ? "Reparto final" : "La rebanada del pastel"));
    tReparto.appendChild(crear("span", "nota", P.temporada_cerrada ? "oficial" : "si terminara hoy"));
    raiz.appendChild(tReparto);
    if (P.hoy.length) {
      const pastel = crear("div", "pastel");
      pastel.setAttribute("aria-hidden", "true");
      P.hoy.forEach((g) => {
        const i = crear("i", { 1: "oro", 2: "plata", 3: "bronce" }[g.pos] || "");
        i.style.flexGrow = String(parseFloat(g.porcentaje) * g.p.length);
        pastel.appendChild(i);
      });
      raiz.appendChild(pastel);
      raiz.appendChild(listaDelReparto(P.hoy));
    }

    const t3 = crear("div", "titulo");
    t3.appendChild(crear("h2", null, "Ganadores por semana"));
    t3.appendChild(crear("span", "nota", P.semanal + " al 1.er lugar"));
    raiz.appendChild(t3);

    const jugadas = D.semanas.filter((s) => s.estado !== "pendiente");
    if (!jugadas.length) {
      raiz.appendChild(aviso("Aún no hay semanas jugadas", "Aquí aparece el ganador de cada una."));
    } else {
      const lista = crear("div", "ganadores");
      jugadas.slice().reverse().forEach((s) => {
        const gente = (s.ganadores || []).map(nombre);
        const fila = crear("div", "fila-gan" + (s.oficial ? "" : " abierta") +
          (s.oficial && jugador !== null && (s.ganadores || []).includes(jugador) ? " tuya" : ""));
        fila.appendChild(crear("span", "sN", "S" + s.n));
        if (!s.proyectable) {
          const q = crear("div", "quien", "En curso");
          q.appendChild(crear("small", null, s.cerrados + " de " + s.total + " cerrados · aún no se proyecta"));
          fila.appendChild(q);
          fila.appendChild(crear("span", "monto", "—"));
        } else {
          const q = crear("div", "quien");
          if (!gente.length) q.appendChild(document.createTextNode("—"));
          else q.appendChild(nombrar(gente, s.oficial));
          q.appendChild(crear("small", null, s.oficial ? "semana cerrada"
            : "va ganando · " + s.cerrados + " de " + s.total + " cerrados"));
          fila.appendChild(q);
          fila.appendChild(crear("span", "monto",
            s.oficial ? (s.premio + (gente.length > 1 ? " c/u" : "")) : "en juego"));
        }
        lista.appendChild(fila);
      });
      raiz.appendChild(lista);
    }

    // La dinámica, en claro: quién gana qué y qué pasa con los empates.
    const t2 = crear("div", "titulo");
    t2.id = "dinamica";
    t2.appendChild(crear("h2", null, "Cómo se gana"));
    raiz.appendChild(t2);
    const regla = (titulo, lineas, abierta, extra) => {
      const caja = crear("details", "regla");
      caja.open = !!abierta;
      caja.appendChild(crear("summary", null, titulo));
      const dentro = crear("div", "dentro");
      const lista = crear("ul");
      lineas.forEach((linea) => lista.appendChild(crear("li", null, linea)));
      dentro.appendChild(lista);
      if (extra) dentro.appendChild(extra);
      caja.appendChild(dentro);
      raiz.appendChild(caja);
    };
    regla("Cada semana", P.dinamica.semana, true);
    const lugares = crear("div", "lugares-premio");
    P.reglas.forEach((r, i) => {
      const fila = crear("div", "lugar-premio " + ["oro", "plata", "bronce"][i]);
      fila.appendChild(crear("span", "n", r.lugar));
      fila.appendChild(crear("span", "pct", r.porcentaje));
      fila.appendChild(crear("b", null, r.monto));
      lugares.appendChild(fila);
    });
    regla("Al final de la temporada", P.dinamica.temporada, false, lugares);
    regla("Si hay empates", P.dinamica.empates, false);
  }

  /* Los que hoy se llevarían algo de la bolsa final, agrupados por lugar. */
  function listaDelReparto(grupos) {
    const caja = crear("div", "ganadores");
    grupos.forEach((g) => {
      const varios = g.p.length > 1;
      const fila = crear("div", "fila-gan" + (jugador !== null && g.p.includes(jugador) ? " tuya" : ""));
      fila.appendChild(crear("span", "sN", ordinal(g.pos)));
      const quien = crear("div", "quien");
      quien.appendChild(nombrar(g.p.map(nombre), true));
      quien.appendChild(crear("small", null, g.aciertos + " aciertos · " +
        (varios ? g.p.length + " empatados, " + g.porcentaje + " cada uno" : g.porcentaje + " de la bolsa")));
      fila.appendChild(quien);
      fila.appendChild(crear("span", "monto", g.premio + (varios ? " c/u" : "")));
      caja.appendChild(fila);
    });
    return caja;
  }

  /* Tu parte si la temporada terminara hoy, o cuántos aciertos te faltan. */
  function tuRebanada() {
    if (jugador === null || D.premios.temporada_cerrada || !D.premios.hoy.length) return null;
    const mio = D.premios.hoy.find((g) => g.p.includes(jugador));
    if (mio) {
      return "Tu rebanada: " + mio.premio + " si todo acabara hoy" +
        (mio.p.length > 1 ? " (empatas con " + (mio.p.length - 1) + (mio.p.length === 2 ? " persona)." : " personas).") : ".");
    }
    const g = D.general.find((f) => f.p === jugador);
    if (!g) return null;
    const faltan = Math.min(...D.premios.hoy.map((x) => x.aciertos)) - g.total;
    return "Hoy no te toca rebanada: estás a " + faltan + (faltan === 1 ? " acierto" : " aciertos") +
      " de la zona de premio, y la temporada es joven.";
  }

  /* ═══ jugadores: buscador, ficha y duelo ═══ */
  const generalPorIdx = new Map(D.general.map((f) => [f.p, f]));
  const jugadas = D.semanas.filter((s) => s.estado !== "pendiente");

  function lineaDe(idx) {
    return jugadas.map((s) => {
      const fila = (s.tabla || []).find((f) => f.p === idx);
      return { n: s.n, aciertos: fila ? fila.f : null, pos: fila ? fila.pos : null };
    });
  }

  function pintarJugadores() {
    const raiz = vistas.jugadores;
    raiz.textContent = "";
    const regreso = crear("button", "regreso", "‹ Tabla general");
    regreso.type = "button";
    regreso.addEventListener("click", () => navegar("general"));
    raiz.appendChild(regreso);

    // Tocar a alguien en cualquier tabla abre su ficha: no hace falta otra lista.
    const idx = perfilAbierto !== null ? perfilAbierto : jugador;
    if (idx === null) {
      raiz.appendChild(crear("div", "frontera"));
      raiz.appendChild(aviso("Elige a alguien", "Toca un nombre en la tabla general para ver su ficha."));
      return;
    }
    raiz.appendChild(perfil(idx));

    const t2 = crear("div", "titulo");
    t2.appendChild(crear("h2", null, "Duelo"));
    t2.appendChild(crear("span", "nota", "compara a dos"));
    raiz.appendChild(t2);
    raiz.appendChild(duelo(idx));
  }

  /* Todo lo que se puede decir de alguien cruzando los picks de los 34. */
  function retrato(idx) {
    const linea = [];
    const porEquipo = new Map();     // equipo -> {veces, aciertos}
    let contra = 0, contraOk = 0, cerrados = 0, aciertos = 0;

    jugadas.forEach((s) => {
      const fila = s.jugadores.indexOf(idx);
      const enTabla = (s.tabla || []).find((f) => f.p === idx);
      if (enTabla) linea.push({ n: s.n, aciertos: enTabla.f, pos: enTabla.pos, abierta: s.estado !== "cerrada" });
      if (fila < 0) return;

      const juegos = partidosDe(s);
      juegos.forEach((p, col) => {
        const local = s.picks[fila][col] === 1;
        const lado = local ? "l" : "v";
        const eq = local ? p.l : p.v;
        const registro = porEquipo.get(eq) || { veces: 0, aciertos: 0 };
        registro.veces++;

        if (p.cerrado) {
          cerrados++;
          const acerto = p.g === lado;
          if (acerto) { aciertos++; registro.aciertos++; }

          // ¿Fue contra la mayoría? Se cuenta cómo votó la quiniela ese partido.
          let casa = 0;
          s.jugadores.forEach((_, otra) => { if (s.picks[otra][col] === 1) casa++; }); 
          const suyos = local ? casa : s.jugadores.length - casa;
          if (suyos * 2 < s.jugadores.length) {
            contra++;
            if (acerto) contraOk++;
          }
        }
        porEquipo.set(eq, registro);
      });
    });

    // El equipo que más elige, desempatando por aciertos.
    let consentido = null;
    porEquipo.forEach((registro, eq) => {
      if (!consentido || registro.veces > consentido.veces ||
          (registro.veces === consentido.veces && registro.aciertos > consentido.aciertos)) {
        consentido = { eq, ...registro };
      }
    });

    return { linea, consentido, contra, contraOk, cerrados, aciertos };
  }

  function perfil(idx) {
    const f = generalPorIdx.get(idx);
    const datos = retrato(idx);
    const caja = crear("div", "perfil");

    const cab = crear("div", "cab");
    const izq = crear("div");
    izq.appendChild(crear("div", "rotulo", f ? ordinal(f.pos) + " lugar de la general" : "Participante"));
    izq.appendChild(crear("div", "nom", nombre(idx)));
    cab.appendChild(izq);
    caja.appendChild(cab);

    // A cuántos del primero: el dato que todo el mundo quiere saber.
    const lider = D.general[0];
    if (f && lider) {
      const falta = lider.total - f.total;
      caja.appendChild(crear("p", "nota-perfil", falta === 0
        ? "Va en la punta de la general."
        : "A " + falta + (falta === 1 ? " acierto" : " aciertos") + " del primer lugar."));
    }
    caja.appendChild(crear("div", "frontera"));

    const cerradas = datos.linea.filter((s) => !s.abierta);
    const semanas = cerradas.length || 1;
    const promedio = (cerradas.reduce((s, x) => s + x.aciertos, 0) / semanas).toFixed(1);
    const ganadas = jugadas.filter((s) => s.oficial && (s.ganadores || []).includes(idx)).length;

    const cifras = crear("div", "cifras");
    [[f ? f.total : 0, "aciertos"], [f ? f.err : 0, "fallos"],
     [promedio, "por semana"], [ganadas, ganadas === 1 ? "semana ganada" : "semanas ganadas"]]
      .forEach(([valor, etiqueta]) => {
        const c = crear("div", "cifra");
        c.appendChild(crear("b", null, String(valor)));
        c.appendChild(crear("span", null, etiqueta));
        cifras.appendChild(c);
      });
    caja.appendChild(cifras);

    if (datos.linea.length) {
      // La semana que sigue en juego va rayada: un 1 de 14 no es una mala semana.
      const mejor = Math.max(1, ...cerradas.map((s) => s.aciertos));
      const peor = cerradas.length ? Math.min(...cerradas.map((s) => s.aciertos)) : mejor;
      const barras = crear("div", "barras");
      datos.linea.forEach((s) => {
        const col = crear("div", "col" + (s.abierta ? " abierta" : s.aciertos === mejor && mejor !== peor ? " mejor" : ""));
        const b = crear("div", "b");
        b.title = "Semana " + s.n + ": " + s.aciertos + " aciertos, " + ordinal(s.pos) + " de la semana" + (s.abierta ? ", en juego" : "");
        col.appendChild(crear("small", "cima", String(s.aciertos)));
        col.appendChild(b);
        col.appendChild(crear("small", null, "S" + s.n));
        barras.appendChild(col);
        requestAnimationFrame(() => {
          b.style.height = Math.max(4, (Math.min(s.aciertos, mejor) / mejor) * 46) + "px";
        });
      });
      caja.appendChild(barras);
    }

    const rasgos = crear("div", "rasgos");
    if (datos.consentido && datos.consentido.veces > 1) {
      rasgos.appendChild(rasgo(
        "Su consentido",
        datos.consentido.eq,
        "lo eligió " + datos.consentido.veces + " veces · " +
          datos.consentido.aciertos + " bien",
        (D.colores[datos.consentido.eq] || {}).local
      ));
    }
    if (datos.cerrados) {
      rasgos.appendChild(rasgo(
        "Contra la mayoría",
        datos.contra + (datos.contra === 1 ? " vez" : " veces"),
        datos.contra ? datos.contraOk + " le salieron" : "siempre va con la mayoría"
      ));
      rasgos.appendChild(rasgo(
        "Acierto",
        Math.round((datos.aciertos / datos.cerrados) * 100) + "%",
        "de " + datos.cerrados + " partidos cerrados"
      ));
      const racha = rachaDe(idx);
      rasgos.appendChild(rasgo(
        "Racha",
        racha.actual >= 2 ? racha.actual + " seguidos" : racha.mejor + " seguidos",
        racha.actual >= 2 ? "va en racha; la mejor: " + racha.mejor : "su mejor marca"
      ));
    }
    if (cerradas.length) {
      const top = cerradas.reduce((m, s) => (s.aciertos > m.aciertos ? s : m), cerradas[0]);
      rasgos.appendChild(rasgo("Mejor semana", "La " + top.n, top.aciertos + " aciertos, " + ordinal(top.pos) + " de la semana"));
    }
    if (rasgos.children.length) caja.appendChild(rasgos);
    return caja;
  }

  function rasgo(titulo, valor, pie, color) {
    const nodo = crear("div", "rasgo");
    if (color) nodo.style.setProperty("--c", color);
    nodo.appendChild(crear("div", "rot", titulo));
    nodo.appendChild(crear("div", "val", valor));
    nodo.appendChild(crear("div", "pie", pie));
    return nodo;
  }

  function duelo(uno) {
    const env = crear("div", "duelo");
    const lista = crear("select", "ancho");
    lista.setAttribute("aria-label", "Comparar con");
    lista.appendChild(Object.assign(crear("option", null, "Comparar con…"), { value: "" }));
    D.general.map((f) => f.p).filter((i) => i !== uno).forEach((i) => {
      lista.appendChild(Object.assign(crear("option", null, nombre(i)), { value: String(i) }));
    });
    // Si estás viendo a alguien más, la comparación natural es contigo.
    if (jugador !== null && jugador !== uno) lista.value = String(jugador);
    env.appendChild(lista);
    const destino = crear("div", "duelo");
    env.appendChild(destino);

    const pintar = () => {
      destino.textContent = "";
      if (lista.value === "") return;
      const a = uno, b = Number(lista.value);
      const fa = generalPorIdx.get(a), fb = generalPorIdx.get(b);
      const caras = crear("div", "caras");
      [[fa, a], [fb, b]].forEach(([f, idx], n) => {
        const otra = n === 0 ? fb : fa;
        const cara = crear("div", "cara" + (f && otra && f.total > otra.total ? " va-arriba" : ""));
        cara.appendChild(crear("div", "q", nombre(idx)));
        cara.appendChild(crear("div", "t", String(f ? f.total : 0)));
        cara.appendChild(crear("div", "rotulo", f ? ordinal(f.pos) : ""));
        if (n === 0) { caras.appendChild(cara); caras.appendChild(crear("div", "vs-mid", "VS")); }
        else caras.appendChild(cara);
      });
      destino.appendChild(caras);

      const s = porSemana.get(D.activa) || jugadas[jugadas.length - 1];
      if (!s || !s.jugadores.length) return;
      const fa2 = s.jugadores.indexOf(a), fb2 = s.jugadores.indexOf(b);
      if (fa2 < 0 || fb2 < 0) return;
      const juegos = partidosDe(s);
      const difs = [];
      juegos.forEach((p, col) => {
        if (s.picks[fa2][col] === s.picks[fb2][col]) return;
        const ladoA = s.picks[fa2][col] === 1 ? "l" : "v";
        difs.push({ p, ladoA });
      });
      const t = crear("div", "titulo");
      t.appendChild(crear("h2", null, "Dónde difieren · semana " + s.n));
      t.appendChild(crear("span", "nota", difs.length + " de " + juegos.length));
      destino.appendChild(t);
      if (!difs.length) {
        destino.appendChild(aviso("Picks idénticos", "Eligieron exactamente lo mismo esta semana."));
        return;
      }
      const caja = crear("div", "dif");
      difs.forEach(({ p, ladoA }) => {
        const row = crear("div", "row");
        const eqA = ladoA === "l" ? p.l : p.v;
        const eqB = ladoA === "l" ? p.v : p.l;
        const claseA = p.cerrado ? (p.g === ladoA ? " gano" : " perdio") : "";
        const claseB = p.cerrado ? (p.g !== ladoA && p.g !== "x" ? " gano" : " perdio") : "";
        row.appendChild(crear("span", "j izq" + claseA, eqA));
        row.appendChild(crear("span", "mid", p.mv === null ? "por jugar" : p.mv + "–" + p.ml));
        row.appendChild(crear("span", "j der" + claseB, eqB));
        caja.appendChild(row);
      });
      destino.appendChild(caja);
    };
    lista.addEventListener("change", pintar);
    pintar();
    return env;
  }

  /* ═══════════════ el momento de la semana ═══════════════
     El portal se acomoda a lo que está pasando: en tiempo de picks se ven los
     picks; con partidos, los partidos; con la semana cerrada, quién ganó. Y
     quien ya dijo quién es ve sus números todo el tiempo, en vivo. */

  const mismoDia = (a, b) => {
    const x = new Date(a), y = new Date(b);
    return x.getFullYear() === y.getFullYear() && x.getMonth() === y.getMonth() && x.getDate() === y.getDate();
  };
  const pct = (a, b) => (b > 0 ? Math.round((100 * a) / b) : null);
  const ordinal = (n) => n + ".º";
  function conOrdinal(tag, clase, valor) {
    return crear(tag, clase, valor);
  }

  /* Todos los partidos de una semana, cargados o por repartir, con el marcador en vivo encima. */
  function todosLosJuegos(s) {
    return s.partidos.map(efectivo).concat((s.por_entregar || []).map(efectivo));
  }
  function juegosEnVivo(s) {
    return s ? todosLosJuegos(s).filter((p) => p.vivo && !p.cerrado) : [];
  }
  /* Los de hoy, jugados o no: el domingo en la noche también importa cómo quedaron. */
  function juegosDeHoy(s) {
    if (!s) return [];
    const ahora = Date.now();
    return todosLosJuegos(s).filter((p) => p.t && mismoDia(p.t * 1000, ahora));
  }

  /* Hasta cuándo se mandan picks y de qué partidos: la tanda que falta de la
     semana en curso o, si ya no queda, la semana siguiente. */
  function picksAbiertos() {
    const ahora = Date.now();
    const abierta = (tandas) => (tandas || []).find((t) => Date.parse(t.cierre) > ahora);
    const s = porSemana.get(D.activa);
    if (s && (s.por_entregar || []).length) {
      const tanda = abierta(s.tandas_por_entregar);
      if (tanda) return { s, lista: s.por_entregar, tandas: s.tandas_por_entregar, cierre: tanda, parcial: true };
    }
    const siguiente = D.semanas.find((x) => x.estado === "pendiente");
    if (siguiente) {
      const tanda = abierta(siguiente.tandas);
      if (tanda) return { s: siguiente, lista: siguiente.partidos, tandas: siguiente.tandas, cierre: tanda, parcial: false };
    }
    return null;
  }

  function falta(ms) {
    if (ms <= 0) return "ya";
    const min = Math.floor(ms / 60000), h = Math.floor(min / 60), d = Math.floor(h / 24);
    if (d >= 1) return d + " d " + (h % 24) + " h";
    if (h >= 1) return h + " h " + (min % 60) + " min";
    return Math.max(1, min) + " min";
  }

  function proximoPartido() {
    const ahora = Date.now();
    let mejor = null;
    D.semanas.forEach((s) => todosLosJuegos(s).forEach((p) => {
      if (!p.cerrado && !p.vivo && p.t && p.t * 1000 > ahora && (!mejor || p.t < mejor.p.t)) mejor = { p, s };
    }));
    return mejor;
  }

  /* Tus números: los de la semana en curso (con lo que va en juego) y los de la temporada. */
  function numerosDe(idx, cual) {
    const g = D.general.find((f) => f.p === idx) || null;
    // La semana en curso; si aún no se reparte, la última que ya tiene tabla.
    const s = cual || [porSemana.get(D.activa)].concat(D.semanas.slice().reverse())
      .find((x) => x && x.tabla && x.tabla.length);
    let semana = null;
    if (s && s.tabla && s.tabla.length) {
      const f = s.tabla.find((x) => x.p === idx);
      const fila = s.jugadores.indexOf(idx);
      if (f && fila >= 0) {
        let ganando = 0, perdiendo = 0;
        partidosDe(s).forEach((p, col) => {
          if (p.cerrado || !p.vivo || !p.g) return;
          if ((p.g === "l") === (s.picks[fila][col] === 1)) ganando++; else perdiendo++;
        });
        const vivos = vivosPorParticipante(s);
        const mio = f.f + (vivos.get(idx) || 0);
        const proy = 1 + s.tabla.filter((x) => x.f + (vivos.get(x.p) || 0) > mio).length;
        semana = { n: s.n, ok: f.f, mal: f.e, jugados: f.f + f.e, pos: f.pos, proy, ganando, perdiendo };
      }
    }
    return { g, semana };
  }

  /* En cuántos de los resultados posibles de lo que falta ganas o empatas la semana. */
  function chanceDe(s, idx) {
    const pendientes = s.partidos.filter((p) => !p.cerrado).length;
    if (!pendientes || !s.panorama || !Object.keys(s.panorama).length) return null;
    const total = Math.pow(2, pendientes);
    const fila = s.panorama[String(idx)];
    if (!fila) return { solo: 0, empata: 0, total };
    return { solo: fila[0], empata: fila[1], total };
  }

  /* Tus aciertos uno tras otro, partido por partido en el orden en que se jugaron. */
  function rachaDe(idx) {
    const seguidos = [];
    D.semanas.forEach((s) => {
      const fila = s.jugadores.indexOf(idx);
      if (fila < 0) return;
      s.partidos.map((p, col) => [p, col]).filter(([p]) => p.cerrado)
        .sort((a, b) => a[0].t - b[0].t)
        .forEach(([p, col]) => seguidos.push(!!p.g && (p.g === "l") === (s.picks[fila][col] === 1)));
    });
    let actual = 0, mejor = 0, corrida = 0;
    seguidos.forEach((bien) => { corrida = bien ? corrida + 1 : 0; mejor = Math.max(mejor, corrida); });
    for (let i = seguidos.length - 1; i >= 0 && seguidos[i]; i--) actual++;
    return { actual, mejor };
  }

  /* ═══ la barra con tu avance, en todas las secciones ═══ */
  function elegirJugador(i) {
    jugador = i;
    guardar("angabave.jugador", i === null ? null : D.participantes[i]);
    selSoy.value = i === null ? "" : String(i);
    cajaSoy.classList.toggle("puesto", i !== null);
    perfilAbierto = null;
    pintarIdentidad();
    repintar();
  }

  function listaDeNombres(vacio) {
    const lista = crear("select");
    lista.setAttribute("aria-label", "Elige tu nombre");
    lista.appendChild(Object.assign(crear("option", null, vacio), { value: "" }));
    D.participantes.map((q, i) => [i, q]).sort((a, b) => a[1].localeCompare(b[1], "es"))
      .forEach(([i, q]) => lista.appendChild(Object.assign(crear("option", null, q), { value: String(i) })));
    return lista;
  }

  /* Sin nombre: una línea que abre la lista de un toque (la lista va encima,
     transparente, para que el teléfono muestre su selector nativo). */
  const LLAVE_INVITACION = "angabave.invitado";
  let ultimaBarra = { quien: null, cifras: [] };
  function pintarMiBarra() {
    if (!miBarra) return;
    miBarra.textContent = "";
    if (jugador === null) {
      if (leer(LLAVE_INVITACION) === "no") return;
      const fila = crear("div", "mi-barra-invita");
      const elegir = crear("label", "elegir");
      elegir.appendChild(crear("span", "txt", "¿Quién eres? Elige tu nombre y sigue tus aciertos en vivo"));
      elegir.appendChild(crear("span", "cta", "Elegir"));
      const lista = listaDeNombres("¿Quién eres?");
      lista.addEventListener("change", () => { if (lista.value !== "") elegirJugador(Number(lista.value)); });
      elegir.appendChild(lista);
      fila.appendChild(elegir);
      const cerrar = crear("button", "cerrar", "×");
      cerrar.type = "button";
      cerrar.setAttribute("aria-label", "Ahora no. Puedes elegir tu nombre después con el botón de arriba.");
      cerrar.addEventListener("click", () => { guardar(LLAVE_INVITACION, "no"); pintarMiBarra(); });
      fila.appendChild(cerrar);
      miBarra.appendChild(fila);
      return;
    }
    const { g, semana } = numerosDe(jugador);
    const b = crear("button", "mi-barra-yo");
    b.type = "button";
    b.setAttribute("aria-label", "Tu avance. Toca para ver tu perfil.");
    const celda = (rotulo, partes, vivo) => {
      const c = crear("span", "celda" + (vivo ? " vivo" : ""));
      c.appendChild(crear("small", "rot", rotulo));
      const linea = crear("span", "linea");
      partes.filter(Boolean).forEach((parte) => linea.appendChild(parte));
      c.appendChild(linea);
      b.appendChild(c);
    };
    if (semana) {
      const enJuego = semana.ganando + semana.perdiendo;
      const p = pct(semana.ok, semana.jugados);
      celda(enJuego ? "En vivo · ganas " + semana.ganando + " de " + enJuego : "Semana " + semana.n, [
        crear("b", null, semana.ok + "/" + semana.jugados),
        p === null ? null : crear("span", "por", p + "%"),
        conOrdinal("span", "rango", ordinal(enJuego ? semana.proy : semana.pos)),
      ], enJuego > 0);
    }
    if (g) {
      const p = pct(g.total, g.total + g.err);
      celda("Temporada", [
        crear("b", null, String(g.total)),
        p === null ? null : crear("span", "por", p + "%"),
        conOrdinal("span", "rango", ordinal(g.pos)),
        g.mov ? crear("span", "mov " + (g.mov > 0 ? "sube" : "baja"), (g.mov > 0 ? "▲" : "▼") + Math.abs(g.mov)) : null,
      ]);
    }
    if (!semana && !g) celda(nombre(jugador), [crear("span", "por", "Aún sin partidos cerrados")]);
    b.addEventListener("click", () => abrirPerfil(jugador));
    // La línea de abajo avanza con los partidos cerrados de la semana.
    const enCurso = semana ? porSemana.get(semana.n) : null;
    if (enCurso && enCurso.total) b.style.setProperty("--avance", (100 * enCurso.cerrados) / enCurso.total + "%");
    // Si una cifra cambió desde la última vez (un acierto en vivo), rueda.
    const cifrasAhora = Array.from(b.querySelectorAll(".linea b"), (x) => x.textContent);
    if (ultimaBarra.quien === jugador) {
      b.querySelectorAll(".linea b").forEach((x, i) => {
        const antes = ultimaBarra.cifras[i];
        if (antes !== undefined && antes !== x.textContent) rodar(x, antes, x.textContent);
      });
    }
    ultimaBarra = { quien: jugador, cifras: cifrasAhora };
    miBarra.appendChild(b);
  }

  /* ═══ hoy ═══ */
  function pintarHoy() {
    const raiz = vistas.hoy;
    raiz.textContent = "";
    const s = porSemana.get(D.activa) || null;
    const vivos = juegosEnVivo(s);
    const deHoy = juegosDeHoy(s).filter((p) => !p.vivo);
    const hoy = deHoy.filter((p) => !p.cerrado && !p.porConfirmar);
    const terminados = deHoy.filter((p) => p.cerrado || p.porConfirmar);
    const picks = picksAbiertos();
    const cerrada = !!s && s.estado === "cerrada";
    // Los picks de la semana que sigue no le quitan el lugar a la que se está
    // jugando (el domingo en la noche importa cómo vas) hasta que cierran pronto.
    const apuran = !!picks && (picks.s === s || !s || s.estado !== "en_vivo" ||
      Date.parse(picks.cierre.cierre) - Date.now() < 36 * 3600e3);
    const fase = vivos.length ? "vivo" : hoy.length ? "hoy" : apuran ? "picks" : cerrada ? "cerrada" : "semana";

    const sinPartidos = !vivos.length && !hoy.length && !terminados.length;
    raiz.appendChild(saludo(fase, s, vivos, hoy, picks, terminados.length, sinPartidos));
    if (novedades) raiz.appendChild(tarjetaNovedades());
    const rejilla = crear("div", "hoy-rejilla");
    const principal = crear("div", "hoy-principal");
    const lateral = crear("div", "hoy-lateral");
    rejilla.appendChild(principal);
    rejilla.appendChild(lateral);
    raiz.appendChild(rejilla);

    const previa = semanaRecienCerrada();
    const tarjetas = {
      partidos: () => tarjetaPartidos(s, vivos, hoy, terminados),
      // Con la semana nueva sin repartir, "tu semana" es la que acaba de cerrar.
      tuSemana: () => tarjetaTuSemana(s && s.estado !== "pendiente" ? s : previa),
      resultado: () => (s && (cerrada || s.proyectable) ? campeon(s, !cerrada) : null),
      previo: () => (previa && previa !== s ? campeon(previa) : null),
      picks: () => (picks ? tarjetaPicks(picks) : null),
      // El titular de un día sin partidos ya dice cuál es el próximo.
      proximo: () => (sinPartidos ? null : tarjetaProximo()),
    };
    // Pocas tarjetas y en orden de importancia: lo que pasa ahora, lo tuyo y
    // quién va ganando. Lo demás vive en su sección de la barra de abajo.
    // [columna principal, columna lateral]; en el teléfono van una tras otra.
    const plan = {
      vivo: [["partidos"], ["tuSemana", "resultado"]],
      hoy: [["partidos", "picks"], ["tuSemana"]],
      picks: [["picks", "previo"], ["tuSemana"]],
      cerrada: [["resultado"], ["tuSemana", "proximo"]],
      semana: [["tuSemana", "partidos"], ["resultado", "proximo"]],
    }[fase];
    let orden = 0;
    plan.forEach((claves, columna) => claves.forEach((clave) => {
      const nodo = tarjetas[clave]();
      if (!nodo) return;
      nodo.style.setProperty("--n", orden++);
      (columna === 0 ? principal : lateral).appendChild(nodo);
    }));
    if (!principal.firstChild) principal.remove();
    if (!principal.isConnected || !lateral.firstChild) rejilla.classList.add("sola");
  }

  /* Lo que cambió mientras no estabas: al abrir ya sabes cómo te fue. */
  const LLAVE_VISITA = "angabave.visita", LLAVE_NOVEDADES = "angabave.novedades";
  let novedades = null;
  function calcularNovedades() {
    const yo = jugador === null ? null : D.general.find((f) => f.p === jugador) || null;
    const ahora = { cerrados: D.cerrados_temporada, quien: yo ? nombre(yo.p) : null,
      total: yo ? yo.total : 0, err: yo ? yo.err : 0, pos: yo ? yo.pos : 0 };
    let previa = null;
    try { previa = JSON.parse(leer(LLAVE_VISITA) || "null"); } catch (e) { previa = null; }
    guardar(LLAVE_VISITA, JSON.stringify(ahora));
    try {
      if (previa && ahora.cerrados > previa.cerrados) {
        const n = ahora.cerrados - previa.cerrados;
        let texto = n === 1 ? "Cerró 1 partido" : "Cerraron " + n + " partidos";
        if (yo && previa.quien === ahora.quien) {
          texto += ": acertaste " + (ahora.total - previa.total) + " y fallaste " + (ahora.err - previa.err);
          if (ahora.pos !== previa.pos) {
            texto += ". " + (ahora.pos < previa.pos ? "Subiste" : "Bajaste") + " de " + ordinal(previa.pos) + " a " + ordinal(ahora.pos) + " en la general";
          }
        }
        sessionStorage.setItem(LLAVE_NOVEDADES, texto + ".");
      }
      novedades = sessionStorage.getItem(LLAVE_NOVEDADES);
    } catch (e) { novedades = null; }
  }
  function tarjetaNovedades() {
    const caja = crear("div", "novedades");
    const txt = crear("div");
    txt.appendChild(crear("span", "rot", "Desde tu última visita"));
    txt.appendChild(crear("p", null, novedades));
    caja.appendChild(txt);
    return caja;
  }

  /* Un día sin partidos se dice claro: si ese día cierran los picks, eso es lo
     único que pasa; si no, no hay nada. Y cuál es el próximo partido. */
  const DIAS_SEMANA = ["domingo", "lunes", "martes", "miércoles", "jueves", "viernes", "sábado"];
  function cuandoEs(t) {
    const fecha = new Date(t * 1000);
    if (mismoDia(fecha, Date.now() + 864e5)) return "mañana a las " + hora(t);
    return "el " + DIAS_SEMANA[fecha.getDay()] + " " + fecha.getDate() + " a las " + hora(t);
  }
  function diaSinPartidos(picks) {
    const linea = crear("p", "dia-libre");
    const cierraHoy = picks ? tandasAbiertas(picks).find((x) => mismoDia(Date.parse(x.cierre), Date.now())) : null;
    linea.appendChild(crear("b", null, cierraHoy ? "Hoy no hay partidos." : "Hoy no hay partidos ni eventos."));
    const partes = [];
    if (cierraHoy) partes.push("Hoy a las " + hora(Date.parse(cierraHoy.cierre) / 1000) + " cierran los picks.");
    const prox = proximoPartido();
    if (prox) partes.push("El próximo: " + prox.p.v + " @ " + prox.p.l + ", " + cuandoEs(prox.p.t) + ".");
    if (partes.length) linea.appendChild(document.createTextNode(" " + partes.join(" ")));
    return linea;
  }

  /* La última semana cerrada sigue siendo noticia hasta el jueves. */
  function semanaRecienCerrada() {
    const cerradas = D.semanas.filter((x) => x.estado === "cerrada");
    const s = cerradas[cerradas.length - 1];
    if (!s) return null;
    const ultimo = Math.max(0, ...s.partidos.map((p) => p.t || 0));
    return ultimo && Date.now() - ultimo * 1000 < 3.5 * 864e5 ? s : null;
  }

  const hora = (t) => new Date(t * 1000).toLocaleTimeString("es-MX", { hour: "2-digit", minute: "2-digit", hour12: false });

  /* Cuántos partidos quedan por elegir y cuándo cierran, tanda por tanda. */
  function tandasAbiertas(picks) {
    return (picks.tandas || []).filter((t) => Date.parse(t.cierre) > Date.now());
  }
  function porElegir(picks) {
    return tandasAbiertas(picks).reduce((n, t) => n + t.claves.length, 0) || picks.lista.length;
  }
  function textoCierres(picks) {
    const abiertas = tandasAbiertas(picks);
    if (abiertas.length <= 1) return "Cierran el " + picks.cierre.cierre_texto + ".";
    const partes = abiertas.map((t) => t.claves.length + " el " + t.cierre_texto);
    return "Cierran " + partes.slice(0, -1).join(", ") + " y " + partes[partes.length - 1] + ".";
  }

  /* Las cuentas regresivas se mueven solas. Cuando una llega a cero el momento
     cambió (cerraron los picks, arrancó un partido) y la vista se rehace. */
  function cuentaRegresiva(clase, antes, hasta) {
    const n = crear("span", clase, antes + falta(hasta - Date.now()));
    n.dataset.hasta = String(hasta);
    n.dataset.antes = antes;
    return n;
  }
  const vencidas = new Set();
  setInterval(() => {
    if (document.hidden) return;
    let cambio = false;
    document.querySelectorAll("[data-hasta]").forEach((n) => {
      const hasta = Number(n.dataset.hasta), resta = hasta - Date.now();
      if (resta > 0) n.textContent = n.dataset.antes + falta(resta);
      else if (!vencidas.has(hasta)) { vencidas.add(hasta); cambio = true; }
    });
    pintarFrescura();
    if (cambio) repintarSinEstorbar();
  }, 20000);

  /* Los titulares entran palabra por palabra. */
  function titular(tag, texto, resaltado) {
    const h = crear(tag);
    let k = 0;
    const poner = (frase) => frase.split(" ").filter(Boolean).forEach((palabra) => {
      const caja = crear("span", "palabra"), i = crear("i", null, palabra);
      i.style.setProperty("--k", k++);
      caja.appendChild(i);
      h.appendChild(caja);
      h.appendChild(document.createTextNode(" "));
    });
    poner(texto);
    if (resaltado) poner(resaltado);
    return h;
  }
  function cabezaDeVista(fecha, texto, resaltado, detalle) {
    const caja = crear("div", "saludo");
    if (fecha) caja.appendChild(crear("div", "fecha", fecha));
    caja.appendChild(titular("h1", texto, resaltado));
    if (detalle) caja.appendChild(crear("p", null, detalle));
    return caja;
  }

  /* El titular de la fase en vivo contesta cómo vas, con el denominador fijo en los
     partidos en juego. Sin nombre, o sin nada que decir todavía, cuenta los partidos. */
  function titularEnVivo(s, vivos) {
    const n = vivos.length;
    const cuenta = [n === 1 ? "1 partido" : n + " partidos", "en vivo"];
    const adelante = (p) => p.g === "v" || p.g === "l";
    if (jugador === null || !s) return { frase: cuenta };
    const lado = (p) => {
      const col = s.partidos.findIndex((q) => q.v === p.v && q.l === p.l);
      const mio = col >= 0 ? miPick(s, col) : null;
      return mio ? mio.lado : null;
    };
    if (n === 1) {
      const p = vivos[0], mio = lado(p);
      if (!mio) return { frase: cuenta };
      return { frase: [!adelante(p) ? "Van empatados" : p.g === mio ? "Vas ganando" : "Vas perdiendo"], partido: p };
    }
    // Un empate ("x" o vacío) no tiene a nadie adelante. Se dice lo que pesa más: nunca "ganando 0".
    const conLider = vivos.filter(adelante);
    if (conLider.length < 3) return { frase: cuenta };
    const gano = conLider.filter((p) => p.g === lado(p)).length;
    const pierdo = conLider.filter((p) => lado(p) && p.g !== lado(p)).length;
    return { frase: gano >= pierdo ? ["Vas ganando", gano + " de " + n] : ["Vas perdiendo", pierdo + " de " + n] };
  }

  function saludo(fase, s, vivos, hoy, picks, yaJugados, sinPartidos) {
    const caja = crear("div", "saludo fase-" + fase);
    const fecha = new Date().toLocaleDateString("es-MX", { weekday: "long", day: "numeric", month: "long" });
    caja.appendChild(crear("div", "fecha", fecha.charAt(0).toUpperCase() + fecha.slice(1)));
    const enVivo = fase === "vivo" ? titularEnVivo(s, vivos) : null;
    const titulo = {
      vivo: fase === "vivo" ? enVivo.frase : null,
      hoy: yaJugados ? [hoy.length === 1 ? "Queda un partido" : "Quedan " + hoy.length + " partidos", "hoy"]
        : hoy.length === 1 ? ["Hoy hay", "partido"] : ["Hoy hay " + hoy.length, "partidos"],
      picks: ["Tiempo de", "picks"],
      cerrada: [s ? "Semana " + s.n : "Semana", "cerrada"],
      semana: s ? ["Semana " + s.n, "en curso"] : ["Temporada", String(D.anio)],
    }[fase];
    caja.appendChild(titular("h1", titulo[0], titulo[1]));
    const detalle = crear("p");
    if (fase === "vivo") {
      const q = enVivo.partido;
      if (q) {
        detalle.textContent = q.v + " " + (q.mv ?? 0) + ", " + q.l + " " + (q.ml ?? 0) + (q.e ? " · " + q.e : "") + ". ";
      }
      const { semana } = jugador !== null && s ? numerosDe(jugador, s) : { semana: null };
      if (semana && semana.ganando + semana.perdiendo) {
        const suma = semana.ok + semana.ganando;
        detalle.textContent += "Si todo queda así: " + suma + (suma === 1 ? " acierto" : " aciertos") +
          " y " + ordinal(semana.proy) + " lugar de la semana.";
      } else {
        detalle.textContent += "Los marcadores se actualizan solos cada minuto.";
      }
    } else if (fase === "hoy") {
      const primero = hoy.slice().sort((a, b) => a.t - b.t)[0];
      const duelo = (hoy.length > 1 ? "El primero: " : "") + primero.v + " @ " + primero.l;
      if (primero.t * 1000 > Date.now()) {
        detalle.textContent = duelo + " a las " + hora(primero.t) + " · ";
        detalle.appendChild(cuentaRegresiva("cuenta", "en ", primero.t * 1000));
      } else {
        detalle.textContent = duelo + " ya arrancó; el marcador aparece en cuanto haya datos.";
      }
    } else if (fase === "cerrada" && s) {
      const gente = (s.ganadores || []).map(nombre);
      const primero = (s.tabla || []).find((f) => f.pos === 1);
      const con = primero ? " con " + primero.f + (primero.f === 1 ? " acierto." : " aciertos.") : ".";
      if (gente.length === 1) detalle.textContent = "Ganó " + gente[0] + con;
      else if (gente.length && gente.length <= 3) detalle.textContent = "Ganaron " + gente.slice(0, -1).join(", ") + " y " + gente[gente.length - 1] + con;
      else if (gente.length) detalle.textContent = "Ganaron " + gente.length + " empatados" + con;
    } else if (fase === "semana" && s) {
      detalle.textContent = s.cerrados + " de " + s.total + " partidos cerrados.";
    }
    if (detalle.textContent) caja.appendChild(detalle);
    if (sinPartidos) caja.appendChild(diaSinPartidos(picks));
    return caja;
  }


  /* Cuántos le fueron a cada lado en un partido ya cargado. */
  function consenso(s, col) {
    let casa = 0;
    s.picks.forEach((fila) => { if (fila[col] === 1) casa++; });
    return { v: s.picks.length - casa, l: casa };
  }

  function sigla(equipo) {
    const i = crear("i", "sig", D.siglas[equipo] || equipo.slice(0, 3).toUpperCase());
    const c = D.colores[equipo] || {};
    if (c.local) { i.style.background = c.local; i.style.color = c.local_texto || "#070b12"; }
    return i;
  }

  /* Los partidos de hoy en una sola tarjeta: en vivo, más tarde y terminados. */
  function tarjetaPartidos(s, vivos, porJugar, terminados) {
    const grupos = [["En vivo", vivos], ["Más tarde", porJugar], ["Terminados", terminados]]
      .filter(([, juegos]) => juegos.length);
    if (!grupos.length) return null;
    const caja = crear("section", "tarjeta partidos-hoy" + (vivos.length ? " envivo" : ""));
    const cab = crear("div", "cab");
    if (vivos.length) cab.appendChild(crear("span", "punto"));
    cab.appendChild(crear("h3", null, grupos.length > 1 ? "Partidos de hoy"
      : vivos.length ? "En vivo ahora" : porJugar.length ? "Hoy juegan" : "Resultados de hoy"));
    if (s) {
      const todos = crear("button", "enlace", "Toda la semana ›");
      todos.type = "button";
      todos.addEventListener("click", () => { pestana = "partidos"; pestanaElegida = true; navegar(s.n); });
      cab.appendChild(todos);
    }
    caja.appendChild(cab);
    if (vivos.length) {
      const linea = crear("div", "frescura");
      linea.appendChild(crear("span", "frescura-texto"));
      const otra = crear("button", "frescura-boton", "Reintentar");
      otra.type = "button";
      otra.addEventListener("click", consultarVivo);
      linea.appendChild(otra);
      caja.appendChild(linea);
      pintarFrescura(linea);
    }
    grupos.forEach(([titulo, juegos]) => {
      if (grupos.length > 1) caja.appendChild(crear("div", "subgrupo", titulo));
      juegos.slice().sort((a, b) => a.t - b.t).forEach((p) => caja.appendChild(filaJuego(s, p)));
    });
    return caja;
  }

  /* Lo que dice la segunda línea de la columna derecha: palabras y personas, nunca
     porcentajes. "Tu lado" es el pick de quien está elegido en este teléfono. */
  function palabrasDeFila(s, p, col) {
    if (!s) return null;
    const sig = (eq) => D.siglas[eq] || eq.slice(0, 3).toUpperCase();
    const neutro = (texto) => ({ texto, tono: "neutro" });
    const terminado = !!(p.cerrado || p.porConfirmar), enJuego = !!p.vivo && !terminado;
    if (col < 0 || !s.picks.length) {
      let borrador = {};
      try { borrador = JSON.parse(leer(LLAVE_BORRADOR(s.n)) || "{}"); } catch (e) { borrador = {}; }
      const lado = borrador[p.v + "@" + p.l];
      return neutro(lado === "v" || lado === "l" ? "En tu borrador: " + sig(lado === "v" ? p.v : p.l) : "Picks por llegar");
    }
    const c = consenso(s, col), mio = miPick(s, col);
    const con = (n) => (n === 1 ? "Solo tú" : "Tú y " + (n - 1) + " más");
    // El primer nombre; si otro participante lo comparte, se le suma la inicial del apellido.
    const quien = () => {
      const fila = s.picks.findIndex((f) => f[col] === (p.g === "l" ? 1 : 0));
      const partes = nombre(s.jugadores[fila]).split(" ");
      const repetido = D.participantes.filter((x) => x.split(" ")[0] === partes[0]).length > 1;
      return repetido && partes.length > 1 ? partes[0] + " " + partes[partes.length - 1][0] + "." : partes[0];
    };
    if (terminado) {
      if (p.g !== "v" && p.g !== "l") return neutro("Empate: nadie le atinó");
      const n = p.g === "l" ? c.l : c.v;
      if (mio && mio.lado === p.g) return { texto: n <= 6 ? con(n) : "Le atinaron " + n, tono: "bien" };
      const texto = n === 0 ? "Nadie le atinó" : n === 1 ? "Le atinó " + quien() : "Le atinaron " + n;
      return { texto, tono: mio ? "mal" : "neutro" };
    }
    if (mio && enJuego) {
      if (p.g !== "v" && p.g !== "l") return neutro("Van empatados");
      return p.g === mio.lado ? { texto: "Vas ganando", tono: "bien" } : { texto: "Vas perdiendo", tono: "mal" };
    }
    if (mio) {
      const n = c[mio.lado];
      return neutro(n <= 6 ? con(n) : "Elegiste " + sig(mio.equipo));
    }
    if (!c.v && !c.l) return null;
    if (c.v === c.l) return neutro(c.v + " y " + c.l);
    return neutro(Math.max(c.v, c.l) + " con " + sig(c.l > c.v ? p.l : p.v));
  }

  /* Un partido, siempre igual en todo el portal. Tocarlo abre quién le fue a quién. */
  const pintados = new Map();   // "partido|lado" -> el último marcador que se dibujó
  function filaJuego(s, p) {
    const clave = p.v + "@" + p.l;
    const col = s ? s.partidos.findIndex((q) => q.v === p.v && q.l === p.l) : -1;
    const anotacion = anotaciones.get(clave);
    const reciente = anotacion && Date.now() - anotacion.cuando < SEGUNDOS_ANOTACION * 1000;
    const fila = crear("button", "juego-fila" + (p.vivo ? " vivo" : "") + (reciente ? " anoto" : ""));
    fila.type = "button";
    const palabras = palabrasDeFila(s, p, col);
    const mio = col >= 0 ? miPick(s, col) : null;
    const terminado = p.cerrado || p.porConfirmar;
    const lados = crear("div", "lados");
    const empezo = p.vivo || p.cerrado || p.porConfirmar;
    [["v", p.v, p.mv], ["l", p.l, p.ml]].forEach(([lado, eq, m]) => {
      const mia = !!mio && mio.lado === lado;
      const l = crear("div", "eq-fila" + (empezo && p.g === lado ? " adelante" : "") +
        (mia ? " fila-mi-pick fila-" + palabras.tono : ""));
      l.appendChild(sigla(eq));
      if (mia) {
        // Ni el color ni el anillo cargan solos el estado: al final, también ✓ o ✕.
        const nombreEq = crear("span", "eq fila-con-marca");
        nombreEq.appendChild(crear("span", "fila-nombre", eq));
        if (terminado && palabras.tono !== "neutro") {
          nombreEq.appendChild(crear("span", "fila-marca", palabras.tono === "bien" ? "✓" : "✕"));
        }
        l.appendChild(nombreEq);
      } else {
        l.appendChild(crear("span", "eq", eq));
      }
      const hay = empezo && m !== null && m !== undefined;
      const mrc = crear("b", "mrc", hay ? String(m) : "");
      const llave = clave + "|" + lado, antes = pintados.get(llave);
      if (hay) {
        pintados.set(llave, m);
        if (antes !== undefined && antes !== m) rodar(mrc, antes, m);
      }
      l.appendChild(mrc);
      lados.appendChild(l);
    });
    fila.appendChild(lados);
    if (reciente) {
      const eq = anotacion.lado === "v" ? p.v : p.l;
      const color = (D.colores[eq] || {}).local;
      if (color) fila.style.setProperty("--c", color);
      if (anotacion.suma > 0) {
        const mas = crear("span", "mas", "+" + anotacion.suma);
        mas.style.top = anotacion.lado === "v" ? "12px" : "44px";
        fila.appendChild(mas);
      }
    }
    const meta = crear("div", "meta");
    const cuando = p.vivo ? (p.e || "En juego")
      : p.cerrado || p.porConfirmar ? (p.e || "Final") : p.t ? hora(p.t) : "Por definir";
    meta.appendChild(crear("span", "cuando", cuando));
    if (palabras) meta.appendChild(crear("span", "fila-palabras " + palabras.tono, palabras.texto));
    fila.appendChild(meta);
    const marcador = empezo && p.mv != null && p.ml != null ? p.mv + " a " + p.ml : "";
    fila.setAttribute("aria-label", [p.v + " contra " + p.l, marcador, cuando, palabras && palabras.texto]
      .filter(Boolean).join(", "));
    fila.addEventListener("click", () => abrirPartido(s, p, fila));
    return fila;
  }

  function tarjetaTuSemana(s) {
    if (jugador === null || !s || s.estado === "pendiente") return null;
    const { semana } = numerosDe(jugador, s);
    if (!semana) return null;
    const caja = crear("section", "tarjeta tu-semana");
    const cab = crear("div", "cab");
    cab.appendChild(crear("h3", null, "Tu semana " + semana.n));
    const ver = crear("button", "enlace", "Ver tabla");
    ver.type = "button";
    ver.addEventListener("click", () => { pestana = "tabla"; pestanaElegida = true; navegar(s.n); });
    cab.appendChild(ver);
    caja.appendChild(cab);
    // Tus cifras ya están en la barra de arriba: aquí va cómo se ven, partido por partido.
    caja.appendChild(tiraDeLaSemana(s));
    const enJuego = semana.ganando + semana.perdiendo;
    const porJugar = Math.max(0, s.total - semana.jugados - enJuego);
    const leyenda = crear("div", "leyenda");
    const dato = (clase, n, texto) => {
      const d = crear("span", clase);
      d.appendChild(crear("b", null, String(n)));
      d.appendChild(document.createTextNode(" " + texto));
      leyenda.appendChild(d);
    };
    dato("ok", semana.ok, semana.ok === 1 ? "acierto" : "aciertos");
    dato("mal", semana.mal, semana.mal === 1 ? "fallo" : "fallos");
    if (enJuego) dato("", semana.ganando, "de " + enJuego + " en juego a favor");
    if (porJugar) dato("", porJugar, "por jugar");
    caja.appendChild(leyenda);

    const c = chanceDe(s, jugador);
    if (c) {
      let texto;
      if (c.solo === c.total) texto = "Ya aseguraste el primer lugar, pase lo que pase.";
      else if (!c.solo && !c.empata) texto = "Con lo que falta ya no alcanzas el primer lugar.";
      else {
        const veces = Math.max(1, Math.round((100 * (c.solo + c.empata)) / c.total));
        texto = "Ganas o empatas la semana en " + veces + " de cada 100 resultados posibles.";
      }
      const nota = crear("button", "nota-chance", texto + " ");
      nota.appendChild(crear("b", null, "Ver escenarios"));
      nota.type = "button";
      nota.addEventListener("click", () => { pestana = "escenarios"; pestanaElegida = true; navegar(s.n); });
      caja.appendChild(nota);
    }
    return caja;
  }

  function tarjetaPicks(picks) {
    const caja = crear("section", "tarjeta tus-picks");
    const cab = crear("div", "cab");
    cab.appendChild(crear("h3", null, "Semana " + picks.s.n));
    cab.appendChild(cuentaRegresiva("cuenta-regresiva", "cierran en ", Date.parse(picks.cierre.cierre)));
    caja.appendChild(cab);
    const cuantos = porElegir(picks), llevas = borradorDe(picks);
    caja.appendChild(crear("p", "nota", (llevas
      ? "Llevas " + llevas + " de " + cuantos + ". "
      : cuantos + (cuantos === 1 ? " partido por elegir. " : " partidos por elegir. ")) + textoCierres(picks)));
    const b = crear("button", "boton-principal", llevas ? "Seguir con mis picks" : "Armar mis picks");
    b.type = "button";
    b.addEventListener("click", () => navegar("picks"));
    caja.appendChild(b);
    return caja;
  }

  /* Cuántos picks de lo que sigue abierto lleva el borrador de este teléfono. */
  function borradorDe(picks) {
    let guardado = {};
    try { guardado = JSON.parse(leer(LLAVE_BORRADOR(picks.s.n)) || "{}"); } catch (e) { guardado = {}; }
    const abiertos = new Set(tandasAbiertas(picks).flatMap((tanda) => tanda.claves));
    return Object.keys(guardado).filter((clave) => abiertos.has(clave)).length;
  }

  function tarjetaProximo() {
    const prox = proximoPartido();
    if (!prox) return null;
    const caja = crear("section", "tarjeta proximo");
    const cab = crear("div", "cab");
    cab.appendChild(crear("h3", null, "Próximo partido"));
    cab.appendChild(cuentaRegresiva("cuenta-regresiva", "en ", prox.p.t * 1000));
    caja.appendChild(cab);
    const fila = crear("div", "juego-fila quieto");
    const lados = crear("div", "lados");
    [prox.p.v, prox.p.l].forEach((eq) => {
      const l = crear("div", "eq-fila");
      l.appendChild(sigla(eq));
      l.appendChild(crear("span", "eq", eq));
      lados.appendChild(l);
    });
    fila.appendChild(lados);
    const meta = crear("div", "meta");
    meta.appendChild(crear("span", "cuando", new Date(prox.p.t * 1000).toLocaleString("es-MX",
      { weekday: "short", day: "numeric", hour: "2-digit", minute: "2-digit", hour12: false })));
    meta.appendChild(crear("span", "consenso", "Semana " + prox.s.n));
    fila.appendChild(meta);
    caja.appendChild(fila);
    return caja;
  }


  /* ═══ picks: la única puerta para armar los tuyos ═══
     Se acomoda a la semana en curso: lo que está abierto, con su cuenta
     regresiva, y lo que el organizador ya registró a tu nombre para que
     revises que quedó bien. */
  function pintarPicks() {
    const raiz = vistas.picks;
    raiz.textContent = "";
    const abiertos = picksAbiertos();
    const conPicks = [porSemana.get(D.activa)].concat(D.semanas.slice().reverse())
      .find((x) => x && x.jugadores && x.jugadores.length);
    const s = abiertos ? abiertos.s : (porSemana.get(D.activa) || conPicks);

    let detalle;
    if (abiertos) {
      const n = porElegir(abiertos);
      detalle = n + (n === 1 ? " partido" : " partidos") + " por elegir. " + textoCierres(abiertos);
    } else {
      detalle = "Por ahora no hay partidos abiertos. Los siguientes se abren en cuanto salga el calendario de la próxima semana.";
    }
    raiz.appendChild(cabezaDeVista(s ? "Semana " + s.n : "Temporada " + D.anio,
      abiertos ? "Tus" : "Picks", abiertos ? "picks" : "cerrados", detalle));

    if (abiertos) {
      const tarjeta = crear("section", "tarjeta tus-picks completa");
      const cab = crear("div", "cab");
      cab.appendChild(crear("h3", null, "Arma tu quiniela"));
      cab.appendChild(cuentaRegresiva("cuenta-regresiva", "cierran en ", Date.parse(abiertos.cierre.cierre)));
      tarjeta.appendChild(cab);
      tarjeta.appendChild(moduloPicks(abiertos.s, abiertos.lista, abiertos.tandas, abiertos.parcial));
      raiz.appendChild(tarjeta);
    }

    if (conPicks) {
      const tarjeta = crear("section", "tarjeta registrados");
      const cab = crear("div", "cab");
      cab.appendChild(crear("h3", null, "Registrados · semana " + conPicks.n));
      const todos = crear("button", "enlace", "Los de todos ›");
      todos.type = "button";
      todos.addEventListener("click", () => { pestana = "picks"; pestanaElegida = true; navegar(conPicks.n); });
      cab.appendChild(todos);
      tarjeta.appendChild(cab);
      if (jugador === null) {
        tarjeta.appendChild(crear("p", "nota", "Elige tu nombre arriba y aquí ves lo que el organizador registró a tu nombre."));
      } else if (conPicks.jugadores.indexOf(jugador) < 0) {
        tarjeta.appendChild(crear("p", "nota", "El organizador todavía no registra picks a tu nombre en la semana " + conPicks.n + "."));
      } else {
        tarjeta.appendChild(crear("p", "nota", "Lo que el organizador cargó a tu nombre. Si algo no coincide con lo que mandaste, avísale."));
        tarjeta.appendChild(boleta(conPicks, jugador));
      }
      raiz.appendChild(tarjeta);
    }
  }


  /* ═══ dentro de "Semana" ═══ */
  function selectorDeSemanas(actual) {
    const caja = crear("div", "cambia-semana");
    const i = D.semanas.findIndex((x) => x.n === actual);
    const flecha = (destino, trazo) => {
      const b = crear("button", "flecha-semana");
      b.type = "button";
      b.innerHTML = '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="' + trazo + '"/></svg>';
      if (!destino) { b.disabled = true; b.setAttribute("aria-label", "No hay más semanas"); return b; }
      b.setAttribute("aria-label", "Semana " + destino.n);
      b.addEventListener("click", () => { pestanaElegida = false; navegar(destino.n); });
      return b;
    };
    caja.appendChild(flecha(D.semanas[i - 1], "M15 5l-7 7 7 7"));
    const centro = crear("button", "semana-elegida");
    centro.type = "button";
    centro.setAttribute("aria-haspopup", "dialog");
    centro.setAttribute("aria-label", "Semana " + actual + ". Elegir otra semana");
    centro.appendChild(crear("span", "num", "Semana " + actual));
    centro.appendChild(crear("span", "abre"));
    centro.addEventListener("click", () => abrirSemanas(actual, centro));
    caja.appendChild(centro);
    caja.appendChild(flecha(D.semanas[i + 1], "M9 5l7 7-7 7"));
    return caja;
  }

  /* Todas las semanas en una hoja aparte: la fila de S1 a S18 ocupaba media
     pantalla. Cada una dice cómo quedó y cuántos llevas tú. */
  function abrirSemanas(actual, origen) {
    const contenido = crear("div");
    const rejilla = crear("div", "rejilla-semanas");
    const g = jugador !== null ? D.general.find((f) => f.p === jugador) : null;
    const ir_ = (n) => {
      // La hoja ocupaba su lugar en el historial: la semana elegida entra en su lugar.
      if (hojaAbierta) hojaAbierta.cerrar(true);
      reemplazarEntrada = true;
      pestanaElegida = false;
      navegar(n);
    };
    D.semanas.forEach((s) => {
      const vivos = juegosEnVivo(s).length;
      const b = crear("button", "celda-semana " + s.estado + (vivos ? " vivo" : ""));
      b.type = "button";
      if (s.n === actual) b.classList.add("elegida");
      if (s.n === D.activa) b.classList.add("en-curso");
      b.appendChild(crear("b", null, String(s.n)));
      b.appendChild(crear("small", null, vivos ? "En vivo" : { pendiente: "Por cargar", en_vivo: "En curso", cerrada: "Cerrada" }[s.estado] || ""));
      const mios = g && g.sem ? g.sem[String(s.n)] : undefined;
      if (mios !== undefined && s.estado !== "pendiente") {
        const gano = s.oficial && (s.ganadores || []).includes(jugador);
        b.appendChild(crear("span", "mio" + (gano ? " gano" : ""), (gano ? "🏆 " : "") + mios + (mios === 1 ? " tuyo" : " tuyos")));
      }
      b.setAttribute("aria-current", String(s.n === actual));
      b.addEventListener("click", () => ir_(s.n));
      rejilla.appendChild(b);
    });
    contenido.appendChild(rejilla);
    if (actual !== D.activa && porSemana.has(D.activa)) {
      const volver = crear("button", "boton-principal volver-actual", "Ir a la semana en curso (" + D.activa + ")");
      volver.type = "button";
      volver.addEventListener("click", () => ir_(D.activa));
      contenido.appendChild(volver);
    }
    const hoja = abrirHoja("Semanas", contenido, { origen });
    const elegida = hoja.querySelector('[aria-current="true"]');
    if (elegida) elegida.focus({ preventScroll: true });
  }

  /* ═══ las hojas que suben ═══
     Se cierran arrastrando hacia abajo, tocando afuera, con Esc o con el botón
     Atrás del teléfono: cada hoja ocupa un lugar en el historial. */
  let hojaAbierta = null, reemplazarEntrada = false, ignorarPop = false;
  function abrirHoja(titulo, contenido, opciones) {
    const { origen, alCerrar } = opciones || {};
    if (hojaAbierta) hojaAbierta.cerrar(true);
    const fondo = crear("div", "hoja-fondo");
    const hoja = crear("div", "hoja");
    hoja.setAttribute("role", "dialog");
    hoja.setAttribute("aria-modal", "true");
    hoja.setAttribute("aria-label", titulo);
    const tirador = crear("div", "tirador");
    tirador.appendChild(crear("div", "agarradera"));
    tirador.appendChild(crear("h3", null, titulo));
    hoja.appendChild(tirador);
    hoja.appendChild(contenido);
    fondo.appendChild(hoja);

    let cerrada = false;
    const tecla = (e) => { if (e.key === "Escape") cerrar(); };
    function cerrar(sinHistoria) {
      if (cerrada) return;
      cerrada = true;
      hojaAbierta = null;
      document.documentElement.classList.remove("con-hoja");
      document.removeEventListener("keydown", tecla);
      fondo.classList.add("saliendo");
      hoja.style.transform = "";
      let terminada = false;
      const fin = () => {
        if (terminada) return;
        terminada = true;
        fondo.remove();
        if (alCerrar) alCerrar();
      };
      fondo.addEventListener("animationend", fin);
      setTimeout(fin, 320);
      if (origen && origen.isConnected) origen.focus({ preventScroll: true });
      if (!sinHistoria && history.state && history.state.hoja) { ignorarPop = true; history.back(); }
    }

    // Arrastrar desde arriba.
    let inicioY = null, ultimoY = 0, ultimoT = 0, velocidad = 0;
    tirador.addEventListener("pointerdown", (e) => {
      inicioY = e.clientY; ultimoY = e.clientY; ultimoT = e.timeStamp; velocidad = 0;
      hoja.style.animation = "none";
      hoja.style.transition = "none";
      tirador.setPointerCapture(e.pointerId);
    });
    tirador.addEventListener("pointermove", (e) => {
      if (inicioY === null) return;
      const d = Math.max(0, e.clientY - inicioY);
      velocidad = (e.clientY - ultimoY) / Math.max(1, e.timeStamp - ultimoT);
      ultimoY = e.clientY; ultimoT = e.timeStamp;
      hoja.style.transform = "translateY(" + d + "px)";
    });
    const soltar = (e) => {
      if (inicioY === null) return;
      const d = Math.max(0, e.clientY - inicioY);
      inicioY = null;
      hoja.style.transition = "transform .32s var(--hoja)";
      if (d > 110 || velocidad > 0.6) { hoja.style.animation = ""; cerrar(); }
      else hoja.style.transform = "";
    };
    tirador.addEventListener("pointerup", soltar);
    tirador.addEventListener("pointercancel", soltar);

    fondo.addEventListener("click", (e) => { if (e.target === fondo) cerrar(); });
    document.addEventListener("keydown", tecla);
    document.documentElement.classList.add("con-hoja");
    document.body.appendChild(fondo);
    history.pushState(Object.assign({}, history.state, { hoja: true }), "", location.href);
    hojaAbierta = { cerrar };
    return hoja;
  }

  /* El aviso de abajo, con una acción: "Borraste tus picks · Deshacer". */
  let flotanteActual = null;
  function avisoFlotante(texto, accion, alTocar) {
    if (flotanteActual) flotanteActual.remove();
    const caja = crear("div", "flotante");
    caja.setAttribute("role", "status");
    caja.appendChild(crear("span", null, texto));
    const quitar = () => {
      caja.classList.add("saliendo");
      setTimeout(() => caja.remove(), 240);
      if (flotanteActual === caja) flotanteActual = null;
    };
    const b = crear("button", null, accion);
    b.type = "button";
    b.addEventListener("click", () => { quitar(); alTocar(); });
    caja.appendChild(b);
    document.body.appendChild(caja);
    flotanteActual = caja;
    setTimeout(quitar, 7000);
  }

  /* Una sola línea con todo lo que antes eran tres tarjetas de avisos. */
  function lineaDeEstado(s) {
    const caja = crear("div", "detalle-semana");
    if (s.estado !== "pendiente") {
      const barra = crear("div", "avance-semana");
      barra.setAttribute("aria-hidden", "true");
      const lleno = crear("i");
      lleno.style.width = (s.total ? (100 * s.cerrados) / s.total : 0) + "%";
      barra.appendChild(lleno);
      caja.appendChild(barra);
    }
    const partes = [];
    if (s.estado === "pendiente") {
      const tanda = (s.tandas || []).find((x) => Date.parse(x.cierre) > Date.now()) || (s.tandas || [])[0];
      partes.push("Picks por cargar");
      if (tanda) partes.push("cierran el " + tanda.cierre_texto);
    } else {
      partes.push(s.cerrados + " de " + s.total + " partidos cerrados");
      if (s.estado !== "cerrada" && !s.proyectable) partes.push("ganador desde " + s.umbral);
    }
    caja.appendChild(crear("p", "linea-estado", partes.join(" · ")));
    return caja;
  }

  /* En Semana ya no va el generador: una sola puerta para los picks. */
  function avisoPicks(s, cuantos) {
    const abiertos = picksAbiertos();
    if (!abiertos || abiertos.s !== s) return null;
    const b = crear("button", "aviso-picks");
    b.type = "button";
    b.appendChild(crear("span", "txt", cuantos + (cuantos === 1 ? " partido" : " partidos") +
      " por elegir. Cierran el " + abiertos.cierre.cierre_texto + "."));
    b.appendChild(crear("span", "ir", "Armar mis picks"));
    b.addEventListener("click", () => navegar("picks"));
    return b;
  }

  /* ═══ vista de una semana ═══ */
  const PESTANAS = [["partidos", "Partidos"], ["tabla", "Tabla"],
                    ["picks", "Quién le fue a quién"], ["escenarios", "Escenarios"]];

  function pintarSemana(n) {
    const s = porSemana.get(n), raiz = vistas.semana;
    raiz.textContent = "";
    if (!s) return;

    const cabeza = crear("div", "cabeza-semana");
    cabeza.appendChild(selectorDeSemanas(n));
    const vivos = juegosEnVivo(s).length;
    const fila = crear("div", "estado-fila");
    const estado = crear("span", "estado-semana " + (vivos ? "vivo" : s.estado),
      vivos ? "En vivo" : { pendiente: "Por cargar", en_vivo: "En curso", cerrada: "Cerrada" }[s.estado] || "");
    if (vivos && ultimaConsulta) estado.title = "Última consulta " + ultimaConsulta.toLocaleTimeString("es-MX");
    fila.appendChild(estado);
    if (n !== D.activa && porSemana.has(D.activa)) {
      const volver = crear("button", "volver-actual", "Ir a la semana " + D.activa);
      volver.type = "button";
      volver.addEventListener("click", () => { pestanaElegida = false; navegar(D.activa); });
      fila.appendChild(volver);
    }
    cabeza.appendChild(fila);
    if (s.estado === "pendiente") cabeza.appendChild(crear("div", "frontera"));
    cabeza.appendChild(lineaDeEstado(s));
    raiz.appendChild(cabeza);

    const franja = avisoDeRezago(s);
    if (franja) raiz.appendChild(franja);

    if (s.estado === "pendiente") {
      const aviso_ = avisoPicks(s, s.partidos.length);
      if (aviso_) raiz.appendChild(aviso_);
      raiz.appendChild(panelPartidos(s));
      return;
    }

    const hero = campeon(s, true);
    if (hero) raiz.appendChild(hero);
    const resumen = miSemana(s);
    if (resumen) raiz.appendChild(resumen);

    /* El organizador reparte por tandas: mientras falten partidos por repartir,
       queda a la mano el acceso a la sección Picks. */
    if ((s.por_entregar || []).length) {
      const aviso_ = avisoPicks(s, s.por_entregar.length);
      if (aviso_) raiz.appendChild(aviso_);
    }

    const disponibles = PESTANAS.filter(([c]) =>
      c !== "escenarios" || (s.cerrados < s.total && Object.keys(s.panorama || {}).length > 0));
    if (!pestanaElegida) pestana = juegosDeHoy(s).length || vivos ? "partidos" : "tabla";
    if (!disponibles.some(([c]) => c === pestana)) pestana = disponibles[0][0];

    const ancla = crear("div");
    raiz.appendChild(ancla);
    const tabs = crear("div", "tabs"), interior = crear("div", "tabs-int");
    interior.setAttribute("role", "tablist");
    interior.setAttribute("aria-label", "Vistas de la semana " + s.n);
    const corredera = crear("span", "corredera");
    interior.appendChild(corredera);
    const panel = crear("div", "panel-semana");
    disponibles.forEach(([clave, etiqueta]) => {
      const b = crear("button", null, etiqueta);
      b.type = "button";
      b.setAttribute("role", "tab");
      b.setAttribute("aria-selected", String(clave === pestana));
      /* Cambiar de pestaña solo cambia lo de abajo: el resto de la vista no se
         redibuja ni vuelve a animarse. Y si ya habías bajado, regresas al inicio de
         la lista nueva, no a la mitad. */
      b.addEventListener("click", () => {
        if (clave === pestana) return;
        const de = disponibles.findIndex(([c]) => c === pestana);
        const a = disponibles.findIndex(([c]) => c === clave);
        pestana = clave;
        pestanaElegida = true;
        raiz.classList.remove("anima");
        interior.querySelectorAll("button").forEach((x) => x.setAttribute("aria-selected", String(x === b)));
        moverCorredera(interior);
        panel.textContent = "";
        panel.appendChild(contenidoDePestana(s));
        panel.style.setProperty("--lado", a > de ? 1 : -1);
        panel.classList.remove("panel-entra");
        void panel.offsetWidth;
        panel.classList.add("panel-entra");
        observarRevela(panel);
        const tope = ancla.getBoundingClientRect().top + window.scrollY -
          (parseFloat(getComputedStyle(document.documentElement).getPropertyValue("--alto-encabezado")) || 0);
        if (window.scrollY > tope) window.scrollTo({ top: tope, behavior: "instant" });
        recordarSitio();
      });
      interior.appendChild(b);
    });
    tabs.appendChild(interior);
    raiz.appendChild(tabs);
    requestAnimationFrame(() => moverCorredera(interior));
    panel.appendChild(contenidoDePestana(s));
    raiz.appendChild(panel);
  }

  function contenidoDePestana(s) {
    if (pestana === "tabla") return tablaSemana(s);
    if (pestana === "partidos") return panelPartidos(s);
    if (pestana === "picks") return panelReparto(s);
    return panelEscenarios(s);
  }

  /* La corredera sigue a la pestaña activa en vez de pintarle un fondo fijo. */
  function moverCorredera(interior) {
    const activa = interior.querySelector('button[aria-selected="true"]');
    const corredera = interior.querySelector(".corredera");
    if (!activa || !corredera) return;
    corredera.style.width = activa.offsetWidth + "px";
    corredera.style.transform = "translateX(" + activa.offsetLeft + "px)";
    activa.scrollIntoView({ inline: "nearest", block: "nearest" });
  }

  /* Filtro de nombres sobre una tabla ya dibujada. */
  function ponerFiltro(destino, filas, textoDe, etiqueta) {
    const caja = crear("div", "filtro-tabla");
    const campo = crear("input");
    campo.type = "search";
    campo.placeholder = etiqueta;
    campo.setAttribute("aria-label", etiqueta);
    caja.appendChild(campo);
    const mia = crear("button", "mi-fila", "Mi fila");
    mia.type = "button";
    mia.hidden = jugador === null;
    mia.addEventListener("click", () => {
      if (campo.value) { campo.value = ""; campo.dispatchEvent(new Event("input")); }
      const fila = destino.querySelector("tbody tr.yo");
      if (!fila) return;
      fila.scrollIntoView({ behavior: suave ? "auto" : "smooth", block: "center" });
      fila.classList.remove("resaltada");
      void fila.offsetWidth;
      fila.classList.add("resaltada");
    });
    caja.appendChild(mia);
    const vacio = crear("div", "sin-resultados", "Nadie con ese nombre.");
    vacio.hidden = true;
    campo.addEventListener("input", () => {
      const busca = campo.value.trim().toLowerCase();
      let visibles = 0;
      filas.forEach((fila) => {
        const cabe = !busca || textoDe(fila).toLowerCase().includes(busca);
        fila.hidden = !cabe;
        if (cabe) visibles++;
      });
      vacio.hidden = visibles > 0;
    });
    destino.insertBefore(caja, destino.firstChild);
    destino.appendChild(vacio);
  }

  /* ═══ volver arriba ═══ */
  const botonArriba = crear("button", "arriba");
  botonArriba.type = "button";
  botonArriba.setAttribute("aria-label", "Volver arriba");
  botonArriba.innerHTML =
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" ' +
    'stroke-linecap="round" stroke-linejoin="round"><path d="M12 19V5M5 12l7-7 7 7"/></svg>';
  botonArriba.addEventListener("click", () => window.scrollTo({ top: 0, behavior: "smooth" }));
  document.body.appendChild(botonArriba);

  /* Al bajar, el campo y la fila de la marca se van con la página: aquí no se toca el campo. */
  const encabezado = document.querySelector("header");
  const filaMarca = encabezado.querySelector(".top");
  const ancho = window.matchMedia("(min-width:900px)");
  let altoMarca = 56;
  function alMoverse() {
    const y = window.scrollY;
    botonArriba.classList.toggle("se-ve", y > 520);
    encabezado.classList.toggle("plegado", y > altoMarca * 0.6);
  }
  let esperandoScroll = false;
  window.addEventListener("scroll", () => {
    if (esperandoScroll) return;
    esperandoScroll = true;
    requestAnimationFrame(() => {
      alMoverse();
      recordarSitio();
      esperandoScroll = false;
    });
  }, { passive: true });

  // El acelerador de arriba usa requestAnimationFrame, que no corre con la
  // pestaña oculta. Al salir se anota la posición a la fuerza.
  window.addEventListener("pagehide", recordarSitio);
  document.addEventListener("visibilitychange", () => {
    if (document.hidden) recordarSitio();
    document.documentElement.classList.toggle("pausada", document.hidden);
  });

  /* La carrera: la cámara se lanza hacia la zona de anotación y regresa a su lugar. Es el punto
     para un touchdown: lo llama quien detecte la jugada. Con el campo fuera de la pantalla o con
     movimiento reducido no hace nada, y no toca nada que no sea transform y opacity. */
  function correCampo() {
    const cancha = document.querySelector(".cancha");
    if (suave || window.scrollY > cancha.offsetHeight || cancha.classList.contains("corre")) return;
    cancha.classList.add("corre");
    setTimeout(() => cancha.classList.remove("corre"), 1500);
  }
  window.correCampo = correCampo;

  /* La frontera: el campo arranca donde termina el encabezado y acaba en la línea amarilla
     de lo que se está viendo. Se mide al pintar y al cambiar de tamaño, nunca al bajar. */
  function ajustarCampo() {
    const estilo = document.documentElement.style;
    const vista = document.querySelector(".vista:not(.oculto)");
    const linea = vista && vista.querySelector(".saludo,.frontera,.cabeza-semana .avance-semana");
    estilo.setProperty("--ancla", encabezado.offsetHeight + "px");
    estilo.setProperty("--alto-campo", (linea ? Math.round(linea.getBoundingClientRect().bottom + window.scrollY) : 0) + "px");
  }

  /* Lo que queda pegado arriba al bajar: en el teléfono, solo tu avance. */
  function medirEncabezado() {
    altoMarca = ancho.matches ? 0 : Math.round(filaMarca.getBoundingClientRect().height);
    const todo = Math.round(encabezado.getBoundingClientRect().height);
    document.documentElement.style.setProperty("--alto-marca", altoMarca + "px");
    document.documentElement.style.setProperty("--alto-encabezado", (todo - altoMarca) + "px");
    ajustarCampo();
  }
  medirEncabezado();
  if (window.ResizeObserver) new ResizeObserver(medirEncabezado).observe(encabezado);
  else window.addEventListener("resize", medirEncabezado);

  /* Lo de más abajo entra una sola vez, cuando asoma sobre la barra. Lo que ya se ve al
     pintar no se mueve, y redibujar no lo vuelve a lanzar. */
  const revelador = suave || !window.IntersectionObserver ? null : new IntersectionObserver((entradas) => {
    entradas.forEach((entrada) => {
      if (!entrada.isIntersecting) return;
      revelador.unobserve(entrada.target);
      entrada.target.classList.add("revela");
    });
  }, { rootMargin: "0px 0px " + (ancho.matches ? 0 : -84) + "px 0px" });
  function observarRevela(raiz) {
    if (!revelador) return;
    revelador.disconnect();
    // Dos cuadros después: ya con la vista puesta y a la altura donde se va a quedar, que
    // al recargar se repone en el cuadro siguiente. Lo que ya se ve no se toca.
    requestAnimationFrame(() => requestAnimationFrame(() => {
      raiz.querySelectorAll(".lista-juegos,.split,.candidato,.regla,.ganadores,.boleta").forEach((nodo) => {
        if (nodo.getBoundingClientRect().top >= window.innerHeight - (ancho.matches ? 0 : 84)) revelador.observe(nodo);
      });
    }));
  }

  /* ═══ navegación ═══ */
  /* La pastilla que marca la sección elegida, en las dos barras. */
  navs.forEach((n) => n.insertBefore(crear("span", "indicador"), n.firstChild));
  function moverIndicadores() {
    navs.forEach((n) => {
      const pastilla = n.querySelector(".indicador");
      const elegido = n.querySelector('button[aria-selected="true"]');
      if (!pastilla || !elegido || !n.offsetWidth) return;     // la barra oculta no se mide
      const margen = n.classList.contains("al-pie") ? 2 : 0;
      pastilla.style.width = (elegido.offsetWidth - margen * 2) + "px";
      pastilla.style.transform = "translateX(" + (elegido.offsetLeft + margen) + "px)";
      if (!pastilla.classList.contains("listo")) requestAnimationFrame(() => pastilla.classList.add("listo"));
    });
  }
  window.addEventListener("resize", moverIndicadores);

  /* Cambiar de sección desliza la vista hacia donde vas: a la derecha si la
     sección está más adelante en la barra (o la semana es posterior), a la
     izquierda si está antes. Sin soporte del navegador, entra como siempre. */
  const ORDEN_VISTAS = ["hoy", "picks", "semana", "general", "jugadores", "premios"];
  function rumboHacia(destino) {
    const de = typeof vistaActual === "number" ? "semana" : vistaActual;
    const a = destino === "semana" || typeof destino === "number" ? "semana" : destino;
    if (de === "semana" && a === "semana") {
      const n = destino === "semana" ? semanaElegida : destino;
      return n > vistaActual ? "adelante" : n < vistaActual ? "atras" : null;
    }
    const i = ORDEN_VISTAS.indexOf(de), j = ORDEN_VISTAS.indexOf(a);
    return j > i ? "adelante" : j < i ? "atras" : null;
  }
  function conTransicion(rumbo, cambio) {
    if (!rumbo || !document.startViewTransition || suave || document.hidden) return false;
    document.documentElement.dataset.rumbo = rumbo;
    const paso = document.startViewTransition(cambio);
    // Una transición que se salta (dos toques seguidos) no es un error.
    [paso.ready, paso.finished, paso.updateCallbackDone].forEach((p) => p && p.catch(() => {}));
    return true;
  }

  /* Cada sección, semana y ficha es un lugar en el historial: el botón Atrás del
     teléfono regresa a donde estabas, a la misma altura, y no te saca del portal. */
  if ("scrollRestoration" in history) history.scrollRestoration = "manual";
  function estadoActual() {
    return { vista: vistaActual, pestana, elegida: pestanaElegida,
      perfil: perfilAbierto === null ? null : D.participantes[perfilAbierto] };
  }
  function direccionDe(vista) {
    if (typeof vista === "number") return "#s" + vista;
    if (vista === "jugadores" && perfilAbierto !== null) return "#jugador/" + encodeURIComponent(D.participantes[perfilAbierto]);
    return "#" + (vista === "jugadores" ? "general" : vista);
  }
  function leerDireccion() {
    const hash = location.hash;
    const semana = hash.match(/^#s(\d+)$/);
    if (semana && porSemana.has(Number(semana[1]))) return { vista: Number(semana[1]) };
    const ficha = hash.match(/^#jugador\/(.+)$/);
    if (ficha) {
      let quien = null;
      try { quien = decodeURIComponent(ficha[1]); } catch (e) { quien = null; }
      if (quien && D.participantes.includes(quien)) return { vista: "jugadores", perfil: quien };
    }
    if (["#hoy", "#picks", "#premios", "#general"].includes(hash)) return { vista: hash.slice(1) };
    return null;
  }
  function anotarAltura() {
    history.replaceState(Object.assign({}, history.state, { y: Math.round(window.scrollY) }), "", location.href);
  }

  function navegar(destino, despues) {
    anotarAltura();
    const cambio = (quieto) => {
      window.scrollTo({ top: 0, behavior: "instant" });
      ir(destino, true, quieto);
      if (despues) despues();
    };
    if (!conTransicion(rumboHacia(destino), () => cambio(true))) cambio(false);
  }

  /* Abrir la ficha de alguien: su nombre viaja desde la fila hasta el titular. */
  function abrirPerfil(idx, nodo) {
    if (nodo && !suave) nodo.style.viewTransitionName = "nombre-perfil";
    anotarAltura();
    perfilAbierto = idx;
    const cambio = (quieto) => {
      if (nodo) nodo.style.viewTransitionName = "";
      window.scrollTo({ top: 0, behavior: "instant" });
      ir("jugadores", true, quieto);
    };
    if (!conTransicion(vistaActual === "jugadores" ? null : "adelante", () => cambio(true))) cambio(false);
  }

  window.addEventListener("popstate", (evento) => {
    if (ignorarPop) { ignorarPop = false; return; }
    if (hojaAbierta) { hojaAbierta.cerrar(true); return; }
    const estado = evento.state || leerDireccion() || { vista: "hoy" };
    if (estado.hoja) return;
    const cambio = () => {
      if (estado.perfil !== undefined) {
        const i = estado.perfil ? D.participantes.indexOf(estado.perfil) : -1;
        perfilAbierto = i >= 0 ? i : null;
      }
      if (estado.pestana) pestana = estado.pestana;
      if (estado.elegida !== undefined) pestanaElegida = !!estado.elegida;
      ir(estado.vista, false, true);
      window.scrollTo({ top: estado.y || 0, behavior: "instant" });
    };
    // En Safari el gesto de regresar ya trae su propia animación.
    if (evento.hasUAVisualTransition || !conTransicion("atras", cambio)) cambio();
  });

  function repintar() {
    const alto = window.scrollY;
    ir(vistaActual, false, true);
    window.scrollTo({ top: alto, behavior: "instant" });
  }

  /* El repintado que pide el reloj o el marcador, no la persona: espera si está
     escribiendo o acaba de tocar algo, y le devuelve lo que tenía a medias. */
  let repintePendiente = false;
  function repintarSinEstorbar() {
    if (escribiendo() || hojaAbierta || Date.now() - ultimoToque < 8000) { repintePendiente = true; return; }
    repintePendiente = false;
    const controles = leerControles();
    repintar();
    reponerControles(controles);
  }
  document.addEventListener("focusout", () => setTimeout(() => {
    if (repintePendiente) repintarSinEstorbar();
  }, 0));

  let vistaRevelada = null;
  function ir(vista, empujar, quieto) {
    if (vista === "semana") vista = semanaElegida;
    if (typeof vista === "number" || /^\d+$/.test(String(vista))) {
      vista = Number(vista);
      if (!porSemana.has(vista)) vista = "hoy";
      else semanaElegida = vista;
    }
    vistaActual = vista;
    const cual = typeof vista === "number" ? "semana" : (vistas[vista] ? vista : "hoy");
    Object.entries(vistas).forEach(([k, nodo]) => nodo.classList.toggle("oculto", k !== cual));
    // Si una pantalla falla al pintar, el resto del arranque sigue.
    try {
      if (cual === "semana") pintarSemana(vista);
      else if (cual === "hoy") pintarHoy();
      else if (cual === "picks") pintarPicks();
      else if (cual === "premios") pintarPremios();
      else if (cual === "jugadores") pintarJugadores();
      else marcarFilasPropias();
    } catch (e) { console.error(e); try { avisoFlotante("Algo no se pudo mostrar. Recarga la página."); } catch (e2) { /* sin aviso */ }; }
    try { pintarMiBarra(); } catch (e) { console.error(e); }
    ajustarCampo();

    // Solo se anima lo que acaba de entrar: redibujar no lanza nada otra vez.
    const nodo = vistas[cual];
    nodo.classList.remove("anima");
    if (!quieto) {
      void nodo.offsetWidth;
      nodo.classList.add("anima");
    }
    if (vista !== vistaRevelada) {
      vistaRevelada = vista;
      observarRevela(nodo);
    }

    // Las fichas viven dentro de General: la barra marca General.
    const enBarra = cual === "jugadores" ? "general" : cual;
    navs.forEach((n) => n.querySelectorAll("button").forEach((b) =>
      b.setAttribute("aria-selected", String(b.dataset.vista === enBarra))));
    moverIndicadores();
    pintarEstado(cual === "semana" ? vista : D.activa);

    const destino = direccionDe(vista);
    if (empujar) {
      if (reemplazarEntrada || location.hash === destino) history.replaceState(estadoActual(), "", destino);
      else history.pushState(estadoActual(), "", destino);
      reemplazarEntrada = false;
    }
    recordarSitio();
  }

  /* En el teléfono cabe la semana más reciente, sin deslizar nada; las demás,
     de la más nueva a la más vieja, quedan a un toque. */
  const botonTodas = document.getElementById("ver-todas");
  if (botonTodas) {
    botonTodas.dataset.todas = botonTodas.textContent;
    botonTodas.addEventListener("click", () => {
      const abierta = vistas.general.querySelector(".rueda").classList.toggle("expandida");
      botonTodas.textContent = abierta ? "Ver menos" : botonTodas.dataset.todas;
    });
  }

  /* La tabla general viene escrita en el HTML: aquí se marca tu fila,
     se hace clicable y se le agrega el buscador. */
  let generalLista = false;
  /* El podio viene escrito en el HTML; aquí sus cifras arrancan de cero. */
  let podioAnimado = false;
  function marcarFilasPropias() {
    const filas = vistas.general.querySelectorAll("tbody tr");
    if (!generalLista && filas.length > 12) {
      generalLista = true;
      const marco = vistas.general.querySelector(".marco");
      const env = crear("div");
      marco.parentNode.insertBefore(env, marco);
      env.appendChild(marco);
      ponerFiltro(env, Array.from(filas),
        (fila) => fila.children[1].textContent, "Buscar participante…");
    }
    const mia = vistas.general.querySelector(".mi-fila");
    if (mia) mia.hidden = jugador === null;
    filas.forEach((tr, i) => {
      const f = D.general[i];
      if (!f) return;
      tr.classList.toggle("yo", f.p === jugador);
      if (!tr.dataset.listo) {
        tr.dataset.listo = "1";
        tr.classList.add("clic");
        tr.addEventListener("click", () => abrirPerfil(f.p, tr.children[1]));
      }
    });
  }

  navs.forEach((n) => n.addEventListener("click", (e) => {
    const b = e.target.closest("button");
    if (!b) return;
    const aqui = typeof vistaActual === "number" ? "semana" : vistaActual === "jugadores" ? "general" : vistaActual;
    // "Semana" en la barra siempre lleva a la que se está jugando.
    if (b.dataset.vista === "semana") {
      pestanaElegida = false;
      if (porSemana.has(D.activa)) semanaElegida = D.activa;
    }
    // Tocar la sección en la que ya estás te regresa arriba.
    const misma = b.dataset.vista === aqui && vistaActual !== "jugadores" && (aqui !== "semana" || vistaActual === semanaElegida);
    if (misma) { window.scrollTo({ top: 0, behavior: suave ? "auto" : "smooth" }); return; }
    navegar(b.dataset.vista);
  }));
  // El logo siempre lleva a Hoy.
  document.querySelector(".logo").addEventListener("click", (e) => {
    e.preventDefault();
    navegar("hoy");
  });
  const aDinamica = document.getElementById("a-dinamica");
  if (aDinamica) aDinamica.addEventListener("click", () => navegar("premios", () => requestAnimationFrame(() => {
    const ancla = document.getElementById("dinamica");
    if (ancla) ancla.scrollIntoView({ behavior: suave ? "auto" : "smooth", block: "start" });
  })));

  montarSoy();
  montarEquipo();
  pintarIdentidad();
  calcularNovedades();

  const direccion = leerDireccion();
  const guardado = sitioGuardado();
  const valida = (v) => v === "hoy" || v === "picks" || v === "general" || v === "premios" || v === "jugadores" ||
    porSemana.has(Number(v));

  const inicio = direccion ? direccion.vista
    : guardado && valida(guardado.vista) ? guardado.vista
    : "hoy";

  if (guardado && guardado.pestana) pestana = guardado.pestana;
  const automatica = !!(guardado && guardado.auto);
  if (automatica && guardado.elegida) pestanaElegida = true;
  const perfilInicial = direccion && direccion.perfil ? direccion.perfil : (guardado && guardado.vista === "jugadores" ? guardado.perfil : null);
  if (perfilInicial && D.participantes.includes(perfilInicial)) {
    perfilAbierto = D.participantes.indexOf(perfilInicial);
  }

  ir(inicio, false);
  // Ya hay vista: se destapa aquí mismo, para que la altura guardada encuentre su página.
  document.documentElement.classList.add("listo");
  history.replaceState(estadoActual(), "", direccionDe(vistaActual));
  alMoverse();

  // La vista ya está dibujada: ahora sí arranca la entrada, para no perder el principio.
  if (document.documentElement.classList.contains("estreno")) {
    try { sessionStorage.setItem("angabave.estreno", "1"); }
    catch (e) { /* sin memoria: cada carga entra como la primera */ }
    clearTimeout(window.campoRescate);
    requestAnimationFrame(() => requestAnimationFrame(() => {
      document.documentElement.classList.add("llegando");
      setTimeout(() => document.documentElement.classList.remove("estreno", "llegando"), 2600);
    }));
  }

  // Y a la altura donde se quedó, para que una recarga no te mande al inicio.
  if (guardado && String(guardado.vista) === String(inicio)) {
    if (automatica) reponerControles(guardado.controles);
    if (guardado.scroll > 0) requestAnimationFrame(() => window.scrollTo({ top: guardado.scroll, behavior: "instant" }));
  }

  if (D.vivo) {
    consultarVivo();
    setInterval(consultarVivo, D.vivo.cada * 1000);
    document.addEventListener("visibilitychange", () => { if (!document.hidden) consultarVivo(); });
    window.addEventListener("online", consultarVivo);
  }
  /* ═══ que nadie se quede con una copia vieja ═══
     Pages cachea el HTML diez minutos y esa cabecera no se puede cambiar. Así
     que se consulta un archivo de cien bytes y se recarga solo si su firma es
     otra: cerró un partido, llegó una hoja, se movió un horario. Una hora nueva
     con la misma firma es un latido: dice que el cálculo sigue vivo, nada más.
     Y si la persona está en medio de algo, se espera a la siguiente revisión.

     Con candados, porque el CDN de GitHub ignora el ?v= (medido: una dirección
     con un ?v= nunca pedido sale del caché). Recargar en seguida puede traer la
     misma página vieja, y sin candados eso era un bucle que recargaba cada
     segundo y dejaba la pantalla en blanco hasta diez minutos después de cada
     publicación. Ahora:
       · solo se recarga si lo publicado es más nuevo que esta página;
       · por cada versión nueva, una sola vez cada once minutos (lo que tarda
         en vencer el caché del CDN);
       · y nunca más de una recarga cada tres minutos, pase lo que pase. */
  const LLAVE_RECARGA = "angabave.recarga";
  const TRES_MIN = 3 * 60 * 1000, ONCE_MIN = 11 * 60 * 1000;

  function marca(iso) {
    // Safari no siempre entiende seis decimales en los segundos.
    const t = Date.parse(String(iso || "").replace(/(\.\d{3})\d+/, "$1"));
    return isFinite(t) ? t : NaN;
  }

  function leerRecarga() {
    try { return JSON.parse(sessionStorage.getItem(LLAVE_RECARGA) || "null") || {}; }
    catch (e) { return {}; }
  }

  function recargarFresco(version) {
    const ahora = Date.now(), previa = leerRecarga();
    if (previa.cuando && ahora - previa.cuando < TRES_MIN) return;
    if (previa.version === version && ahora - previa.cuando < ONCE_MIN) return;
    try {
      sessionStorage.setItem(LLAVE_RECARGA, JSON.stringify({ cuando: ahora, version }));
    } catch (e) {
      // Sin dónde anotar la recarga no hay candado: mejor no recargar solo.
      return;
    }
    recargaAutomatica = true;
    recordarSitio();
    const url = new URL(location.href);
    url.searchParams.set("v", String(ahora));
    location.replace(url.toString());
  }

  /* El aviso de "lleva tanto sin recalcularse" entra o sale según el último latido. */
  function revisarRezago() {
    if (typeof vistaActual !== "number") return;
    const hay = !!vistas.semana.querySelector(".rezago");
    if (hay !== !!avisoDeRezago(porSemana.get(vistaActual))) repintarSinEstorbar();
  }

  async function revisarVersion() {
    if (document.hidden) return;
    try {
      const r = await fetch("version.json?t=" + Date.now(), { cache: "no-store" });
      if (!r.ok) return;
      const sello = await r.json();
      const publicada = marca(sello.generado), esta = marca(D.generado);
      if (publicada > latido) latido = publicada;
      latidoVisto = true;
      revisarRezago();
      if (!sello.firma || sello.firma === D.firma) return;   // nada oficial cambió
      if (!(publicada > esta)) return;   // el CDN trajo uno más viejo o ilegible
      if (escribiendo() || document.querySelector(".hoja-fondo") || Date.now() - ultimoToque < 30000) return;
      recargarFresco(sello.firma);
    } catch (e) { /* sin red o archivo viejo: se sigue con lo que hay */ }
  }

  setInterval(revisarVersion, 90000);
  document.addEventListener("visibilitychange", () => { if (!document.hidden) revisarVersion(); });
  revisarVersion();

  // Arrancó bien: la red de seguridad ya no hace falta.
  window.angabaveListo = true;
})();
</script>
</body>
</html>
