{#- Red de seguridad común al portal y a la página del enlace.

    Va en JavaScript viejo a propósito (var, function, nada de flechas): si el
    script principal no arranca —un navegador que no lo entiende, un error a
    medio camino—, esto sí corre. En vez de una pantalla en blanco se ve qué
    hacer, y el detalle del error con el navegador exacto, para que una captura
    baste para arreglarlo.

    La página avisa que arrancó con window.angabaveListo = true. Si no lo hace
    en `espera_rescate` milisegundos después de haber llegado completa (o en un
    minuto, si sigue llegando), sale este aviso: con datos móviles la página puede
    tardar en bajar y mientras siga llegando no es una falla. Si al final sí
    arranca, el aviso se quita solo. -#}
<div id="rescate" role="alert" style="display:none; position:fixed; left:16px; right:16px; top:16px; z-index:2147483647; max-width:520px; margin:0 auto; background:#101613; color:#F3F6F4; border:1px solid #FF6B61; border-radius:16px; padding:16px; font:14px/1.45 -apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif">
  <strong style="display:block; font-size:16px; margin-bottom:6px">La página no abrió en este teléfono</strong>
  <span style="display:block; color:#A7B1AB">Ciérrala y vuelve a abrir el enlace. Si sigue igual, actualiza tu teléfono o ábrela en otro, y mándale a Angel una captura de esta pantalla.</span>
  <a href="" style="display:inline-block; margin-top:4px; padding:12px 0; color:#FFD60A; font-weight:700">Volver a intentar</a>
  <small id="rescate-detalle" style="display:block; font-size:12px; color:#A7B1AB; word-break:break-word"></small>
</div>
<noscript><div style="margin:16px; padding:16px; border:1px solid #FF6B61; border-radius:16px; background:#101613; color:#F3F6F4; font:14px/1.45 -apple-system,Arial,sans-serif">Esta página necesita JavaScript. Actívalo en los ajustes del navegador, o ábrela desde otro.</div></noscript>
<script>
(function () {
  var detalle = "";
  var inicio = new Date().getTime(), finHtml = 0;
  function anotar(texto) {
    if (!detalle && texto) detalle = String(texto).slice(0, 300);
  }
  window.addEventListener("error", function (e) {
    anotar(e && (e.message || (e.error && e.error.message)));
  });
  window.addEventListener("unhandledrejection", function (e) {
    anotar(e && e.reason && (e.reason.message || e.reason));
  });
  document.addEventListener("DOMContentLoaded", function () {
    finHtml = new Date().getTime();
  });
  function revisar() {
    if (window.angabaveListo) return;
    var ahora = new Date().getTime();
    var llegando = !finHtml && ahora - inicio < 60000;
    var recien = finHtml && !detalle && ahora - finHtml < 6000;
    if (llegando || recien) {
      window.setTimeout(revisar, 1000);
      return;
    }
    var caja = document.getElementById("rescate");
    var nota = document.getElementById("rescate-detalle");
    if (!caja || !nota) return;
    nota.appendChild(document.createTextNode(
      "Detalle: " + (detalle || (finHtml ? "la página no terminó de arrancar" : "la página tardó más de un minuto en llegar")) + " · " + navigator.userAgent
    ));
    caja.style.display = "block";
    var vigia = window.setInterval(function () {
      if (!window.angabaveListo) return;
      caja.style.display = "none";
      window.clearInterval(vigia);
    }, 1000);
  }
  window.setTimeout(revisar, {{ espera_rescate }});
})();
</script>
