{#- Red de seguridad común al portal y a la página del enlace.

    Va en JavaScript viejo a propósito (var, function, nada de flechas): si el
    script principal no arranca —un navegador que no lo entiende, un error a
    medio camino—, esto sí corre. En vez de una pantalla en blanco se ve qué
    hacer, y el detalle del error con el navegador exacto, para que una captura
    baste para arreglarlo.

    La página avisa que arrancó con window.angabaveListo = true. Si no lo hace
    en `espera_rescate` milisegundos después de haber llegado completa:
      · casi siempre es que con datos celulares llegó cortada, así que se vuelve
        a pedir sola una vez (con ?r= nuevo, para que ni el caché del teléfono ni
        un nodo atrasado del CDN la repitan);
      · si tampoco arranca, sale el aviso, con la prueba de conexión a un toque.
    Mientras siga llegando no es una falla: pasado un minuto se avisa que la
    señal va lenta y se sigue esperando. Si al final arranca, el aviso se quita solo. -#}
<div id="rescate" role="alert" style="display:none; position:fixed; left:16px; right:16px; top:16px; z-index:2147483647; max-width:520px; margin:0 auto; background:#101613; color:#F3F6F4; border:1px solid #FF6B61; border-radius:16px; padding:16px; font:14px/1.45 -apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif">
  <strong id="rescate-titulo" style="display:block; font-size:16px; margin-bottom:6px">La página no abrió en este teléfono</strong>
  <span id="rescate-texto" style="display:block; color:#A7B1AB">Vuelve a intentar. Si sigue igual, abre la prueba de conexión y mándale a Angel una captura de esta pantalla y de esa.</span>
  <a id="rescate-otra" href="" style="display:inline-block; margin:4px 24px 0 0; padding:12px 0; color:#FFD60A; font-weight:700">Volver a intentar</a>
  <a href="red.html" style="display:inline-block; margin-top:4px; padding:12px 0; color:#F3F6F4; font-weight:700">Probar la conexión</a>
  <small id="rescate-detalle" style="display:block; font-size:12px; color:#A7B1AB; word-break:break-word"></small>
</div>
<noscript><div style="margin:16px; padding:16px; border:1px solid #FF6B61; border-radius:16px; background:#101613; color:#F3F6F4; font:14px/1.45 -apple-system,Arial,sans-serif">Esta página necesita JavaScript. Actívalo en los ajustes del navegador, o ábrela desde otro.</div></noscript>
<script>
(function () {
  var detalle = "";
  var inicio = new Date().getTime(), finHtml = 0, mostrado = "";
  function anotar(texto) {
    if (!detalle && texto) detalle = String(texto).slice(0, 300);
  }
  window.addEventListener("error", function (e) {
    anotar(e && (e.message || (e.error && e.error.message)));
  });
  window.addEventListener("unhandledrejection", function (e) {
    anotar(e && e.reason && (e.reason.message || e.reason));
  });
  document.addEventListener("DOMContentLoaded", function () {
    finHtml = new Date().getTime();
  });

  function otraVez() {
    var partes = location.href.split("#"), base = partes.shift();
    base = base.replace(/([?&])r=\d*(&|$)/, "$1").replace(/[?&]$/, "");
    return base + (base.indexOf("?") < 0 ? "?" : "&") + "r=" + new Date().getTime() + (partes.length ? "#" + partes.join("#") : "");
  }

  function reintentar() {
    try {
      var antes = Number(sessionStorage.getItem("angabave.reintento")) || 0, ahora = new Date().getTime();
      if (ahora - antes < 120000) return false;
      sessionStorage.setItem("angabave.reintento", String(ahora));
    } catch (e) {
      return false;   // sin dónde anotarlo no hay candado: mejor no recargar solo
    }
    location.replace(otraVez());
    return true;
  }

  function poner(id, texto) {
    var nodo = document.getElementById(id);
    if (nodo) nodo.textContent = texto;
  }

  function mostrar(tipo) {
    var caja = document.getElementById("rescate");
    if (!caja || mostrado === tipo) return;
    mostrado = tipo;
    if (tipo === "lenta") {
      poner("rescate-titulo", "Tu señal va muy lenta");
      poner("rescate-texto", "La página sigue llegando y se abre sola en cuanto termine. Si tarda mucho, vuelve a intentar con mejor señal o con wifi.");
    } else {
      poner("rescate-titulo", "La página no abrió en este teléfono");
      poner("rescate-texto", "Vuelve a intentar. Si sigue igual, abre la prueba de conexión y mándale a Angel una captura de esta pantalla y de esa.");
    }
    var otra = document.getElementById("rescate-otra");
    if (otra) otra.setAttribute("href", otraVez());
    poner("rescate-detalle",
      "Detalle: " + (detalle || (finHtml ? "la página no terminó de arrancar" : "la página tardó más de un minuto en llegar")) + " · " + navigator.userAgent
    );
    caja.style.display = "block";
  }

  function revisar() {
    var caja = document.getElementById("rescate");
    if (window.angabaveListo) {
      if (caja) caja.style.display = "none";
      return;
    }
    var ahora = new Date().getTime();
    if (!finHtml) {
      if (ahora - inicio >= 60000) mostrar("lenta");
    } else if (detalle || ahora - finHtml >= 6000) {
      // Una sola vuelta automática por carga: con el aviso a la vista ya no se recarga sola.
      if (mostrado !== "fallo" && reintentar()) return;
      mostrar("fallo");
    }
    window.setTimeout(revisar, 1000);
  }
  window.setTimeout(revisar, {{ espera_rescate }});
})();
</script>
